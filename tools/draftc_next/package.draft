// Draft-written staging driver for the self-hosted compiler frontend.
//
// This executable owns the replaced lexical, concrete-syntax, folder-package,
// recursive import-graph, and declaration-name phases. `lex` and `syntax` load
// one source file; `package-syntax` selects and parses one package;
// `workspace-syntax` resolves explicitly configured roots and every reachable
// import; `workspace-declarations` additionally publishes package declarations
// and file-local alias bindings; `workspace-public-names` projects target
// package public declarations beneath those aliases and qualifies two-part
// imported-name lookup; `workspace-target-declarations` materializes package
// `when` through target facts and demand-driven local scalar constant products,
// then rebinds that public view.
// Every command
// renders the same stdout/stderr bytes and exit status as its C++ bootstrap
// oracle. Keeping the commands phase-bounded makes bootstrap replacement
// measurable; later semantic slices can join this driver without placing LLVM
// or native-linker behavior in the frontend packages.
//
// main owns all process-facing sources, token storage, diagnostics, and output
// builders until the final writes complete. The imported compiler packages do
// not observe arguments or standard streams. Relevant specification: sections
// 3-4, especially folder packages, declarations, and compile-time `when`.
package draftc_next

import core/array
import core/os
import compiler/diagnostic as compiler_diagnostic
import compiler/sema as compiler_sema
import compiler/source as compiler_source
import compiler/syntax as compiler_syntax
import compiler/text as compiler_text
import compiler/workspace as compiler_workspace

// text_equal performs exact command spelling comparison without locale or
// normalization. Process arguments are borrowed for the process lifetime.
text_equal :: proc(left, right: string) -> bool {
    if len(left) != len(right) {
        return false
    }
    for index: usize = 0; index < len(left); index += 1 {
        if left[index] != right[index] {
            return false
        }
    }
    return true
}

// append_escaped_token copies one token spelling under the bootstrap dump
// contract. LF, CR, tab, and backslash have readable escapes; printable ASCII
// is retained; every other byte is a fixed question mark. This intentionally
// does not decode UTF-8 or depend on terminal encoding.
append_escaped_token :: proc(output: ^compiler_text.Builder, spelling: []u8) {
    for byte in spelling {
        switch byte {
        case '\n': compiler_text.append_text(output, "\\n")
        case '\r': compiler_text.append_text(output, "\\r")
        case '\t': compiler_text.append_text(output, "\\t")
        case '\\': compiler_text.append_text(output, "\\\\")
        case:
            if byte >= 0x20 && byte <= 0x7e {
                compiler_text.append_byte(output, byte)
            } else {
                compiler_text.append_byte(output, cast[u8]('?'))
            }
        }
    }
}

// render_tokens appends one line per public lexer token. Line and column are
// one-based source coordinates; inserted semicolons have no quoted spelling;
// EOF has neither an inserted marker nor source spelling.
render_tokens :: proc(
    source: ^compiler_source.Source_File,
    tokens: ^compiler_syntax.Token_List,
    output: ^compiler_text.Builder,
) {
    for token in compiler_syntax.token_list_view(tokens) {
        coordinate := compiler_source.line_column(source, token.range.begin)
        compiler_text.append_unsigned(output, cast[usize](coordinate.line))
        compiler_text.append_byte(output, cast[u8](':'))
        compiler_text.append_unsigned(output, cast[usize](coordinate.column))
        compiler_text.append_byte(output, cast[u8](' '))
        compiler_text.append_text(
            output,
            compiler_syntax.token_kind_name(token.kind),
        )
        if token.inserted {
            compiler_text.append_text(output, " [inserted]")
        } else if token.kind != .end_of_file {
            compiler_text.append_text(output, " \"")
            append_escaped_token(
                output,
                compiler_source.bytes_in_range(source, token.range),
            )
            compiler_text.append_byte(output, cast[u8]('"'))
        }
        compiler_text.append_byte(output, cast[u8]('\n'))
    }
}

// render_load_error maps the source owner's closed failure set to the current
// bootstrap command spelling. Oversized source is a read failure at this
// process boundary because no valid Source_File can be published from it.
render_load_error :: proc(
    output: ^compiler_text.Builder,
    path: string,
    error: compiler_source.Load_Error,
) {
    compiler_text.append_text(output, "error: ")
    if error == .cannot_open {
        compiler_text.append_text(output, "cannot open source file '")
    } else {
        compiler_text.append_text(output, "cannot read source file '")
    }
    compiler_text.append_text(output, path)
    compiler_text.append_text(output, "'\n")
}

// run_lex owns one complete command transaction. Token output is written even
// when lexical diagnostics exist, matching bootstrap inspection behavior; the
// diagnostics follow on stderr and determine the nonzero status.
run_lex :: proc(path: string) -> int {
    source: compiler_source.Source_File
    load_error := compiler_source.load(&source, path)
    defer compiler_source.destroy(&source)
    if load_error != .none {
        error_output: compiler_text.Builder
        compiler_text.init(&error_output)
        defer compiler_text.destroy(&error_output)
        render_load_error(&error_output, path, load_error)
        write_error := os.write_all(
            os.standard_error,
            compiler_text.view(&error_output),
        )
        if write_error != .none {
            return 1
        }
        return 1
    }

    diagnostics: compiler_diagnostic.Sink
    tokens: compiler_syntax.Token_List
    token_output: compiler_text.Builder
    diagnostic_output: compiler_text.Builder
    compiler_diagnostic.init(&diagnostics)
    compiler_syntax.token_list_init(&tokens)
    compiler_text.init(&token_output)
    compiler_text.init(&diagnostic_output)
    defer compiler_text.destroy(&diagnostic_output)
    defer compiler_text.destroy(&token_output)
    defer compiler_syntax.token_list_destroy(&tokens)
    defer compiler_diagnostic.destroy(&diagnostics)

    compiler_syntax.lex(&source, &diagnostics, &tokens)
    render_tokens(&source, &tokens, &token_output)
    compiler_diagnostic.render(&source, &diagnostics, &diagnostic_output)

    if os.write_all(
        os.standard_output,
        compiler_text.view(&token_output),
    ) != .none {
        return 1
    }
    if os.write_all(
        os.standard_error,
        compiler_text.view(&diagnostic_output),
    ) != .none {
        return 1
    }
    return 1 if compiler_diagnostic.has_errors(&diagnostics) else 0
}

// run_syntax owns one source-to-concrete-tree transaction. The tree dump is
// emitted even when recovery reported errors; diagnostics follow on stderr and
// determine status, exactly like the bootstrap inspection command.
run_syntax :: proc(path: string) -> int {
    source: compiler_source.Source_File
    load_error := compiler_source.load(&source, path)
    defer compiler_source.destroy(&source)
    if load_error != .none {
        error_output: compiler_text.Builder
        compiler_text.init(&error_output)
        defer compiler_text.destroy(&error_output)
        render_load_error(&error_output, path, load_error)
        if os.write_all(
            os.standard_error,
            compiler_text.view(&error_output),
        ) != .none {
            return 1
        }
        return 1
    }

    diagnostics: compiler_diagnostic.Sink
    tree: compiler_syntax.Syntax_Tree
    syntax_output: compiler_text.Builder
    diagnostic_output: compiler_text.Builder
    compiler_diagnostic.init(&diagnostics)
    compiler_text.init(&syntax_output)
    compiler_text.init(&diagnostic_output)
    compiler_syntax.parse_source_file(&source, &diagnostics, &tree)
    defer compiler_syntax.syntax_tree_destroy(&tree)
    defer compiler_text.destroy(&diagnostic_output)
    defer compiler_text.destroy(&syntax_output)
    defer compiler_diagnostic.destroy(&diagnostics)

    compiler_syntax.dump_syntax_tree(&tree, &syntax_output)
    compiler_diagnostic.render(&source, &diagnostics, &diagnostic_output)
    if os.write_all(
        os.standard_output,
        compiler_text.view(&syntax_output),
    ) != .none {
        return 1
    }
    if os.write_all(
        os.standard_error,
        compiler_text.view(&diagnostic_output),
    ) != .none {
        return 1
    }
    return 1 if compiler_diagnostic.has_errors(&diagnostics) else 0
}

// target_selector_valid keeps package source selection on the same closed file
// tags as the bootstrap. This command performs no target semantics yet; the tag
// only selects exact direct-child filenames before parsing.
target_selector_valid :: proc(selector: string) -> bool {
    return text_equal(selector, "aarch64-macos") ||
        text_equal(selector, "aarch64-linux") ||
        text_equal(selector, "x86_64-linux") ||
        text_equal(selector, "x86_64-windows")
}

// run_package_syntax owns one deterministic folder-package transaction. The
// package layer constructs both output streams completely before process I/O,
// so partial writes cannot affect compiler state or diagnostic ordering.
run_package_syntax :: proc(path, file_tag: string) -> int {
    loaded: compiler_workspace.Package
    succeeded := compiler_workspace.load(
        &loaded,
        path,
        compiler_workspace.Load_Options{file_tag = file_tag},
    )
    defer compiler_workspace.destroy(&loaded)

    syntax_output: compiler_text.Builder
    diagnostic_output: compiler_text.Builder
    compiler_text.init(&syntax_output)
    compiler_text.init(&diagnostic_output)
    defer compiler_text.destroy(&diagnostic_output)
    defer compiler_text.destroy(&syntax_output)

    compiler_workspace.dump_package_syntax(&loaded, &syntax_output)
    compiler_workspace.render_diagnostics(&loaded, &diagnostic_output)
    if os.write_all(
        os.standard_output,
        compiler_text.view(&syntax_output),
    ) != .none {
        return 1
    }
    if os.write_all(
        os.standard_error,
        compiler_text.view(&diagnostic_output),
    ) != .none {
        return 1
    }
    return 0 if succeeded else 1
}

// run_workspace_syntax owns one canonical recursive package-graph transaction.
// The explicit workspace, dependency, and physical core roots are the complete
// namespace: no environment or ambient checkout search occurs. Output excludes
// physical paths so equivalent checkout locations have the same graph dump.
run_workspace_syntax :: proc(
    root_package, workspace_directory, core_directory: string,
    core_identity, file_tag: string,
    dependencies: []compiler_workspace.Dependency_Mapping,
) -> int {
    graph: compiler_workspace.Workspace_Graph
    succeeded := compiler_workspace.load_workspace(
        &graph,
        root_package,
        compiler_workspace.Workspace_Options{
            workspace_directory = workspace_directory,
            core_directory = core_directory,
            core_content_identity = core_identity,
            dependencies = dependencies,
            package_options = compiler_workspace.Load_Options{
                file_tag = file_tag,
            },
        },
    )
    defer compiler_workspace.destroy_workspace_graph(&graph)

    graph_output: compiler_text.Builder
    diagnostic_output: compiler_text.Builder
    compiler_text.init(&graph_output)
    compiler_text.init(&diagnostic_output)
    defer compiler_text.destroy(&diagnostic_output)
    defer compiler_text.destroy(&graph_output)

    compiler_workspace.dump_workspace_graph(&graph, &graph_output)
    compiler_workspace.render_workspace_diagnostics(
        &graph,
        &diagnostic_output,
    )
    if os.write_all(
        os.standard_output,
        compiler_text.view(&graph_output),
    ) != .none {
        return 1
    }
    if os.write_all(
        os.standard_error,
        compiler_text.view(&diagnostic_output),
    ) != .none {
        return 1
    }
    return 0 if succeeded else 1
}

// run_workspace_declarations extends the canonical graph transaction through
// the first semantic name-set boundary. A graph failure publishes the same
// partial graph and diagnostics as workspace-syntax and never enters semantics.
// A successful graph remains alive until every borrowed declaration spelling,
// dump row, and semantic diagnostic has been rendered.
run_workspace_declarations :: proc(
    root_package, workspace_directory, core_directory: string,
    core_identity, file_tag: string,
    dependencies: []compiler_workspace.Dependency_Mapping,
) -> int {
    graph: compiler_workspace.Workspace_Graph
    graph_succeeded := compiler_workspace.load_workspace(
        &graph,
        root_package,
        compiler_workspace.Workspace_Options{
            workspace_directory = workspace_directory,
            core_directory = core_directory,
            core_content_identity = core_identity,
            dependencies = dependencies,
            package_options = compiler_workspace.Load_Options{
                file_tag = file_tag,
            },
        },
    )
    defer compiler_workspace.destroy_workspace_graph(&graph)

    semantic: compiler_sema.Semantic_Workspace
    semantic_succeeded := compiler_sema.collect_workspace_declarations(
        &graph,
        &semantic,
    )
    defer compiler_sema.destroy_semantic_workspace(&semantic)

    standard_output: compiler_text.Builder
    diagnostic_output: compiler_text.Builder
    compiler_text.init(&standard_output)
    compiler_text.init(&diagnostic_output)
    defer compiler_text.destroy(&diagnostic_output)
    defer compiler_text.destroy(&standard_output)

    compiler_workspace.dump_workspace_graph(&graph, &standard_output)
    compiler_workspace.render_workspace_diagnostics(
        &graph,
        &diagnostic_output,
    )
    if graph_succeeded {
        compiler_sema.dump_workspace_declarations(
            &graph,
            &semantic,
            &standard_output,
        )
        compiler_sema.render_workspace_diagnostics(
            &graph,
            &semantic,
            &diagnostic_output,
        )
    }
    if os.write_all(
        os.standard_output,
        compiler_text.view(&standard_output),
    ) != .none {
        return 1
    }
    if os.write_all(
        os.standard_error,
        compiler_text.view(&diagnostic_output),
    ) != .none {
        return 1
    }
    return 0 if graph_succeeded && semantic_succeeded else 1
}

// run_workspace_public_names extends successful declaration collection through
// the source-level cross-package name view. It emits the earlier graph and
// declaration rows first, then public definitions and imported alias members.
// The graph remains alive because every emitted name is a borrowed source view.
// A graph or declaration failure preserves the earlier command's exact partial
// output and diagnostics and does not attempt cross-package binding.
run_workspace_public_names :: proc(
    root_package, workspace_directory, core_directory: string,
    core_identity, file_tag: string,
    dependencies: []compiler_workspace.Dependency_Mapping,
) -> int {
    graph: compiler_workspace.Workspace_Graph
    graph_succeeded := compiler_workspace.load_workspace(
        &graph,
        root_package,
        compiler_workspace.Workspace_Options{
            workspace_directory = workspace_directory,
            core_directory = core_directory,
            core_content_identity = core_identity,
            dependencies = dependencies,
            package_options = compiler_workspace.Load_Options{
                file_tag = file_tag,
            },
        },
    )
    defer compiler_workspace.destroy_workspace_graph(&graph)

    semantic: compiler_sema.Semantic_Workspace
    declarations_succeeded := compiler_sema.collect_workspace_declarations(
        &graph,
        &semantic,
    )
    defer compiler_sema.destroy_semantic_workspace(&semantic)
    public_names_succeeded := false
    if declarations_succeeded {
        public_names_succeeded = compiler_sema.bind_workspace_public_names(
            &graph,
            &semantic,
        )
    }

    standard_output: compiler_text.Builder
    diagnostic_output: compiler_text.Builder
    compiler_text.init(&standard_output)
    compiler_text.init(&diagnostic_output)
    defer compiler_text.destroy(&diagnostic_output)
    defer compiler_text.destroy(&standard_output)

    compiler_workspace.dump_workspace_graph(&graph, &standard_output)
    compiler_workspace.render_workspace_diagnostics(
        &graph,
        &diagnostic_output,
    )
    if graph_succeeded {
        compiler_sema.dump_workspace_declarations(
            &graph,
            &semantic,
            &standard_output,
        )
        compiler_sema.render_workspace_diagnostics(
            &graph,
            &semantic,
            &diagnostic_output,
        )
    }
    if public_names_succeeded {
        compiler_sema.dump_workspace_public_names(
            &graph,
            &semantic,
            &standard_output,
        )
    }
    if os.write_all(
        os.standard_output,
        compiler_text.view(&standard_output),
    ) != .none {
        return 1
    }
    if os.write_all(
        os.standard_error,
        compiler_text.view(&diagnostic_output),
    ) != .none {
        return 1
    }
    return 0 if graph_succeeded && declarations_succeeded &&
        public_names_succeeded else 1
}

// run_workspace_target_declarations preserves the earlier graph/declaration
// prefix, then selects package `when` regions through target facts and local
// scalar constant dependencies, appends their symbols without changing an
// unconditional Symbol_Id, and rebuilds public alias spans from the chosen
// declaration tables. The immutable graph remains alive for every borrowed
// source spelling and product value through the final writes.
run_workspace_target_declarations :: proc(
    root_package, workspace_directory, core_directory: string,
    core_identity, file_tag: string,
    dependencies: []compiler_workspace.Dependency_Mapping,
) -> int {
    (facts, have_facts) := compiler_sema.select_builtin_target_facts(file_tag)
    assert(have_facts, "validated target selector has no semantic facts")

    graph: compiler_workspace.Workspace_Graph
    graph_succeeded := compiler_workspace.load_workspace(
        &graph,
        root_package,
        compiler_workspace.Workspace_Options{
            workspace_directory = workspace_directory,
            core_directory = core_directory,
            core_content_identity = core_identity,
            dependencies = dependencies,
            package_options = compiler_workspace.Load_Options{
                file_tag = file_tag,
            },
        },
    )
    defer compiler_workspace.destroy_workspace_graph(&graph)

    semantic: compiler_sema.Semantic_Workspace
    declarations_succeeded := compiler_sema.collect_workspace_declarations(
        &graph,
        &semantic,
    )
    defer compiler_sema.destroy_semantic_workspace(&semantic)

    standard_output: compiler_text.Builder
    diagnostic_output: compiler_text.Builder
    compiler_text.init(&standard_output)
    compiler_text.init(&diagnostic_output)
    defer compiler_text.destroy(&diagnostic_output)
    defer compiler_text.destroy(&standard_output)

    // Preserve the previous phase byte-for-byte before condition
    // materialization mutates only the semantic symbol suffix.
    compiler_workspace.dump_workspace_graph(&graph, &standard_output)
    compiler_workspace.render_workspace_diagnostics(
        &graph,
        &diagnostic_output,
    )
    if graph_succeeded {
        compiler_sema.dump_workspace_declarations(
            &graph,
            &semantic,
            &standard_output,
        )
    }

    target_declarations_succeeded := false
    public_names_succeeded := false
    if declarations_succeeded {
        target_declarations_succeeded =
            compiler_sema.materialize_workspace_target_declarations(
                &graph,
                &facts,
                &semantic,
            )
        if target_declarations_succeeded {
            public_names_succeeded = compiler_sema.bind_workspace_public_names(
                &graph,
                &semantic,
            )
        }
    }
    if target_declarations_succeeded {
        compiler_sema.dump_workspace_target_declarations(
            &graph,
            &facts,
            &semantic,
            &standard_output,
        )
    }
    if public_names_succeeded {
        compiler_sema.dump_workspace_public_names(
            &graph,
            &semantic,
            &standard_output,
        )
    }
    if graph_succeeded {
        compiler_sema.render_workspace_diagnostics(
            &graph,
            &semantic,
            &diagnostic_output,
        )
    }
    if os.write_all(
        os.standard_output,
        compiler_text.view(&standard_output),
    ) != .none {
        return 1
    }
    if os.write_all(
        os.standard_error,
        compiler_text.view(&diagnostic_output),
    ) != .none {
        return 1
    }
    return 0 if graph_succeeded && declarations_succeeded &&
        target_declarations_succeeded && public_names_succeeded else 1
}

// main accepts only implemented phases so an unimplemented command cannot
// silently fall back to the bootstrap or claim self-hosted coverage.
main :: proc() -> int {
    arguments := os.args()
    if len(arguments) == 3 && text_equal(arguments[1], "lex") {
        return run_lex(arguments[2])
    }
    if len(arguments) == 3 && text_equal(arguments[1], "syntax") {
        return run_syntax(arguments[2])
    }
    if len(arguments) == 5 &&
        text_equal(arguments[1], "package-syntax") &&
        text_equal(arguments[3], "--target") &&
        target_selector_valid(arguments[4]) {
        return run_package_syntax(arguments[2], arguments[4])
    }
    workspace_syntax_command := len(arguments) >= 2 &&
        text_equal(arguments[1], "workspace-syntax")
    workspace_declarations_command := len(arguments) >= 2 &&
        text_equal(arguments[1], "workspace-declarations")
    workspace_public_names_command := len(arguments) >= 2 &&
        text_equal(arguments[1], "workspace-public-names")
    workspace_target_declarations_command := len(arguments) >= 2 &&
        text_equal(arguments[1], "workspace-target-declarations")
    if len(arguments) >= 11 &&
        (len(arguments) - 11) % 4 == 0 &&
        (workspace_syntax_command || workspace_declarations_command ||
            workspace_public_names_command ||
            workspace_target_declarations_command) &&
        text_equal(arguments[3], "--workspace") &&
        text_equal(arguments[5], "--core") &&
        text_equal(arguments[7], "--core-identity") &&
        text_equal(arguments[9], "--target") &&
        target_selector_valid(arguments[10]) {
        dependencies: array.Dynamic[compiler_workspace.Dependency_Mapping]
        array.init(&dependencies)
        defer array.destroy(&dependencies)
        argument_index: usize = 11
        valid := true
        for argument_index < len(arguments) {
            if !text_equal(arguments[argument_index], "--dependency") {
                valid = false
                break
            }
            array.append(
                &dependencies,
                compiler_workspace.Dependency_Mapping{
                    import_prefix = arguments[argument_index + 1],
                    physical_directory = arguments[argument_index + 2],
                    content_identity = arguments[argument_index + 3],
                },
            )
            argument_index += 4
        }
        if valid {
            if workspace_syntax_command {
                return run_workspace_syntax(
                    arguments[2],
                    arguments[4],
                    arguments[6],
                    arguments[8],
                    arguments[10],
                    array.view(&dependencies),
                )
            }
            if workspace_declarations_command {
                return run_workspace_declarations(
                    arguments[2],
                    arguments[4],
                    arguments[6],
                    arguments[8],
                    arguments[10],
                    array.view(&dependencies),
                )
            }
            if workspace_public_names_command {
                return run_workspace_public_names(
                    arguments[2],
                    arguments[4],
                    arguments[6],
                    arguments[8],
                    arguments[10],
                    array.view(&dependencies),
                )
            }
            return run_workspace_target_declarations(
                arguments[2],
                arguments[4],
                arguments[6],
                arguments[8],
                arguments[10],
                array.view(&dependencies),
            )
        }
    }
    write_error := os.write_text_all(
        os.standard_error,
        "usage:\n  draftc-next lex <file.draft>\n  draftc-next syntax <file.draft>\n  draftc-next package-syntax <package> --target <selector>\n  draftc-next workspace-syntax <root-package> --workspace <workspace> --core <core-root> --core-identity <identity> --target <selector> [--dependency <prefix> <root> <identity>]...\n  draftc-next workspace-declarations <root-package> --workspace <workspace> --core <core-root> --core-identity <identity> --target <selector> [--dependency <prefix> <root> <identity>]...\n  draftc-next workspace-public-names <root-package> --workspace <workspace> --core <core-root> --core-identity <identity> --target <selector> [--dependency <prefix> <root> <identity>]...\n  draftc-next workspace-target-declarations <root-package> --workspace <workspace> --core <core-root> --core-identity <identity> --target <selector> [--dependency <prefix> <root> <identity>]...\n",
    )
    if write_error != .none {
        return 1
    }
    return 1
}
