// Canonical workspace roots, package identities, and recursive import loading.
//
// This module is the self-hosted boundary between folder parsing and semantic
// analysis. It maps explicitly configured physical roots to stable semantic
// identities, loads every transitively imported folder package, records each
// source import occurrence, rejects cycles, and prevents canonicalized paths
// (including symlink targets) from escaping their selected root. The resulting
// graph is closed and acyclic exactly when load_workspace returns true.
//
// Workspace_Graph owns every root spelling, identity, loaded Package, import
// path, diagnostic message, and traversal row. Package_Id is a stable u32 index
// into its package table. Source ranges and syntax IDs are interpreted only
// through the nested Package_File that owns their source and tree. Discovery is
// deliberately sequential: packages use recursive first-discovery order;
// imports use canonical filename order and syntax order within each file.
//
// This phase depends only on compiler source, syntax, diagnostic, text, the
// one-package loader, and core ownership/filesystem facilities. It knows no
// declarations, types, or LLVM details. Relevant specification: section 3,
// "Folder packages".
package compiler_workspace

import core/filesystem
import core/io
import core/memory
import core/runtime
import compiler/diagnostic as compiler_diagnostic
import compiler/source as compiler_source
import compiler/syntax as compiler_syntax
import compiler/text as compiler_text

Initial_Canonical_Path_Capacity :: 4096
Maximum_Package_Import_Depth :: cast[u32](256)
Invalid_Package_Value :: ~cast[u32](0)

// Package_Id is one stable index into Workspace_Graph.packages. The all-ones
// value is invalid and marks a failed import edge or an absent root package.
// IDs are process-local traversal facts and must not enter persistent hashes.
pub Package_Id :: struct {
    value: u32,
}

// package_id_valid distinguishes a published graph row from the invalid
// sentinel returned after a diagnosed load or graph failure.
pub package_id_valid :: proc(id: Package_Id) -> bool {
    return id.value != Invalid_Package_Value
}

invalid_package_id :: proc() -> Package_Id {
    return Package_Id{value = Invalid_Package_Value}
}

// Root_Kind records which explicit namespace mapping selected a package.
// Workspace is the unmatched import fallback, dependency prefixes are supplied
// by build configuration, and core is the reserved compiler distribution.
pub Root_Kind :: enum u8 {
    workspace,
    dependency,
    core,
}

// Dependency_Mapping is borrowed load configuration. import_prefix is matched
// only at slash-component boundaries. content_identity, not physical_directory,
// participates in semantic identity and must name pinned dependency contents.
pub Dependency_Mapping :: struct {
    import_prefix: string,
    physical_directory: string,
    content_identity: string,
}

// Workspace_Options contains every permitted physical source root. All string
// and dependency views are borrowed only for load_workspace. The initial
// self-hosted graph accepts a physical core directory; embedded distribution
// packages and in-memory source overrides remain at the later replacement seam.
pub Workspace_Options :: struct {
    workspace_directory: string,
    core_directory: string,
    core_content_identity: string,
    dependencies: []Dependency_Mapping,
    package_options: Load_Options,
}

// Package_Root is one owned semantic-to-physical root mapping. identity and
// import_prefix affect graph meaning. physical_directory is a canonical,
// absolute, slash-separated I/O path and must never enter semantic hashes.
pub Package_Root :: struct {
    kind: Root_Kind,
    identity: memory.Owned_String,
    import_prefix: memory.Owned_String,
    physical_directory: memory.Owned_String,
}

// Package_Identity is the specification's semantic pair. root_relative_path
// uses slash separators, has no leading or trailing slash, and is exactly "."
// for the mapped root directory itself. Equality is bytewise semantic equality.
pub Package_Identity :: struct {
    root_identity: memory.Owned_String,
    root_relative_path: memory.Owned_String,
}

// Workspace_Package owns one successfully loaded folder package. root indexes
// Workspace_Graph.roots; identity is canonicalized before publication. The
// nested Package owns all source bytes, syntax trees, and file diagnostics.
pub Workspace_Package :: struct {
    identity: Package_Identity,
    root: u32,
    loaded: Package,
}

// Package_Import is one source occurrence rather than one deduplicated graph
// edge. file_index addresses the importing Package.files table; syntax is the
// ImportClause node in that file's tree. path owns the exact normalized package
// path written in source. Alias binding belongs to declaration collection.
pub Package_Import :: struct {
    importing_package: Package_Id,
    imported_package: Package_Id,
    file_index: usize,
    syntax: compiler_syntax.Node_Id,
    path: memory.Owned_String,
}

Diagnostic_Kind :: enum u8 {
    pre_source,
    source,
    rendered,
}

// Graph_Diagnostic preserves insertion order across configuration, recursive
// loading, and import resolution. source rows retain structured location facts;
// rendered rows own complete output from a failed one-package transaction, whose
// parser diagnostics cannot be retained after that unpublished package dies.
Graph_Diagnostic :: struct {
    kind: Diagnostic_Kind,
    message: memory.Owned_String,
    source_package: Package_Id,
    file_index: usize,
    range: compiler_source.Source_Range,
}

Visit_State :: enum u8 {
    loading,
    complete,
}

// Package_Visit is parallel to packages during one load. A loading hit is a
// back edge; a complete hit reuses the existing stable Package_Id.
Package_Visit :: struct {
    state: Visit_State,
}

// Workspace_Graph is a partial inspection result on failure and a closed,
// acyclic graph on success. All Dynamic fields are independently owned. roots
// are ordered workspace, accepted dependencies, then core; packages use first
// discovery order; imports use deterministic recursive resolution order.
pub Workspace_Graph :: struct {
    roots: Root_Array,
    packages: Workspace_Package_Array,
    imports: Package_Import_Array,
    diagnostics: Graph_Diagnostic_Array,
    visits: Package_Visit_Array,
    root_package: Package_Id,
    failed: bool,
}

// Diagnostic_Context identifies the source edge responsible for a recursive
// operation. Invalid context denotes configuration or command-root diagnostics.
Diagnostic_Context :: struct {
    valid: bool,
    source_package: Package_Id,
    file_index: usize,
    range: compiler_source.Source_Range,
}

// Parsed_Import temporarily owns facts copied from one stable syntax tree. The
// complete list is extracted before recursion so graph array growth cannot
// invalidate a retained pointer into the importing package row.
Parsed_Import :: struct {
    file_index: usize,
    syntax: compiler_syntax.Node_Id,
    range: compiler_source.Source_Range,
    path: memory.Owned_String,
}

// The bootstrap currently gives imported generic record instantiations
// different type identities when a package consumes them from multiple files.
// These six concrete arrays are the same explicit workaround used by the syntax
// token and node tables. Each owns contiguous storage, captures its allocator,
// grows geometrically, and invalidates pointers on growth while preserving
// integer indices. Remove them in favor of core/array only after that compiler
// limitation is fixed and this package is requalified on all targets.
Root_Array :: struct {
    data: [^]Package_Root,
    length: usize,
    capacity: usize,
    allocator: runtime.Allocator,
}

Workspace_Package_Array :: struct {
    data: [^]Workspace_Package,
    length: usize,
    capacity: usize,
    allocator: runtime.Allocator,
}

Package_Import_Array :: struct {
    data: [^]Package_Import,
    length: usize,
    capacity: usize,
    allocator: runtime.Allocator,
}

Graph_Diagnostic_Array :: struct {
    data: [^]Graph_Diagnostic,
    length: usize,
    capacity: usize,
    allocator: runtime.Allocator,
}

Package_Visit_Array :: struct {
    data: [^]Package_Visit,
    length: usize,
    capacity: usize,
    allocator: runtime.Allocator,
}

Parsed_Import_Array :: struct {
    data: [^]Parsed_Import,
    length: usize,
    capacity: usize,
    allocator: runtime.Allocator,
}

root_array_init :: proc(values: ^Root_Array) {
    assert(values.data == nil && values.length == 0 && values.capacity == 0,
        "root array is not empty")
    values.allocator = context.allocator
}

root_array_append :: proc(values: ^Root_Array, value: Package_Root) {
    if values.length == values.capacity {
        next := values.capacity * 2
        if next < 4 {
            next = 4
        }
        values.data = cast[[^]Package_Root](memory.resize_with_allocator(
            cast[rawptr](values.data),
            values.capacity * size_of(Package_Root),
            next * size_of(Package_Root),
            align_of(Package_Root),
            values.allocator,
        ))
        values.capacity = next
    }
    values.data[values.length] = value
    values.length += 1
}

root_array_destroy :: proc(values: ^Root_Array) {
    memory.free_bytes_with_allocator(
        cast[rawptr](values.data),
        values.capacity * size_of(Package_Root),
        align_of(Package_Root),
        values.allocator,
    )
    values.data = nil
    values.length = 0
    values.capacity = 0
}

workspace_package_array_init :: proc(values: ^Workspace_Package_Array) {
    assert(values.data == nil && values.length == 0 && values.capacity == 0,
        "workspace package array is not empty")
    values.allocator = context.allocator
}

workspace_package_array_append :: proc(
    values: ^Workspace_Package_Array,
    value: Workspace_Package,
) {
    if values.length == values.capacity {
