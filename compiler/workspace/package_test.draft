// Focused pure tests for self-hosted package filename selection.
//
// Process-level differential tests own real directory enumeration, sorting,
// loading, parsing, and diagnostics. These tests isolate the closed filename
// grammar for every target and validation mode without depending on ambient
// filesystem contents. Relevant specification: section 3, "Folder packages".
package compiler_workspace

import core/testing

expect_selected :: proc(
    test: ^testing.Test,
    filename: string,
    options: Load_Options,
    expected_kind: File_Kind,
) {
    (kind, selected) := selected_file_kind(filename, options)
    testing.expect(test, selected)
    if selected {
        testing.expect(test, kind == expected_kind)
    }
}

expect_excluded :: proc(
    test: ^testing.Test,
    filename: string,
    options: Load_Options,
) {
    (_, selected) := selected_file_kind(filename, options)
    testing.expect(test, !selected)
}

test_selects_unqualified_source_and_assembly :: proc(test: ^testing.Test) {
    options := Load_Options{file_tag = "aarch64-macos"}
    expect_selected(test, "package.draft", options, .draft_source)
    expect_selected(test, "native.s", options, .assembly_source)
    expect_selected(test, "native.S", options, .assembly_source)
    expect_selected(test, "native.asm", options, .assembly_source)
    expect_excluded(test, "README.md", options)
    expect_excluded(test, ".draft", options)
}

test_selects_only_exact_target_qualifier :: proc(test: ^testing.Test) {
    options := Load_Options{file_tag = "x86_64-linux"}
    expect_selected(
        test,
        "platform@x86_64-linux.draft",
        options,
        .draft_source,
    )
    expect_selected(
        test,
        "native@x86_64-linux.s",
        options,
        .assembly_source,
    )
    expect_excluded(test, "platform@aarch64-linux.draft", options)
    expect_excluded(test, "platform@linux.draft", options)
    expect_excluded(test, "platform@.draft", options)
}

test_validation_suffixes_follow_removed_qualifier :: proc(test: ^testing.Test) {
    ordinary := Load_Options{file_tag = "aarch64-linux"}
    expect_excluded(test, "feature_test.draft", ordinary)
    expect_excluded(test, "feature_test@aarch64-linux.draft", ordinary)
    expect_excluded(test, "feature_bench@aarch64-linux.draft", ordinary)

    validation := Load_Options{
        file_tag = "aarch64-linux",
        include_tests = true,
        include_benchmarks = true,
    }
    expect_selected(
        test,
        "feature_test@aarch64-linux.draft",
        validation,
        .draft_source,
    )
    expect_selected(
        test,
        "feature_bench@aarch64-linux.draft",
        validation,
        .draft_source,
    )
}

test_validation_suffixes_do_not_exclude_assembly :: proc(test: ^testing.Test) {
    options := Load_Options{file_tag = "x86_64-windows"}
    expect_selected(test, "support_test.asm", options, .assembly_source)
    expect_selected(
        test,
        "support_bench@x86_64-windows.asm",
        options,
        .assembly_source,
    )
}

test_final_qualifier_and_extension_are_authoritative :: proc(
    test: ^testing.Test,
) {
    options := Load_Options{file_tag = "aarch64-macos"}
    expect_selected(
        test,
        "name@other@aarch64-macos.draft",
        options,
        .draft_source,
    )
    expect_excluded(test, "name@aarch64-macos.draft.txt", options)
    expect_selected(test, "name..draft", options, .draft_source)
}

// Root selection is component-aligned: a mapping may claim its exact root and
// descendants, but a textual prefix inside one component remains workspace
// source. This is the key disambiguation invariant for dependency namespaces.
test_workspace_component_prefixes_are_aligned :: proc(test: ^testing.Test) {
    vendor := text_bytes("vendor")
    testing.expect(test, component_prefix(vendor, text_bytes("vendor")))
    testing.expect(
        test,
        component_prefix(vendor, text_bytes("vendor/text")),
    )
    testing.expect(
        test,
        !component_prefix(vendor, text_bytes("vendorized/text")),
    )
    testing.expect(
        test,
        !component_prefix(text_bytes("vendor/text"), vendor),
    )
}

// Dependency prefixes are already normalized semantic paths. Rejecting empty,
// absolute, repeated, dot, and dot-dot components prevents configuration from
// creating aliases or traversal before any physical path is consulted.
test_workspace_dependency_prefix_validation :: proc(test: ^testing.Test) {
    testing.expect(test, valid_import_prefix(text_bytes("vendor")))
    testing.expect(test, valid_import_prefix(text_bytes("vendor/text")))
    testing.expect(test, !valid_import_prefix(text_bytes("")))
    testing.expect(test, !valid_import_prefix(text_bytes("/vendor")))
    testing.expect(test, !valid_import_prefix(text_bytes("vendor/")))
    testing.expect(test, !valid_import_prefix(text_bytes("vendor//text")))
    testing.expect(test, !valid_import_prefix(text_bytes("vendor/./text")))
    testing.expect(test, !valid_import_prefix(text_bytes("vendor/../text")))
}
