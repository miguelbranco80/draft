// This executable demonstrates the human-facing core/console API and the
// allocation-free core/format layer beneath it. It verifies boundary integer
// spellings in memory before sending representative text, integers, booleans,
// and process information to standard output.
//
// Console operations return core/io errors. The example checks every result so
// a broken pipe or unavailable descriptor fails visibly instead of being
// mistaken for successful output.
package console_example

import core/console
import core/format
import core/os

Minimum_I64 :: cast[i64](0x8000000000000000)
Maximum_U64 :: cast[u64](0xffffffffffffffff)
Minimum_I128 :: cast[i128](0x80000000000000000000000000000000)
Maximum_U128 :: cast[u128](0xffffffffffffffffffffffffffffffff)

// bytes_equal_text compares one mutable byte view with an immutable string
// without conflating their ownership or mutability. Neither input is retained.
bytes_equal_text :: proc(bytes: []u8, text: string) -> bool {
    if len(bytes) != len(text) {
        return false
    }
    for byte, index in bytes {
        if byte != text[index] {
            return false
        }
    }
    return true
}

// main first verifies formatting without I/O, including zero, insufficient
// storage, and both integer-width boundaries. It then checks every console
// result while emitting a short process-facing report.
main :: proc() {
    zero_storage: [1]u8
    (zero_text, zero_ok) := format.unsigned_decimal(zero_storage[:], 0)
    assert(zero_ok)
    assert(bytes_equal_text(zero_text, "0"))

    insufficient_storage: [1]u8
    (_, insufficient_ok) :=
        format.unsigned_decimal(insufficient_storage[:], 10)
    assert(!insufficient_ok)

    unsigned_storage: [20]u8
    (unsigned_text, unsigned_ok) :=
        format.unsigned_decimal(unsigned_storage[:], Maximum_U64)
    assert(unsigned_ok)
    assert(bytes_equal_text(unsigned_text, "18446744073709551615"))

    signed_storage: [20]u8
    (signed_text, signed_ok) :=
        format.signed_decimal(signed_storage[:], Minimum_I64)
    assert(signed_ok)
    assert(bytes_equal_text(signed_text, "-9223372036854775808"))

    wide_unsigned_storage: [39]u8
    (wide_unsigned_text, wide_unsigned_ok) :=
        format.unsigned_decimal_128(wide_unsigned_storage[:], Maximum_U128)
    assert(wide_unsigned_ok)
    assert(bytes_equal_text(
        wide_unsigned_text,
        "340282366920938463463374607431768211455",
    ))

    wide_signed_storage: [40]u8
    (wide_signed_text, wide_signed_ok) :=
        format.signed_decimal_128(wide_signed_storage[:], Minimum_I128)
    assert(wide_signed_ok)
    assert(bytes_equal_text(
        wide_signed_text,
        "-170141183460469231731687303715884105728",
    ))

    short_wide_unsigned_storage: [38]u8
    (_, short_wide_unsigned_ok) := format.unsigned_decimal_128(
        short_wide_unsigned_storage[:],
        Maximum_U128,
    )
    assert(!short_wide_unsigned_ok)

    short_wide_signed_storage: [39]u8
    (_, short_wide_signed_ok) := format.signed_decimal_128(
        short_wide_signed_storage[:],
        Minimum_I128,
    )
    assert(!short_wide_signed_ok)

    positive_storage: [2]u8
    (positive_text, positive_ok) :=
        format.signed_decimal(positive_storage[:], 42)
    assert(positive_ok)
    assert(bytes_equal_text(positive_text, "42"))

    arguments := os.args()
    small_signed: i8 = -8
    small_unsigned: u16 = 16
    assert(console.println("Draft console example") == .none)
    assert(console.println("minimum i64:", Minimum_I64) == .none)
    assert(console.println("maximum u64:", Maximum_U64) == .none)
    assert(console.println("minimum i128:", Minimum_I128) == .none)
    assert(console.println("maximum u128:", Maximum_U128) == .none)
    assert(console.println(
        "mixed:",
        true,
        small_signed,
        small_unsigned,
        len(arguments) != 0,
    ) == .none)
    assert(console.println() == .none)
}
