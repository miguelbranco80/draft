package core_thread

import core/thread
import core/memory
import core/runtime

// This is language-level package TLS, distinct from the runtime's private TLS
// Context record. Each attached thread must receive its own initialized value.
thread_local local_counter: u64 = 7

Observation :: struct {
    value: u64,
    context_index: int,
    temporary_is_thread_owned: bool,
    initial_thread_local: u64,
    final_thread_local: u64,
    ready: bool,
}

Work :: struct {
    observation: ^Observation,
    mutex: ^thread.Mutex,
    condition: ^thread.Condition,
}

worker :: proc(user: rawptr) {
    work := cast[^Work](user)
    snapshot := runtime.default_context()
    initial_thread_local := local_counter
    local_counter = 42
    temporary := memory.temporary_new[u64]()
    temporary^ = 91
    assert(temporary^ == 91)

    // The mutex protects both the payload and the ready flag. Signaling while
    // holding it gives the waiting thread one simple, auditable publication
    // edge; the wait loop also handles permitted spurious wakeups.
    thread.mutex_lock(work^.mutex)
    work^.observation^.value = 42
    work^.observation^.context_index = snapshot.user_index
    work^.observation^.temporary_is_thread_owned =
        snapshot.temp_allocator.procedure != snapshot.allocator.procedure
    work^.observation^.initial_thread_local = initial_thread_local
    work^.observation^.final_thread_local = local_counter
    work^.observation^.ready = true
    thread.condition_signal(work^.condition)
    thread.mutex_unlock(work^.mutex)
}

main :: proc() {
    assert(local_counter == 7)
    local_counter = 99
    context.user_index = 73
    // A child must not inherit this deliberately non-temporary provider. The
    // hosted runtime replaces it with state owned by the new OS thread.
    context.temp_allocator = context.allocator
    observation: Observation

    mutex: thread.Mutex
    condition: thread.Condition
    assert(thread.mutex_init(&mutex))
    assert(thread.condition_init(&condition))
    work := Work{
        observation = &observation,
        mutex = &mutex,
        condition = &condition,
    }

    (child, started) := thread.spawn(worker, cast[rawptr](&work))
    assert(started)

    thread.mutex_lock(&mutex)
    for !observation.ready {
        thread.condition_wait(&condition, &mutex)
    }
    assert(observation.value == 42)
    assert(observation.context_index == 73)
    assert(observation.temporary_is_thread_owned)
    assert(observation.initial_thread_local == 7)
    assert(observation.final_thread_local == 42)
    thread.mutex_unlock(&mutex)

    assert(thread.join(&child))
    assert(local_counter == 99)
    assert(thread.current_id() != 0)
    thread.yield()

    assert(thread.condition_destroy(&condition))
    assert(thread.mutex_destroy(&mutex))
}
