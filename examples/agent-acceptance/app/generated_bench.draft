package app

import lib
import core/benchmark
import core/time

// The benchmark deliberately uses declarations supplied by three synthesis
// stages. Running it from a copied, committed resolution store proves that the
// benchmark command consumes checked generated source without reopening the
// provider boundary. The one-second limit is a wiring assertion, not a useful
// performance claim about this tiny operation.
measure_generated_program :: proc() {
    record := Generated_Record{value = lib.base() + generated_offset}
    assert(record.value == 42)
}

bench_generated_program :: proc(benchmark_state: ^benchmark.Benchmark) {
    benchmark.require_max_time(benchmark_state, time.second)
    benchmark.measure(benchmark_state, measure_generated_program)
}
