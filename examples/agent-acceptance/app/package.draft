package app

import lib

// The declaration site is resolved before bodies that may name its result.
// Its prompt is intentionally exact so the checked expansion demonstrates the
// grammar boundary rather than asking the provider to design an API.
... "Declare a package constant named generated_offset with type i64 and value 2. Output only the declaration."

// This member site is independent of generated_offset, so both requests may
// share one opaque interface ready wave. Consuming the generated field in both
// the executable and the test proves that the completed interface was rebuilt
// before dependent bodies were checked.
pub Generated_Record :: struct {
    ... "Declare one struct member named value with type i64. Output only the member declaration."
}

main :: proc() -> int {
    expected: i64 = ... "Produce the i64 expression 42. Output only the expression."
    record := Generated_Record{value = lib.base() + generated_offset}
    actual := record.value

    judge "The generated declaration, member, expression, and statement preserve actual == expected."
    ... "Emit one runtime assertion statement checking actual == expected. Output only the statement."
    return 0
}
