// turbo-ui-gallery is the independent interactive proof for lib/turbo_ui. It
// owns the terminal resources, event loop, persistent window/control values,
// and renderer; the UI library sees only one borrowed Surface and semantic
// event at a time. The program demonstrates menus, buttons, checkboxes, a
// preorder tree, proportional scrolling, splitters, dialogs, overlapping
// movable windows, mouse capture, keyboard focus, popup capture, resize
// handling, and differential presentation.
package turbo_ui_gallery

import core/io
import core/os
import core/terminal
import core/time
import core/tui
import lib/turbo_ui
import lib/turbo_ui_terminal

Input_Buffer_Size :: 128
Maximum_Columns :: 240
Maximum_Rows :: 100

Window_Controls :: 0
Window_Files :: 1
Window_Layout :: 2
Window_Dialog :: 3

Menu_File :: 180
Menu_File_Popup :: 181
Menu_Options :: 182
Menu_Options_Popup :: 183
Combo_Theme :: 240
Combo_Theme_Popup :: 241
Text_Capacity :: 64

// Gallery_State contains every persistent application value. The UI owns none
// of these records, which makes state changes inspectable in the smoke test.
Gallery_State :: struct {
    ui: turbo_ui.State,
    menus: turbo_ui.Menu_State,
    windows: [4]turbo_ui.Window_State,
    checked: bool,
    radio: usize,
    combo: turbo_ui.Combo_Box_State,
    combo_selection: usize,
    text_box: turbo_ui.Text_Box_State,
    text: [Text_Capacity]u8,
    files: turbo_ui.List_State,
    file_nodes: [9]turbo_ui.Tree_Node,
    split: usize,
    clicks: usize,
}

init_gallery :: proc(gallery: ^Gallery_State) {
    gallery.windows[Window_Controls] = turbo_ui.window_init(
        100,
        turbo_ui.Rect{column = 3, row = 3, width = 38, height = 16},
        1,
    )
    gallery.windows[Window_Files] = turbo_ui.window_init(
        101,
        turbo_ui.Rect{column = 30, row = 6, width = 32, height = 14},
        2,
    )
    gallery.windows[Window_Layout] = turbo_ui.window_init(
        102,
        turbo_ui.Rect{column = 12, row = 16, width = 52, height = 9},
        3,
    )
    gallery.windows[Window_Dialog] = turbo_ui.dialog_window_init(
        103,
        turbo_ui.Rect{column = 22, row = 8, width = 36, height = 9},
        4,
    )
    gallery.windows[Window_Dialog].visible = false
    gallery.checked = true
    gallery.split = 21
    gallery.file_nodes = [9]turbo_ui.Tree_Node{
        turbo_ui.Tree_Node{depth = 0, has_children = true, expanded = true},
        turbo_ui.Tree_Node{depth = 1, has_children = true, expanded = true},
        turbo_ui.Tree_Node{depth = 2},
        turbo_ui.Tree_Node{depth = 2},
        turbo_ui.Tree_Node{depth = 0, has_children = true, expanded = true},
        turbo_ui.Tree_Node{depth = 1},
        turbo_ui.Tree_Node{depth = 0, has_children = true, expanded = true},
        turbo_ui.Tree_Node{depth = 1, has_children = true, expanded = true},
        turbo_ui.Tree_Node{depth = 2},
    }
    turbo_ui.text_box_set_text(&gallery.text_box, gallery.text[:], "Draft UI")
}

open_dialog :: proc(gallery: ^Gallery_State) {
    turbo_ui.show_modal_window(
        &gallery.ui,
        gallery.windows[:],
        gallery.windows[Window_Dialog].id,
    )
}

// paint_controls renders ordinary value widgets in the first window.
paint_controls :: proc(
    gallery: ^Gallery_State,
    content: turbo_ui.Rect,
) {
    layout := turbo_ui.layout_begin(content, .vertical, 1, 1)
    check_bounds := turbo_ui.layout_next(&layout, 1)
    turbo_ui.checkbox(
        &gallery.ui,
        200,
        check_bounds,
        "Enable diagnostics",
        &gallery.checked,
    )
    radio_bounds := turbo_ui.layout_next(&layout, 1)
    turbo_ui.radio_button(
        &gallery.ui,
        203,
        radio_bounds,
        "Compact layout",
        &gallery.radio,
        0,
    )
    radio_bounds = turbo_ui.layout_next(&layout, 1)
    turbo_ui.radio_button(
        &gallery.ui,
        204,
        radio_bounds,
        "Roomy layout",
        &gallery.radio,
        1,
    )
    text_bounds := turbo_ui.layout_next(&layout, 1)
    turbo_ui.text_box(
        &gallery.ui,
        205,
        text_bounds,
        &gallery.text_box,
        gallery.text[:],
    )
    themes := [3]string{"Classic blue", "High contrast", "Monochrome"}
    combo_bounds := turbo_ui.layout_next(&layout, 1)
    turbo_ui.combo_box(
        &gallery.ui,
        &gallery.combo,
        Combo_Theme,
        Combo_Theme_Popup,
        combo_bounds,
        themes[:],
        &gallery.combo_selection,
    )
    button_bounds := turbo_ui.layout_next(&layout, 1)
    if turbo_ui.button(&gallery.ui, 201, button_bounds, "Count activation") {
        gallery.clicks += 1
    }
    dialog_bounds := turbo_ui.layout_next(&layout, 1)
    if turbo_ui.button(&gallery.ui, 202, dialog_bounds, "Open dialog") {
        open_dialog(gallery)
    }
    turbo_ui.status_bar(
        &gallery.ui,
        turbo_ui.layout_rest(&layout),
        "Tab focuses controls; popups capture input",
    )
}

// paint_files demonstrates the tree specialization of the compound list:
// caller-owned preorder nodes and expansion bits, keyboard parent/child
// navigation, custom immediate rows, and the integrated proportional scrollbar.
// The borrowed literals and visibility mapping remain valid only for this frame.
paint_files :: proc(
    gallery: ^Gallery_State,
    content: turbo_ui.Rect,
) {
    files := [9]string{
        "lib",
        "turbo_ui",
        "list.draft",
        "tree.draft",
        "examples",
        "turbo-ui-gallery",
        "docs",
        "implementation",
        "turbo-draft.md",
    }
    if content.width == 0 {
        return
    }
    visibility: [9]usize
    view := turbo_ui.tree_view(
        &gallery.ui,
        210,
        211,
        content,
        gallery.file_nodes[:],
        visibility[:],
        &gallery.files,
        .click_and_enter,
    )
    for visible_index := view.list.first;
        visible_index < view.list.end;
        visible_index += 1 {
        row := turbo_ui.tree_row_begin(
            &gallery.ui,
            view,
            visible_index,
            gallery.file_nodes[:],
        )
        if row.visible {
            turbo_ui.write_clipped(
                gallery.ui.surface,
                turbo_ui.intersect(gallery.ui.clip, row.content),
                turbo_ui.Point{
                    column = row.content.column,
                    row = row.content.row,
                },
                files[row.model_index],
                row.style,
            )
        }
    }
}

// paint_layout demonstrates a reusable splitter and clipped panel drawing.
paint_layout :: proc(
    gallery: ^Gallery_State,
    content: turbo_ui.Rect,
    theme: turbo_ui.Theme,
) {
    if content.width < 3 || content.height == 0 {
        return
    }
    maximum := content.width - 2
    turbo_ui.splitter(
        &gallery.ui,
        220,
        content,
        .horizontal,
        &gallery.split,
        8,
        maximum,
    )
    left := turbo_ui.Rect{
        column = content.column,
        row = content.row,
        width = gallery.split,
        height = content.height,
    }
    right := turbo_ui.Rect{
        column = content.column + gallery.split + 1,
        row = content.row,
        width = content.width - gallery.split - 1,
        height = content.height,
    }
    turbo_ui.fill_rect(gallery.ui.surface, content, left, ' ', theme.window)
    turbo_ui.fill_rect(gallery.ui.surface, content, right, ' ', theme.dialog)
    turbo_ui.write_clipped(
        gallery.ui.surface,
        left,
        turbo_ui.Point{column = left.column + 1, row = left.row + 1},
        "Editor pane",
        theme.text,
    )
    turbo_ui.write_clipped(
        gallery.ui.surface,
        right,
        turbo_ui.Point{column = right.column + 1, row = right.row + 1},
        "Diagnostics",
        theme.text,
    )
}

paint_dialog :: proc(
    gallery: ^Gallery_State,
    content: turbo_ui.Rect,
    theme: turbo_ui.Theme,
) {
    turbo_ui.write_clipped(
        gallery.ui.surface,
        content,
        turbo_ui.Point{column = content.column + 2, row = content.row + 1},
        "A reusable immediate-mode dialog.",
        theme.text,
    )
    close := false
    if content.height > 3 && content.width > 8 {
        buttons := turbo_ui.layout_begin(
            turbo_ui.Rect{
                column = content.column + 7,
                row = content.row + 3,
                width = content.width - 8,
                height = 1,
            },
            .horizontal,
            0,
            1,
        )
        close = turbo_ui.button(
            &gallery.ui,
            230,
            turbo_ui.layout_next(&buttons, 8),
            "OK",
            true,
            .default_action,
        )
        cancel := turbo_ui.button(
            &gallery.ui,
            231,
            turbo_ui.layout_next(&buttons, 10),
            "Cancel",
            true,
            .cancel_action,
        )
        close = close || cancel
    } else {
        close = turbo_ui.button(
            &gallery.ui,
            231,
            turbo_ui.Rect{},
            "Cancel",
            true,
            .cancel_action,
        )
    }
    if close {
        turbo_ui.hide_window(
            &gallery.ui,
            gallery.windows[:],
            gallery.windows[Window_Dialog].id,
        )
    }
}

// paint_menus submits both drop-down contents after the desktop windows. Menu
// actions mutate ordinary gallery values; no callback or retained item tree is
// involved. The Options menu deliberately includes checked, radio, disabled,
// and separator rows so the gallery covers the complete menu vocabulary.
paint_menus :: proc(gallery: ^Gallery_State) {
    file_menu := turbo_ui.begin_menu(
        &gallery.ui,
        &gallery.menus,
        Menu_File,
        Menu_File_Popup,
        turbo_ui.Rect{column = 1, row = 1, width = 25, height = 6},
    )
    if turbo_ui.menu_action(
        &gallery.ui, &gallery.menus, &file_menu,
        250, "Open dialog", "F4",
        access_key = cast[u8]('o'),
    ) {
        open_dialog(gallery)
    }
    turbo_ui.menu_separator(&gallery.ui, &file_menu)
    turbo_ui.menu_action(
        &gallery.ui, &gallery.menus, &file_menu,
        251, "Unavailable action", "", false,
        access_key = cast[u8]('u'),
    )
    if turbo_ui.menu_action(
        &gallery.ui, &gallery.menus, &file_menu,
        252, "Close active window", "Alt-F3",
        gallery.ui.active_window != turbo_ui.No_Widget,
        access_key = cast[u8]('c'),
    ) {
        turbo_ui.hide_window(
            &gallery.ui,
            gallery.windows[:],
            gallery.ui.active_window,
        )
    }
    turbo_ui.end_menu(&gallery.ui, &gallery.menus, file_menu)

    options_menu := turbo_ui.begin_menu(
        &gallery.ui,
        &gallery.menus,
        Menu_Options,
        Menu_Options_Popup,
        turbo_ui.Rect{column = 10, row = 1, width = 25, height = 6},
    )
    turbo_ui.menu_check(
        &gallery.ui, &gallery.menus, &options_menu,
        253, "Diagnostics", &gallery.checked,
        access_key = cast[u8]('d'),
    )
    turbo_ui.menu_separator(&gallery.ui, &options_menu)
    turbo_ui.menu_radio(
        &gallery.ui, &gallery.menus, &options_menu,
        254, "Compact", &gallery.radio, 0,
        access_key = cast[u8]('c'),
    )
    turbo_ui.menu_radio(
        &gallery.ui, &gallery.menus, &options_menu,
        255, "Roomy", &gallery.radio, 1,
        access_key = cast[u8]('r'),
    )
    turbo_ui.end_menu(&gallery.ui, &gallery.menus, options_menu)
}

// paint_gallery is one complete immediate traversal. Window ordering is
// computed into fixed caller storage; each case uses only the public library.
paint_gallery :: proc(
    gallery: ^Gallery_State,
    surface: ^tui.Surface,
    supplied_event: turbo_ui.Event,
) {
    event := supplied_event
    // F4 is the command shortcut printed beside File > Open dialog. Handle it
    // at application scope so focused controls cannot accidentally disable the
    // advertised command, while still giving an existing popup or modal first
    // refusal over the same physical key.
    if event.kind == .key && event.key.code == .f4 &&
        !event.key.alt && !event.key.control &&
        gallery.ui.popup_id == turbo_ui.No_Widget &&
        !gallery.windows[Window_Dialog].visible {
        open_dialog(gallery)
        event = turbo_ui.no_event()
    }
    theme := turbo_ui.turbo_theme()
    tui.clear(surface, theme.desktop)
    desktop := turbo_ui.Rect{row = 1, width = surface.columns}
    if surface.rows > 2 {
        desktop.height = surface.rows - 2
    }
    modal := turbo_ui.No_Widget
    if gallery.windows[Window_Dialog].visible {
        modal = gallery.windows[Window_Dialog].id
    }
    turbo_ui.begin_window_frame(
        &gallery.ui,
        surface,
        event,
        theme,
        gallery.windows[:],
        desktop,
        modal,
    )

    turbo_ui.menu_bar(
        &gallery.ui,
        &gallery.menus,
        turbo_ui.Rect{width = surface.columns, height = 1},
    )
    turbo_ui.menu_title(
        &gallery.ui,
        &gallery.menus,
        Menu_File,
        Menu_File_Popup,
        turbo_ui.Rect{column = 1, width = 8, height = 1},
        "File",
        cast[u8]('f'),
        turbo_ui.Rect{column = 1, row = 1, width = 25, height = 6},
    )
    turbo_ui.menu_title(
        &gallery.ui,
        &gallery.menus,
        Menu_Options,
        Menu_Options_Popup,
        turbo_ui.Rect{column = 10, width = 11, height = 1},
        "Options",
        cast[u8]('o'),
        turbo_ui.Rect{column = 10, row = 1, width = 25, height = 6},
    )
    turbo_ui.menu_bar_end(&gallery.ui, &gallery.menus)

    order: [4]usize
    count := turbo_ui.window_order(gallery.windows[:], order[:])
    for order_index: usize = 0; order_index < count; order_index += 1 {
        index := order[order_index]
        window := &gallery.windows[index]
        window_context: turbo_ui.Window_Context
        if index == Window_Dialog {
            window_context = turbo_ui.dialog_begin(
                &gallery.ui,
                window,
                "Message",
            )
        } else {
            title := "Controls"
            if index == Window_Files {
                title = "Files"
            } else if index == Window_Layout {
                title = "Layout"
            }
            window_context = turbo_ui.begin_window(
                &gallery.ui,
                window,
                title,
            )
        }
        if window_context.visible {
            switch index {
            case Window_Controls:
                paint_controls(gallery, window_context.content)
            case Window_Files:
                paint_files(gallery, window_context.content)
            case Window_Layout:
                paint_layout(gallery, window_context.content, theme)
            case Window_Dialog:
                paint_dialog(gallery, window_context.content, theme)
            case:
            }
        }
        turbo_ui.end_window(&gallery.ui, window_context)
        if window_context.close_requested {
            turbo_ui.hide_window(&gallery.ui, gallery.windows[:], window.id)
        }
    }

    paint_menus(gallery)
    themes := [3]string{"Classic blue", "High contrast", "Monochrome"}
    turbo_ui.combo_box_popup(
        &gallery.ui,
        &gallery.combo,
        Combo_Theme_Popup,
        themes[:],
        &gallery.combo_selection,
    )

    if surface.rows != 0 {
        turbo_ui.status_bar(
            &gallery.ui,
            turbo_ui.Rect{
                row = surface.rows - 1,
                width = surface.columns,
                height = 1,
            },
            "Alt-F menu  F4 dialog  Alt-F3 close  Ctrl-F5 move/size  Tab focus",
        )
    }
    turbo_ui.end_frame(&gallery.ui)
    if turbo_ui.needs_repaint(&gallery.ui) {
        paint_gallery(gallery, surface, turbo_ui.no_event())
    }
}

render_size :: proc(size: terminal.Size) -> (usize, usize, bool) {
    if size.columns == 0 || size.rows == 0 {
        return (0, 0, false)
    }
    columns := size.columns
    rows := size.rows
    if columns > Maximum_Columns {
        columns = Maximum_Columns
    }
    if rows > Maximum_Rows {
        rows = Maximum_Rows
    }
    return (columns, rows, true)
}

text_equal :: proc(left, right: string) -> bool {
    if len(left) != len(right) {
        return false
    }
    for index: usize = 0; index < len(left); index += 1 {
        if left[index] != right[index] {
            return false
        }
    }
    return true
}

has_smoke_argument :: proc() -> bool {
    for argument in os.args() {
        if text_equal(argument, "--smoke") {
            return true
        }
    }
    return false
}

run_smoke :: proc() -> int {
    gallery: Gallery_State
    init_gallery(&gallery)
    surface: tui.Surface
    tui.surface_init(&surface, 80, 28)
    defer tui.surface_destroy(&surface)
    paint_gallery(&gallery, &surface, turbo_ui.no_event())
    paint_gallery(
        &gallery,
        &surface,
        turbo_ui.key_event(turbo_ui.Key_Event{code = .f4}),
    )
    if !gallery.windows[Window_Dialog].visible {
        return 1
    }
    (cell, valid) := tui.cell_at(&surface, 0, 0)
    if !valid || cell.value == cast[rune](0) {
        return 1
    }
    if os.write_text_all(
        os.standard_output,
        "turbo ui gallery smoke ok\n",
    ) != .none {
        return 1
    }
    return 0
}

run_interactive :: proc(
    session: ^terminal.Session,
    screen: ^terminal.Screen,
    watcher: ^terminal.Resize_Watcher,
    initial_size: terminal.Size,
) -> io.Error {
    (columns, rows, available) := render_size(initial_size)
    if !available {
        return .unavailable
    }
    renderer: tui.Renderer
    tui.renderer_init(&renderer, columns, rows)
    defer tui.renderer_destroy(&renderer)
    gallery: Gallery_State
    init_gallery(&gallery)
    decoder: terminal.Decoder
    input: [Input_Buffer_Size]u8

    paint_gallery(&gallery, tui.surface(&renderer), turbo_ui.no_event())
    if tui.present(&renderer, screen) != .none {
        return .unavailable
    }
    for {
        (size, changed, size_error) := terminal.poll_resize(watcher)
        if size_error != .none {
            return size_error
        }
        if changed {
            (new_columns, new_rows, new_available) := render_size(size)
            if !new_available {
                return .unavailable
            }
            tui.renderer_resize(&renderer, new_columns, new_rows)
            paint_gallery(
                &gallery,
                tui.surface(&renderer),
                turbo_ui_terminal.resize(size),
            )
            if tui.present(&renderer, screen) != .none {
                return .unavailable
            }
        }

        (count, read_error) := terminal.read(
            session,
            input[:],
            100 * time.millisecond,
        )
        if read_error == .end_of_input {
            return .none
        }
        if read_error != .none {
            return read_error
        }
        repaint := false
        pending_motion: turbo_ui.Event
        motion_pending := false
        for index: usize = 0; index < count; index += 1 {
            event := turbo_ui_terminal.decode(&decoder, input[index])
            if event.kind == .none {
                continue
            }
            if event.kind == .mouse && event.mouse.action == .move {
                pending_motion = event
                motion_pending = true
                continue
            }
            if motion_pending {
                paint_gallery(&gallery, tui.surface(&renderer), pending_motion)
                repaint = true
                motion_pending = false
            }
            if event.kind == .key && event.key.code == .escape &&
                gallery.ui.popup_id == turbo_ui.No_Widget &&
                !gallery.windows[Window_Dialog].visible {
                return .none
            }
            paint_gallery(&gallery, tui.surface(&renderer), event)
            repaint = true
        }
        if motion_pending {
            paint_gallery(&gallery, tui.surface(&renderer), pending_motion)
            repaint = true
        }
        // Resolve an ambiguous lone Escape after one quiet input interval. CSI
        // and mouse sequences arriving in the same read are already completed
        // above; an incomplete control sequence is deliberately discarded.
        if count == 0 {
            event := turbo_ui_terminal.flush(&decoder)
            if event.kind == .key && event.key.code == .escape &&
                gallery.ui.popup_id == turbo_ui.No_Widget &&
                !gallery.windows[Window_Dialog].visible {
                return .none
            }
            if event.kind != .none {
                paint_gallery(&gallery, tui.surface(&renderer), event)
                repaint = true
            }
        }
        if repaint && tui.present(&renderer, screen) != .none {
            return .unavailable
        }
    }
    return .none
}

report_error :: proc(message: string) {
    result := os.write_text_all(os.standard_error, message)
    if result != .none {
        return
    }
}

// main acquires resources in input, resize, screen, mouse order and releases
// them in exact reverse order. After disabling mouse reports, it discards any
// reports already queued in raw input before returning cooked mode to the
// shell. Every cleanup is attempted even after failure.
main :: proc() -> int {
    if has_smoke_argument() {
        return run_smoke()
    }
    session: terminal.Session
    if terminal.begin_raw(&session, os.standard_input) != .none {
        report_error("turbo-ui-gallery: input is not a terminal; use --smoke\n")
        return 1
    }
    watcher: terminal.Resize_Watcher
    (initial_size, resize_error) := terminal.begin_resize_watch(
        &watcher,
        os.standard_output,
    )
    screen: terminal.Screen
    reporting: terminal.Mouse_Reporting
    run_error: io.Error = .unavailable
    if resize_error == .none &&
        terminal.begin_screen(&screen, os.standard_output) == .none &&
        terminal.begin_mouse_reporting(&reporting, &screen) == .none {
        run_error = run_interactive(
            &session,
            &screen,
            &watcher,
            initial_size,
        )
    }

    mouse_restored := terminal.restore_mouse_reporting(&reporting)
    input_discarded := terminal.discard_pending_input(&session) == .none
    screen_restored := terminal.restore_screen(&screen)
    watch_ended := terminal.end_resize_watch(&watcher)
    input_restored := terminal.restore(&session)
    if !mouse_restored || !input_discarded || !screen_restored ||
        !watch_ended || !input_restored {
        report_error("turbo-ui-gallery: terminal cleanup failed\n")
        return 1
    }
    if run_error != .none {
        report_error("turbo-ui-gallery: terminal I/O failed\n")
        return 1
    }
    return 0
}
