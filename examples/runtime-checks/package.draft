package runtime_checks

Code :: enum i16 {
    Zero,
    Seven = 7,
}

Outcome :: union {
    empty,
    value: i64,
    failure: u32,
}

make_outcome :: proc(value: i64) -> Outcome {
    return .value(value)
}

read_outcome :: proc(outcome: Outcome) -> i64 {
    switch outcome {
    case .value(payload):
        return payload
    case .failure(_):
        return -1
    case .empty:
        return 0
    }
    return -2
}

divide :: proc(left, right: i64) -> i64 {
    return left / right
}

shift :: proc(value: u32, count: usize) -> u32 {
    return value << count
}

scale :: proc(value: f64) -> f64 {
    return value * 0.5
}

identity[T: number] :: proc(value: T) -> T {
    return value
}

narrow :: proc(value: f64) -> i32 {
    return cast[i32](value)
}

to_rune :: proc(value: i64) -> rune {
    return cast[rune](value)
}

to_code :: proc(value: i64) -> Code {
    return cast[Code](value)
}

main :: proc() {
    assert(divide(84, 2) == 42)
    assert(shift(1, 5) == 32)
    assert(scale(3.0) == 1.5)
    assert(identity[i64](42) == 42)
    value: u32 = 17
    assert(identity(value) == 17)
    (left, _): (i64, i64) = (20, 0)
    (_, right): (i64, i64) = (0, 22)
    assert(left + right == 42)
    assert(read_outcome(make_outcome(42)) == 42)
    assert(read_outcome(.failure(7)) == -1)
    assert(read_outcome(.empty) == 0)
    zero_outcome: Outcome
    assert(read_outcome(zero_outcome) == 0)
    assert(narrow(42.75) == 42)
    assert(cast[i64](to_rune(65)) == 65)
    assert(to_code(7) == .Seven)
}
