package runtime_checks

Code :: enum i16 {
    Zero,
    Seven = 7,
}

Outcome :: variant {
    empty,
    value: i64,
    failure: u32,
}

Text_Outcome :: variant {
    empty,
    value: string,
}

Callback_Outcome :: variant {
    empty,
    value: proc(value: i64) -> i64,
}

Overlay :: union {
    byte: u8,
    word: u64,
}

Text_Overlay :: union {
    text: string,
    words: [2]u64,
}

// Relocatable values deliberately sit behind both product and union layers.
// A global initializer must retain their linker relocations at the exact Draft
// offsets; flattening a union to raw bytes is not sufficient for these fields.
Relocation_Box :: struct {
    marker: u8,
    text: Text_Outcome,
    callback: Callback_Outcome,
    overlay: Text_Overlay,
}

Relocation_Envelope :: variant {
    empty,
    value: Relocation_Box,
}

Distance :: distinct i64
Truth :: distinct bool
Handle :: distinct ^i64
Multi_Handle :: distinct [^]i64
Callback_Handle :: distinct proc(value: i64) -> i64
Pair_Handle :: distinct Pair[i64, i64]
Tuple_Handle :: distinct (i64, i64)
Array_Handle :: distinct [3]i64
Slice_Handle :: distinct []i64
Text_Handle :: distinct string
Outcome_Handle :: distinct Outcome
Code_Handle :: distinct Code

Pair[T: type, U: type] :: struct {
    first: T,
    second: U,
}

Maybe[T: type] :: variant {
    none,
    some: T,
}

Value_Buffer[N: usize] :: struct {
    values: [N + 1]i64,
}

Value_Envelope[N: usize] :: struct {
    buffer: Value_Buffer[N + 1],
}

Narrow_Value_Buffer[N: u8] :: struct {
    values: [cast[usize](N) + 1]i64,
}

computed_layout_count :: proc(value: usize) -> usize {
    return value + 1
}

computed_layout_choice :: proc(wide: bool) -> usize {
    if wide {
        return 4
    }
    return 8
}

computed_enum_value :: proc() -> i16 {
    return 7
}

Computed_Layout_Buffer :: struct {
    values: [computed_layout_count(2)]i64,
}

Computed_Aligned :: align(computed_layout_choice(false)) struct {
    value: u8,
}

// Selective packing changes this one storage occurrence without changing the
// u32 value type. The following u16 resumes ordinary natural placement.
Packed_Header :: struct {
    tag: u8,
    packed value: u32,
    checksum: u16,
}

// Consecutive bit fields share bytes in source order. The signed field crosses
// a byte boundary; the following ordinary u16 closes the bit stream and resumes
// natural alignment at byte offset two.
Bit_Header :: struct {
    bits(3) kind: u8,
    bits(6) delta: i16,
    bits(1) active: bool,
    ordinary: u16,
}

Bit_Header_Constant :: Bit_Header{
    kind = 5,
    // More than one 6-bit modulus below zero: constant encoding must retain
    // exactly the same low bits as a runtime store.
    delta = -67,
    active = true,
    ordinary = 42,
}

Computed_Code :: enum i16 {
    Zero,
    Seven = computed_enum_value(),
}

last_enveloped[N: usize] :: proc(value: ^Value_Envelope[N]) -> i64 {
    return value.buffer.values[N + 1]
}

last_narrow[N: u8] :: proc(value: ^Narrow_Value_Buffer[N]) -> i64 {
    return value.values[cast[usize](N)]
}

increment_value :: proc(value: i64) -> i64 {
    return value + 1
}

Increment_Callback :: increment_value
Compile_Time_Relocation_Box :: Relocation_Box{
    marker = 8,
    text = .value("constant"),
    callback = .value(Increment_Callback),
    overlay = Text_Overlay{text = "local"},
}
Switch_Base :: 40
Untyped_One :: 1
Untyped_Tuple :: (1, 2.5)
Compile_Time_Text :: "draft"[1:4]
global_callback: proc(value: i64) -> i64 = Increment_Callback
global_table: [4]u32 = [4]u32{1, 4, 9, 16}
global_partial_table: [3]i64 = [3]i64{42}
global_tuple: (i32, u64) = (7, 9)
global_partial_pair: Pair[i64, i64] = Pair[i64, i64]{second = 42}
global_outcome: Outcome = .value(42)
global_text_outcome: Text_Outcome = .value("draft")
global_overlay: Overlay = Overlay{word = 0x1020304050607080}
global_relocation_box: Relocation_Box = Relocation_Box{
    marker = 7,
    text = .value("nested"),
    callback = .value(Increment_Callback),
    overlay = Text_Overlay{text = "overlay"},
}
global_text_outcomes: [2]Text_Outcome = [2]Text_Outcome{
    .value("first"),
    .value("second"),
}
global_relocation_tuple: (Text_Outcome, Callback_Outcome) = (
    .value("tuple"),
    .value(Increment_Callback),
)
global_relocation_envelope: Relocation_Envelope = .value(Relocation_Box{
    marker = 9,
    text = .value("envelope"),
    callback = .value(Increment_Callback),
    overlay = Text_Overlay{text = "inside"},
})
thread_local tls_relocation_box: Relocation_Box = Relocation_Box{
    marker = 10,
    text = .value("thread"),
    callback = .value(Increment_Callback),
    overlay = Text_Overlay{text = "local"},
}

pair_total :: proc(pair: Pair[i64, i64]) -> i64 {
    return pair.first + pair.second
}

unwrap_maybe :: proc(value: Maybe[i64]) -> i64 {
    switch value {
    case .some(payload):
        return payload
    case .none:
        return 0
    }
}

make_outcome :: proc(value: i64) -> Outcome {
    return .value(value)
}

read_outcome :: proc(outcome: Outcome) -> i64 {
    switch outcome {
    case .value(payload):
        return payload
    case .failure(_):
        return -1
    case .empty:
        return 0
    }
}

divide :: proc(left, right: i64) -> i64 {
    return left / right
}

remainder :: proc(left, right: i64) -> i64 {
    return left % right
}

shift :: proc(value: u32, count: usize) -> u32 {
    return value << count
}

compound_shift :: proc(value: u32, count: usize) -> u32 {
    result := value
    result <<= count
    return result
}

wide_shift_left :: proc(value: u128, count: i8) -> u128 {
    return value << count
}

wide_shift_right :: proc(value: u128, count: i8) -> u128 {
    return value >> count
}

integer_operator_matrix[T: integer] :: proc(
    left, right: T,
    count: u8,
) -> bool {
    // Six and three keep every mathematical result representable in the
    // narrowest signed type while still distinguishing every binary integer
    // operation. Applying unary negation twice also checks unsigned modular
    // negation without requiring an unrepresentable negative literal.
    return left + right == 9 &&
        left - right == 3 &&
        left * right == 18 &&
        left / right == 2 &&
        left % right == 0 &&
        (left & right) == 2 &&
        (left | right) == 7 &&
        left ~ right == 5 &&
        left << count == 12 &&
        left >> count == 3 &&
        +left == left &&
        -(-left) == left &&
        ~(~left) == left &&
        left != right &&
        left > right &&
        left >= right &&
        right < left &&
        right <= left
}

float_operator_matrix[T: float] :: proc(left, right: T) -> bool {
    // These values and results are exactly representable even in f16, so this
    // checks the operations themselves rather than a format-specific rounding
    // threshold. IEEE exceptional behavior has separate constant/runtime tests.
    return left + right == 9.0 &&
        left - right == 3.0 &&
        left * right == 18.0 &&
        left / right == 2.0 &&
        +left == left &&
        -(-left) == left &&
        left != right &&
        left > right &&
        left >= right &&
        right < left &&
        right <= left
}

integer_compound_matrix[T: integer] :: proc(
    start, operand: T,
    count: u8,
) -> bool {
    // Run every compound form in one reversible sequence. The intermediate
    // values stay representable in i8, so the same source can instantiate at
    // every integer identity without accidentally testing overflow instead.
    value := start
    value += operand
    value -= operand
    value *= operand
    value /= operand
    value %= 5
    value |= 6
    value &= 3
    value ~= 1
    value <<= count
    value >>= count
    return value == 2
}

float_compound_matrix[T: float] :: proc(start, operand: T) -> bool {
    // Six and three are exactly representable at every supported float width.
    value := start
    value += operand
    value -= operand
    value *= operand
    value /= operand
    return value == start
}

complete_numeric_operator_matrix :: proc() -> bool {
    // This deliberately duplicates the concrete runtime instantiations in
    // main. static_assert sends the same closed vocabulary through the typed
    // compile-time interpreter, while main sends it through HIR, MIR, LLVM,
    // and the launched AArch64 process.
    return integer_operator_matrix[i8](6, 3, 1) &&
        integer_operator_matrix[i16](6, 3, 1) &&
        integer_operator_matrix[i32](6, 3, 1) &&
        integer_operator_matrix[i64](6, 3, 1) &&
        integer_operator_matrix[i128](6, 3, 1) &&
        integer_operator_matrix[u8](6, 3, 1) &&
        integer_operator_matrix[u16](6, 3, 1) &&
        integer_operator_matrix[u32](6, 3, 1) &&
        integer_operator_matrix[u64](6, 3, 1) &&
        integer_operator_matrix[u128](6, 3, 1) &&
        integer_operator_matrix[int](6, 3, 1) &&
        integer_operator_matrix[uint](6, 3, 1) &&
        integer_operator_matrix[isize](6, 3, 1) &&
        integer_operator_matrix[usize](6, 3, 1) &&
        integer_operator_matrix[uintptr](6, 3, 1) &&
        float_operator_matrix[f16](6.0, 3.0) &&
        float_operator_matrix[f32](6.0, 3.0) &&
        float_operator_matrix[f64](6.0, 3.0) &&
        integer_compound_matrix[i8](6, 3, 1) &&
        integer_compound_matrix[i16](6, 3, 1) &&
        integer_compound_matrix[i32](6, 3, 1) &&
        integer_compound_matrix[i64](6, 3, 1) &&
        integer_compound_matrix[i128](6, 3, 1) &&
        integer_compound_matrix[u8](6, 3, 1) &&
        integer_compound_matrix[u16](6, 3, 1) &&
        integer_compound_matrix[u32](6, 3, 1) &&
        integer_compound_matrix[u64](6, 3, 1) &&
        integer_compound_matrix[u128](6, 3, 1) &&
        integer_compound_matrix[int](6, 3, 1) &&
        integer_compound_matrix[uint](6, 3, 1) &&
        integer_compound_matrix[isize](6, 3, 1) &&
        integer_compound_matrix[usize](6, 3, 1) &&
        integer_compound_matrix[uintptr](6, 3, 1) &&
        float_compound_matrix[f16](6.0, 3.0) &&
        float_compound_matrix[f32](6.0, 3.0) &&
        float_compound_matrix[f64](6.0, 3.0)
}

scale :: proc(value: f64) -> f64 {
    return value * 0.5
}

mixed_untyped_numeric :: proc(condition: bool) -> f64 {
    arithmetic := 1 + 1.5
    selected := 1 if condition else 2.5
    return arithmetic + selected
}

exact_untyped_comparisons :: proc() -> bool {
    // f64 would round the first pair to equal values, while int cannot hold
    // the second pair. Both comparisons use Draft's exact untyped domains.
    return 9007199254740993 != 9007199254740992.0 &&
        340282366920938463463374607431768211456 > 0
}

contextual_float_constants :: proc() -> f64 {
    direct: f64 = 1
    return direct + Untyped_One + Untyped_Tuple.0 + Untyped_Tuple.1
}

contextual_tuple_constant :: proc() -> (f64, f64) {
    return Untyped_Tuple
}

inferred_tuple_conditional :: proc(condition: bool) -> f64 {
    pair := Untyped_Tuple if condition else (3, 4.5)
    return cast[f64](pair.0) + pair.1
}

inferred_pointer_conditional :: proc(
    condition: bool,
    fallback: ^i64,
) -> ^i64 {
    selected := (nil if condition else nil) if condition else fallback
    return selected
}

grouped_nil_comparison :: proc(value: ^i64) -> bool {
    return (nil) != value && value != (nil)
}

inferred_code_conditional :: proc(
    condition: bool,
    fallback: Code,
) -> Code {
    selected := (.Seven) if condition else fallback
    return selected
}

inferred_outcome_conditional :: proc(
    condition: bool,
    fallback: Outcome,
) -> Outcome {
    selected := .value(42) if condition else fallback
    return selected
}

identity[T: number] :: proc(value: T) -> T {
    return value
}

narrow :: proc(value: f64) -> i32 {
    return cast[i32](value)
}

to_rune :: proc(value: i64) -> rune {
    return cast[rune](value)
}

to_code :: proc(value: i64) -> Code {
    return cast[Code](cast[i16](value))
}

read_text_outcome :: proc(value: Text_Outcome) -> usize {
    switch value {
    case .value(payload):
        return len(payload)
    case .empty:
        return 0
    }
}

call_callback_outcome :: proc(value: Callback_Outcome, argument: i64) -> i64 {
    switch value {
    case .value(callback):
        return callback(argument)
    case .empty:
        return argument
    }
}

read_relocation_envelope :: proc(value: Relocation_Envelope) -> i64 {
    switch value {
    case .value(box):
        return cast[i64](box.marker) +
            cast[i64](read_text_outcome(box.text)) +
            call_callback_outcome(box.callback, 0) +
            cast[i64](len(box.overlay.text))
    case .empty:
        return 0
    }
}

last[N: usize] :: proc(values: [N]i64) -> i64 {
    static_assert(N > 0)
    return values[N - 1]
}

inferred_offset[N: usize] :: proc(values: [N + 1]i64) -> usize {
    return N
}

inferred_buffer_offset[N: usize] :: proc(value: ^Value_Buffer[N + 1]) -> usize {
    return N
}

inferred_reverse_offset[N: usize] :: proc(values: [10 - N]i64) -> usize {
    return N
}

storage_roundtrip :: proc(flag: bool, bits: b32) -> bool {
    encoded := cast[b32](flag)
    return cast[bool](encoded) || cast[bool](bits)
}

distinct_logical :: proc(left, right: Truth) -> Truth {
    return !left || (left && right)
}

nil_handle :: proc(value: Handle) -> bool {
    return value == nil
}

switch_handle :: proc(value: Handle) -> i64 {
    switch value {
    case nil:
        return 0
    case:
        return 1
    }
}

nil_callback_handle :: proc(value: Callback_Handle) -> bool {
    return value == nil
}

aggregate_handle_total :: proc(
    pair: Pair_Handle,
    tuple: Tuple_Handle,
    array: Array_Handle,
    slice: Slice_Handle,
    text: Text_Handle,
) -> i64 {
    slice_tail: Slice_Handle = slice[1:]
    text_tail: Text_Handle = text[1:]
    assert(pair.first == 10)
    assert(tuple.1 == 20)
    assert(array[2] == 42)
    assert(slice_tail[0] == 20)
    assert(len(text_tail) == 4)
    total := pair.first + tuple.1 + array[2] + slice_tail[0]
    for value, index in array {
        total += value + cast[i64](index)
    }
    return total + cast[i64](len(text_tail))
}

read_outcome_handle :: proc(value: Outcome_Handle) -> i64 {
    switch value {
    case .value(payload):
        return payload
    case .failure(_):
        return -1
    case .empty:
        return 0
    }
}

make_outcome_handle :: proc(value: i64) -> Outcome_Handle {
    return .value(value)
}

read_code_handle :: proc(value: Code_Handle) -> i64 {
    switch value {
    case .Seven:
        return 7
    case .Zero:
        return 0
    }
}

make_code_handle :: proc() -> Code_Handle {
    return .Seven
}

switch_integer :: proc(value: i64) -> i64 {
    switch value {
    case Switch_Base + 2:
        return 1
    case:
        return 0
    }
}

switch_float :: proc(value: f64) -> i64 {
    switch value {
    case 1.5:
        return 1
    case 0.0:
        return 2
    case:
        return 0
    }
}

switch_pointer :: proc(value: ^i64) -> i64 {
    switch value {
    case nil:
        return 0
    case:
        return 1
    }
}

switch_callback :: proc(value: proc(value: i64) -> i64) -> i64 {
    switch value {
    case increment_value:
        return 1
    case nil:
        return 0
    case:
        return -1
    }
}

endian_roundtrip :: proc(value: u32) -> u32 {
    big := cast[u32be](value)
    little := cast[u32le](value)
    assert(big == cast[u32be](value))
    return cast[u32](big) + cast[u32](little)
}

boolean_storage_matrix :: proc() -> bool {
    true8 := cast[b8](true)
    false8 := cast[b8](false)
    true16 := cast[b16](true)
    false16 := cast[b16](false)
    true32 := cast[b32](true)
    false32 := cast[b32](false)
    true64 := cast[b64](true)
    false64 := cast[b64](false)
    return cast[bool](true8) && !cast[bool](false8) && true8 != false8 &&
        cast[bool](true16) && !cast[bool](false16) && true16 != false16 &&
        cast[bool](true32) && !cast[bool](false32) && true32 != false32 &&
        cast[bool](true64) && !cast[bool](false64) && true64 != false64
}

endian_integer_matrix :: proc() -> bool {
    signed16: i16 = -123
    signed32: i32 = -1234567
    signed64: i64 = -123456789
    signed128: i128 = -123456789
    unsigned16: u16 = 0x1234
    unsigned32: u32 = 0x12345678
    unsigned64: u64 = 0x123456789abcdef0
    unsigned128: u128 = 0x123456789abcdef0

    return cast[i16](cast[i16le](signed16)) == signed16 &&
        cast[i16](cast[i16be](signed16)) == signed16 &&
        cast[i16le](signed16) == cast[i16le](signed16) &&
        cast[i16be](signed16) == cast[i16be](signed16) &&
        cast[i32](cast[i32le](signed32)) == signed32 &&
        cast[i32](cast[i32be](signed32)) == signed32 &&
        cast[i64](cast[i64le](signed64)) == signed64 &&
        cast[i64](cast[i64be](signed64)) == signed64 &&
        cast[i128](cast[i128le](signed128)) == signed128 &&
        cast[i128](cast[i128be](signed128)) == signed128 &&
        cast[u16](cast[u16le](unsigned16)) == unsigned16 &&
        cast[u16](cast[u16be](unsigned16)) == unsigned16 &&
        cast[u32](cast[u32le](unsigned32)) == unsigned32 &&
        cast[u32](cast[u32be](unsigned32)) == unsigned32 &&
        cast[u64](cast[u64le](unsigned64)) == unsigned64 &&
        cast[u64](cast[u64be](unsigned64)) == unsigned64 &&
        cast[u128](cast[u128le](unsigned128)) == unsigned128 &&
        cast[u128](cast[u128be](unsigned128)) == unsigned128
}

endian_float_matrix :: proc() -> bool {
    half: f16 = 1.5
    single: f32 = -123.5
    double: f64 = 123456.25
    return cast[f16](cast[f16le](half)) == half &&
        cast[f16](cast[f16be](half)) == half &&
        cast[f16le](half) == cast[f16le](half) &&
        cast[f16be](half) == cast[f16be](half) &&
        cast[f32](cast[f32le](single)) == single &&
        cast[f32](cast[f32be](single)) == single &&
        cast[f64](cast[f64le](double)) == double &&
        cast[f64](cast[f64be](double)) == double
}

pointer_distance :: proc(value: [^]i64, count: isize) -> isize {
    return ptr_sub(ptr_offset(value, count), value)
}

pointer_equality_matrix :: proc(value: ^u8) -> bool {
    // Draft defines address equality independently for each data-pointer
    // family. No cross-family implicit comparison is involved here: each cast
    // is compared only with another value of its own exact type.
    many := cast[[^]u8](value)
    raw_bits := cast[rawptr](value)
    terminated := cast[cstring](value)
    return value != nil && value == value &&
        many != nil && many == many &&
        raw_bits != nil && raw_bits == raw_bits &&
        terminated != nil && terminated == terminated
}

procedure_equality_matrix :: proc(
    callback: proc(value: i64) -> i64,
) -> bool {
    return callback != nil && callback == increment_value
}

observe_boolean :: proc(count: ^usize, value: bool) -> bool {
    count^ += 1
    return value
}

observe_assignment :: proc(count: ^usize, value: i64) -> i64 {
    count^ += 1
    return value
}

exercise_assignment_patterns :: proc() {
    calls: usize
    left: i64
    right: i64

    // Discarding a result never suppresses its evaluation.
    left, _ = observe_assignment(&calls, 20),
        observe_assignment(&calls, 99)
    assert(left == 20 && calls == 2)

    // A parenthesized pattern consumes one tuple and writes only selected
    // members. The first member is still evaluated before it is discarded.
    (_, right) = (
        observe_assignment(&calls, 100),
        observe_assignment(&calls, 22),
    )
    assert(right == 22 && calls == 4)

    // Stores begin only after the complete tuple value exists, so this is an
    // ordinary swap rather than two sequential assignments.
    (left, right) = (right, left)
    assert(left == 22 && right == 20)
    _ = observe_assignment(&calls, 123)
    assert(calls == 5)

    // A constant tuple is destructured after each exact member receives the
    // declared or target binding type; the aggregate itself has no storage.
    (constant_left, constant_right): (f64, f64) = Untyped_Tuple
    assigned_left, assigned_right: f64
    (assigned_left, assigned_right) = Untyped_Tuple
    assert(constant_left + assigned_left == 2.0)
    assert(constant_right + assigned_right == 5.0)
}

exercise_expression_control :: proc() {
    calls: usize
    assert(!(false && observe_boolean(&calls, true)))
    assert(calls == 0)
    assert(true || observe_boolean(&calls, false))
    assert(calls == 0)
    assert(true && observe_boolean(&calls, true))
    assert(calls == 1)
    assert(!(false || observe_boolean(&calls, false)))
    assert(calls == 2)

    // Only the selected conditional-expression value may run.
    selected := (
        observe_boolean(&calls, true) if true else
        observe_boolean(&calls, false)
    )
    assert(selected && calls == 3)
    selected = (
        observe_boolean(&calls, true) if false else
        observe_boolean(&calls, false)
    )
    assert(!selected && calls == 4)
}

exercise_loop_forms :: proc() {
    infinite_count: usize
    for {
        infinite_count += 1
        if infinite_count == 3 {
            break
        }
    }
    assert(infinite_count == 3)

    conditional_count: usize
    for conditional_count < 3 {
        conditional_count += 1
    }
    assert(conditional_count == 3)

    clause_total: usize
    for index: usize = 0; index < 4; index += 1 {
        clause_total += index
    }
    assert(clause_total == 6)

    values := [3]i64{10, 20, 12}
    iteration_total: i64
    for value, index in values {
        iteration_total += value + cast[i64](index)
    }
    assert(iteration_total == 45)
}

record_defer :: proc(trace: [^]i64, count: ^usize, value: i64) {
    trace[count^] = value
    count^ += 1
}

exercise_return_defers :: proc(trace: [^]i64, count: ^usize) -> i64 {
    // Defer captures arguments when the statement executes. Mutating `saved`
    // afterward must not change the first recorded value; return 42 is also
    // evaluated before either deferred call runs.
    saved: i64 = 1
    defer record_defer(trace, count, saved)
    saved = 99
    defer record_defer(trace, count, 2)
    return 42
}

exercise_control_exit_defers :: proc(trace: [^]i64, count: ^usize) {
    // Each loop iteration owns one lexical activation. Both continue and break
    // must discharge that activation before selecting their next CFG target.
    for index: i64 = 0; index < 4; index += 1 {
        defer record_defer(trace, count, 10 + index)
        if index == 0 {
            continue
        }
        if index == 1 {
            break
        }
    }

    // A switch case is another defer scope even though cases never fall
    // through. break exits the switch only after its case cleanup.
    subject: i64 = 1
    switch subject {
    case 1:
        defer record_defer(trace, count, 20)
        break
    case:
        return
    }

    // Nested fallthrough unwinds the inner scope before the outer one.
    {
        defer record_defer(trace, count, 30)
        {
            defer record_defer(trace, count, 31)
        }
    }
}

main :: proc() {
    // The same closed storage-scalar vocabulary must agree in the compile-time
    // evaluator and the native pipeline. Runtime assertions below execute each
    // function again after LLVM lowering.
    static_assert(boolean_storage_matrix())
    static_assert(endian_integer_matrix())
    static_assert(endian_float_matrix())
    static_assert(complete_numeric_operator_matrix())
    assert(len(Compile_Time_Text) == 3)
    assert(Compile_Time_Text[0] == cast[u8]('r'))
    assert(Compile_Time_Text[2] == cast[u8]('f'))
    assert(global_callback(41) == 42)
    assert(global_table[3] == 16)
    assert(global_partial_table[0] == 42 && global_partial_table[2] == 0)
    assert(global_tuple.0 == 7 && global_tuple.1 == 9)
    assert(global_partial_pair.first == 0 && global_partial_pair.second == 42)
    assert(read_outcome(global_outcome) == 42)
    assert(read_text_outcome(global_text_outcome) == 5)
    assert(global_overlay.word == 0x1020304050607080)
    assert(global_relocation_box.marker == 7)
    assert(read_text_outcome(global_relocation_box.text) == 6)
    assert(call_callback_outcome(global_relocation_box.callback, 41) == 42)
    assert(len(global_relocation_box.overlay.text) == 7)
    assert(read_text_outcome(global_text_outcomes[0]) == 5)
    assert(read_text_outcome(global_text_outcomes[1]) == 6)
    assert(read_text_outcome(global_relocation_tuple.0) == 5)
    assert(call_callback_outcome(global_relocation_tuple.1, 41) == 42)
    assert(read_relocation_envelope(global_relocation_envelope) == 24)
    assert(tls_relocation_box.marker == 10)
    assert(read_text_outcome(tls_relocation_box.text) == 6)
    assert(call_callback_outcome(tls_relocation_box.callback, 41) == 42)
    assert(len(tls_relocation_box.overlay.text) == 5)
    local_relocation_box := Compile_Time_Relocation_Box
    assert(local_relocation_box.marker == 8)
    assert(read_text_outcome(local_relocation_box.text) == 8)
    assert(call_callback_outcome(local_relocation_box.callback, 41) == 42)
    assert(len(local_relocation_box.overlay.text) == 5)
    assert(divide(84, 2) == 42)
    minimum: i64 = -9223372036854775807 - 1
    assert(remainder(minimum, -1) == 0)
    assert(shift(1, 5) == 32)
    assert(compound_shift(1, 5) == 32)
    assert(wide_shift_left(1, 0) == 1)
    assert(wide_shift_left(1, 127) ==
        170141183460469231731687303715884105728)
    assert(wide_shift_right(
        170141183460469231731687303715884105728,
        127,
    ) == 1)
    // Instantiate the same closed operator vocabulary at every integer
    // identity, including the pointer-sized identities that share a physical
    // width but remain distinct source types.
    assert(integer_operator_matrix[i8](6, 3, 1))
    assert(integer_operator_matrix[i16](6, 3, 1))
    assert(integer_operator_matrix[i32](6, 3, 1))
    assert(integer_operator_matrix[i64](6, 3, 1))
    assert(integer_operator_matrix[i128](6, 3, 1))
    assert(integer_operator_matrix[u8](6, 3, 1))
    assert(integer_operator_matrix[u16](6, 3, 1))
    assert(integer_operator_matrix[u32](6, 3, 1))
    assert(integer_operator_matrix[u64](6, 3, 1))
    assert(integer_operator_matrix[u128](6, 3, 1))
    assert(integer_operator_matrix[int](6, 3, 1))
    assert(integer_operator_matrix[uint](6, 3, 1))
    assert(integer_operator_matrix[isize](6, 3, 1))
    assert(integer_operator_matrix[usize](6, 3, 1))
    assert(integer_operator_matrix[uintptr](6, 3, 1))
    assert(float_operator_matrix[f16](6.0, 3.0))
    assert(float_operator_matrix[f32](6.0, 3.0))
    assert(float_operator_matrix[f64](6.0, 3.0))
    assert(integer_compound_matrix[i8](6, 3, 1))
    assert(integer_compound_matrix[i16](6, 3, 1))
    assert(integer_compound_matrix[i32](6, 3, 1))
    assert(integer_compound_matrix[i64](6, 3, 1))
    assert(integer_compound_matrix[i128](6, 3, 1))
    assert(integer_compound_matrix[u8](6, 3, 1))
    assert(integer_compound_matrix[u16](6, 3, 1))
    assert(integer_compound_matrix[u32](6, 3, 1))
    assert(integer_compound_matrix[u64](6, 3, 1))
    assert(integer_compound_matrix[u128](6, 3, 1))
    assert(integer_compound_matrix[int](6, 3, 1))
    assert(integer_compound_matrix[uint](6, 3, 1))
    assert(integer_compound_matrix[isize](6, 3, 1))
    assert(integer_compound_matrix[usize](6, 3, 1))
    assert(integer_compound_matrix[uintptr](6, 3, 1))
    assert(float_compound_matrix[f16](6.0, 3.0))
    assert(float_compound_matrix[f32](6.0, 3.0))
    assert(float_compound_matrix[f64](6.0, 3.0))
    assert(scale(3.0) == 1.5)
    assert(mixed_untyped_numeric(true) == 3.5)
    assert(mixed_untyped_numeric(false) == 5.0)
    assert(exact_untyped_comparisons())
    assert(contextual_float_constants() == 5.5)
    contextual_tuple := contextual_tuple_constant()
    assert(contextual_tuple.0 == 1.0 && contextual_tuple.1 == 2.5)
    assert(inferred_tuple_conditional(true) == 3.5)
    assert(inferred_tuple_conditional(false) == 7.5)
    conditional_pointee: i64 = 42
    assert(inferred_pointer_conditional(true, &conditional_pointee) == nil)
    assert(inferred_pointer_conditional(false, &conditional_pointee) ==
        &conditional_pointee)
    assert(grouped_nil_comparison(&conditional_pointee))
    assert(inferred_code_conditional(true, .Zero) == .Seven)
    assert(inferred_code_conditional(false, .Zero) == .Zero)
    conditional_outcome: Outcome = .failure(7)
    assert(read_outcome(inferred_outcome_conditional(
        true,
        conditional_outcome,
    )) == 42)
    assert(read_outcome(inferred_outcome_conditional(
        false,
        conditional_outcome,
    )) == -1)
    assert(identity[i64](42) == 42)
    value: u32 = 17
    assert(identity(value) == 17)
    inferred_values: [3]i64
    inferred_buffer: Value_Buffer[3]
    assert(inferred_offset(inferred_values) == 2)
    assert(inferred_buffer_offset(&inferred_buffer) == 2)
    assert(inferred_reverse_offset(inferred_values) == 7)
    envelope: Value_Envelope[2]
    envelope.buffer.values[3] = 42
    assert(last_enveloped(&envelope) == 42)
    narrow_envelope: Narrow_Value_Buffer[2]
    narrow_envelope.values[2] = 42
    assert(last_narrow(&narrow_envelope) == 42)
    computed_layout: Computed_Layout_Buffer
    computed_layout.values[2] = 42
    assert(computed_layout.values[2] == 42)
    static_assert(size_of(Computed_Layout_Buffer) == 24)
    static_assert(align_of(Computed_Aligned) == 8)
    packed_header: Packed_Header
    packed_header.value = 42
    packed_header.checksum = 7
    assert(packed_header.value == 42)
    assert(packed_header.checksum == 7)
    static_assert(size_of(Packed_Header) == 8)
    static_assert(align_of(Packed_Header) == 2)
    static_assert(type_member_offset(Packed_Header, 1) == 1)
    static_assert(type_member_offset(Packed_Header, 2) == 6)
    static_assert(type_member_is_packed(Packed_Header, 1))
    bit_header := Bit_Header_Constant
    assert(bit_header.kind == 5)
    assert(bit_header.delta == -3)
    assert(bit_header.active)
    assert(bit_header.ordinary == 42)
    bit_header.kind += 1
    bit_header.delta += 1
    bit_header.active = !bit_header.active
    assert(bit_header.kind == 6)
    assert(bit_header.delta == -2)
    assert(!bit_header.active)
    assert(bit_header.ordinary == 42)
    bit_header.kind = 15
    bit_header.delta = -33
    assert(bit_header.kind == 7)
    assert(bit_header.delta == 31)
    uninitialized_bits: Bit_Header = ---
    uninitialized_bits_pointer := &uninitialized_bits
    uninitialized_bits_pointer.kind = 5
    assert(uninitialized_bits_pointer.kind == 5)
    uninitialized_bits_pointer.delta = -3
    assert(uninitialized_bits_pointer.kind == 5)
    assert(uninitialized_bits_pointer.delta == -3)
    uninitialized_bits_pointer.active = true
    assert(uninitialized_bits_pointer.active)
    assert(uninitialized_bits_pointer.delta == -3)
    static_assert(size_of(Bit_Header) == 4)
    static_assert(align_of(Bit_Header) == 2)
    static_assert(type_member_offset(Bit_Header, 1) == 0)
    static_assert(type_member_offset(Bit_Header, 3) == 2)
    static_assert(type_member_bit_offset(Bit_Header, 1) == 3)
    static_assert(type_member_bit_width(Bit_Header, 1) == 6)
    computed_code: Computed_Code = .Seven
    assert(computed_code == .Seven)
    (left, _): (i64, i64) = (20, 0)
    (_, right): (i64, i64) = (0, 22)
    assert(left + right == 42)
    assert(read_outcome(make_outcome(42)) == 42)
    assert(read_outcome(.failure(7)) == -1)
    assert(read_outcome(.empty) == 0)
    zero_outcome: Outcome
    assert(read_outcome(zero_outcome) == 0)
    pair := Pair[i64, i64]{first = 20, second = 22}
    assert(pair_total(pair) == 42)
    partial_pair := Pair[i64, i64]{second = 42}
    partial_table := [3]i64{42}
    assert(partial_pair.first == 0 && partial_pair.second == 42)
    assert(partial_table[0] == 42 && partial_table[2] == 0)
    assert(unwrap_maybe(.some(42)) == 42)
    assert(unwrap_maybe(.none) == 0)
    assert(narrow(42.75) == 42)
    assert(cast[i64](to_rune(65)) == 65)
    assert(to_code(7) == .Seven)
    assert(storage_roundtrip(false, cast[b32](true)))
    assert(boolean_storage_matrix())
    assert(endian_integer_matrix())
    assert(endian_float_matrix())
    truth := cast[Truth](true)
    falsehood := cast[Truth](false)
    assert(cast[bool](distinct_logical(falsehood, truth)))
    assert(!cast[bool](distinct_logical(truth, falsehood)))
    pointee: i64 = 42
    handle := cast[Handle](&pointee)
    assert(!nil_handle(handle))
    assert(ptr_offset(handle, 0)^ == 42)
    assert(switch_handle(handle) == 1)
    empty_handle: Handle = nil
    assert(nil_handle(empty_handle))
    assert(switch_handle(empty_handle) == 0)
    callback_handle := cast[Callback_Handle](increment_value)
    assert(!nil_callback_handle(callback_handle))
    assert(callback_handle(41) == 42)
    empty_callback_handle: Callback_Handle = nil
    assert(nil_callback_handle(empty_callback_handle))
    pointer_values := [3]i64{10, 20, 42}
    multi := cast[[^]i64](&pointer_values[0])
    multi_handle := cast[Multi_Handle](multi)
    assert(multi_handle[2] == 42)
    assert(ptr_sub(ptr_offset(multi_handle, 2), multi_handle) == 2)
    assert(multi_handle[:3][1] == 20)
    raw_pair: Pair[i64, i64] = Pair[i64, i64]{first = 10, second = 0}
    pair_handle := cast[Pair_Handle](raw_pair)
    raw_tuple: (i64, i64) = (0, 20)
    tuple_handle := cast[Tuple_Handle](raw_tuple)
    array_handle := cast[Array_Handle](pointer_values)
    slice_handle := cast[Slice_Handle](pointer_values[:])
    text_handle := cast[Text_Handle]("draft")
    assert(aggregate_handle_total(
        pair_handle,
        tuple_handle,
        array_handle,
        slice_handle,
        text_handle,
    ) == 171)
    raw_outcome: Outcome = .value(42)
    assert(read_outcome_handle(cast[Outcome_Handle](raw_outcome)) == 42)
    assert(read_outcome_handle(make_outcome_handle(42)) == 42)
    raw_code: Code = .Seven
    assert(read_code_handle(cast[Code_Handle](raw_code)) == 7)
    assert(read_code_handle(make_code_handle()) == 7)
    assert(endian_roundtrip(21) == 42)
    assert(switch_integer(42) == 1 && switch_integer(41) == 0)
    assert(switch_float(1.5) == 1 && switch_float(2.0) == 0)
    // IEEE negative zero compares equal to positive zero, including in the
    // ordered equality chain used for floating-point switch dispatch.
    assert(switch_float(-0.0) == 2)

    pointer_subject: i64 = 42
    assert(switch_pointer(&pointer_subject) == 1)
    assert(switch_pointer(nil) == 0)
    assert(switch_callback(increment_value) == 1)
    nil_callback: proc(value: i64) -> i64 = nil
    assert(switch_callback(nil_callback) == 0)

    distance := cast[Distance](cast[i64](40))
    distance += 2
    assert(cast[i64](distance) == 42)

    assert(ptr_offset(multi, 2)^ == 42)
    assert(pointer_distance(multi, 2) == 2)
    pointer_byte: u8 = 0
    assert(pointer_equality_matrix(&pointer_byte))
    assert(procedure_equality_matrix(increment_value))
    assert(last[3](pointer_values) == 42)
    assert(last(pointer_values) == 42)

    exercise_assignment_patterns()
    exercise_expression_control()
    exercise_loop_forms()

    defer_trace: [8]i64
    defer_count: usize
    assert(exercise_return_defers(
        cast[[^]i64](&defer_trace[0]),
        &defer_count,
    ) == 42)
    exercise_control_exit_defers(
        cast[[^]i64](&defer_trace[0]),
        &defer_count,
    )
    assert(defer_count == 7)
    expected := [7]i64{2, 1, 10, 11, 20, 31, 30}
    for value, index in expected {
        assert(defer_trace[index] == value)
    }
}
