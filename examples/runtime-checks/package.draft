package runtime_checks

Code :: enum i16 {
    Zero,
    Seven = 7,
}

Outcome :: union {
    empty,
    value: i64,
    failure: u32,
}

Text_Outcome :: union {
    empty,
    value: string,
}

Overlay :: raw union {
    byte: u8,
    word: u64,
}

Distance :: distinct i64

Pair[T: type, U: type] :: struct {
    first: T,
    second: U,
}

Maybe[T: type] :: union {
    none,
    some: T,
}

increment_value :: proc(value: i64) -> i64 {
    return value + 1
}

Increment_Callback :: increment_value
Switch_Base :: 40
global_callback: proc(value: i64) -> i64 = Increment_Callback
global_table: [4]u32 = [4]u32{1, 4, 9, 16}
global_partial_table: [3]i64 = [3]i64{42}
global_tuple: (i32, u64) = (7, 9)
global_partial_pair: Pair[i64, i64] = Pair[i64, i64]{second = 42}
global_outcome: Outcome = .value(42)
global_text_outcome: Text_Outcome = .value("draft")
global_overlay: Overlay = Overlay{word = 0x1020304050607080}

pair_total :: proc(pair: Pair[i64, i64]) -> i64 {
    return pair.first + pair.second
}

unwrap_maybe :: proc(value: Maybe[i64]) -> i64 {
    switch value {
    case .some(payload):
        return payload
    case .none:
        return 0
    }
}

make_outcome :: proc(value: i64) -> Outcome {
    return .value(value)
}

read_outcome :: proc(outcome: Outcome) -> i64 {
    switch outcome {
    case .value(payload):
        return payload
    case .failure(_):
        return -1
    case .empty:
        return 0
    }
}

divide :: proc(left, right: i64) -> i64 {
    return left / right
}

remainder :: proc(left, right: i64) -> i64 {
    return left % right
}

shift :: proc(value: u32, count: usize) -> u32 {
    return value << count
}

compound_shift :: proc(value: u32, count: usize) -> u32 {
    result := value
    result <<= count
    return result
}

scale :: proc(value: f64) -> f64 {
    return value * 0.5
}

mixed_untyped_numeric :: proc(condition: bool) -> f64 {
    arithmetic := 1 + 1.5
    selected := 1 if condition else 2.5
    return arithmetic + selected
}

identity[T: number] :: proc(value: T) -> T {
    return value
}

narrow :: proc(value: f64) -> i32 {
    return cast[i32](value)
}

to_rune :: proc(value: i64) -> rune {
    return cast[rune](value)
}

to_code :: proc(value: i64) -> Code {
    return cast[Code](cast[i16](value))
}

read_text_outcome :: proc(value: Text_Outcome) -> usize {
    switch value {
    case .value(payload):
        return len(payload)
    case .empty:
        return 0
    }
}

last[N: usize] :: proc(values: [N]i64) -> i64 {
    static_assert(N > 0)
    return values[N - 1]
}

storage_roundtrip :: proc(flag: bool, bits: b32) -> bool {
    encoded := cast[b32](flag)
    return cast[bool](encoded) || cast[bool](bits)
}

switch_integer :: proc(value: i64) -> i64 {
    switch value {
    case Switch_Base + 2:
        return 1
    case:
        return 0
    }
}

switch_float :: proc(value: f64) -> i64 {
    switch value {
    case 1.5:
        return 1
    case 0.0:
        return 2
    case:
        return 0
    }
}

switch_pointer :: proc(value: ^i64) -> i64 {
    switch value {
    case nil:
        return 0
    case:
        return 1
    }
}

switch_callback :: proc(value: proc(value: i64) -> i64) -> i64 {
    switch value {
    case increment_value:
        return 1
    case nil:
        return 0
    case:
        return -1
    }
}

endian_roundtrip :: proc(value: u32) -> u32 {
    big := cast[u32be](value)
    little := cast[u32le](value)
    assert(big == cast[u32be](value))
    return cast[u32](big) + cast[u32](little)
}

pointer_distance :: proc(value: [^]i64, count: isize) -> isize {
    return ptr_sub(ptr_offset(value, count), value)
}

observe_boolean :: proc(count: ^usize, value: bool) -> bool {
    count^ += 1
    return value
}

observe_assignment :: proc(count: ^usize, value: i64) -> i64 {
    count^ += 1
    return value
}

exercise_assignment_patterns :: proc() {
    calls: usize
    left: i64
    right: i64

    // Discarding a result never suppresses its evaluation.
    left, _ = observe_assignment(&calls, 20),
        observe_assignment(&calls, 99)
    assert(left == 20 && calls == 2)

    // A parenthesized pattern consumes one tuple and writes only selected
    // members. The first member is still evaluated before it is discarded.
    (_, right) = (
        observe_assignment(&calls, 100),
        observe_assignment(&calls, 22),
    )
    assert(right == 22 && calls == 4)

    // Stores begin only after the complete tuple value exists, so this is an
    // ordinary swap rather than two sequential assignments.
    (left, right) = (right, left)
    assert(left == 22 && right == 20)
    _ = observe_assignment(&calls, 123)
    assert(calls == 5)
}

exercise_expression_control :: proc() {
    calls: usize
    assert(!(false && observe_boolean(&calls, true)))
    assert(calls == 0)
    assert(true || observe_boolean(&calls, false))
    assert(calls == 0)
    assert(true && observe_boolean(&calls, true))
    assert(calls == 1)
    assert(!(false || observe_boolean(&calls, false)))
    assert(calls == 2)

    // Only the selected conditional-expression value may run.
    selected := (
        observe_boolean(&calls, true) if true else
        observe_boolean(&calls, false)
    )
    assert(selected && calls == 3)
    selected = (
        observe_boolean(&calls, true) if false else
        observe_boolean(&calls, false)
    )
    assert(!selected && calls == 4)
}

exercise_loop_forms :: proc() {
    infinite_count: usize
    for {
        infinite_count += 1
        if infinite_count == 3 {
            break
        }
    }
    assert(infinite_count == 3)

    conditional_count: usize
    for conditional_count < 3 {
        conditional_count += 1
    }
    assert(conditional_count == 3)

    clause_total: usize
    for index: usize = 0; index < 4; index += 1 {
        clause_total += index
    }
    assert(clause_total == 6)

    values := [3]i64{10, 20, 12}
    iteration_total: i64
    for value, index in values {
        iteration_total += value + cast[i64](index)
    }
    assert(iteration_total == 45)
}

record_defer :: proc(trace: [^]i64, count: ^usize, value: i64) {
    trace[count^] = value
    count^ += 1
}

exercise_return_defers :: proc(trace: [^]i64, count: ^usize) -> i64 {
    // Defer captures arguments when the statement executes. Mutating `saved`
    // afterward must not change the first recorded value; return 42 is also
    // evaluated before either deferred call runs.
    saved: i64 = 1
    defer record_defer(trace, count, saved)
    saved = 99
    defer record_defer(trace, count, 2)
    return 42
}

exercise_control_exit_defers :: proc(trace: [^]i64, count: ^usize) {
    // Each loop iteration owns one lexical activation. Both continue and break
    // must discharge that activation before selecting their next CFG target.
    for index: i64 = 0; index < 4; index += 1 {
        defer record_defer(trace, count, 10 + index)
        if index == 0 {
            continue
        }
        if index == 1 {
            break
        }
    }

    // A switch case is another defer scope even though cases never fall
    // through. break exits the switch only after its case cleanup.
    subject: i64 = 1
    switch subject {
    case 1:
        defer record_defer(trace, count, 20)
        break
    case:
        return
    }

    // Nested fallthrough unwinds the inner scope before the outer one.
    {
        defer record_defer(trace, count, 30)
        {
            defer record_defer(trace, count, 31)
        }
    }
}

main :: proc() {
    assert(global_callback(41) == 42)
    assert(global_table[3] == 16)
    assert(global_partial_table[0] == 42 && global_partial_table[2] == 0)
    assert(global_tuple.0 == 7 && global_tuple.1 == 9)
    assert(global_partial_pair.first == 0 && global_partial_pair.second == 42)
    assert(read_outcome(global_outcome) == 42)
    assert(read_text_outcome(global_text_outcome) == 5)
    assert(global_overlay.word == 0x1020304050607080)
    assert(divide(84, 2) == 42)
    minimum: i64 = -9223372036854775807 - 1
    assert(remainder(minimum, -1) == 0)
    assert(shift(1, 5) == 32)
    assert(compound_shift(1, 5) == 32)
    assert(scale(3.0) == 1.5)
    assert(mixed_untyped_numeric(true) == 3.5)
    assert(mixed_untyped_numeric(false) == 5.0)
    assert(identity[i64](42) == 42)
    value: u32 = 17
    assert(identity(value) == 17)
    (left, _): (i64, i64) = (20, 0)
    (_, right): (i64, i64) = (0, 22)
    assert(left + right == 42)
    assert(read_outcome(make_outcome(42)) == 42)
    assert(read_outcome(.failure(7)) == -1)
    assert(read_outcome(.empty) == 0)
    zero_outcome: Outcome
    assert(read_outcome(zero_outcome) == 0)
    pair := Pair[i64, i64]{first = 20, second = 22}
    assert(pair_total(pair) == 42)
    partial_pair := Pair[i64, i64]{second = 42}
    partial_table := [3]i64{42}
    assert(partial_pair.first == 0 && partial_pair.second == 42)
    assert(partial_table[0] == 42 && partial_table[2] == 0)
    assert(unwrap_maybe(.some(42)) == 42)
    assert(unwrap_maybe(.none) == 0)
    assert(narrow(42.75) == 42)
    assert(cast[i64](to_rune(65)) == 65)
    assert(to_code(7) == .Seven)
    assert(storage_roundtrip(false, cast[b32](true)))
    assert(endian_roundtrip(21) == 42)
    assert(switch_integer(42) == 1 && switch_integer(41) == 0)
    assert(switch_float(1.5) == 1 && switch_float(2.0) == 0)
    // IEEE negative zero compares equal to positive zero, including in the
    // ordered equality chain used for floating-point switch dispatch.
    assert(switch_float(-0.0) == 2)

    pointer_subject: i64 = 42
    assert(switch_pointer(&pointer_subject) == 1)
    assert(switch_pointer(nil) == 0)
    assert(switch_callback(increment_value) == 1)
    nil_callback: proc(value: i64) -> i64 = nil
    assert(switch_callback(nil_callback) == 0)

    distance := cast[Distance](cast[i64](40))
    distance += 2
    assert(cast[i64](distance) == 42)

    pointer_values := [3]i64{10, 20, 42}
    multi := cast[[^]i64](&pointer_values[0])
    assert(ptr_offset(multi, 2)^ == 42)
    assert(pointer_distance(multi, 2) == 2)
    assert(last[3](pointer_values) == 42)
    assert(last(pointer_values) == 42)

    exercise_assignment_patterns()
    exercise_expression_control()
    exercise_loop_forms()

    defer_trace: [8]i64
    defer_count: usize
    assert(exercise_return_defers(
        cast[[^]i64](&defer_trace[0]),
        &defer_count,
    ) == 42)
    exercise_control_exit_defers(
        cast[[^]i64](&defer_trace[0]),
        &defer_count,
    )
    assert(defer_count == 7)
    expected := [7]i64{2, 1, 10, 11, 20, 31, 30}
    for value, index in expected {
        assert(defer_trace[index] == value)
    }
}
