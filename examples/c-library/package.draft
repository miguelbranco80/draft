package c_library

import core/runtime

// This package has no Draft `main`: it is a native library fixture. Its public
// C surface exercises records, enums, raw unions, and callback pointers through
// the exact same Darwin ABI classifier used by call lowering.
Pair :: @repr(C) struct {
    left: i32,
    right: i32,
}

Choice :: @repr(C) enum {
    neither = -1,
    left = 1,
    right = 2,
}

Number :: @repr(C) raw union {
    integer: i64,
    decimal: f64,
}

// These records deliberately select the remaining Darwin arm64 aggregate
// classes. The C client below calls every one through a real dylib, so changes
// to packing, register classification, or sret handling cannot hide behind an
// LLVM text snapshot.
Odd_Bytes :: @repr(C) struct {
    bytes: [3]u8,
}

Aligned_Word :: @repr(C) @align(16) struct {
    word: i64,
}

Float_Pair :: @repr(C) struct {
    left: f32,
    right: f32,
}

Large_Record :: @repr(C) struct {
    words: [3]i64,
}

Private_Record :: struct {
    value: i64,
}

thread_local bridge_counter: i32 = 7

bridge_ordinary :: proc(value: i32) -> i32 {
    result := value + cast[i32](context.user_index) + bridge_counter
    bridge_counter += 1
    return result
}

export pair_identity :: c "draft_pair_identity" proc(value: Pair) -> Pair {
    return value
}

export choice_identity :: c "draft_choice_identity" proc(value: Choice) -> Choice {
    return value
}

export number_identity :: c "draft_number_identity" proc(value: Number) -> Number {
    return value
}

export odd_bytes_identity :: c "draft_odd_bytes_identity" proc(
    value: Odd_Bytes,
) -> Odd_Bytes {
    return value
}

export aligned_word_identity :: c "draft_aligned_word_identity" proc(
    value: Aligned_Word,
) -> Aligned_Word {
    return value
}

export float_pair_identity :: c "draft_float_pair_identity" proc(
    value: Float_Pair,
) -> Float_Pair {
    return value
}

export large_record_identity :: c "draft_large_record_identity" proc(
    value: Large_Record,
) -> Large_Record {
    return value
}

// Return declarators are more subtle than parameters in C: the function name
// must be nested inside every pointer/array layer. These two exports keep the
// generated header and the physical direct-pointer ABI honest.
export pointer_pointer_identity :: c "draft_pointer_pointer_identity" proc(
    value: ^^u8,
) -> ^^u8 {
    return value
}

export row_pointer_identity :: c "draft_row_pointer_identity" proc(
    value: ^[3]u8,
) -> ^[3]u8 {
    return value
}

export opaque_pointer_pointer_identity :: c "draft_opaque_pointer_pointer_identity" proc(
    value: ^^Private_Record,
) -> ^^Private_Record {
    return value
}

// A C-convention export has no hidden Context and cannot enter an ordinary
// Draft procedure directly. These explicit runtime bridges also attach a
// foreign-created pthread lazily before bridge_ordinary touches package TLS.
export bridge_from_c :: c "draft_bridge_from_c" proc(value: i32) -> i32 {
    thread_context := runtime.default_context()
    return runtime.call_with_context(&thread_context, bridge_ordinary, value)
}

export apply :: c "draft_apply" proc(
    callback: c proc(value: i32) -> i32,
    value: i32,
) -> i32 {
    return callback(value)
}
