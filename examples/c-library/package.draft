package c_library

import core/runtime

// This package has no Draft `main`: it is a native library fixture. Its public
// C surface exercises records, enums, unions, and callback pointers through
// the exact same selected AArch64 C ABI classifier used by call lowering.
Pair :: c struct {
    left: i32,
    right: i32,
}

Choice :: c enum {
    neither = -1,
    none = 0,
    left = 1,
    right = 2,
}

// C's default enum backing never narrows below `int` width. A nonnegative set
// uses the unsigned form, and a value beyond u32 widens to 64 bits on both
// current AArch64 C ABIs. These types keep that target rule visible in the real
// generated-header and C-client boundary below.
Unsigned_Choice :: c enum {
    none,
    largest = 4294967295,
}

Wide_Choice :: c enum {
    none,
    large = 4294967296,
}

Maximum_Choice :: c enum {
    none,
    maximum = 18446744073709551615,
}

Minimum_Choice :: c enum {
    minimum = -9223372036854775808,
    none = 0,
}

// Explicit fixed backings use the same C scalar ABI. The generated header has
// to construct 128-bit constants from two exact 64-bit halves because C has no
// portable `__int128` literal suffix or INT128_C macro.
Huge_Choice :: c enum u128 {
    none,
    huge = 340282366920938463463374607431768211455,
}

Number :: c union {
    integer: i64,
    decimal: f64,
}

// These records deliberately select the remaining AArch64 aggregate classes.
// The C client below calls every one through a real shared library, so changes
// to packing, register classification, or sret handling cannot hide behind an
// LLVM text snapshot.
Odd_Bytes :: c struct {
    bytes: [3]u8,
}

Aligned_Word :: c align(16) struct {
    word: i64,
}

Float_Pair :: c struct {
    left: f32,
    right: f32,
}

// A three-lane half-precision record is still an HFA. Its six-byte physical
// payload is especially useful here: treating it as an ordinary small record
// would put the argument in an integer register and disagree with Clang.
Half_Triple :: c struct {
    values: [3]f16,
}

// AAPCS64 homogeneous-aggregate classification composes through C unions and
// nested records. Union members overlap, so their lane count is the maximum of
// the members rather than their sum. Nested_Floats is therefore four
// f32 lanes: two from overlay plus two from tail.
Float_Overlay :: c union {
    scalar: f32,
    pair: [2]f32,
}

Nested_Floats :: c struct {
    overlay: Float_Overlay,
    tail: [2]f32,
}

Large_Record :: c struct {
    words: [3]i64,
}

Private_Record :: struct {
    value: i64,
}

// This type is intentionally not C-declarable by value. A Draft slice has no
// C11 field spelling, but the C ABI still permits a pointer to the record as an
// opaque address. Header generation must expose only void * and must not emit
// the record definition.
Opaque_View_Record :: c struct {
    view: []u8,
}

Opaque_View_Box :: c struct {
    value: ^Opaque_View_Record,
}

thread_local bridge_counter: i32 = 7

bridge_ordinary :: proc(value: i32) -> i32 {
    result := value + cast[i32](context.user_index) + bridge_counter
    bridge_counter += 1
    return result
}

export pair_identity as "draft_pair_identity" :: c proc(value: Pair) -> Pair {
    return value
}

export choice_identity as "draft_choice_identity" :: c proc(value: Choice) -> Choice {
    return value
}

export unsigned_choice_identity as "draft_unsigned_choice_identity" :: c proc(
    value: Unsigned_Choice,
) -> Unsigned_Choice {
    return value
}

export wide_choice_identity as "draft_wide_choice_identity" :: c proc(
    value: Wide_Choice,
) -> Wide_Choice {
    return value
}

export maximum_choice_identity as "draft_maximum_choice_identity" :: c proc(
    value: Maximum_Choice,
) -> Maximum_Choice {
    return value
}

export minimum_choice_identity as "draft_minimum_choice_identity" :: c proc(
    value: Minimum_Choice,
) -> Minimum_Choice {
    return value
}

export huge_choice_identity as "draft_huge_choice_identity" :: c proc(
    value: Huge_Choice,
) -> Huge_Choice {
    return value
}

export number_identity as "draft_number_identity" :: c proc(value: Number) -> Number {
    return value
}

export odd_bytes_identity as "draft_odd_bytes_identity" :: c proc(
    value: Odd_Bytes,
) -> Odd_Bytes {
    return value
}

export aligned_word_identity as "draft_aligned_word_identity" :: c proc(
    value: Aligned_Word,
) -> Aligned_Word {
    return value
}

export float_pair_identity as "draft_float_pair_identity" :: c proc(
    value: Float_Pair,
) -> Float_Pair {
    return value
}

export half_triple_identity as "draft_half_triple_identity" :: c proc(
    value: Half_Triple,
) -> Half_Triple {
    return value
}

export float_overlay_identity as "draft_float_overlay_identity" :: c proc(
    value: Float_Overlay,
) -> Float_Overlay {
    return value
}

export nested_floats_identity as "draft_nested_floats_identity" :: c proc(
    value: Nested_Floats,
) -> Nested_Floats {
    return value
}

export large_record_identity as "draft_large_record_identity" :: c proc(
    value: Large_Record,
) -> Large_Record {
    return value
}

// Return declarators are more subtle than parameters in C: the function name
// must be nested inside every pointer/array layer. These two exports keep the
// generated header and the physical direct-pointer ABI honest.
export pointer_pointer_identity as "draft_pointer_pointer_identity" :: c proc(
    value: ^^u8,
) -> ^^u8 {
    return value
}

export row_pointer_identity as "draft_row_pointer_identity" :: c proc(
    value: ^[3]u8,
) -> ^[3]u8 {
    return value
}

export opaque_pointer_pointer_identity as "draft_opaque_pointer_pointer_identity" :: c proc(
    value: ^^Private_Record,
) -> ^^Private_Record {
    return value
}

export opaque_view_identity as "draft_opaque_view_identity" :: c proc(
    value: ^Opaque_View_Record,
) -> ^Opaque_View_Record {
    return value
}

export opaque_view_box_identity as "draft_opaque_view_box_identity" :: c proc(
    value: Opaque_View_Box,
) -> Opaque_View_Box {
    return value
}

// A C-convention export has no hidden Context and cannot enter an ordinary
// Draft procedure directly. These explicit runtime bridges also attach a
// foreign-created pthread lazily before bridge_ordinary touches package TLS.
export bridge_from_c as "draft_bridge_from_c" :: c proc(value: i32) -> i32 {
    thread_context := runtime.default_context()
    return runtime.call_with_context(&thread_context, bridge_ordinary, value)
}

export apply as "draft_apply" :: c proc(
    callback: c proc(value: i32) -> i32,
    value: i32,
) -> i32 {
    return callback(value)
}
