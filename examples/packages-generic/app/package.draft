package app

// left discovers lib/generic before right is loaded. The compiler must still
// body-check both consumers before their shared dependency.
import lib/left as left
import lib/right as right
import lib/generic as generic

// Qualified and applied type values use the same `::` form as scalar
// constants. Semantic lookup, rather than the expression parser, distinguishes
// these aliases from imported constants and ordinary indexing expressions.
Shared_Alias :: left.Shared_Value
Box_Alias :: generic.Box[u64]
Procedural_Buffer_Alias :: generic.Procedural_Buffer[2]

// Private_Value intentionally does not appear in this package's public
// interface. Passing it to a dependency template exercises the separate
// concrete-type transfer used by workspace monomorphization.
Private_Value :: struct {
    value: u64,
}

Private_Procedural_Buffer :: generic.Typed_Procedural_Buffer[Private_Value, 2]

main :: proc() {
    original := Private_Value{value = 42}
    copy := generic.identity[Private_Value](original)
    assert(copy.value == 42)
    assert(generic.identity[u64](9) == 9)
    assert(generic.byte_size[Private_Value]() == 8)
    through := left.through_generic[Private_Value](original)
    assert(through.value == 42)
    assert(left.composed_count[4]() == 5)
    assert(left.value() == 11)
    assert(right.value() == 22)
    shared: Shared_Alias = left.Shared_Value{value = 42}
    assert(shared.value == 42)
    box: Box_Alias = generic.Box[u64]{value = 42}
    assert(box.value == 42)
    procedural: Procedural_Buffer_Alias
    assert(len(procedural.values) == 3)
    private_procedural: Private_Procedural_Buffer
    assert(len(private_procedural.values) == 10)
}
