package layout

// The implementation detail which determines the physical layout stays in
// this package. A package which composes Buffer must request the concrete type
// graph; it cannot evaluate this private procedure from imported source.
increment :: proc(value: usize) -> usize {
    return value + 1
}

pub Buffer[N: usize] :: struct {
    values: [increment(N)]u8,
}

// Structural aliases have no nominal identity of their own. The package still
// owns evaluation of increment, so consumers receive the final array graph and
// never need access to this private helper procedure.
pub Procedural_Bytes[N: usize] :: [increment(N)]u8
