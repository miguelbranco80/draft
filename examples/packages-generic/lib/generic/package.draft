package generic

import lib/layout as layout

// A public nominal template also exercises consumer-side type applications.
pub Box[T: type] :: struct {
    value: T,
}

// Layout procedures stay private to their defining package. A consumer of this
// public template receives only the concrete owner-produced type graph.
layout_count :: proc(value: usize) -> usize {
    return value + 1
}

pub Procedural_Buffer[N: usize] :: struct {
    values: [layout_count(N)]u8,
}

pub Procedural_Wrapper[N: usize] :: struct {
    value: Procedural_Buffer[layout_count(N)],
}

// Instantiating this template crosses two ownership boundaries. generic owns
// layout_count, while lib/layout owns Buffer's private increment procedure.
pub Transitive_Procedural_Wrapper[N: usize] :: struct {
    value: layout.Buffer[layout_count(N)],
}

layout_for[T: type] :: proc(extra: usize) -> usize {
    return size_of(T) + extra
}

pub Typed_Procedural_Buffer[T: type, N: usize] :: struct {
    values: [layout_for[T](N)]u8,
}

// Public generic procedure bodies are compiled here, in their defining
// package, after consumers have published every concrete type/value request.
pub identity[T: type] :: proc(value: T) -> T {
    return value
}

pub byte_size[T: type] :: proc() -> usize {
    return size_of(T)
}

pub plus_one[N: usize] :: proc() -> usize {
    return N + 1
}
