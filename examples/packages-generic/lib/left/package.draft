package left

import lib/generic as generic

pub Shared_Value :: struct {
    value: u64,
}

// This public template composes a template from another package. Its symbolic
// body is checked without emitting code; each concrete instance publishes the
// transitive request to lib/generic.
pub through_generic[T: type] :: proc(input: T) -> T {
    return generic.identity[T](input)
}

increment_count :: proc(value: usize) -> usize {
    return value + 1
}

pub composed_count[N: usize] :: proc() -> usize {
    return generic.exact_count[increment_count(N)]()
}

pub value :: proc() -> u64 {
    copy := generic.identity[Shared_Value](Shared_Value{value = 11})
    return generic.identity[u64](copy.value)
}
