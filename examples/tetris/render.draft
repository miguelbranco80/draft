// This file paints one complete Tetris state into core/tui's desired Surface.
// The game owns no ANSI construction, terminal writes, or retained frame
// history: tui.Renderer compares this desired cell grid with the last complete
// publication and emits only changed cell runs. Painting still starts from a
// blank surface on every frame, which keeps the application operation direct
// and makes disappearance of pieces or text explicit in the desired state.
//
// The renderer reads Game without mutating it. Its fixed 50-by-24 game layout
// is centered when space permits; smaller terminals receive a clipped bounded
// message instead of an out-of-bounds write. All glyphs are printable ASCII
// occupying exactly one cell, so no Unicode width policy is hidden here.
package tetris

import core/format
import core/io
import core/terminal
import core/tui

Layout_Columns :: 50
Layout_Rows :: 24

// piece_style maps nonzero board identities to ANSI 256-color foregrounds
// through tui's target-independent cell style. The chosen palette entries are
// distinguishable on light and dark backgrounds. An invalid identity gets the
// default style rather than indexing unrelated state.
piece_style :: proc(value: u8) -> tui.Style {
    switch value {
    case 1:
        return tui.Style{foreground = tui.indexed_color(51)}
    case 2:
        return tui.Style{foreground = tui.indexed_color(226)}
    case 3:
        return tui.Style{foreground = tui.indexed_color(201)}
    case 4:
        return tui.Style{foreground = tui.indexed_color(46)}
    case 5:
        return tui.Style{foreground = tui.indexed_color(196)}
    case 6:
        return tui.Style{foreground = tui.indexed_color(27)}
    case 7:
        return tui.Style{foreground = tui.indexed_color(208)}
    }
    return tui.Style{}
}

// piece_contains_world translates a visible board coordinate into one piece's
// local mask. It is a pure geometry query used for active, ghost, and preview
// rendering; collision remains authoritative in game.draft.
piece_contains_world :: proc(piece: Piece, column: i32, row: i32) -> bool {
    return piece_has_cell(
        piece.kind,
        piece.rotation,
        column - piece.column,
        row - piece.row,
    )
}

// paint_unsigned formats one value into bounded stack storage and immediately
// copies the initialized digits into cells. Twenty bytes cover every u64. The
// formatter result is still checked so this remains correct if the local
// scratch bound changes independently later.
paint_unsigned :: proc(
    surface: ^tui.Surface,
    column, row: usize,
    value: u64,
) -> bool {
    storage: [20]u8
    (digits, formatted) := format.unsigned_decimal(storage[:], value)
    if !formatted {
        return false
    }
    return tui.write_ascii_bytes(
        surface,
        column,
        row,
        digits,
        tui.Style{},
    )
}

// paint_board_cell paints exactly two terminal columns. Settled and active
// cells share their kind color and use `[]`; projected cells use dim dots; an
// empty cell needs no write because paint_game has already cleared the surface.
paint_board_cell :: proc(
    surface: ^tui.Surface,
    screen_column, screen_row: usize,
    game: ^Game,
    board_column, board_row, projected_row: i32,
) -> bool {
    active := piece_contains_world(game^.current, board_column, board_row)
    value := game^.board[board_index(board_column, board_row)]
    if active {
        value = piece_value(game^.current.kind)
    }
    if value != 0 {
        return tui.write_ascii(
            surface,
            screen_column,
            screen_row,
            "[]",
            piece_style(value),
        )
    }

    ghost := game^.current
    ghost.row = projected_row
    if !game^.game_over &&
        piece_contains_world(ghost, board_column, board_row) {
        return tui.write_ascii(
            surface,
            screen_column,
            screen_row,
            "..",
            tui.Style{dim = true},
        )
    }
    return true
}

// paint_preview_row draws one of the next piece's four mask rows. Preview
// cells use the board's two-column geometry and the same kind palette.
paint_preview_row :: proc(
    surface: ^tui.Surface,
    column, row: usize,
    kind: Piece_Kind,
    mask_row: i32,
) -> bool {
    value := piece_value(kind)
    for mask_column: i32 = 0;
        mask_column < Piece_Box_Size;
        mask_column += 1 {
        if piece_has_cell(kind, 0, mask_column, mask_row) {
            if !tui.write_ascii(
                surface,
                column + cast[usize](mask_column) * 2,
                row,
                "[]",
                piece_style(value),
            ) {
                return false
            }
        }
    }
    return true
}

// paint_sidebar owns the fixed information-panel row mapping. Empty rows are
// deliberate. The explicit switch keeps the complete 20-row layout visible
// rather than hiding it behind a widget or callback system.
paint_sidebar :: proc(
    surface: ^tui.Surface,
    column, row: usize,
    game: ^Game,
    board_row: i32,
) -> bool {
    switch board_row {
    case 0:
        return tui.write_ascii(surface, column, row, "NEXT", tui.Style{})
    case 1, 2, 3, 4:
        return paint_preview_row(
            surface,
            column,
            row,
            game^.next,
            board_row - 1,
        )
    case 6:
        if !tui.write_ascii(surface, column, row, "SCORE  ", tui.Style{}) {
            return false
        }
        return paint_unsigned(surface, column + 7, row, game^.score)
    case 7:
        if !tui.write_ascii(surface, column, row, "LINES  ", tui.Style{}) {
            return false
        }
        return paint_unsigned(surface, column + 7, row, game^.lines)
    case 8:
        if !tui.write_ascii(surface, column, row, "LEVEL  ", tui.Style{}) {
            return false
        }
        return paint_unsigned(
            surface,
            column + 7,
            row,
            cast[u64](game^.level),
        )
    case 10:
        return tui.write_ascii(
            surface,
            column,
            row,
            "A/D or arrows  move",
            tui.Style{},
        )
    case 11:
        return tui.write_ascii(
            surface,
            column,
            row,
            "W/up           rotate",
            tui.Style{},
        )
    case 12:
        return tui.write_ascii(
            surface,
            column,
            row,
            "Z              rotate back",
            tui.Style{},
        )
    case 13:
        return tui.write_ascii(
            surface,
            column,
            row,
            "S/down         soft drop",
            tui.Style{},
        )
    case 14:
        return tui.write_ascii(
            surface,
            column,
            row,
            "Space          hard drop",
            tui.Style{},
        )
    case 15:
        return tui.write_ascii(
            surface,
            column,
            row,
            "P pause   Q quit",
            tui.Style{},
        )
    case 17:
        if game^.game_over {
            return tui.write_ascii(
                surface,
                column,
                row,
                "GAME OVER",
                tui.Style{},
            )
        }
        if game^.paused {
            return tui.write_ascii(
                surface,
                column,
                row,
                "PAUSED",
                tui.Style{},
            )
        }
        return tui.write_ascii(
            surface,
            column,
            row,
            "PLAYING",
            tui.Style{},
        )
    case 18:
        if game^.game_over {
            return tui.write_ascii(
                surface,
                column,
                row,
                "Press R to restart",
                tui.Style{},
            )
        }
    }
    return true
}

// paint_clipped_ascii is used only for the undersized-terminal notice. The
// normal layout remains exact and rejects accidental overflow. This exceptional
// path deliberately paints the visible prefix so even a very narrow terminal
// receives useful information without inventing a general clipping policy for
// core/tui.
paint_clipped_ascii :: proc(
    surface: ^tui.Surface,
    column, row: usize,
    text: string,
) -> bool {
    if row >= surface^.rows || column >= surface^.columns {
        return true
    }
    count := len(text)
    available := surface^.columns - column
    if count > available {
        count = available
    }
    for index: usize = 0; index < count; index += 1 {
        if !tui.put(
            surface,
            column + index,
            row,
            text[index],
            tui.Style{},
        ) {
            return false
        }
    }
    return true
}

// paint_game replaces the complete desired Surface. A normal game is centered
// within the current terminal dimensions. A smaller surface gets a bounded
// diagnostic frame and still counts as a successful renderable state.
paint_game :: proc(renderer: ^tui.Renderer, game: ^Game) -> bool {
    surface := tui.surface(renderer)
    tui.clear(surface, tui.Style{})

    if surface^.columns < Layout_Columns || surface^.rows < Layout_Rows {
        if !paint_clipped_ascii(surface, 0, 0, "DRAFT TETRIS") {
            return false
        }
        if !paint_clipped_ascii(surface, 0, 1, "Terminal too small") {
            return false
        }
        return paint_clipped_ascii(surface, 0, 2, "Need 50 x 24 cells")
    }

    origin_column := (surface^.columns - Layout_Columns) / 2
    origin_row := (surface^.rows - Layout_Rows) / 2
    if !tui.write_ascii(
        surface,
        origin_column,
        origin_row,
        "DRAFT TETRIS",
        tui.Style{},
    ) || !tui.write_ascii(
        surface,
        origin_column,
        origin_row + 1,
        "+--------------------+",
        tui.Style{},
    ) {
        return false
    }

    projected_row := ghost_row(game)
    for board_row: i32 = 0; board_row < Board_Height; board_row += 1 {
        screen_row := origin_row + 2 + cast[usize](board_row)
        if !tui.put(
            surface,
            origin_column,
            screen_row,
            cast[u8]('|'),
            tui.Style{},
        ) {
            return false
        }
        for board_column: i32 = 0;
            board_column < Board_Width;
            board_column += 1 {
            if !paint_board_cell(
                surface,
                origin_column + 1 + cast[usize](board_column) * 2,
                screen_row,
                game,
                board_column,
                board_row,
                projected_row,
            ) {
                return false
            }
        }
        if !tui.put(
            surface,
            origin_column + 21,
            screen_row,
            cast[u8]('|'),
            tui.Style{},
        ) || !paint_sidebar(
            surface,
            origin_column + 24,
            screen_row,
            game,
            board_row,
        ) {
            return false
        }
    }

    return tui.write_ascii(
        surface,
        origin_column,
        origin_row + 22,
        "+--------------------+",
        tui.Style{},
    ) && tui.write_ascii(
        surface,
        origin_column,
        origin_row + 23,
        "Seven-bag pieces. Compact wall kicks.",
        tui.Style{},
    )
}

// render_game separates application painting from publication. A painting
// invariant failure becomes an explicit application-level unavailable error;
// terminal write failures propagate from tui.present unchanged.
render_game :: proc(
    renderer: ^tui.Renderer,
    screen: ^terminal.Screen,
    game: ^Game,
) -> io.Error {
    if !paint_game(renderer, game) {
        return .unavailable
    }
    return tui.present(renderer, screen)
}
