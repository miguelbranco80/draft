package core_memory

import core/memory
import core/runtime

Aligned_Value :: align(64) struct {
    word: u64,
}

main :: proc() {
    provided := runtime.default_context()
    assert(provided.allocator.procedure != nil)
    assert(provided.temp_allocator.procedure != nil)

    value := memory.new[Aligned_Value]()
    assert(cast[uintptr](value) % 64 == 0)
    assert(value.word == 0)
    value.word = 42
    assert(value.word == 42)
    memory.free(value)

    explicit := memory.new_with_allocator[Aligned_Value](provided.allocator)
    assert(cast[uintptr](explicit) % 64 == 0)
    assert(explicit.word == 0)
    memory.free_with_allocator(explicit, provided.allocator)

    values := cast[[^]u64](memory.allocate(4 * size_of(u64), 64))
    view := values[:4]
    assert(view[0] == 0 && view[3] == 0)
    view[3] = 99
    assert(view[3] == 99)
    resized_storage := memory.resize(
        cast[rawptr](values),
        4 * size_of(u64),
        8 * size_of(u64),
        64,
    )
    resized := cast[[^]u64](resized_storage)
    resized_view := resized[:8]
    assert(cast[uintptr](resized) % 64 == 0)
    assert(resized_view[3] == 99 && resized_view[7] == 0)
    memory.free_bytes(resized_storage, 8 * size_of(u64), 64)

    // Temporary storage is zeroed and honors the same target alignment rules,
    // but is reclaimed as one thread-owned lifetime group.
    temporary := memory.temporary_new[Aligned_Value]()
    assert(cast[uintptr](temporary) % 64 == 0)
    assert(temporary.word == 0)
    temporary.word = 73
    temp_resized := memory.resize_with_allocator(
        cast[rawptr](temporary),
        size_of(Aligned_Value),
        2 * size_of(Aligned_Value),
        align_of(Aligned_Value),
        context.temp_allocator,
    )
    assert(cast[uintptr](temp_resized) % 64 == 0)
    assert(cast[^Aligned_Value](temp_resized).word == 73)
    memory.reset_temporary()

    arena: memory.Arena
    memory.arena_init(&arena, 128)
    arena_storage := memory.arena_allocator(&arena)
    arena_value := memory.new_with_allocator[Aligned_Value](arena_storage)
    assert(cast[uintptr](arena_value) % 64 == 0)
    arena_value.word = 81
    assert(arena_value.word == 81)
    memory.arena_reset(&arena)
    reused := memory.new_with_allocator[u64](arena_storage)
    reused^ = 17
    assert(reused^ == 17)
    memory.arena_destroy(&arena)

    buffer: memory.Buffer[u64]
    memory.buffer_init(&buffer, 3)
    buffer.data[0] = 10
    buffer.data[1] = 20
    buffer.data[2] = 30
    buffer_view := memory.buffer_view(&buffer)
    assert(len(buffer_view) == 3 && buffer_view[1] == 20)
    memory.buffer_destroy(&buffer)

    owned: memory.Owned_String
    memory.owned_string_copy(&owned, "draft")
    owned_bytes := memory.owned_string_bytes(&owned)
    assert(len(owned_bytes) == 5)
    assert(owned_bytes[0] == cast[u8]('d') && owned_bytes[4] == cast[u8]('t'))
    assert(memory.owned_string_cstring(&owned) != nil)
    memory.owned_string_destroy(&owned)

    exact_source := [3]u8{97, 0, 98}
    exact: memory.Owned_String
    memory.owned_string_copy_bytes_with_allocator(
        &exact,
        exact_source[:],
        provided.allocator,
    )
    exact_bytes := memory.owned_string_bytes(&exact)
    assert(len(exact_bytes) == 3)
    assert(exact_bytes[0] == 97 && exact_bytes[1] == 0 && exact_bytes[2] == 98)
    assert(exact.data[3] == 0)
    memory.owned_string_destroy(&exact)

    (region, reserved) := memory.virtual_reserve(16384)
    assert(reserved)
    assert(memory.virtual_commit(&region))
    mapped := cast[[^]u8](region.data)
    mapped[0] = 42
    assert(mapped[0] == 42)
    assert(memory.virtual_protect(&region, .read))
    assert(mapped[0] == 42)
    assert(memory.virtual_release(&region))
}
