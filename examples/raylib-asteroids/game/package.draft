// This package owns the complete deterministic Asteroids simulation used by
// the raylib example. It contains game state, fixed-step movement, toroidal
// wrapping, firing, collisions, asteroid splitting, lives, score, and waves.
// It deliberately performs no allocation, I/O, timing, input polling, or
// drawing. The graphical shell supplies one Input value per fixed tick, which
// makes every transition reproducible in tests and keeps raylib outside the
// semantic core of the game.
//
// Positions and velocities use screen coordinates: x grows right and y grows
// down. Every object wraps across a 960-by-720 logical world. Arrays own all
// bullets and asteroids inline; an inactive slot contains no live object and
// may be replaced without cleanup. A Game therefore owns no indirect resource
// and may be reset by assigning a zero value before re-establishing its public
// invariants. Draft specification: sections 4-7.
package game

import core/random

pub World_Width :: 960
pub World_Height :: 720
pub Fixed_Steps_Per_Second :: 120
pub Fixed_Step_Seconds :: 0.008333333333333333

Bullet_Capacity :: 24
Asteroid_Capacity :: 64
Initial_Lives :: 3
Initial_Asteroids :: 4
Maximum_Wave_Asteroids :: 10
Bullet_Lifetime_Ticks :: 132
Shot_Cooldown_Ticks :: 18
Respawn_Protection_Ticks :: 240

Ship_Acceleration_Per_Tick :: 1.7
Ship_Drag_Per_Tick :: 0.995
Bullet_Speed :: 540.0
Turn_Cosine :: 0.9990482215818578
Turn_Sine :: 0.043619387365336

// Vector is the application's ordinary two-dimensional value. It is not a C
// record: the rendering boundary explicitly converts it to raylib.Vector2 so
// game representation remains independent of a foreign library's ABI.
pub Vector :: struct {
    x: f32,
    y: f32,
}

// Input is one fixed simulation tick's complete player intent. Held controls
// may be true for successive ticks. fire is also treated as held input; the
// game's explicit cooldown provides a stable firing rate independent of the
// display frame rate.
pub Input :: struct {
    turn_left: bool,
    turn_right: bool,
    thrust: bool,
    fire: bool,
}

// Asteroid_Size determines collision radius, score, and split behavior. A
// large or medium asteroid produces two children of the next size when hit;
// a small asteroid disappears.
pub Asteroid_Size :: enum u8 {
    large,
    medium,
    small,
}

// Ship is the one player craft. direction remains approximately unit length
// because rotation uses one precomputed orthonormal step. velocity is measured
// in logical pixels per second. invulnerability_ticks is zero when collision
// damage is enabled and otherwise counts down once per fixed tick.
pub Ship :: struct {
    position: Vector,
    direction: Vector,
    velocity: Vector,
    invulnerability_ticks: u32,
}

// Bullet occupies one reusable inline slot. position and velocity have the
// same units as Ship. remaining_ticks is meaningful only while active and
// bounds every shot's lifetime even though the world itself wraps.
pub Bullet :: struct {
    active: bool,
    position: Vector,
    velocity: Vector,
    remaining_ticks: u32,
}

// Asteroid occupies one reusable inline slot. radius is derived from size at
// activation and retained to make collision/render queries direct. rotation
// and spin_per_tick affect only appearance; all gameplay collision remains a
// circle and therefore independent of display polygon detail.
pub Asteroid :: struct {
    active: bool,
    size: Asteroid_Size,
    position: Vector,
    velocity: Vector,
    radius: f32,
    rotation: f32,
    spin_per_tick: f32,
}

// Game is one complete simulation owner. The arrays never relocate and no
// pointer into them survives a public operation. generator is core/random's
// deterministic stream used only for gameplay placement and velocity; it is
// not a source of cryptographic randomness. score and wave grow monotonically
// during one game. game_over implies lives == 0 and suppresses every later tick
// until the caller explicitly invokes game_init again.
pub Game :: struct {
    ship: Ship,
    bullets: [Bullet_Capacity]Bullet,
    asteroids: [Asteroid_Capacity]Asteroid,
    generator: random.Generator,
    score: u64,
    lives: u32,
    wave: u32,
    shot_cooldown_ticks: u32,
    game_over: bool,
}

// vector_add and vector_scale are the two compositions used throughout the
// simulation. Keeping them local and concrete avoids introducing a generic
// arithmetic layer for one two-field record.
vector_add :: proc(left: Vector, right: Vector) -> Vector {
    return Vector{x = left.x + right.x, y = left.y + right.y}
}

vector_scale :: proc(value: Vector, scale: f32) -> Vector {
    return Vector{x = value.x * scale, y = value.y * scale}
}

// wrap_axis maps any finite coordinate into [0, limit). Current velocities can
// cross at most one edge per tick, but the loops preserve the operation's
// contract if a focused test or future effect supplies a larger displacement.
wrap_axis :: proc(value: f32, limit: f32) -> f32 {
    result := value
    for result < 0.0 {
        result += limit
    }
    for result >= limit {
        result -= limit
    }
    return result
}

wrap_position :: proc(position: Vector) -> Vector {
    return Vector{
        x = wrap_axis(position.x, cast[f32](World_Width)),
        y = wrap_axis(position.y, cast[f32](World_Height)),
    }
}

// wrapped_axis_distance returns the shortest unsigned separation on one
// toroidal axis. Both inputs are expected to have passed through wrap_position;
// the defensive absolute branch also makes direct test construction safe.
wrapped_axis_distance :: proc(left, right, extent: f32) -> f32 {
    distance := left - right
    if distance < 0.0 {
        distance = -distance
    }
    half := extent * 0.5
    if distance > half {
        distance = extent - distance
    }
    return distance
}

// positions_overlap compares squared toroidal distance with the combined
// collision radius. Avoiding a square root is exact for this predicate and
// keeps the pure package independent of a math-library provider.
positions_overlap :: proc(
    left: Vector,
    left_radius: f32,
    right: Vector,
    right_radius: f32,
) -> bool {
    x := wrapped_axis_distance(
        left.x,
        right.x,
        cast[f32](World_Width),
    )
    y := wrapped_axis_distance(
        left.y,
        right.y,
        cast[f32](World_Height),
    )
    radius := left_radius + right_radius
    return x * x + y * y <= radius * radius
}

// direction_from_index returns one of sixteen fixed unit-circle directions.
// A compact table would be equally valid, but the switch makes every constant
// visible and avoids any question about aggregate constant initialization.
direction_from_index :: proc(index: u32) -> Vector {
    switch index & 15 {
    case 0:
        return Vector{x = 1.0, y = 0.0}
    case 1:
        return Vector{x = 0.9238795, y = 0.3826834}
    case 2:
        return Vector{x = 0.7071068, y = 0.7071068}
    case 3:
        return Vector{x = 0.3826834, y = 0.9238795}
    case 4:
        return Vector{x = 0.0, y = 1.0}
    case 5:
        return Vector{x = -0.3826834, y = 0.9238795}
    case 6:
        return Vector{x = -0.7071068, y = 0.7071068}
    case 7:
        return Vector{x = -0.9238795, y = 0.3826834}
    case 8:
        return Vector{x = -1.0, y = 0.0}
    case 9:
        return Vector{x = -0.9238795, y = -0.3826834}
    case 10:
        return Vector{x = -0.7071068, y = -0.7071068}
    case 11:
        return Vector{x = -0.3826834, y = -0.9238795}
    case 12:
        return Vector{x = 0.0, y = -1.0}
    case 13:
        return Vector{x = 0.3826834, y = -0.9238795}
    case 14:
        return Vector{x = 0.7071068, y = -0.7071068}
    case:
        return Vector{x = 0.9238795, y = -0.3826834}
    }
}

// asteroid_radius is the single gameplay authority for size geometry. Render
// code reads the retained radius instead of duplicating this policy.
asteroid_radius :: proc(size: Asteroid_Size) -> f32 {
    switch size {
    case .large:
        return 42.0
    case .medium:
        return 25.0
    case .small:
        return 13.0
    }
    return 0.0
}

asteroid_score :: proc(size: Asteroid_Size) -> u64 {
    switch size {
    case .large:
        return 20
    case .medium:
        return 50
    case .small:
        return 100
    }
    return 0
}

// activate_asteroid claims the first inactive slot in index order. Stable slot
// selection makes simultaneous split outcomes deterministic. A false result
// means the fixed capacity is exhausted; the caller preserves the already
// completed hit rather than writing out of bounds or allocating unexpectedly.
activate_asteroid :: proc(
    game: ^Game,
    size: Asteroid_Size,
    position: Vector,
    velocity: Vector,
    rotation: f32,
    spin_per_tick: f32,
) -> bool {
    for index: usize = 0; index < len(game.asteroids); index += 1 {
        if game.asteroids[index].active {
            continue
        }
        game.asteroids[index] = Asteroid{
            active = true,
            size = size,
            position = wrap_position(position),
            velocity = velocity,
            radius = asteroid_radius(size),
            rotation = rotation,
            spin_per_tick = spin_per_tick,
        }
        return true
    }
    return false
}

// random_edge_position places a new wave on one of the four boundaries. The
// initial ship is at the center, so every wave member starts well outside the
// ship's collision radius without rejection sampling.
random_edge_position :: proc(game: ^Game, edge: u32) -> Vector {
    if edge & 1 == 0 {
        x: f32
        if edge & 2 != 0 {
            x = cast[f32](World_Width) - 1.0
        }
        return Vector{
            x = x,
            y = random.unit_f32(&game.generator) * cast[f32](World_Height),
        }
    }

    y: f32
    if edge & 2 != 0 {
        y = cast[f32](World_Height) - 1.0
    }
    return Vector{
        x = random.unit_f32(&game.generator) * cast[f32](World_Width),
        y = y,
    }
}

// spawn_wave adds a bounded number of large asteroids. The upper bound leaves
// enough slots for every member of the largest wave to split twice without
// allocation: ten large objects can become twenty medium and then forty small
// objects, all within Asteroid_Capacity.
spawn_wave :: proc(game: ^Game) {
    count := Initial_Asteroids
    additional := game.wave - 1
    maximum_additional := Maximum_Wave_Asteroids - Initial_Asteroids
    if additional >= cast[u32](maximum_additional) {
        count = Maximum_Wave_Asteroids
    } else {
        count += cast[int](additional)
    }
    for index: int = 0; index < count; index += 1 {
        direction_index := cast[u32](
            random.next_u64(&game.generator) & 15,
        )
        direction := direction_from_index(direction_index)
        speed := 38.0 + random.unit_f32(&game.generator) * 42.0
        position := random_edge_position(game, cast[u32](index))
        rotation := random.unit_f32(&game.generator) * 360.0
        spin := (random.unit_f32(&game.generator) - 0.5) * 1.2
        activated := activate_asteroid(
            game,
            .large,
            position,
            vector_scale(direction, speed),
            rotation,
            spin,
        )
        if !activated {
            return
        }
    }
}

// reset_ship establishes the center spawn, upward facing direction, and a
// finite protection window. It intentionally leaves score, bullets, asteroids,
// and wave untouched so the same operation is correct after losing a life.
reset_ship :: proc(game: ^Game) {
    game.ship = Ship{
        position = Vector{
            x = cast[f32](World_Width) * 0.5,
            y = cast[f32](World_Height) * 0.5,
        },
        direction = Vector{x = 0.0, y = -1.0},
        velocity = Vector{x = 0.0, y = 0.0},
        invulnerability_ticks = Respawn_Protection_Ticks,
    }
}

// game_init replaces all prior state and establishes a playable first wave.
// It is also the restart operation. The replacement is safe because Game owns
// only inline values and no cleanup obligation.
pub game_init :: proc(game: ^Game, seed: u64) {
    empty: Game
    game^ = empty
    random.init(&game.generator, seed)
    game.lives = Initial_Lives
    game.wave = 1
    reset_ship(game)
    spawn_wave(game)
}

// rotate_ship applies one exact fixed-angle step. The constants form an
// orthonormal matrix; alternating left and right therefore returns close to
// the original direction without normalization or a math-library dependency.
rotate_ship :: proc(ship: ^Ship, turn_left: bool) {
    old := ship.direction
    if turn_left {
        ship.direction = Vector{
            x = old.x * Turn_Cosine + old.y * Turn_Sine,
            y = -old.x * Turn_Sine + old.y * Turn_Cosine,
        }
    } else {
        ship.direction = Vector{
            x = old.x * Turn_Cosine - old.y * Turn_Sine,
            y = old.x * Turn_Sine + old.y * Turn_Cosine,
        }
    }
}

// fire_bullet claims the first free slot and publishes a shot from the ship's
// nose. Failure because every slot is live is a deliberate no-op; it does not
// reset the cooldown, so the next tick may fire as soon as a slot expires.
fire_bullet :: proc(game: ^Game) -> bool {
    for index: usize = 0; index < len(game.bullets); index += 1 {
        if game.bullets[index].active {
            continue
        }
        nose := vector_add(
            game.ship.position,
            vector_scale(game.ship.direction, 16.0),
        )
        shot_velocity := vector_add(
            game.ship.velocity,
            vector_scale(game.ship.direction, Bullet_Speed),
        )
        game.bullets[index] = Bullet{
            active = true,
            position = wrap_position(nose),
            velocity = shot_velocity,
            remaining_ticks = Bullet_Lifetime_Ticks,
        }
        return true
    }
    return false
}

// update_ship consumes held input in a stable order: rotation, thrust, drag,
// movement, then firing. Opposite turn controls cancel. Drag is applied every
// tick, including thrust ticks, which bounds ordinary play speed without a
// square-root based clamp.
update_ship :: proc(game: ^Game, input: Input) {
    if input.turn_left != input.turn_right {
        rotate_ship(&game.ship, input.turn_left)
    }
    if input.thrust {
        acceleration := vector_scale(
            game.ship.direction,
            Ship_Acceleration_Per_Tick,
        )
        game.ship.velocity = vector_add(game.ship.velocity, acceleration)
    }
    game.ship.velocity = vector_scale(
        game.ship.velocity,
        Ship_Drag_Per_Tick,
    )
    displacement := vector_scale(
        game.ship.velocity,
        cast[f32](Fixed_Step_Seconds),
    )
    game.ship.position = wrap_position(
        vector_add(game.ship.position, displacement),
    )

    if game.shot_cooldown_ticks != 0 {
        game.shot_cooldown_ticks -= 1
    }
    if input.fire && game.shot_cooldown_ticks == 0 {
        if fire_bullet(game) {
            game.shot_cooldown_ticks = Shot_Cooldown_Ticks
        }
    }
    if game.ship.invulnerability_ticks != 0 {
        game.ship.invulnerability_ticks -= 1
    }
}

// update_bullets moves every live shot and retires it after its exact fixed
// lifetime. Movement occurs before the collision pass, so collision queries
// observe the same positions later rendered for this tick.
update_bullets :: proc(game: ^Game) {
    for index: usize = 0; index < len(game.bullets); index += 1 {
        bullet := &game.bullets[index]
        if !bullet.active {
            continue
        }
        displacement := vector_scale(
            bullet.velocity,
            cast[f32](Fixed_Step_Seconds),
        )
        bullet.position = wrap_position(
            vector_add(bullet.position, displacement),
        )
        if bullet.remaining_ticks <= 1 {
            bullet.active = false
        } else {
            bullet.remaining_ticks -= 1
        }
    }
}

// update_asteroids advances geometry and visual rotation. rotation is bounded
// to a small interval so a long-running game does not lose visible f32
// precision; gameplay collision does not depend on it.
update_asteroids :: proc(game: ^Game) {
    for index: usize = 0; index < len(game.asteroids); index += 1 {
        asteroid := &game.asteroids[index]
        if !asteroid.active {
            continue
        }
        displacement := vector_scale(
            asteroid.velocity,
            cast[f32](Fixed_Step_Seconds),
        )
        asteroid.position = wrap_position(
            vector_add(asteroid.position, displacement),
        )
        asteroid.rotation += asteroid.spin_per_tick
        if asteroid.rotation >= 360.0 {
            asteroid.rotation -= 360.0
        } else if asteroid.rotation < 0.0 {
            asteroid.rotation += 360.0
        }
    }
}

// split_asteroid creates two next-size children from one already removed
// parent. The parent's perpendicular velocity gives the pair visibly distinct
// paths while preserving its general motion. Capacity failure can only follow
// externally corrupted state because spawn_wave's bound reserves enough slots;
// the explicit result is still inspected and safely truncates that split.
split_asteroid :: proc(game: ^Game, parent: Asteroid) {
    child_size: Asteroid_Size
    switch parent.size {
    case .large:
        child_size = .medium
    case .medium:
        child_size = .small
    case .small:
        return
    }

    perpendicular := Vector{x = -parent.velocity.y, y = parent.velocity.x}
    first_velocity := vector_add(
        vector_scale(parent.velocity, 1.08),
        vector_scale(perpendicular, 0.42),
    )
    second_velocity := vector_add(
        vector_scale(parent.velocity, 1.08),
        vector_scale(perpendicular, -0.42),
    )
    first := activate_asteroid(
        game,
        child_size,
        parent.position,
        first_velocity,
        parent.rotation + 17.0,
        parent.spin_per_tick + 0.19,
    )
    if !first {
        return
    }
    second := activate_asteroid(
        game,
        child_size,
        parent.position,
        second_velocity,
        parent.rotation - 17.0,
        parent.spin_per_tick - 0.19,
    )
    if !second {
        return
    }
}

// destroy_asteroid snapshots the value before releasing its slot. Children
// may immediately reuse that same index, so reading through the old array
// element after activation would observe a child rather than the parent.
destroy_asteroid :: proc(game: ^Game, index: usize) {
    parent := game.asteroids[index]
    game.asteroids[index].active = false
    game.score += asteroid_score(parent.size)
    split_asteroid(game, parent)
}

// resolve_bullet_collisions visits bullets and asteroid slots in ascending
// order. One bullet destroys at most one object. Newly split children may be
// hit by a later bullet in the same tick, which is deterministic and matches
// their immediate publication into the world.
resolve_bullet_collisions :: proc(game: ^Game) {
    for bullet_index: usize = 0;
        bullet_index < len(game.bullets);
        bullet_index += 1 {
        bullet := &game.bullets[bullet_index]
        if !bullet.active {
            continue
        }
        for asteroid_index: usize = 0;
            asteroid_index < len(game.asteroids);
            asteroid_index += 1 {
            asteroid := &game.asteroids[asteroid_index]
            if !asteroid.active {
                continue
            }
            if positions_overlap(
                bullet.position,
                2.0,
                asteroid.position,
                asteroid.radius,
            ) {
                bullet.active = false
                destroy_asteroid(game, asteroid_index)
                break
            }
        }
    }
}

// resolve_ship_collision applies at most one life loss per tick. Protection
// suppresses damage but not rendering or movement. A surviving ship respawns
// in the center with cleared velocity; asteroids and bullets continue, making
// each life part of one persistent wave.
resolve_ship_collision :: proc(game: ^Game) {
    if game.ship.invulnerability_ticks != 0 {
        return
    }
    for index: usize = 0; index < len(game.asteroids); index += 1 {
        asteroid := &game.asteroids[index]
        if !asteroid.active {
            continue
        }
        if positions_overlap(
            game.ship.position,
            11.0,
            asteroid.position,
            asteroid.radius,
        ) {
            game.lives -= 1
            if game.lives == 0 {
                game.game_over = true
            } else {
                reset_ship(game)
            }
            return
        }
    }
}

// active_asteroid_count is a public read-only rendering/testing query. It
// exposes no array pointer and its result is independent of inactive contents.
pub active_asteroid_count :: proc(game: ^Game) -> usize {
    count: usize
    for asteroid in game.asteroids {
        if asteroid.active {
            count += 1
        }
    }
    return count
}

// game_tick performs one complete 1/120-second transition. The phase order is
// intentional: player movement and shots publish first; every object moves;
// bullets resolve before the ship; and a cleared wave is replenished only
// after all collisions. A terminal game is inert until explicit reinitializing.
pub game_tick :: proc(game: ^Game, input: Input) {
    if game.game_over {
        return
    }
    update_ship(game, input)
    update_bullets(game)
    update_asteroids(game)
    resolve_bullet_collisions(game)
    resolve_ship_collision(game)
    if !game.game_over && active_asteroid_count(game) == 0 {
        game.wave += 1
        spawn_wave(game)
    }
}
