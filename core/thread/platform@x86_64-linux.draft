// This target-selected half of core/thread provides glibc 2.39's x86-64
// pthread handles, opaque synchronization storage, and C entry points. Thread,
// Mutex, and Condition own native resources only after the common API reports
// successful initialization; this file supplies physical representation and
// no lifetime policy. Draft specification: sections 5-7 and 12, plus the
// versioned x86-64 GNU/Linux target profile.
package thread

import core/c_abi
import core/time

// glibc x86-64 defines pthread_t as unsigned long. Keeping the scalar identity
// matters to C declarations even though it occupies one pointer-width register.
Pthread_Handle :: uintptr
Native_Thread_Result :: rawptr
Native_Start_Routine :: c proc(user: rawptr) -> Native_Thread_Result

pub Thread :: c struct {
    handle: Pthread_Handle,
}

// glibc 2.39 x86-64 gives pthread_mutex_t 40 bytes and pthread_cond_t 48 bytes,
// both aligned to eight. Leading i64 fields establish alignment; pthread is the
// only code permitted to interpret the remaining opaque bytes.
pub Mutex :: c struct {
    alignment: i64,
    opaque: [32]u8,
}

pub Condition :: c struct {
    alignment: i64,
    opaque: [40]u8,
}

foreign linux {
    pthread_create :: c proc(
        thread: ^Pthread_Handle,
        attributes: rawptr,
        start: Native_Start_Routine,
        user: rawptr,
    ) -> c_abi.int
    pthread_join :: c proc(thread: Pthread_Handle, result: ^rawptr) -> c_abi.int
    pthread_self :: c proc() -> Pthread_Handle
    sched_yield :: c proc() -> c_abi.int
    pthread_mutex_init :: c proc(mutex: ^Mutex, attributes: rawptr) -> c_abi.int
    pthread_mutex_destroy :: c proc(mutex: ^Mutex) -> c_abi.int
    pthread_mutex_lock :: c proc(mutex: ^Mutex) -> c_abi.int
    pthread_mutex_trylock :: c proc(mutex: ^Mutex) -> c_abi.int
    pthread_mutex_unlock :: c proc(mutex: ^Mutex) -> c_abi.int
    pthread_cond_init :: c proc(condition: ^Condition, attributes: rawptr) -> c_abi.int
    pthread_cond_destroy :: c proc(condition: ^Condition) -> c_abi.int
    pthread_cond_wait :: c proc(condition: ^Condition, mutex: ^Mutex) -> c_abi.int
    pthread_cond_signal :: c proc(condition: ^Condition) -> c_abi.int
    pthread_cond_broadcast :: c proc(condition: ^Condition) -> c_abi.int
    nanosleep :: c proc(requested: ^Timespec, remaining: ^Timespec) -> c_abi.int
}

Timespec :: c struct {
    seconds: i64,
    nanoseconds: i64,
}

native_thread_create :: proc(
    handle: ^Pthread_Handle,
    attributes: rawptr,
    start: Native_Start_Routine,
    user: rawptr,
) -> c_abi.int {
    return pthread_create(handle, attributes, start, user)
}

native_thread_is_empty :: proc(thread: ^Thread) -> bool {
    return thread^.handle == cast[Pthread_Handle](0)
}

native_thread_join :: proc(thread: ^Thread) -> c_abi.int {
    return pthread_join(thread^.handle, nil)
}

native_thread_clear :: proc(thread: ^Thread) {
    thread^.handle = cast[Pthread_Handle](0)
}

native_thread_current_id :: proc() -> uintptr {
    return cast[uintptr](pthread_self())
}

native_thread_yield :: proc() {
    sched_yield()
}

native_mutex_init :: proc(mutex: ^Mutex) -> c_abi.int {
    return pthread_mutex_init(mutex, nil)
}

native_mutex_destroy :: proc(mutex: ^Mutex) -> c_abi.int {
    return pthread_mutex_destroy(mutex)
}

native_mutex_lock :: proc(mutex: ^Mutex) -> c_abi.int {
    return pthread_mutex_lock(mutex)
}

native_mutex_try_lock :: proc(mutex: ^Mutex) -> c_abi.int {
    return pthread_mutex_trylock(mutex)
}

native_mutex_unlock :: proc(mutex: ^Mutex) -> c_abi.int {
    return pthread_mutex_unlock(mutex)
}

native_condition_init :: proc(condition: ^Condition) -> c_abi.int {
    return pthread_cond_init(condition, nil)
}

native_condition_destroy :: proc(condition: ^Condition) -> c_abi.int {
    return pthread_cond_destroy(condition)
}

native_condition_wait :: proc(
    condition: ^Condition,
    mutex: ^Mutex,
) -> c_abi.int {
    return pthread_cond_wait(condition, mutex)
}

native_condition_signal :: proc(condition: ^Condition) -> c_abi.int {
    return pthread_cond_signal(condition)
}

native_condition_broadcast :: proc(condition: ^Condition) -> c_abi.int {
    return pthread_cond_broadcast(condition)
}

native_thread_sleep :: proc(duration: time.Duration) -> bool {
    total := cast[i64](duration)
    requested := Timespec{
        seconds = total / cast[i64](time.second),
        nanoseconds = total % cast[i64](time.second),
    }
    remaining: Timespec
    return nanosleep(&requested, &remaining) == 0
}
