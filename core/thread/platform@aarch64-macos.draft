package thread

import core/c as c

// Darwin pthread_t is an opaque pointer. Thread is move-by-convention
// ownership metadata: joining clears the handle, while copying a live value
// would create two aliases to one join right.
Pthread_Handle :: rawptr

pub Thread :: c struct {
    handle: Pthread_Handle,
}

// Darwin's LP64 pthread mutex contains an eight-byte signature plus 56 opaque
// bytes; its condition contains the signature plus 40 bytes.
pub Mutex :: c struct {
    signature: i64,
    opaque: [56]u8,
}

pub Condition :: c struct {
    signature: i64,
    opaque: [40]u8,
}

foreign darwin {
    pthread_create :: c proc(
        thread: ^Pthread_Handle,
        attributes: rawptr,
        start: Start_Routine,
        user: rawptr,
    ) -> c.int
    pthread_join :: c proc(thread: Pthread_Handle, result: ^rawptr) -> c.int
    pthread_self :: c proc() -> Pthread_Handle
    sched_yield :: c proc() -> c.int
    pthread_mutex_init :: c proc(mutex: ^Mutex, attributes: rawptr) -> c.int
    pthread_mutex_destroy :: c proc(mutex: ^Mutex) -> c.int
    pthread_mutex_lock :: c proc(mutex: ^Mutex) -> c.int
    pthread_mutex_trylock :: c proc(mutex: ^Mutex) -> c.int
    pthread_mutex_unlock :: c proc(mutex: ^Mutex) -> c.int
    pthread_cond_init :: c proc(condition: ^Condition, attributes: rawptr) -> c.int
    pthread_cond_destroy :: c proc(condition: ^Condition) -> c.int
    pthread_cond_wait :: c proc(condition: ^Condition, mutex: ^Mutex) -> c.int
    pthread_cond_signal :: c proc(condition: ^Condition) -> c.int
    pthread_cond_broadcast :: c proc(condition: ^Condition) -> c.int
    nanosleep :: c proc(requested: ^Timespec, remaining: ^Timespec) -> c.int
}
