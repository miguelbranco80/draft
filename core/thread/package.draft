package thread

import core/c_abi
import core/memory
import core/runtime
import core/time

pub Entry_Proc :: proc(user: rawptr)

Start_State :: struct {
    thread_context: runtime.Context,
    entry: Entry_Proc,
    user: rawptr,
}

release_start_state :: proc(state: ^Start_State) {
    memory.free_with_allocator(state, state^.thread_context.allocator)
}

// An OS thread begins with the target's C callback convention and no hidden
// Context. The two runtime bridge calls lazily establish Draft TLS, enter the
// ordinary user callback with the copied spawning Context, and finally release
// trampoline state through the same explicit Context. Native_Thread_Result and
// the returned zero is selected at compile time because POSIX returns a pointer
// from a start callback while Windows returns a 32-bit status.
thread_trampoline :: c proc(user: rawptr) -> Native_Thread_Result {
    state := cast[^Start_State](user)
    runtime.install_thread_context(&state^.thread_context)
    // Installation replaces the copied temp_allocator with the hosted
    // thread-owned provider. Use the installed snapshot for every ordinary
    // child call rather than the pre-install spawn record.
    thread_context := runtime.default_context()
    runtime.call_with_context(
        &thread_context,
        state^.entry,
        state^.user,
    )
    runtime.call_with_context(
        &thread_context,
        release_start_state,
        state,
    )
    when target.os == .windows {
        return 0
    } else {
        return nil
    }
}

pub spawn :: proc(entry: Entry_Proc, user: rawptr) -> (Thread, bool) {
    assert(entry != nil, "thread entry procedure is nil")
    state := memory.new_with_allocator[Start_State](context.allocator)
    state^.thread_context = context
    state^.entry = entry
    state^.user = user

    result: Thread
    status := native_thread_create(
        &result.handle,
        nil,
        thread_trampoline,
        cast[rawptr](state),
    )
    if status != 0 {
        memory.free_with_allocator(state, context.allocator)
        empty: Thread
        return (empty, false)
    }
    return (result, true)
}

pub join :: proc(thread: ^Thread) -> bool {
    if native_thread_is_empty(thread) {
        return true
    }
    status := native_thread_join(thread)
    if status == 0 {
        native_thread_clear(thread)
        return true
    }
    return false
}

pub current_id :: proc() -> uintptr {
    return native_thread_current_id()
}

pub yield :: proc() {
    native_thread_yield()
}

pub mutex_init :: proc(mutex: ^Mutex) -> bool {
    return native_mutex_init(mutex) == 0
}

pub mutex_destroy :: proc(mutex: ^Mutex) -> bool {
    return native_mutex_destroy(mutex) == 0
}

pub mutex_lock :: proc(mutex: ^Mutex) {
    assert(native_mutex_lock(mutex) == 0, "mutex lock failed")
}

pub mutex_try_lock :: proc(mutex: ^Mutex) -> bool {
    return native_mutex_try_lock(mutex) == 0
}

pub mutex_unlock :: proc(mutex: ^Mutex) {
    assert(native_mutex_unlock(mutex) == 0, "mutex unlock failed")
}

pub condition_init :: proc(condition: ^Condition) -> bool {
    return native_condition_init(condition) == 0
}

pub condition_destroy :: proc(condition: ^Condition) -> bool {
    return native_condition_destroy(condition) == 0
}

pub condition_wait :: proc(condition: ^Condition, mutex: ^Mutex) {
    assert(native_condition_wait(condition, mutex) == 0,
        "condition wait failed")
}

pub condition_signal :: proc(condition: ^Condition) {
    assert(native_condition_signal(condition) == 0, "condition signal failed")
}

pub condition_broadcast :: proc(condition: ^Condition) {
    assert(native_condition_broadcast(condition) == 0,
        "condition broadcast failed")
}

pub sleep :: proc(duration: time.Duration) -> bool {
    if duration <= 0 {
        return true
    }
    return native_thread_sleep(duration)
}
