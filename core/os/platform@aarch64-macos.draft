// This target-selected half of core/os supplies Darwin constants and C
// procedure declarations to the portable policy in package.draft. It owns no
// resources or state: every pointer is borrowed for one synchronous native
// call, and descriptor lifetime remains with the common File API.
//
// The declarations intentionally depend only on core/c_abi and the macOS target
// profile. Their numeric flags and C signatures are ABI facts rather than
// portable POSIX assumptions. Draft specification: sections 5-7, section 12,
// and the versioned AArch64 macOS target profile.
package os

import core/c_abi

// Darwin open(2) flags from the selected macOS SDK. These are target facts,
// not portable POSIX values: Linux uses different bits for every flag below.
pub open_append :: cast[c_abi.int](0x0008)
pub open_create :: cast[c_abi.int](0x0200)
pub open_truncate :: cast[c_abi.int](0x0400)
pub open_exclusive :: cast[c_abi.int](0x0800)

// New files begin as rw-rw-rw- before the process umask removes permissions.
// Decimal 438 is octal 0666 in the selected Darwin SDK.
pub default_creation_permissions :: cast[c_abi.unsigned_int](438)

pub page_size :: proc() -> usize {
    return 16384
}

// POSIX read fills mutable caller storage, while write only observes its source
// for the duration of the call. Draft has no const-qualified pointer family, so
// both declarations use [^]u8; the write nonmutation/nonretention contract is
// what permits package.draft to pass raw_data(string) without copying.
foreign darwin {
    // open consumes the promoted mode argument only when open_create is set.
    // The bare tail is the real Darwin variadic ABI; LLVM owns its required
    // stack placement rather than routing the call through package assembly.
    native_open as "open" :: c proc(
        path: cstring,
        flags: c_abi.int,
        ..,
    ) -> c_abi.int
    native_read as "read" :: c proc(
        descriptor: c_abi.int,
        destination: [^]u8,
        count: c_abi.size_t,
    ) -> c_abi.ssize_t
    native_write as "write" :: c proc(
        descriptor: c_abi.int,
        source: [^]u8,
        count: c_abi.size_t,
    ) -> c_abi.ssize_t
    native_close as "close" :: c proc(descriptor: c_abi.int) -> c_abi.int
    native_unlink as "unlink" :: c proc(path: cstring) -> c_abi.int
    native_process_id as "getpid" :: c proc() -> c_abi.int
    native_exit as "_exit" :: c proc(status: c_abi.int)
}
