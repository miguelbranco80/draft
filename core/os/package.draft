// This package is the hosted operating-system boundary shared by the current
// macOS and GNU/Linux targets. It exposes process-lifetime argument and
// environment views, explicit descriptor handles, one-call byte/text
// reads/writes, complete writes, pathname operations, and small process facts.
// Target files and package assembly own platform constants and fixed C ABI
// adapters; this common file owns portable Draft policy over those selected
// operations.
//
// File values alias native descriptors and never own cleanup implicitly.
// Callers retain ownership of every byte slice and must close each successfully
// opened handle exactly once through its chosen owner. Recoverable native
// failures are collapsed into core/io.Error or bool by this initial surface.
// Draft specification: sections 5-7 and the selected target profile.
package os

import core/c_abi
import core/io

// The hosted entry shim owns the process vectors and exposes their already
// materialized Draft string records through this private runtime ABI. The
// wrappers below return non-owning views valid until process exit.
foreign draft_runtime {
    process_args_data as "__draft.os.args_data" :: c proc() -> rawptr
    process_args_count as "__draft.os.args_count" :: c proc() -> usize
    process_environment_data as "__draft.os.environment_data" :: c proc() -> rawptr
    process_environment_count as "__draft.os.environment_count" :: c proc() -> usize
}

pub args :: proc() -> []string {
    data := cast[[^]string](process_args_data())
    return data[:process_args_count()]
}

// Environment entries retain the target process representation `name=value`.
// This preserves exact bytes and duplicate-name ordering; policy for selecting
// or decoding a value belongs in ordinary library/application code.
pub environment :: proc() -> []string {
    data := cast[[^]string](process_environment_data())
    return data[:process_environment_count()]
}

// File is a small non-owning descriptor handle. Closing it is explicit, and a
// copied File aliases the same OS resource. A failed open returns a File whose
// descriptor is -1. Keeping that sentinel in the ordinary value means callers
// can initialize and clean up a handle without a second representation.
pub File :: c struct {
    descriptor: c_abi.int,
}

pub standard_input: File = File{descriptor = 0}
pub standard_output: File = File{descriptor = 1}
pub standard_error: File = File{descriptor = 2}

// Access modes occupy the low two bits and must not be combined with each
// other on either supported POSIX target. Target-owned creation and status
// flag values live in the selected platform source file.
pub open_read_only :: cast[c_abi.int](0)
pub open_write_only :: cast[c_abi.int](1)
pub open_read_write :: cast[c_abi.int](2)

// New files receive rw-rw-rw- before the process umask removes permissions.
// The decimal spelling is octal 0666; naming the policy is clearer at call
// sites than repeating a target-shaped numeric literal.
pub default_creation_permissions :: cast[c_abi.unsigned_int](438)

// POSIX declares open(2) as variadic because the mode argument is consumed only
// when O_CREAT is present. Draft 1 rejects variadic foreign declarations, so
// each target assembly file supplies this fixed three-argument C ABI wrapper.
// The kernel ignores the third value when O_CREAT is absent.
foreign package_assembly {
    native_open as "draft_os_open_fixed" :: c proc(
        path: cstring,
        flags: c_abi.int,
        mode: c_abi.unsigned_int,
    ) -> c_abi.int
}

pub file_from_descriptor :: proc(descriptor: c_abi.int) -> File {
    return File{descriptor = descriptor}
}

// Opens a pathname through the fixed-signature package-assembly adapter.
// `mode` is used only when flags contains open_create. The low-level form stays
// public because systems code needs combinations such as append or exclusive
// creation, while the convenience procedures below cover the common cases.
pub open :: proc(
    path: cstring,
    flags: c_abi.int,
    mode: c_abi.unsigned_int,
) -> (File, io.Error) {
    descriptor := native_open(path, flags, mode)
    if descriptor < 0 {
        return (File{descriptor = -1}, .unavailable)
    }
    return (File{descriptor = descriptor}, .none)
}

// Opens an existing file for reading. The ignored mode is explicitly zero so
// the fixed native signature has one unsurprising call convention everywhere.
pub open_for_reading :: proc(path: cstring) -> (File, io.Error) {
    return open(path, open_read_only, 0)
}

// Creates a file for writing, truncating an existing file. The process umask
// remains the final authority over permissions, exactly as for C open(2).
pub create_for_writing :: proc(path: cstring) -> (File, io.Error) {
    flags := open_write_only | open_create | open_truncate
    return open(path, flags, default_creation_permissions)
}

pub read :: proc(handle: File, destination: []u8) -> (usize, io.Error) {
    if len(destination) == 0 {
        return (0, .none)
    }
    data := cast[[^]u8](&destination[0])
    count := native_read(handle.descriptor, data, len(destination))
    if count < 0 {
        return (0, .unavailable)
    }
    if count == 0 {
        return (0, .end_of_input)
    }
    return (cast[usize](count), .none)
}

pub write :: proc(handle: File, source: []u8) -> (usize, io.Error) {
    if len(source) == 0 {
        return (0, .none)
    }
    data := cast[[^]u8](&source[0])
    count := native_write(handle.descriptor, data, len(source))
    if count < 0 {
        return (0, .unavailable)
    }
    return (cast[usize](count), .none)
}

// write_text performs one native write from immutable string storage without
// copying it into a mutable byte buffer. raw_data is safe for this exact use:
// the selected POSIX write operation reads `count` bytes synchronously and
// neither mutates nor retains the pointer. The empty case avoids presenting a
// possibly nil empty-string address to a native call and matches write([]u8).
// A successful call may accept only a prefix; callers needing completion use
// write_text_all.
pub write_text :: proc(handle: File, source: string) -> (usize, io.Error) {
    if len(source) == 0 {
        return (0, .none)
    }
    count := native_write(handle.descriptor, raw_data(source), len(source))
    if count < 0 {
        return (0, .unavailable)
    }
    return (cast[usize](count), .none)
}

// write_all synchronously writes the complete borrowed source range in order.
// A native write may accept only a prefix, so the operation advances by the
// reported count until no bytes remain. A successful zero-byte write on a
// non-empty suffix is converted to unavailable: retrying it could spin forever
// without an externally visible state change. Empty input succeeds without a
// native call. The File is borrowed by value and is not closed or retained.
pub write_all :: proc(handle: File, source: []u8) -> io.Error {
    written: usize
    for written < len(source) {
        (count, error) := write(handle, source[written:])
        if error != .none {
            return error
        }
        if count == 0 {
            return .unavailable
        }
        written += count
    }
    return .none
}

// write_text_all is the immutable-string counterpart to write_all. Each
// iteration passes a sliced string view whose data pointer already begins at
// the first unwritten byte, so partial native writes advance without copying
// or allocating. A successful zero-byte write on a nonempty suffix is an
// unavailable error because retrying the same state could never make local
// progress. Empty input succeeds without extracting or dereferencing data.
pub write_text_all :: proc(handle: File, source: string) -> io.Error {
    written: usize
    for written < len(source) {
        (count, error) := write_text(handle, source[written:])
        if error != .none {
            return error
        }
        if count == 0 {
            return .unavailable
        }
        written += count
    }
    return .none
}

pub close :: proc(handle: ^File) -> bool {
    if handle^.descriptor < 0 {
        return true
    }
    result := native_close(handle^.descriptor)
    if result == 0 {
        handle^.descriptor = -1
        return true
    }
    return false
}

// Removes one pathname. Open handles remain valid until closed, following the
// target operating system's ordinary unlink semantics.
pub remove :: proc(path: cstring) -> bool {
    return native_unlink(path) == 0
}

pub process_id :: proc() -> u64 {
    return cast[u64](native_process_id())
}

pub exit :: proc(status: int) {
    native_exit(cast[c_abi.int](status))
}
