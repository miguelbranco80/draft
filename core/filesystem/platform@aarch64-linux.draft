// This target-selected half of core/filesystem adapts glibc's Linux dirent ABI
// to the portable copied-name contract. Directory owns one DIR pointer. The
// returned dirent remains libc-owned and short-lived, so read scans only to its
// mandatory zero terminator and copies before the next native call.
package filesystem

import core/c_abi
import core/io

Linux_Dirent :: c struct {
    inode: u64,
    offset: i64,
    record_length: u16,
    entry_type: u8,
    name: [256]u8,
}

foreign linux {
    native_open_directory as "opendir" :: c proc(path: cstring) -> rawptr
    native_read_directory as "readdir" :: c proc(handle: rawptr) -> ^Linux_Dirent
    native_close_directory as "closedir" :: c proc(handle: rawptr) -> c_abi.int
    native_real_path as "realpath" :: c proc(
        path: cstring,
        resolved: [^]u8,
    ) -> cstring
}

foreign libc {
    native_free as "free" :: c proc(storage: rawptr)
}

Directory_Type :: cast[u8](4)
Regular_File_Type :: cast[u8](8)

pub Directory :: struct {
    handle: rawptr,
}

// canonicalize resolves one existing path through the Linux filesystem and
// follows every symlink. The native allocation is released before return. A
// successful result initializes exactly the returned byte prefix with an
// absolute `/`-separated path. If destination is too small, invalid is returned
// with the required byte count and destination is left unchanged.
pub canonicalize :: proc(
    path: cstring,
    destination: []u8,
) -> (usize, io.Error) {
    resolved := native_real_path(path, nil)
    if resolved == nil {
        return (0, .unavailable)
    }
    defer native_free(cast[rawptr](resolved))

    bytes := cast[[^]u8](resolved)
    count: usize
    for bytes[count] != 0 {
        count += 1
    }
    if count > len(destination) {
        return (count, .invalid)
    }
    for index: usize = 0; index < count; index += 1 {
        destination[index] = bytes[index]
    }
    return (count, .none)
}

pub open :: proc(path: cstring) -> (Directory, io.Error) {
    static_assert(size_of(Linux_Dirent) == 280)
    static_assert(align_of(Linux_Dirent) == 8)
    handle := native_open_directory(path)
    if handle == nil {
        return (Directory{}, .unavailable)
    }
    return (Directory{handle = handle}, .none)
}

pub read :: proc(
    directory: ^Directory,
    destination: []u8,
) -> (Entry, io.Error) {
    if directory.handle == nil {
        return (Entry{}, .invalid)
    }
    native := native_read_directory(directory.handle)
    if native == nil {
        return (Entry{}, .end_of_input)
    }
    count: usize
    for count < len(native.name) && native.name[count] != 0 {
        count += 1
    }
    if count == len(native.name) || count > len(destination) {
        return (Entry{}, .invalid)
    }
    for index: usize = 0; index < count; index += 1 {
        destination[index] = native.name[index]
    }
    kind: Entry_Kind = .unknown
    if native.entry_type == Directory_Type {
        kind = .directory
    } else if native.entry_type == Regular_File_Type {
        kind = .regular_file
    }
    return (Entry{kind = kind, name_length = count}, .none)
}

pub close :: proc(directory: ^Directory) -> bool {
    if directory.handle == nil {
        return true
    }
    if native_close_directory(directory.handle) != 0 {
        return false
    }
    directory.handle = nil
    return true
}
