package benchmark

import core/time

// Benchmark stores the smallest target-independent measurement record. The
// validation evidence layer owns warmup, sampling, aggregation, and runner
// identity; this ordinary API measures one callback and records its budget.
pub Benchmark :: struct {
    maximum_time: time.Duration,
    last_time: time.Duration,
    samples: usize,
    failures: usize,
    user: rawptr,
}

pub require_max_time :: proc(
    benchmark: ^Benchmark,
    maximum: time.Duration,
) {
    benchmark.maximum_time = maximum
}

pub measure :: proc(benchmark: ^Benchmark, operation: proc()) {
    begin := time.monotonic_now()
    operation()
    elapsed := time.monotonic_now() - begin
    benchmark.last_time = elapsed
    benchmark.samples += 1
    if benchmark.maximum_time > 0 && elapsed > benchmark.maximum_time {
        benchmark.failures += 1
    }
}

pub failed :: proc(benchmark: ^Benchmark) -> bool {
    return benchmark.failures != 0
}
