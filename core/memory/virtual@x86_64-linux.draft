// This target-selected half of core/memory implements virtual address-space
// reservation for the x86-64 GNU/Linux profile. It owns no retained state:
// successful storage is returned as an explicit Virtual_Region, and release or
// protection changes remain the common package's responsibility. Linux UAPI
// constants and libc signatures are target facts, while allocation policy
// stays in package.draft. Draft specification: sections 5-7 and 12, plus the
// versioned x86-64 GNU/Linux target profile.
package memory

foreign linux {
    native_mmap as "mmap" :: c proc(
        address: rawptr,
        size: usize,
        protection, flags, descriptor: i32,
        offset: i64,
    ) -> rawptr
    native_mprotect as "mprotect" :: c proc(
        address: rawptr,
        size: usize,
        protection: i32,
    ) -> i32
    native_munmap as "munmap" :: c proc(address: rawptr, size: usize) -> i32
}

native_virtual_protect :: proc(
    address: rawptr,
    size: usize,
    protection: Virtual_Protection,
) -> bool {
    return native_mprotect(address, size, cast[i32](protection)) == 0
}

native_virtual_release :: proc(address: rawptr, size: usize) -> bool {
    return native_munmap(address, size) == 0
}

// Linux MAP_PRIVATE | MAP_ANONYMOUS is 0x0002 | 0x0020 for the selected
// x86-64 UAPI. mmap reports failure with the all-ones pointer value.
pub virtual_reserve :: proc(size: usize) -> (Virtual_Region, bool) {
    empty: Virtual_Region
    if size == 0 {
        return (empty, false)
    }
    storage := native_mmap(nil, size, 0, 0x0022, -1, 0)
    failed := cast[rawptr](~cast[uintptr](0))
    if storage == failed {
        return (empty, false)
    }
    return (Virtual_Region{data = storage, size = size}, true)
}
