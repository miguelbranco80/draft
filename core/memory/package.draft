package memory

import core/runtime

// This package is the ordinary Draft substrate over the versioned allocator
// ABI. The byte operations remain available for containers and arenas, while
// new/free provide the common typed path without compiler-defined allocation
// behavior. Explicit-allocator forms use distinct names because Draft 1 has no
// declaration overloading or default procedure arguments.

pub allocate :: proc(size, alignment: usize) -> rawptr {
    return allocate_with_allocator(size, alignment, context.allocator)
}

pub allocate_with_allocator :: proc(
    size, alignment: usize,
    allocator: runtime.Allocator,
) -> rawptr {
    if size == 0 {
        return nil
    }
    storage := allocator.procedure(
        allocator.user,
        .allocate,
        nil,
        0,
        size,
        alignment,
    )
    assert(storage != nil, "allocation failed")
    return storage
}

pub resize :: proc(
    storage: rawptr,
    old_size, new_size, alignment: usize,
) -> rawptr {
    return resize_with_allocator(
        storage,
        old_size,
        new_size,
        alignment,
        context.allocator,
    )
}

pub resize_with_allocator :: proc(
    storage: rawptr,
    old_size, new_size, alignment: usize,
    allocator: runtime.Allocator,
) -> rawptr {
    resized := allocator.procedure(
        allocator.user,
        .resize,
        storage,
        old_size,
        new_size,
        alignment,
    )
    if new_size != 0 {
        assert(resized != nil, "resize failed")
    }
    return resized
}

pub free_bytes :: proc(storage: rawptr, size, alignment: usize) {
    free_bytes_with_allocator(storage, size, alignment, context.allocator)
}

pub free_bytes_with_allocator :: proc(
    storage: rawptr,
    size, alignment: usize,
    allocator: runtime.Allocator,
) {
    if storage == nil {
        return
    }
    allocator.procedure(
        allocator.user,
        .free,
        storage,
        size,
        0,
        alignment,
    )
}

pub new[T: type] :: proc() -> ^T {
    return cast[^T](allocate(size_of(T), align_of(T)))
}

pub new_with_allocator[T: type] :: proc(
    allocator: runtime.Allocator,
) -> ^T {
    return cast[^T](allocate_with_allocator(
        size_of(T),
        align_of(T),
        allocator,
    ))
}

pub free[T: type] :: proc(storage: ^T) {
    free_bytes(cast[rawptr](storage), size_of(T), align_of(T))
}

pub free_with_allocator[T: type] :: proc(
    storage: ^T,
    allocator: runtime.Allocator,
) {
    free_bytes_with_allocator(
        cast[rawptr](storage),
        size_of(T),
        align_of(T),
        allocator,
    )
}

// Temporary allocation uses the active Context's thread-owned resettable
// allocator. Individual frees are intentionally unnecessary: values remain
// live until reset_temporary or thread exit. Callers must not retain a returned
// pointer across either boundary.
pub temporary_allocate :: proc(size, alignment: usize) -> rawptr {
    return allocate_with_allocator(size, alignment, context.temp_allocator)
}

pub temporary_new[T: type] :: proc() -> ^T {
    return cast[^T](temporary_allocate(size_of(T), align_of(T)))
}

pub reset_temporary :: proc() {
    runtime.reset_temporary_allocator()
}
