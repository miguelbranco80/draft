// These tests exercise the platform-independent contracts of core/terminal
// without borrowing or modifying the test runner's real terminal. They verify
// timeout conversion, inactive raw/screen/resize resources, destructive input
// cleanup validation, size-query validation, and streaming key decoding across
// read boundaries. The native
// validation driver copies this package to a private workspace, selects the
// matching host target, and links the real libc symbols. Actual mode and
// alternate-screen changes require an application or pseudo-terminal
// integration test and are deliberately not attempted against CTest's
// stdin/stdout.
package terminal

import core/c_abi
import core/os
import core/testing
import core/time

// text_equal is the deliberately tiny test-side string comparison. Draft does
// not define structural string equality, and importing a larger text package
// would obscure these terminal package tests with an unrelated dependency.
text_equal :: proc(left, right: string) -> bool {
    if len(left) != len(right) {
        return false
    }
    for index: usize = 0; index < len(left); index += 1 {
        if left[index] != right[index] {
            return false
        }
    }
    return true
}

// test_timeout_milliseconds fixes the conversion rules that keep poll from
// expiring early or accidentally interpreting an overflowing duration as an
// infinite wait. It calls the private helper because this is a same-package
// test; applications consume only Duration through terminal.read.
test_timeout_milliseconds :: proc(test: ^testing.Test) {
    testing.expect(test, timeout_milliseconds(0 * time.nanosecond) == 0)
    testing.expect(test, timeout_milliseconds(-1 * time.nanosecond) == 0)
    testing.expect(test, timeout_milliseconds(1 * time.nanosecond) == 1)
    testing.expect(test, timeout_milliseconds(1 * time.millisecond) == 1)
    testing.expect(
        test,
        timeout_milliseconds(time.millisecond + time.nanosecond) == 2,
    )
    maximum := cast[c_abi.int](Maximum_Poll_Milliseconds)
    testing.expect(
        test,
        timeout_milliseconds(
            Maximum_Poll_Milliseconds * time.millisecond,
        ) == maximum,
    )
    testing.expect(
        test,
        timeout_milliseconds(
            Maximum_Poll_Milliseconds * time.millisecond + time.nanosecond,
        ) == maximum,
    )
}

// test_inactive_session proves that a zero Session has no hidden descriptor or
// cleanup side effect. Invalid operations return explicit errors, and restore
// remains safe for cleanup paths that did not complete acquisition.
test_inactive_session :: proc(test: ^testing.Test) {
    session: Session
    storage: [1]u8

    testing.expect(test, session.state == .inactive)
    (count, error) := read(&session, storage[:], 0 * time.nanosecond)
    testing.expect(test, count == 0)
    testing.expect(test, error == .invalid)
    testing.expect(test, discard_pending_input(&session) == .invalid)
    testing.expect(test, !suspend(&session))
    testing.expect(test, !resume(&session))
    testing.expect(test, restore(&session))

    invalid_input := os.File{descriptor = -1}
    begin_error := begin_raw(&session, invalid_input)
    testing.expect(test, begin_error == .invalid)
    testing.expect(test, session.state == .inactive)

    (terminal_size, size_error) := query_size(invalid_input)
    testing.expect(test, size_error == .invalid)
    testing.expect(test, terminal_size.columns == 0)
    testing.expect(test, terminal_size.rows == 0)

    watcher: Resize_Watcher
    testing.expect(test, watcher.state == .inactive)
    (inactive_size, changed, poll_error) := poll_resize(&watcher)
    testing.expect(test, poll_error == .invalid)
    testing.expect(test, !changed)
    testing.expect(test, inactive_size.columns == 0)
    testing.expect(test, inactive_size.rows == 0)
    (watch_size, watch_error) := begin_resize_watch(&watcher, invalid_input)
    testing.expect(test, watch_error == .invalid)
    testing.expect(test, watch_size.columns == 0)
    testing.expect(test, watch_size.rows == 0)
    testing.expect(test, watcher.state == .inactive)
    testing.expect(test, end_resize_watch(&watcher))
}

// test_key_decoder covers ordinary/single-byte keys, fragmented CSI and SS3
// forms, xterm modifiers, Alt-prefixed bytes, and the caller-controlled lone-
// Escape timeout. It feeds exactly one byte per call so no buffering assumption
// can hide state errors.
test_key_decoder :: proc(test: ^testing.Test) {
    decoder: Decoder

    ordinary := decode_key(&decoder, cast[u8]('q'))
    testing.expect(test, ordinary.kind == .byte)
    testing.expect(test, ordinary.byte_value == cast[u8]('q'))
    testing.expect(test, !ordinary.shift && !ordinary.alt && !ordinary.control)

    enter := decode_key(&decoder, 13)
    testing.expect(test, enter.kind == .enter)
    tab := decode_key(&decoder, 9)
    testing.expect(test, tab.kind == .tab)
    backspace := decode_key(&decoder, 127)
    testing.expect(test, backspace.kind == .backspace)
    testing.expect(test, backspace.byte_value == 127)
    testing.expect(test, !backspace.control)
    control_h := decode_key(&decoder, 8)
    testing.expect(test, control_h.kind == .backspace)
    testing.expect(test, control_h.byte_value == 8)
    testing.expect(test, control_h.control)
    control_c := decode_key(&decoder, 3)
    testing.expect(test, control_c.kind == .byte)
    testing.expect(test, control_c.byte_value == 3)
    testing.expect(test, control_c.control)

    // ESC followed by an ordinary byte is the byte-terminal spelling of Alt.
    testing.expect(test, decode_key(&decoder, 27).kind == .none)
    alt_q := decode_key(&decoder, cast[u8]('q'))
    testing.expect(test, alt_q.kind == .byte)
    testing.expect(test, alt_q.byte_value == cast[u8]('q'))
    testing.expect(test, alt_q.alt)

    testing.expect(test, decode_key(&decoder, 27).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('[')).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('D')).kind == .left)

    // Numeric-tilde keys include Insert and the editing/navigation vocabulary.
    testing.expect(test, decode_key(&decoder, 27).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('[')).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('2')).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('~')).kind == .insert)

    // Modified CSI arrows preserve their explicit modifier parameter. Every
    // parameter byte is consumed rather than leaking as ordinary input.
    testing.expect(test, decode_key(&decoder, 27).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('[')).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('1')).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8](';')).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('5')).kind == .none)
    control_left := decode_key(&decoder, cast[u8]('D'))
    testing.expect(test, control_left.kind == .left)
    testing.expect(test, control_left.control)
    testing.expect(test, !control_left.shift && !control_left.alt)

    // Back-tab establishes Shift directly, even without a numeric modifier.
    testing.expect(test, decode_key(&decoder, 27).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('[')).kind == .none)
    shift_tab := decode_key(&decoder, cast[u8]('Z'))
    testing.expect(test, shift_tab.kind == .tab)
    testing.expect(test, shift_tab.shift)

    // SS3 P is F1. Numeric-tilde 24 is F12, fixing both common function-key
    // families without depending on the read boundary.
    testing.expect(test, decode_key(&decoder, 27).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('O')).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('P')).kind == .f1)

    testing.expect(test, decode_key(&decoder, 27).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('[')).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('2')).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('4')).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('~')).kind == .f12)

    // `15;4~` is F5 with Shift+Alt under xterm's modifier numbering.
    testing.expect(test, decode_key(&decoder, 27).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('[')).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('1')).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('5')).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8](';')).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('4')).kind == .none)
    shifted_alt_f5 := decode_key(&decoder, cast[u8]('~'))
    testing.expect(test, shifted_alt_f5.kind == .f5)
    testing.expect(test, shifted_alt_f5.shift && shifted_alt_f5.alt)
    testing.expect(test, !shifted_alt_f5.control)

    // Unsupported SS3 finals are consumed as a unit, then bytes resume.
    testing.expect(test, decode_key(&decoder, 27).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('O')).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('X')).kind == .none)
    testing.expect(test,
        decode_key(&decoder, cast[u8]('q')).kind == .byte)

    testing.expect(test, decode_key(&decoder, 27).kind == .none)
    testing.expect(test, decoder_pending(&decoder))
    testing.expect(test, flush_key(&decoder).kind == .escape)
    testing.expect(test, !decoder_pending(&decoder))
    testing.expect(test, flush_key(&decoder).kind == .none)
}

// test_general_input_decoder proves SGR mouse reports remain indivisible from
// keyboard input and translate one-based protocol coordinates, buttons,
// modifiers, drag state, release, and wheel direction into portable values.
test_general_input_decoder :: proc(test: ^testing.Test) {
    decoder: Decoder
    press_sequence := "\x1b[<4;4;3M"
    press: Input
    for index: usize = 0; index < len(press_sequence); index += 1 {
        result := decode_input(&decoder, press_sequence[index])
        if result.kind != .none {
            press = result
        }
    }
    testing.expect(test, press.kind == .mouse)
    testing.expect(test, press.mouse.action == .press)
    testing.expect(test, press.mouse.button == .primary)
    testing.expect(test, press.mouse.column == 3 && press.mouse.row == 2)
    testing.expect(test, press.mouse.shift)

    drag_sequence := "\x1b[<32;8;6M"
    drag: Input
    for index: usize = 0; index < len(drag_sequence); index += 1 {
        result := decode_input(&decoder, drag_sequence[index])
        if result.kind != .none {
            drag = result
        }
    }
    testing.expect(test, drag.kind == .mouse)
    testing.expect(test, drag.mouse.action == .move)
    testing.expect(test, drag.mouse.primary_down)
    testing.expect(test, drag.mouse.column == 7 && drag.mouse.row == 5)

    hover_sequence := "\x1b[<35;9;7M"
    hover: Input
    for index: usize = 0; index < len(hover_sequence); index += 1 {
        result := decode_input(&decoder, hover_sequence[index])
        if result.kind != .none {
            hover = result
        }
    }
    testing.expect(test, hover.kind == .mouse)
    testing.expect(test, hover.mouse.action == .move)
    testing.expect(test, hover.mouse.button == .none)
    testing.expect(test, !hover.mouse.primary_down)

    release_sequence := "\x1b[<0;8;6m"
    release: Input
    for index: usize = 0; index < len(release_sequence); index += 1 {
        result := decode_input(&decoder, release_sequence[index])
        if result.kind != .none {
            release = result
        }
    }
    testing.expect(test, release.kind == .mouse)
    testing.expect(test, release.mouse.action == .release)
    testing.expect(test, release.mouse.button == .primary)

    wheel_sequence := "\x1b[<65;2;2M"
    wheel: Input
    for index: usize = 0; index < len(wheel_sequence); index += 1 {
        result := decode_input(&decoder, wheel_sequence[index])
        if result.kind != .none {
            wheel = result
        }
    }
    testing.expect(test, wheel.kind == .mouse)
    testing.expect(test, wheel.mouse.action == .wheel)
    testing.expect(test, wheel.mouse.wheel_delta == 1)

    horizontal_wheel := "\x1b[<66;2;2M"
    horizontal: Input
    for index: usize = 0; index < len(horizontal_wheel); index += 1 {
        result := decode_input(&decoder, horizontal_wheel[index])
        if result.kind != .none {
            horizontal = result
        }
    }
    testing.expect(test, horizontal.kind == .none)

    // Key-only consumers discard a complete mouse sequence and still decode
    // the following q exactly once, with no CSI punctuation leaked as keys.
    key_only_decoder: Decoder
    emitted_keys: usize
    for index: usize = 0; index < len(press_sequence); index += 1 {
        key := decode_key(&key_only_decoder, press_sequence[index])
        if key.kind != .none {
            emitted_keys += 1
        }
    }
    testing.expect(test, emitted_keys == 0)
    q := decode_key(&key_only_decoder, cast[u8]('q'))
    testing.expect(test, q.kind == .byte && q.byte_value == cast[u8]('q'))

    reporting: Mouse_Reporting
    screen: Screen
    testing.expect(test,
        begin_mouse_reporting(&reporting, &screen) == .invalid)
    testing.expect(test, !suspend_mouse_reporting(&reporting))
    testing.expect(test, !resume_mouse_reporting(&reporting))
    testing.expect(test, restore_mouse_reporting(&reporting))

    // Reporting policy is selected before any terminal I/O. Fix the exact
    // sequences here so the remote-friendly default cannot accidentally start
    // emitting unpressed motion and suspend/resume cannot choose another mode.
    testing.expect(test,
        text_equal(
            begin_mouse_sequence(.buttons_and_drag),
            Begin_Drag_Mouse_Sequence,
        ))
    testing.expect(test,
        text_equal(
            begin_mouse_sequence(.all_motion),
            Begin_All_Motion_Mouse_Sequence,
        ))
}

// test_inactive_screen fixes the zero-state contract without writing control
// bytes to the test runner. Invalid output is rejected before it can create a
// restoration obligation, and inactive cleanup remains idempotent.
test_inactive_screen :: proc(test: ^testing.Test) {
    screen: Screen
    storage: [1]u8
    testing.expect(test, screen.state == .inactive)
    testing.expect(test, write_screen(&screen, storage[:]) == .invalid)
    testing.expect(test, !suspend_screen(&screen))
    testing.expect(test, !resume_screen(&screen))
    testing.expect(test, restore_screen(&screen))

    invalid_output := os.File{descriptor = -1}
    testing.expect(test,
        begin_screen(&screen, invalid_output) == .invalid)
    testing.expect(test, screen.state == .inactive)
}
