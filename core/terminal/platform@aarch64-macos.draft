// This target-selected half of core/terminal defines Darwin's native termios
// record, poll count ABI, TIOCGWINSZ request, and SIGWINCH action layout.
// Native_Mode matches the macOS
// 14 arm64 SDK exactly: four unsigned-long flag words, twenty control bytes,
// padding to eight-byte speed fields, and 72 bytes total. Every pointer is
// borrowed for one libc call; resource ownership and portable error policy
// remain in package.draft.
//
// The declarations depend only on core/c_abi and the AArch64 macOS target profile.
// Their layouts and signatures are target ABI facts, not portable POSIX facts.
// Draft specification: sections 5-7 and 12.
package terminal

import core/c_abi

// POSIX terminals require no separate output-mode resource for ANSI escape
// processing. The byte exists only so common Screen can retain one uniform
// target-owned restoration record.
Native_Output_Mode :: struct {
    unused: u8,
}

native_begin_screen :: proc(
    descriptor: c_abi.int,
    mode: ^Native_Output_Mode,
) -> bool {
    return true
}

native_suspend_screen :: proc(
    descriptor: c_abi.int,
    mode: ^Native_Output_Mode,
) -> bool {
    return true
}

native_resume_screen :: proc(
    descriptor: c_abi.int,
    mode: ^Native_Output_Mode,
) -> bool {
    return true
}

native_restore_screen :: proc(
    descriptor: c_abi.int,
    mode: ^Native_Output_Mode,
) -> bool {
    return true
}

// Native_Mode is stored opaquely by public Session after begin_raw. Field names
// document the Darwin layout, but common code deliberately delegates all flag
// mutation to libc's cfmakeraw so Draft does not duplicate platform policy.
Native_Mode :: c struct {
    input_flags: c_abi.unsigned_long,
    output_flags: c_abi.unsigned_long,
    control_flags: c_abi.unsigned_long,
    local_flags: c_abi.unsigned_long,
    control_characters: [20]c_abi.unsigned_char,
    input_speed: c_abi.unsigned_long,
    output_speed: c_abi.unsigned_long,
}

Native_Apply_Now :: cast[c_abi.int](0)
Native_Size_Request :: cast[c_abi.unsigned_long](0x40087468)
Native_Resize_Uses_Notifications :: true
Native_Resize_Signal :: cast[c_abi.int](28)

// Darwin sigset_t is one unsigned 32-bit word. Its public sigaction omits the
// private kernel trampoline and is therefore 16 bytes on arm64: handler, mask,
// then flags. The saved value is retained verbatim for exact restoration.
Native_Signal_Action :: c struct {
    handler: c proc(signal_number: c_abi.int),
    mask: c_abi.unsigned_int,
    flags: c_abi.int,
}

foreign darwin {
    native_get_mode as "tcgetattr" :: c proc(
        descriptor: c_abi.int,
        mode: ^Native_Mode,
    ) -> c_abi.int
    native_set_mode as "tcsetattr" :: c proc(
        descriptor: c_abi.int,
        action: c_abi.int,
        mode: ^Native_Mode,
    ) -> c_abi.int
    native_make_raw as "cfmakeraw" :: c proc(mode: ^Native_Mode)
    native_poll as "poll" :: c proc(
        descriptors: ^Poll_Descriptor,
        count: c_abi.unsigned_int,
        timeout_milliseconds: c_abi.int,
    ) -> c_abi.int
    native_ioctl as "ioctl" :: c proc(
        descriptor: c_abi.int,
        request: c_abi.unsigned_long,
        ..,
    ) -> c_abi.int
    native_sigaction as "sigaction" :: c proc(
        signal_number: c_abi.int,
        action: ^Native_Signal_Action,
        previous: ^Native_Signal_Action,
    ) -> c_abi.int
    native_sigemptyset as "sigemptyset" :: c proc(
        set: ^c_abi.unsigned_int,
    ) -> c_abi.int
}

// Darwin defines nfds_t as unsigned int. Hiding that count type behind this
// one-descriptor helper lets the portable package express its actual operation
// without pretending Linux has the same poll signature.
native_poll_one :: proc(
    descriptor: ^Poll_Descriptor,
    timeout_milliseconds: c_abi.int,
) -> c_abi.int {
    static_assert(size_of(Native_Mode) == 72)
    static_assert(align_of(Native_Mode) == 8)
    return native_poll(descriptor, 1, timeout_milliseconds)
}

// TIOCGWINSZ writes one borrowed Native_Window_Size through ioctl's unnamed C
// argument. The request value encodes Darwin's eight-byte output record and is
// therefore an exact selected-target fact rather than portable POSIX policy.
native_query_size :: proc(
    descriptor: c_abi.int,
    size: ^Native_Window_Size,
) -> c_abi.int {
    return native_ioctl(descriptor, Native_Size_Request, size)
}

// native_begin_resize_watch first reads the existing process disposition. It
// accepts only SIG_DFL (the nil procedure pointer) and refuses even an explicit
// SIG_IGN or real handler, because Draft cannot safely fabricate or chain those
// reserved/native procedure-pointer values.
// The installed action has an empty mask and no SA_RESTART, allowing poll to
// return EINTR and wake terminal.read as soon as SIGWINCH is delivered.
native_begin_resize_watch :: proc(previous: ^Native_Signal_Action) -> bool {
    static_assert(size_of(Native_Signal_Action) == 16)
    static_assert(align_of(Native_Signal_Action) == 8)

    if native_sigaction(Native_Resize_Signal, nil, previous) != 0 {
        return false
    }
    if previous.handler != nil {
        return false
    }

    action: Native_Signal_Action
    action.handler = resize_signal_handler
    if native_sigemptyset(&action.mask) != 0 {
        return false
    }
    return native_sigaction(Native_Resize_Signal, &action, nil) == 0
}

// native_end_resize_watch reinstalls every byte of the disposition captured by
// begin. Common code retains ownership when this native operation fails.
native_end_resize_watch :: proc(previous: ^Native_Signal_Action) -> bool {
    return native_sigaction(Native_Resize_Signal, previous, nil) == 0
}
