// This target-selected half of core/terminal defines glibc 2.39's AArch64
// termios record and poll count ABI. Native_Mode matches the selected Ubuntu
// 24.04-class contract: four 32-bit flag words, one line byte, thirty-two
// control bytes, padding, two 32-bit speeds, and 60 bytes total. Every pointer
// is borrowed for one libc call; ownership and error policy remain common.
//
// The declarations depend only on core/c_abi and the AArch64 GNU/Linux target
// profile. Their layouts and signatures are versioned ABI facts rather than a
// claim about every Linux libc. Draft specification: sections 5-7 and 12.
package terminal

import core/c_abi

// Native_Mode is stored opaquely by Session. libc's cfmakeraw owns flag policy;
// exposing the physical fields here exists solely to give the C boundary the
// exact selected glibc layout and alignment.
Native_Mode :: c struct {
    input_flags: c_abi.unsigned_int,
    output_flags: c_abi.unsigned_int,
    control_flags: c_abi.unsigned_int,
    local_flags: c_abi.unsigned_int,
    line_discipline: c_abi.unsigned_char,
    control_characters: [32]c_abi.unsigned_char,
    input_speed: c_abi.unsigned_int,
    output_speed: c_abi.unsigned_int,
}

Native_Apply_Now :: cast[c_abi.int](0)

foreign linux {
    native_get_mode as "tcgetattr" :: c proc(
        descriptor: c_abi.int,
        mode: ^Native_Mode,
    ) -> c_abi.int
    native_set_mode as "tcsetattr" :: c proc(
        descriptor: c_abi.int,
        action: c_abi.int,
        mode: ^Native_Mode,
    ) -> c_abi.int
    native_make_raw as "cfmakeraw" :: c proc(mode: ^Native_Mode)
    native_poll as "poll" :: c proc(
        descriptors: ^Poll_Descriptor,
        count: c_abi.unsigned_long,
        timeout_milliseconds: c_abi.int,
    ) -> c_abi.int
}

// glibc defines nfds_t as unsigned long. The common implementation always
// waits on exactly one descriptor, so the differing count type stays confined
// to this target-owned adapter.
native_poll_one :: proc(
    descriptor: ^Poll_Descriptor,
    timeout_milliseconds: c_abi.int,
) -> c_abi.int {
    static_assert(size_of(Native_Mode) == 60)
    static_assert(align_of(Native_Mode) == 4)
    return native_poll(descriptor, 1, timeout_milliseconds)
}
