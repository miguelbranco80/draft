// core/process is the small hosted child-process boundary shared by Draft
// development tools. It launches one exact executable with explicit argument,
// environment-override, and working-directory policy, waits for completion,
// and reports exit or signal status. It performs no shell parsing, command
// lookup, redirection, or background lifetime.
//
// Platform files own native process conversion, creation, and wait handles.
// The common package owns validation and deterministic inherited-environment
// merging. Every cstring and slice is borrowed synchronously and remains owned
// by the caller. Temporary terminated environment copies die after the child
// has copied them during exec/CreateProcess.
package process

import core/array
import core/memory
import core/os

pub Error :: enum u8 {
    none,
    unavailable,
    invalid_options,
}

// Options contains the exact process-facing tail. arguments excludes argv[0];
// run installs path there. environment contains NAME=value overrides rather
// than a complete environment. An empty working_directory inherits the parent
// directory. CString storage must remain live for the synchronous call.
pub Options :: struct {
    arguments: []cstring,
    environment: []cstring,
    working_directory: cstring,
}

// Environment_Preparation_Result keeps caller-controlled option errors
// separate from a host environment which the current target implementation
// cannot reproduce. In particular, Windows promises ASCII environment names;
// a non-ASCII inherited name can only be discovered while constructing the
// complete replacement environment and is therefore unavailable, not an
// invalid user override.
Environment_Preparation_Result :: enum u8 {
    success,
    invalid_options,
    unavailable,
}

// Result distinguishes failure to create/wait from an ordinary nonzero exit.
// signal is meaningful only when exited is false and error is none; Windows
// currently reports all completed processes as exited with their DWORD code.
pub Result :: struct {
    error: Error,
    exited: bool,
    exit_code: u32,
    signal: u32,
}

// run is the zero-configuration convenience operation. It preserves the
// original core/process surface while giving all launches one implementation
// and one result contract.
pub run :: proc(path: cstring) -> Result {
    options: Options
    return run_with_options(path, options)
}

// cstring_length scans one required terminated process string. All callers
// validate nil before reaching this helper; the returned count excludes NUL.
cstring_length :: proc(text: cstring) -> usize {
    bytes := cast[[^]u8](text)
    length: usize
    for bytes[length] != 0 {
        length += 1
    }
    return length
}

// environment_name_length finds the NAME prefix and reports whether the row is
// a valid nonempty NAME=value spelling. Values may be empty and may contain
// additional '=' bytes.
environment_name_length :: proc(text: cstring) -> (usize, bool) {
    bytes := cast[[^]u8](text)
    length: usize
    for bytes[length] != 0 && bytes[length] != cast[u8]('=') {
        when target.os == .windows {
            // The bootstrap sorter implements the exact ASCII-insensitive
            // ordering used below. Reject non-ASCII names instead of emitting
            // a Unicode environment block in an order CreateProcess does not
            // define as canonical. Values after '=' remain arbitrary UTF-8.
            if bytes[length] >= 0x80 {
                return (0, false)
            }
        }
        length += 1
    }
    return (length, length != 0 && bytes[length] == cast[u8]('='))
}

// environment_sort_name_length returns the name prefix used for deterministic
// Windows block ordering. Ordinary rows stop at their first '='. Windows also
// carries hidden drive-directory rows such as `=C:=C:\\...`; their leading '='
// is part of the name and the second '=' begins the value. Native rows are
// assumed well formed because os.environment owns their platform conversion.
environment_sort_name_length :: proc(text: cstring) -> usize {
    bytes := cast[[^]u8](text)
    index: usize = 0
    if bytes[0] == cast[u8]('=') {
        index = 1
    }
    for bytes[index] != 0 && bytes[index] != cast[u8]('=') {
        index += 1
    }
    return index
}

// environment_name_is_ascii accepts every byte spelling used by a native
// inherited row, including Windows' hidden drive-directory entries. It checks
// only the complete name prefix; values remain arbitrary UTF-8.
environment_name_is_ascii :: proc(text: cstring) -> bool {
    bytes := cast[[^]u8](text)
    length := environment_sort_name_length(text)
    for index: usize = 0; index < length; index += 1 {
        if bytes[index] >= 0x80 {
            return false
        }
    }
    return true
}

// environment_name_equal compares only the NAME portions used for override
// replacement. POSIX names are byte-sensitive; Windows folds ASCII because
// that is the operating-system environment-name contract.
environment_name_equal :: proc(left: cstring, right: cstring) -> bool {
    (left_length, left_valid) := environment_name_length(left)
    (right_length, right_valid) := environment_name_length(right)
    if !left_valid || !right_valid || left_length != right_length {
        return false
    }
    left_bytes := cast[[^]u8](left)
    right_bytes := cast[[^]u8](right)
    for index: usize = 0; index < left_length; index += 1 {
        left_byte := left_bytes[index]
        right_byte := right_bytes[index]
        when target.os == .windows {
            if left_byte >= cast[u8]('a') && left_byte <= cast[u8]('z') {
                left_byte -= cast[u8]('a') - cast[u8]('A')
            }
            if right_byte >= cast[u8]('a') && right_byte <= cast[u8]('z') {
                right_byte -= cast[u8]('a') - cast[u8]('A')
            }
        }
        if left_byte != right_byte {
            return false
        }
    }
    return true
}

// environment_row_less supplies the case-insensitive name order required for
// the Windows environment block. Values never participate: comparing complete
// rows would incorrectly put `A1=x` before `A=x` because '1' precedes '='.
// The operation is instantiated only by prepare_environment's Windows branch.
environment_row_less :: proc(left, right: cstring) -> bool {
    left_bytes := cast[[^]u8](left)
    right_bytes := cast[[^]u8](right)
    left_length := environment_sort_name_length(left)
    right_length := environment_sort_name_length(right)
    common_length := left_length
    if right_length < common_length {
        common_length = right_length
    }
    for index: usize = 0; index < common_length; index += 1 {
        left_byte := left_bytes[index]
        right_byte := right_bytes[index]
        if left_byte >= cast[u8]('a') && left_byte <= cast[u8]('z') {
            left_byte -= cast[u8]('a') - cast[u8]('A')
        }
        if right_byte >= cast[u8]('a') && right_byte <= cast[u8]('z') {
            right_byte -= cast[u8]('a') - cast[u8]('A')
        }
        if left_byte != right_byte {
            return left_byte < right_byte
        }
    }
    return left_length < right_length
}

// append_owned_environment adds one independent terminated copy. The owner
// array may move, but each Owned_String's byte allocation remains stable.
append_owned_environment :: proc(
    owners: ^array.Dynamic[memory.Owned_String],
    bytes: []u8,
) {
    owned: memory.Owned_String
    memory.owned_string_copy_bytes(&owned, bytes)
    array.append(owners, owned)
}

// prepare_environment constructs a complete environment only when overrides
// exist. Parent rows keep operating-system order; overridden names are removed,
// then each last override is appended in manifest order. Duplicate overrides
// therefore have one deterministic last-wins meaning on every target.
prepare_environment :: proc(
    overrides: []cstring,
    owners: ^array.Dynamic[memory.Owned_String],
    pointers: ^array.Dynamic[cstring],
) -> Environment_Preparation_Result {
    array.init(owners)
    array.init(pointers)
    if len(overrides) == 0 {
        return .success
    }
    for override in overrides {
        if override == nil {
            return .invalid_options
        }
        (_, valid) := environment_name_length(override)
        if !valid {
            return .invalid_options
        }
    }

    for inherited in os.environment() {
        inherited_owner: memory.Owned_String
        memory.owned_string_copy(&inherited_owner, inherited)
        inherited_pointer := memory.owned_string_cstring(&inherited_owner)
        when target.os == .windows {
            // The Windows environment block must be sorted under the same
            // case-insensitive name relation used for override replacement.
            // Fail honestly when the current ASCII-only implementation cannot
            // reproduce one inherited name; classifying host state as an
            // invalid user option would make the Result contract misleading.
            if !environment_name_is_ascii(inherited_pointer) {
                memory.owned_string_destroy(&inherited_owner)
                return .unavailable
            }
        }
        replaced := false
        for override in overrides {
            if environment_name_equal(inherited_pointer, override) {
                replaced = true
                break
            }
        }
        if replaced {
            memory.owned_string_destroy(&inherited_owner)
        } else {
            array.append(owners, inherited_owner)
        }
    }
    for index: usize = 0; index < len(overrides); index += 1 {
        superseded := false
        for later := index + 1; later < len(overrides); later += 1 {
            if environment_name_equal(overrides[index], overrides[later]) {
                superseded = true
                break
            }
        }
        if superseded {
            continue
        }
        length := cstring_length(overrides[index])
        append_owned_environment(
            owners,
            cast[[^]u8](overrides[index])[:length],
        )
    }
    if owners.length > ~cast[usize](0) / size_of(cstring) {
        return .unavailable
    }
    array.reserve(pointers, owners.length)
    for index: usize = 0; index < owners.length; index += 1 {
        array.append(
            pointers,
            memory.owned_string_cstring(&owners.data[index]),
        )
    }
    when target.os == .windows {
        // CreateProcess requires a case-insensitively sorted Unicode
        // environment block. Pointer sorting changes no owner addresses and
        // leaves the POSIX inherited-order contract untouched.
        for index: usize = 1; index < pointers.length; index += 1 {
            row := pointers.data[index]
            cursor := index
            for cursor != 0 &&
                environment_row_less(row, pointers.data[cursor - 1]) {
                pointers.data[cursor] = pointers.data[cursor - 1]
                cursor -= 1
            }
            pointers.data[cursor] = row
        }
    }
    return .success
}

// destroy_environment releases every row and the non-owning parallel pointer
// table. It is valid after partial preparation, which keeps validation failures
// on the same cleanup path as a completed launch.
destroy_environment :: proc(
    owners: ^array.Dynamic[memory.Owned_String],
    pointers: ^array.Dynamic[cstring],
) {
    array.destroy(pointers)
    for index: usize = 0; index < owners.length; index += 1 {
        memory.owned_string_destroy(&owners.data[index])
    }
    array.destroy(owners)
}

// run_with_options validates borrowed process strings, constructs a complete
// environment only when overrides exist, and synchronously delegates target
// creation/waiting. Invalid option syntax is distinct from an unavailable
// native launch; child exit failure remains an ordinary Result status.
pub run_with_options :: proc(path: cstring, options: Options) -> Result {
    if path == nil {
        return Result{error = .unavailable}
    }
    for argument in options.arguments {
        if argument == nil {
            return Result{error = .invalid_options}
        }
    }
    environment_owners: array.Dynamic[memory.Owned_String]
    environment_pointers: array.Dynamic[cstring]
    environment_result := prepare_environment(
        options.environment,
        &environment_owners,
        &environment_pointers,
    )
    if environment_result != .success {
        destroy_environment(&environment_owners, &environment_pointers)
        if environment_result == .invalid_options {
            return Result{error = .invalid_options}
        }
        return Result{error = .unavailable}
    }
    defer destroy_environment(&environment_owners, &environment_pointers)
    working_directory := options.working_directory
    if working_directory != nil && cast[[^]u8](working_directory)[0] == 0 {
        // Both nil and an explicitly terminated empty string mean inheritance.
        // Normalize here so every target wrapper receives one native contract:
        // POSIX must not call chdir("") and Windows must pass null to
        // CreateProcessW rather than an empty current-directory string.
        working_directory = nil
    }
    return native_run(
        path,
        options.arguments,
        array.view(&environment_pointers),
        working_directory,
        len(options.environment) != 0,
    )
}
