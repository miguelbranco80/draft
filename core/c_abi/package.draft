// The c_abi package names the scalar types used by the selected C application
// binary interface. These aliases keep a foreign declaration readable without
// turning `c` into both a language modifier and an unrelated package name.
//
// Darwin and GNU/Linux use LP64, while 64-bit Windows uses Microsoft's LLP64:
// pointers remain 64 bits but C long remains 32 bits. The target-selected
// aliases below make that difference explicit without making user foreign
// declarations target-qualified. These are ordinary Draft aliases: source
// tools can inspect every width, and the package owns no runtime state or
// native resource.
// Draft specification: sections 7 and 12, plus the selected target profile.
package c_abi

pub char :: i8
pub signed_char :: i8
pub unsigned_char :: u8
pub short :: i16
pub unsigned_short :: u16
pub int :: i32
pub unsigned_int :: u32
when target.abi == .win64 {
    pub long :: i32
    pub unsigned_long :: u32
} else {
    pub long :: i64
    pub unsigned_long :: u64
}
pub long_long :: i64
pub unsigned_long_long :: u64
pub size_t :: usize
pub ssize_t :: isize
pub intptr_t :: isize
pub uintptr_t :: uintptr
