// These same-package tests fix core/tui's storage and ANSI diff contracts
// without touching the test runner's terminal. They use the real Context heap,
// inspect the private reusable byte buffer, and destroy every owning value.
// Native integration copies the package to process-unique build storage before
// invoking draftc test, so evidence and objects never enter the source checkout.
package tui

import core/testing
import core/terminal

bytes_equal_text :: proc(bytes: []u8, text: string) -> bool {
    if len(bytes) != len(text) {
        return false
    }
    for index: usize = 0; index < len(bytes); index += 1 {
        if bytes[index] != text[index] {
            return false
        }
    }
    return true
}

// test_surface_mutation verifies zero-style blank initialization and the
// all-or-nothing bounds/ASCII contracts of put, fill, and both ASCII writers.
test_surface_mutation :: proc(test: ^testing.Test) {
    grid: Surface
    surface_init(&grid, 5, 2)

    (initial, initial_valid) := cell_at(&grid, 0, 0)
    testing.expect(test, initial_valid)
    testing.expect(test, initial.value == ' ')
    testing.expect(test, initial.columns == 1)
    testing.expect(test, !initial.continuation)
    testing.expect(test, !initial.style.foreground.indexed)

    accent := Style{foreground = indexed_color(51), bold = true}
    testing.expect(test, put(&grid, 1, 0, cast[u8]('X'), accent))
    runtime_text := [3]u8{
        cast[u8]('a'),
        cast[u8]('b'),
        cast[u8]('c'),
    }
    testing.expect(test, write_ascii_bytes(
        &grid,
        2,
        0,
        runtime_text[:],
        Style{},
    ))
    testing.expect(test, !write_ascii(&grid, 4, 1, "no", Style{}))
    testing.expect(test, !write_ascii(&grid, 0, 1, "bad\n", Style{}))
    invalid_runtime_text := [2]u8{cast[u8]('x'), cast[u8]('\n')}
    testing.expect(test, !write_ascii_bytes(
        &grid,
        0,
        1,
        invalid_runtime_text[:],
        Style{},
    ))
    (unchanged, unchanged_valid) := cell_at(&grid, 0, 1)
    testing.expect(test, unchanged_valid)
    testing.expect(test, unchanged.value == ' ')
    testing.expect(test, fill(
        &grid,
        0,
        1,
        5,
        1,
        '-',
        Style{},
    ))

    (accent_cell, accent_valid) := cell_at(&grid, 1, 0)
    testing.expect(test, accent_valid)
    testing.expect(test, accent_cell.value == 'X')
    testing.expect(test, accent_cell.style.foreground.index == 51)
    testing.expect(test, accent_cell.style.bold)
    (outside, outside_valid) := cell_at(&grid, 5, 0)
    testing.expect(test, !outside_valid)
    testing.expect(test, outside.value == cast[rune](0))

    surface_destroy(&grid)
    testing.expect(test, grid.cells.data == nil)
}

// test_unicode_graphemes verifies exact byte retention, one/two-column cell
// ownership, diff emission, and whole-glyph replacement through a continuation
// coordinate. The decomposed accent must remain byte-for-byte decomposed; TUI
// display never normalizes caller text.
test_unicode_graphemes :: proc(test: ^testing.Test) {
    renderer: Renderer
    renderer_init(&renderer, 6, 1)
    commit_desired(&renderer)

    testing.expect(test, write_utf8(
        surface(&renderer),
        1,
        0,
        "é界",
        Style{},
    ))
    (accent, accent_valid) := cell_at(surface(&renderer), 1, 0)
    testing.expect(test,
        accent_valid && accent.value == 'e' && accent.columns == 1 &&
        !accent.continuation)
    (wide, wide_valid) := cell_at(surface(&renderer), 2, 0)
    testing.expect(test,
        wide_valid && wide.value == '界' && wide.columns == 2 &&
        !wide.continuation)
    (continuation, continuation_valid) :=
        cell_at(surface(&renderer), 3, 0)
    testing.expect(test,
        continuation_valid && continuation.continuation &&
        continuation.columns == 0)
    testing.expect(test, bytes_equal_text(
        build_render_bytes(&renderer),
        "\x1b[?2026h\x1b[1;2Hé界\x1b[0m\x1b[?2026l",
    ))
    commit_desired(&renderer)
    testing.expect(test, len(build_render_bytes(&renderer)) == 0)

    // Painting into the old wide glyph's continuation clears its leading cell
    // before placing X, producing two ordinary one-column cells in the diff.
    testing.expect(test, put(
        surface(&renderer),
        3,
        0,
        cast[u8]('X'),
        Style{},
    ))
    testing.expect(test, bytes_equal_text(
        build_render_bytes(&renderer),
        "\x1b[?2026h\x1b[1;3H X\x1b[0m\x1b[?2026l",
    ))

    // Validation finishes before mutation for nonprinting and overflowing
    // strings; the already-painted accent remains present after both failures.
    testing.expect(test,
        !write_utf8(surface(&renderer), 0, 0, "bad\n", Style{}))
    testing.expect(test,
        !write_utf8(surface(&renderer), 5, 0, "界", Style{}))
    (unchanged, unchanged_valid) := cell_at(surface(&renderer), 1, 0)
    testing.expect(test, unchanged_valid && unchanged.value == 'e')

    renderer_destroy(&renderer)
}

// test_renderer_diff verifies exact first-frame clearing, no-op frames,
// contiguous changed-run positioning, style emission, and resize invalidation.
// commit_desired models the state transition that present performs only after a
// complete terminal write.
test_renderer_diff :: proc(test: ^testing.Test) {
    renderer: Renderer
    renderer_init(&renderer, 3, 2)

    first := build_render_bytes(&renderer)
    testing.expect(test, bytes_equal_text(
        first,
        "\x1b[?2026h\x1b[0m\x1b[H\x1b[J\x1b[1;1H   \x1b[2;1H   \x1b[0m\x1b[?2026l",
    ))
    commit_desired(&renderer)
    testing.expect(test, len(build_render_bytes(&renderer)) == 0)

    // Even an empty diff requires an active Screen. Returning success while the
    // alternate screen is absent would preserve history for the wrong visible
    // surface, so the invalid call also forces a future full repaint.
    inactive_screen: terminal.Screen
    testing.expect(test, present(&renderer, &inactive_screen) == .invalid)
    testing.expect(test, !renderer.previous_valid)
    commit_desired(&renderer)

    testing.expect(test, put(
        surface(&renderer),
        1,
        0,
        cast[u8]('X'),
        Style{},
    ))
    changed := build_render_bytes(&renderer)
    testing.expect(test, bytes_equal_text(
        changed,
        "\x1b[?2026h\x1b[1;2HX\x1b[0m\x1b[?2026l",
    ))
    commit_desired(&renderer)

    styled := Style{foreground = indexed_color(51), dim = true}
    testing.expect(test, put(
        surface(&renderer),
        2,
        0,
        cast[u8]('Y'),
        styled,
    ))
    styled_change := build_render_bytes(&renderer)
    testing.expect(test, bytes_equal_text(
        styled_change,
        "\x1b[?2026h\x1b[1;3H\x1b[0m\x1b[2m\x1b[38;5;51mY\x1b[0m\x1b[?2026l",
    ))
    commit_desired(&renderer)

    // Window shadows and desktop backgrounds are both space glyphs; their
    // style is nevertheless visible terminal state. This exact diff proves
    // that moving a shadow away publishes the replacement background cell
    // inside the same synchronized frame rather than comparing rune alone.
    shadow := Style{background = indexed_color(0)}
    desktop := Style{background = indexed_color(1)}
    testing.expect(test, put(
        surface(&renderer),
        0,
        1,
        cast[u8](' '),
        shadow,
    ))
    commit_desired(&renderer)
    testing.expect(test, put(
        surface(&renderer),
        0,
        1,
        cast[u8](' '),
        desktop,
    ))
    testing.expect(test, bytes_equal_text(
        build_render_bytes(&renderer),
        "\x1b[?2026h\x1b[2;1H\x1b[0m\x1b[48;5;1m \x1b[0m\x1b[?2026l",
    ))
    commit_desired(&renderer)

    // U+2195 is an Extended_Pictographic text symbol, not a default emoji.
    // The renderer must therefore emit the adjacent border corner immediately
    // after it in one changed run. Modeling the arrow as two columns would
    // omit that physical cell on ordinary terminals and let old shadow color
    // remain visible there as a one-cell trail.
    testing.expect(test, put_rune(surface(&renderer), 0, 1, '↕', Style{}))
    testing.expect(test, put_rune(surface(&renderer), 1, 1, '╗', Style{}))
    testing.expect(test, bytes_equal_text(
        build_render_bytes(&renderer),
        "\x1b[?2026h\x1b[2;1H↕╗\x1b[0m\x1b[?2026l",
    ))
    commit_desired(&renderer)

    // A changed frame cannot be written through an inactive Screen. present
    // returns terminal's explicit error and forgets previous correspondence,
    // because a real write failure could have published an unknown prefix.
    testing.expect(test, put(
        surface(&renderer),
        0,
        1,
        cast[u8]('!'),
        Style{},
    ))
    testing.expect(test, present(&renderer, &inactive_screen) == .invalid)
    testing.expect(test, !renderer.previous_valid)
    failed_repaint := build_render_bytes(&renderer)
    testing.expect(test, len(failed_repaint) > 3)
    testing.expect(test, failed_repaint[0] == 27)
    commit_desired(&renderer)

    invalidate(&renderer)
    invalidated := build_render_bytes(&renderer)
    testing.expect(test, len(invalidated) > 3)
    testing.expect(test, invalidated[0] == 27)
    commit_desired(&renderer)

    renderer_resize(&renderer, 2, 1)
    testing.expect(test, renderer.desired.columns == 2)
    testing.expect(test, renderer.desired.rows == 1)
    testing.expect(test, !renderer.previous_valid)
    resized := build_render_bytes(&renderer)
    testing.expect(test, bytes_equal_text(
        resized,
        "\x1b[?2026h\x1b[0m\x1b[H\x1b[J\x1b[1;1H  \x1b[0m\x1b[?2026l",
    ))

    renderer_destroy(&renderer)
    testing.expect(test, renderer.desired.cells.data == nil)
    testing.expect(test, renderer.previous.cells.data == nil)
    testing.expect(test, renderer.output.data == nil)
}
