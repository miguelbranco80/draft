// turbo_editor_app's package module owns the long-lived application model shared
// by the standalone editor and DraftIDE: documents, compiler-derived rows,
// window values, text inputs, navigation history, and local clipboard bytes.
// Sibling modules implement commands, views, desktop composition, optional host
// integration, and terminal lifetime over this one explicit owner.
//
// The optional Host_Api is a borrowed synchronous procedure table. No compiler
// foreign declaration appears anywhere in this package, which keeps the same
// file editor buildable without LLVM or the bootstrap compiler service.
package turbo_editor_app

import core/array
import core/filesystem
import core/format
import core/memory
import core/os
import core/time
import lib/draft_compiler_api
import lib/turbo_editor
import lib/turbo_ui

// Root-package selection keeps dirty files open rather than overwriting them.
// Sixty-four slots cover a workspace with many tools/examples while keeping the
// complete owner table small and fixed; document/history bytes remain dynamic
// allocations rather than inflating App's stack footprint.
Maximum_Buffers :: 64
// Each occupied document slot derives one keyboard/body identity and one
// scrollbar capture identity even though only the active slot is painted. The
// two disjoint 64-ID ranges prevent a thumb drag from aliasing another slot's
// editor focus or any of the application's lower-numbered authored controls.
Editor_Body_Id_Base :: 600
Editor_Scrollbar_Id_Base :: 1600
Search_Capacity :: 128
Replacement_Capacity :: 128
Go_Line_Capacity :: 20
// Build status may contain one complete host artifact path. Keep it bounded by
// the same path policy as the compiler bridge rather than truncating the most
// important result of a successful operation.
Status_Capacity :: Host_Path_Capacity + 256
Input_Capacity :: 128
Input_Drain_Batch_Limit :: 32
Maximum_Columns :: 300
Maximum_Rows :: 120
Input_Idle_Timeout :: 100 * time.millisecond
Escape_Ambiguity_Timeout :: 25 * time.millisecond
Scrollbar_Initial_Repeat :: 350 * time.millisecond
Scrollbar_Repeat_Interval :: 50 * time.millisecond
Double_Click_Interval :: 500 * time.millisecond

Window_Editor :: 0
Window_Open_Documents :: 1
Window_Find :: 2
Window_Quit :: 3
Window_Diagnostics :: 4
Window_Packages :: 5
Window_Declarations :: 6
Window_References :: 7
Window_Effects :: 8
Window_Denials :: 9
Window_File_Browser :: 10
Window_Workspace_Confirm :: 11
Window_Replace :: 12
Window_Go_To_Line :: 13
Window_Shortcut_Help :: 14
Window_Compiler_Options :: 15
Window_Run_Configuration :: 16
Window_Close_Document :: 17
Window_About :: 18
Window_Workspace_Files :: 19
Window_Build_Output :: 20
Window_Count :: 21

// File_Browser_Mode gives one reusable directory browser three exact commit
// operations. The browser itself owns only path navigation and selection;
// command code decides whether the chosen path opens a document, becomes a
// document's new pathname, or replaces the active compiler workspace.
File_Browser_Mode :: enum u8 {
    open_file,
    save_as,
    open_workspace,
}

// Workspace_Transition records the operation waiting behind the dirty-document
// confirmation dialog. `none` is the only valid idle state. open_file retains
// the selected file path while the compiler session is transactionally moved
// to that file's natural package/workspace scope.
Workspace_Transition :: enum u8 {
    none,
    open_workspace,
    open_file,
    close_workspace,
}

// Agent_Action is an explicit event-loop request, never a Build mode. Resolve
// may change target-scoped generated-source pins and Judge may record evidence,
// so those two save current root source before queuing. expand_comment instead
// returns unsaved editor bytes and starts the one Comment_Expansion_Job after
// its pending frame is visible. Resolve and Judge remain synchronous; comment
// expansion alone keeps the terminal loop responsive through an owned worker.
Agent_Action :: enum u8 {
    none,
    expand_comment,
    resolve,
    judge_claims,
}

Menu_File :: 520
Menu_File_Popup :: 521
Menu_Edit :: 522
Menu_Edit_Popup :: 523
Menu_Compile :: 524
Menu_Compile_Popup :: 525
Menu_Run :: 526
Menu_Run_Popup :: 527
Menu_Window :: 528
Menu_Window_Popup :: 529
Menu_Help :: 530
Menu_Help_Popup :: 531

// Shortcut_Row_Count is the complete authored keyboard reference shown by the
// Help window. The rows deliberately include editor movement and desktop
// manipulation in addition to menu accelerators: these commands are otherwise
// discoverable only by experimenting with a terminal keyboard. shortcut_row
// below is the single text source for the visible table and its coverage test.
Shortcut_Row_Count :: 51

// Only the four immutable semantic reports share the tooling-text table.
// Diagnostics are structured activatable rows, and Build Output has a distinct
// lifetime: both are results of the latest operation rather than projections
// of the retained last-good compiler graph.
Text_Window_First :: Window_Declarations
Text_Window_Count :: 4
Tooling_Text_Capacity :: 32768
Build_Output_Capacity :: 32768
Diagnostic_Row_Text_Capacity :: 1024
Compiler_Configuration_Capacity :: 32768
Session_Summary_Capacity :: 1024
Host_Path_Capacity :: 4096
Browser_Name_Capacity :: 1024
Browser_Entry_Name_Capacity :: 1024
Maximum_Browser_Entries :: 512
Maximum_Run_Arguments :: 64
Maximum_Run_Environment :: 64
Run_Value_Capacity :: 1024

Maximum_Syntax_Spans :: 4096
Maximum_Root_Packages :: 64
Maximum_Reachable_Sources :: 512
Root_Package_Name_Capacity :: 512
Root_Package_Overflow_Label :: "<root-package path exceeds IDE display limit>"
Reachable_Source_Copy_Capacity :: 4096
Maximum_Package_Rows :: 512
Package_Row_Text_Capacity :: 512
Package_Row_Overflow_Label :: "<package row exceeds IDE display limit>"
Maximum_Navigation_Rows :: 512
Maximum_Navigation_History :: 64

// Package_Tree_Row keeps the compiler's fixed structural record beside the
// Draft-owned display bytes. The parallel package_nodes table is contiguous so
// turbo_ui can borrow it directly; corresponding indices always describe the
// same service row.
Package_Tree_Row :: struct {
    info: draft_compiler_api.Package_Row,
    text: [Package_Row_Text_Capacity]u8,
    length: usize,
}

// Navigation_Target is an application-owned stable source destination. The
// compiler's source index is intentionally absent: a later successful check may
// replace the complete graph and reuse that process-local number. Copying path
// and exact byte range lets the Usages window and Back/Forward history remain
// valid across those checks. path is explicitly destroyed when its owning row
// or history suffix is replaced.
Navigation_Target :: struct {
    path: memory.Owned_String,
    start: usize,
    end: usize,
    line: usize,
    column: usize,
    editable: bool,
}

// App owns every persistent document and window value. Buffer owns independent
// zero-terminated pathname copies for file operations; source-list names and
// paths are separate copies of compiler-service rows.
App :: struct {
    ui: turbo_ui.State,
    menus: turbo_ui.Menu_State,
    buffers: [Maximum_Buffers]turbo_editor.Buffer,
    buffer_count: usize,
    active: usize,
    buffer_root: [Maximum_Buffers]usize,
    buffer_has_root: [Maximum_Buffers]bool,

    windows: [Window_Count]turbo_ui.Window_State,
    open_documents: turbo_ui.List_State,
    shortcut_list: turbo_ui.List_State,
    navigation_list: turbo_ui.List_State,
    diagnostics: turbo_ui.List_State,

    search: [Search_Capacity]u8,
    search_box: turbo_ui.Text_Box_State,
    replacement: [Replacement_Capacity]u8,
    replacement_box: turbo_ui.Text_Box_State,
    go_line: [Go_Line_Capacity]u8,
    go_line_box: turbo_ui.Text_Box_State,
    browser_location: [Host_Path_Capacity]u8,
    browser_location_box: turbo_ui.Text_Box_State,
    browser_name: [Browser_Name_Capacity]u8,
    browser_name_box: turbo_ui.Text_Box_State,
    browser_entry_names: [Maximum_Browser_Entries]memory.Owned_String,
    browser_entry_kind: [Maximum_Browser_Entries]filesystem.Entry_Kind,
    browser_entry_count: usize,
    browser_list: turbo_ui.List_State,
    browser_mode: File_Browser_Mode,
    // Workspace Files owns a second directory snapshot so opening a modal
    // Open/Save dialog cannot move or replace the persistent browser. root is
    // the compiler-published workspace boundary; both lengths are zero without
    // a compiler session, and location is otherwise kept lexically at or below
    // root. Entry names are independent owners because native enumeration
    // storage expires on the next filesystem.read call. truncated makes the
    // bounded current-directory prefix explicit in both state and presentation.
    workspace_files_root: [Host_Path_Capacity]u8,
    workspace_files_root_length: usize,
    workspace_files_location: [Host_Path_Capacity]u8,
    workspace_files_location_length: usize,
    workspace_file_entry_names:
        [Maximum_Browser_Entries]memory.Owned_String,
    workspace_file_entry_kind:
        [Maximum_Browser_Entries]filesystem.Entry_Kind,
    workspace_file_entry_count: usize,
    workspace_files_truncated: bool,
    workspace_files_list: turbo_ui.List_State,
    workspace_error: [512]u8,
    workspace_error_length: usize,
    pending_workspace_path: [Host_Path_Capacity]u8,
    pending_workspace_length: usize,
    pending_file_path: [Host_Path_Capacity]u8,
    pending_file_length: usize,
    pending_workspace_transition: Workspace_Transition,
    confirming_scope_change: bool,
    workspace_open: bool,
    unnamed_count: usize,
    status: string,
    status_storage: [Status_Capacity]u8,
    status_length: usize,
    status_bytes_active: bool,

    host: draft_compiler_api.Host_Api,
    syntax_spans: [Maximum_Syntax_Spans]turbo_editor.Syntax_Span,
    syntax_span_count: usize,
    diagnostic_count: u32,
    diagnostic_row_count: usize,
    // semantic_dirty means at least one open active-root file has changed
    // since the latest complete compiler transaction. Lexical coloring remains
    // current while this bit is set, but diagnostics and semantic tooling are
    // deliberately retained as the last explicit Check/Build/Run result.
    semantic_dirty: bool,
    tooling_text: [Text_Window_Count][Tooling_Text_Capacity]u8,
    tooling_length: [Text_Window_Count]usize,
    tooling_views: [Text_Window_Count]turbo_ui.Text_View_State,
    build_output: [Build_Output_Capacity]u8,
    build_output_length: usize,
    build_output_view: turbo_ui.Text_View_State,
    compiler_configuration: [Compiler_Configuration_Capacity]u8,
    compiler_configuration_length: usize,
    compiler_configuration_view: turbo_ui.Text_View_State,
    session_summary: [Session_Summary_Capacity]u8,
    session_summary_length: usize,
    root_package_names: [Maximum_Root_Packages][Root_Package_Name_Capacity]u8,
    root_package_length: [Maximum_Root_Packages]usize,
    root_package_count: usize,
    root_packages: turbo_ui.List_State,
    selected_target: usize,
    package_rows: [Maximum_Package_Rows]Package_Tree_Row,
    package_nodes: [Maximum_Package_Rows]turbo_ui.Tree_Node,
    package_row_count: usize,
    package_tree: turbo_ui.List_State,
    package_expanded: [Maximum_Package_Rows]bool,
    package_seen: [Maximum_Package_Rows]bool,
    navigation_rows: [Maximum_Navigation_Rows]Navigation_Target,
    navigation_row_count: usize,
    navigation_history: [Maximum_Navigation_History]Navigation_Target,
    navigation_history_count: usize,
    // navigation_history_index names the currently displayed entry whenever
    // history_count is nonzero. A new semantic jump discards only the forward
    // suffix, exactly like a browser, then appends current and destination.
    navigation_history_index: usize,
    semantic_usages_visible: bool,
    // Reachable-source rows are compiler-discovered ordinary files reachable from
    // the active root package.
    // Each label/path owner is independent because C ABI copy operations
    // return variable-length bytes that cannot borrow compiler storage.
    reachable_source_names: [Maximum_Reachable_Sources]memory.Owned_String,
    reachable_source_paths: [Maximum_Reachable_Sources]memory.Owned_String,
    reachable_source_count: usize,
    // Run configuration rows are exact values, not shell text. Each argument
    // and NAME=value environment override occupies one bounded UTF-8 field;
    // the working directory is a separate pathname. The selected-root ordinal
    // pairs overrides with the root whose defaults they replaced.
    run_argument_storage: [Maximum_Run_Arguments][Run_Value_Capacity]u8,
    run_argument_length: [Maximum_Run_Arguments]usize,
    run_argument_count: usize,
    run_arguments: turbo_ui.List_State,
    run_argument_edit: [Run_Value_Capacity]u8,
    run_argument_box: turbo_ui.Text_Box_State,
    run_environment_storage: [Maximum_Run_Environment][Run_Value_Capacity]u8,
    run_environment_length: [Maximum_Run_Environment]usize,
    run_environment_count: usize,
    run_environment: turbo_ui.List_State,
    run_environment_edit: [Run_Value_Capacity]u8,
    run_environment_box: turbo_ui.Text_Box_State,
    run_working_directory: [Host_Path_Capacity]u8,
    run_working_directory_box: turbo_ui.Text_Box_State,
    run_configuration_root: usize,
    run_configuration_loaded: bool,
    run_configuration_overridden: bool,
    run_requested: bool,
    pending_agent_action: Agent_Action,
    // comment_expansion_job is the sole cross-thread application record. The
    // host-integration module owns its snapshots and atomic phase; the terminal
    // loop merely quiesces editor/host interaction until it can join the worker.
    comment_expansion_job: Comment_Expansion_Job,
    quit_discard_mask: u64,
    // clipboard is an IDE-local byte clipboard. Bracketed terminal paste still
    // enters as text events; this owner gives Cut/Copy/Paste deterministic
    // behavior without depending on a desktop clipboard or SSH forwarding.
    clipboard: array.Dynamic[u8],
}

init_windows :: proc(app: ^App) {
    array.init(&app.clipboard)
    comment_expansion_job_init(&app.comment_expansion_job)
    // The document is an ordinary desktop window rather than a privileged
    // background layer. Its content remains the reusable turbo_editor view;
    // only this application decides that the view is closable, zoomable, and
    // eligible for Tile/Cascade beside semantic windows.
    app.windows[Window_Editor] = turbo_ui.window_init(
        399,
        turbo_ui.Rect{column = 1, row = 1, width = 86, height = 26},
        1,
    )
    // Preserve the old full-desktop editing area on first launch while still
    // giving the editor real chrome and an ordinary restore rectangle. The
    // first Tile/Cascade operation leaves zoom and arranges it normally.
    app.windows[Window_Editor].zoomed = true
    app.windows[Window_Editor].focus_id = Editor_Body_Id_Base
    app.windows[Window_Open_Documents] = turbo_ui.tool_window_init(
        401,
        turbo_ui.Rect{column = 18, row = 5, width = 34, height = 13},
        3,
    )
    app.windows[Window_Find] = turbo_ui.dialog_window_init(
        402,
        turbo_ui.Rect{column = 20, row = 7, width = 44, height = 6},
        10,
    )
    app.windows[Window_Quit] = turbo_ui.dialog_window_init(
        403,
        // The conflict-specific overwrite question is wider than the ordinary
        // dirty-document prompt and must remain complete at 80 columns.
        turbo_ui.Rect{column = 13, row = 7, width = 54, height = 6},
        11,
    )
    app.windows[Window_Diagnostics] = turbo_ui.window_init(
        404,
        turbo_ui.Rect{column = 4, row = 4, width = 76, height = 17},
        5,
    )
    app.windows[Window_Packages] = turbo_ui.window_init(
        405,
        turbo_ui.Rect{column = 3, row = 2, width = 82, height = 25},
        4,
    )
    app.windows[Window_Declarations] = turbo_ui.window_init(
        406,
        turbo_ui.Rect{column = 8, row = 4, width = 70, height = 19},
        4,
    )
    app.windows[Window_References] = turbo_ui.window_init(
        407,
        turbo_ui.Rect{column = 10, row = 5, width = 72, height = 19},
        4,
    )
    app.windows[Window_Effects] = turbo_ui.window_init(
        408,
        turbo_ui.Rect{column = 12, row = 6, width = 68, height = 17},
        4,
    )
    app.windows[Window_Denials] = turbo_ui.window_init(
        409,
        turbo_ui.Rect{column = 14, row = 7, width = 64, height = 15},
        4,
    )
    app.windows[Window_File_Browser] = turbo_ui.dialog_window_init(
        410,
        turbo_ui.Rect{column = 6, row = 2, width = 82, height = 22},
        12,
    )
    app.windows[Window_Workspace_Confirm] = turbo_ui.dialog_window_init(
        411,
        // The scope-change question is the longest confirmation sentence.
        // Seventy inner columns preserve it verbatim on the conventional
        // 80-column terminal instead of hiding the actual choice at the edge.
        turbo_ui.Rect{column = 4, row = 7, width = 72, height = 6},
        13,
    )
    app.windows[Window_Replace] = turbo_ui.dialog_window_init(
        412,
        turbo_ui.Rect{column = 14, row = 5, width = 60, height = 8},
        14,
    )
    app.windows[Window_Go_To_Line] = turbo_ui.dialog_window_init(
        413,
        turbo_ui.Rect{column = 22, row = 8, width = 38, height = 6},
        15,
    )
    app.windows[Window_Shortcut_Help] = turbo_ui.dialog_window_init(
        414,
        turbo_ui.Rect{column = 10, row = 1, width = 70, height = 22},
        16,
    )
    app.windows[Window_Compiler_Options] = turbo_ui.window_init(
        415,
        turbo_ui.Rect{column = 7, row = 3, width = 82, height = 25},
        4,
    )
    app.windows[Window_Run_Configuration] = turbo_ui.dialog_window_init(
        416,
        turbo_ui.Rect{column = 5, row = 2, width = 86, height = 20},
        18,
    )
    app.windows[Window_Close_Document] = turbo_ui.dialog_window_init(
        417,
        turbo_ui.Rect{column = 20, row = 8, width = 52, height = 6},
        19,
    )
    app.windows[Window_About] = turbo_ui.dialog_window_init(
        418,
        turbo_ui.Rect{column = 18, row = 7, width = 62, height = 11},
        20,
    )
    app.windows[Window_Workspace_Files] = turbo_ui.tool_window_init(
        419,
        turbo_ui.Rect{column = 2, row = 2, width = 40, height = 22},
        850,
    )
    app.windows[Window_Build_Output] = turbo_ui.window_init(
        420,
        turbo_ui.Rect{column = 6, row = 5, width = 78, height = 18},
        4,
    )
    app.windows[Window_Open_Documents].visible = false
    app.windows[Window_Find].visible = false
    app.windows[Window_Quit].visible = false
    for index: usize = Window_Diagnostics; index < Window_Count; index += 1 {
        app.windows[index].visible = false
    }
}

// shortcut_row returns one stable key/action pair for the Help window. A
// switch is intentionally used instead of parallel global arrays: it keeps the
// table immutable, allocation-free, and impossible to index with mismatched
// key and description counts. Rows are grouped in the order users normally
// need them—discovery, editing, semantic navigation, build, desktop, movement.
shortcut_row :: proc(index: usize) -> (string, string) {
    switch index {
    case 0:
        return ("F1", "Open this keyboard shortcut reference")
    case 1:
        return ("Ctrl-N", "Create a new in-memory document")
    case 2:
        return ("Ctrl-O", "Browse for a file")
    case 3:
        return ("Ctrl-W", "Close the active document")
    case 4:
        return ("Ctrl-S / F2", "Save the active document")
    case 5:
        return ("Alt-F, A", "Save the active document with a new path")
    case 6:
        return ("Alt-0", "Show all open documents")
    case 7:
        return ("Ctrl-Z", "Undo one editing operation")
    case 8:
        return ("Ctrl-Y", "Redo one editing operation")
    case 9:
        return ("Ctrl-X / Ctrl-C", "Cut / copy to the IDE clipboard")
    case 10:
        return ("Ctrl-V / Delete", "Paste / delete the selection")
    case 11:
        return ("Ctrl-A", "Select the complete document")
    case 12:
        return ("Ctrl-F", "Open Find")
    case 13:
        return ("F3 / Shift-F3", "Find next / previous")
    case 14:
        return ("Ctrl-R", "Open Replace")
    case 15:
        return ("F4", "Replace current match and find next")
    case 16:
        return ("Ctrl-G", "Go to a one-based line number")
    case 17:
        return ("F12 / Shift-F12", "Go to definition / find usages")
    case 18:
        return ("Alt-Left / Alt-Right", "Go back / forward in navigation")
    case 19:
        return ("F6", "Open Compiler Options")
    case 20:
        return ("Alt-F9", "Check the active root package")
    case 21:
        return ("F9", "Build the active root package")
    case 22:
        return ("F5", "Build and run the active root package")
    case 23:
        return ("F8", "Show current diagnostics")
    case 24:
        return ("Ctrl-F6", "Activate the next desktop window")
    case 25:
        return ("Ctrl-Shift-F6", "Activate the previous desktop window")
    case 26:
        return ("Ctrl-F5", "Enter keyboard move/size mode")
    case 27:
        return ("Alt-F3", "Close the active window")
    case 28:
        return ("Alt-F", "Open the File menu")
    case 29:
        return ("Alt-E", "Open the Edit menu")
    case 30:
        return ("Alt-C", "Open the Compile menu")
    case 31:
        return ("Alt-R", "Open the Run menu")
    case 32:
        return ("Alt-W", "Open the Window menu")
    case 33:
        return ("Alt-H", "Open the Help menu")
    case 34:
        return ("Alt-X", "Exit DraftIDE")
    case 35:
        return ("Home / End", "Move to the start / end of the line")
    case 36:
        return ("Ctrl-Home / Ctrl-End", "Move to the start / end of the file")
    case 37:
        return ("Ctrl-Left / Ctrl-Right", "Move by word")
    case 38:
        return ("Shift + movement", "Extend the editor selection")
    case 39:
        return ("Page Up / Down", "Move by the visible editor page")
    case 40:
        return ("Tab", "Insert a tab; move focus inside a dialog")
    case 41:
        return ("Backspace / Delete", "Delete before / after the cursor")
    case 42:
        return ("Esc", "Cancel the current menu, dialog, or operation")
    case 43:
        return ("Enter", "Activate the focused default action")
    case 44:
        return ("Space", "Activate the focused control")
    case 45:
        return ("Arrows", "Move in lists, menus, and editor text")
    case 46:
        return ("Alt + underlined key", "Activate a visible menu or button")
    case 47:
        return ("Mouse wheel", "Scroll the window beneath the pointer")
    case 48:
        return ("Enter", "Open a selected file or enter a directory")
    case 49:
        return ("Drag title / border", "Move or resize an ordinary window")
    case 50:
        return ("Ctrl-E", "Expand the contiguous //? prompt under the cursor")
    case:
        assert(false, "shortcut help row index is outside the authored table")
        return ("", "")
    }
}

init_one_buffer :: proc(app: ^App, path: string) -> bool {
    if app.buffer_count == Maximum_Buffers {
        return false
    }
    index := app.buffer_count
    turbo_editor.buffer_init(&app.buffers[index], path)
    load_result := turbo_editor.load(&app.buffers[index])
    if load_result == .failed {
        turbo_editor.buffer_destroy(&app.buffers[index])
        return false
    }
    app.buffer_count += 1
    return true
}

init_one_buffer_bytes :: proc(app: ^App, path: []u8) -> bool {
    if app.buffer_count == Maximum_Buffers {
        return false
    }
    index := app.buffer_count
    turbo_editor.buffer_init_bytes(&app.buffers[index], path)
    load_result := turbo_editor.load(&app.buffers[index])
    if load_result == .failed {
        turbo_editor.buffer_destroy(&app.buffers[index])
        return false
    }
    app.buffer_count += 1
    return true
}

// init_one_unnamed_buffer appends an in-memory document with a stable display
// label but no filesystem authority. Save routes it through Save As; Exit
// treats its initial dirty bit exactly like authored content.
init_one_unnamed_buffer :: proc(app: ^App) -> bool {
    if app.buffer_count == Maximum_Buffers {
        return false
    }
    app.unnamed_count += 1
    storage: [64]u8
    prefix := "Untitled "
    length: usize
    for index: usize = 0; index < len(prefix); index += 1 {
        storage[length] = prefix[index]
        length += 1
    }
    digits_storage: [20]u8
    (digits, valid) := format.unsigned_decimal(
        digits_storage[:],
        cast[u64](app.unnamed_count),
    )
    if !valid || length + len(digits) > len(storage) {
        return false
    }
    for byte in digits {
        storage[length] = byte
        length += 1
    }
    turbo_editor.buffer_init_unnamed(
        &app.buffers[app.buffer_count],
        storage[:length],
    )
    app.buffer_count += 1
    return true
}

// init_one_read_only_buffer copies one compiler-distributed source into the
// ordinary document table without claiming a filesystem owner. The source can
// therefore participate in the same editor, selection, and navigation code,
// while turbo_editor itself enforces the no-mutation contract beneath every UI
// command.
init_one_read_only_buffer :: proc(
    app: ^App,
    path, source: []u8,
) -> bool {
    if app.buffer_count == Maximum_Buffers {
        return false
    }
    index := app.buffer_count
    turbo_editor.buffer_init_read_only_bytes(
        &app.buffers[index],
        path,
        source,
    )
    app.buffer_count += 1
    return true
}

init_app :: proc(app: ^App) -> bool {
    init_windows(app)
    arguments := os.args()
    if len(arguments) <= 1 {
        if !init_one_unnamed_buffer(app) {
            return false
        }
    } else {
        for index: usize = 1; index < len(arguments) &&
            app.buffer_count < Maximum_Buffers; index += 1 {
            if !init_one_buffer(app, arguments[index]) {
                return false
            }
        }
    }
    app.status = "F1 Help  F2 Save  F5 Run  F6 Compiler Options  Alt-X Exit"
    return app.buffer_count != 0
}

// destroy_workspace_documents releases every dynamic owner whose identity is
// tied to the currently open Workspace. Open Workspace uses this narrower
// lifetime boundary so the IDE-local clipboard and window interaction state
// survive, while final application destruction follows it with the remaining
// process-lifetime owners.
destroy_workspace_documents :: proc(app: ^App) {
    for index: usize = 0; index < app.buffer_count; index += 1 {
        turbo_editor.buffer_destroy(&app.buffers[index])
    }
    app.buffer_count = 0
    for index: usize = 0; index < app.reachable_source_count; index += 1 {
        memory.owned_string_destroy(&app.reachable_source_names[index])
        memory.owned_string_destroy(&app.reachable_source_paths[index])
    }
    app.reachable_source_count = 0
    clear_workspace_file_entries(app)
    app.workspace_files_root_length = 0
    app.workspace_files_location_length = 0
    for index: usize = 0; index < app.navigation_row_count; index += 1 {
        memory.owned_string_destroy(&app.navigation_rows[index].path)
    }
    app.navigation_row_count = 0
    for index: usize = 0;
        index < app.navigation_history_count;
        index += 1 {
        memory.owned_string_destroy(&app.navigation_history[index].path)
    }
    app.navigation_history_count = 0
}

// destroy_app is the final balanced counterpart to init_windows/init_app. It
// may run after partial document initialization; every counted owner is valid,
// and no application operation may observe App afterward.
destroy_app :: proc(app: ^App) {
    // The compiler worker borrows App and the externally owned host session,
    // so it must stop before any document or application-owned byte storage is
    // released. Normal interactive flow has already completed it; this join is
    // the teardown guarantee for terminal EOF and partial initialization paths.
    comment_expansion_job_destroy(&app.comment_expansion_job)
    destroy_workspace_documents(app)
    for index: usize = 0; index < app.browser_entry_count; index += 1 {
        memory.owned_string_destroy(&app.browser_entry_names[index])
    }
    app.browser_entry_count = 0
    array.destroy(&app.clipboard)
}

active_buffer :: proc(app: ^App) -> ^turbo_editor.Buffer {
    assert(app.active < app.buffer_count, "active editor buffer is invalid")
    return &app.buffers[app.active]
}

// activate_buffer preserves the compiler-source invariant before exposing an
// older editor buffer. Files opened by root switching remember the service
// root which selected their pathname. Re-selecting that buffer first restores
// the same compiler root; otherwise a later check or F5 could submit one root's
// bytes as another root's active source file.
activate_buffer :: proc(app: ^App, index: usize) -> bool {
    if index >= app.buffer_count {
        return false
    }
    root_changed := false
    if app.host.select_root != nil && app.host.selected_root != nil &&
        app.buffer_has_root[index] {
        current := app.host.selected_root(app.host.user)
        required := app.buffer_root[index]
        if current != required {
            if app.host.select_root(app.host.user, required) == 0 {
                return false
            }
            refresh_root_packages(app)
            refresh_reachable_sources(app)
            root_changed = true
        }
    }
    app.active = index
    app.open_documents.cursor = index
    editor_focus := cast[turbo_ui.Widget_Id](Editor_Body_Id_Base + app.active)
    app.windows[Window_Editor].focus_id = editor_focus
    turbo_ui.show_window(
        &app.ui,
        app.windows[:],
        app.windows[Window_Editor].id,
    )
    app.ui.focused_id = editor_focus
    if turbo_editor.is_read_only(&app.buffers[index]) {
        // Syntax spans are tied to the exact active overlay of the latest host
        // check. A compiler-distributed source is not an editable overlay, so
        // retaining the previous buffer's spans would color unrelated offsets.
        app.syntax_span_count = 0
    } else if app.host.colorize != nil {
        refresh_syntax(app)
    }
    if root_changed {
        // Root selection invalidates the retained checked graph, but opening a
        // document should still remain a lexical-only foreground operation.
        // Refresh copied configuration now and defer semantics until an
        // explicit Check/Build/Run/navigation command.
        app.semantic_dirty = true
        refresh_tooling_text(app)
    }
    return true
}

// refresh_reachable_sources copies the compiler's deterministic editable-file
// table for the active root package into Draft ownership. The fixed copy buffer is
// an explicit UI/path bound; an overflowing row stops publication rather than
// retaining a truncated path that could name a different file.
refresh_reachable_sources :: proc(app: ^App) {
    for index: usize = 0; index < app.reachable_source_count; index += 1 {
        memory.owned_string_destroy(&app.reachable_source_names[index])
        memory.owned_string_destroy(&app.reachable_source_paths[index])
    }
    app.reachable_source_count = 0
    if app.host.source_count == nil || app.host.copy_source_name == nil ||
        app.host.copy_source_path_at == nil {
        return
    }
    count := app.host.source_count(app.host.user)
    if count > Maximum_Reachable_Sources {
        count = Maximum_Reachable_Sources
    }
    name_storage: [Reachable_Source_Copy_Capacity]u8
    path_storage: [Reachable_Source_Copy_Capacity]u8
    for index: usize = 0; index < count; index += 1 {
        name_length := app.host.copy_source_name(
            app.host.user,
            index,
            cast[[^]u8](&name_storage[0]),
            len(name_storage),
        )
        path_length := app.host.copy_source_path_at(
            app.host.user,
            index,
            cast[[^]u8](&path_storage[0]),
            len(path_storage),
        )
        if name_length == 0 || name_length >= len(name_storage) ||
            path_length == 0 || path_length >= len(path_storage) {
            break
        }
        memory.owned_string_copy_bytes(
            &app.reachable_source_names[index],
            name_storage[:name_length],
        )
        memory.owned_string_copy_bytes(
            &app.reachable_source_paths[index],
            path_storage[:path_length],
        )
        app.reachable_source_count += 1
    }
}

buffer_in_active_root :: proc(app: ^App, index: usize) -> bool {
    if index >= app.buffer_count {
        return false
    }
    path := turbo_editor.path_bytes(&app.buffers[index])
    for source_index: usize = 0;
        source_index < app.reachable_source_count;
        source_index += 1 {
        if byte_views_equal(
            path,
            memory.owned_string_bytes(&app.reachable_source_paths[source_index]),
        ) {
            return true
        }
    }
    return false
}

// collect_host_overlays snapshots the active buffer plus every other dirty
// buffer belonging to the active checked graph. Clean inactive files remain on
// disk inputs; resubmitting them would make the compiler conservatively
// invalidate packages whose bytes did not change. Documents and path owners
// outlive the synchronous call. active_overlay is an index in this compact
// output table, not the application's buffer table.
collect_host_overlays :: proc(
    app: ^App,
    overlays: []draft_compiler_api.Overlay,
) -> (usize, usize, bool) {
    count: usize
    active_overlay: usize
    found_active := false
    filter_active_root := app.host.source_count != nil
    for index: usize = 0; index < app.buffer_count; index += 1 {
        if index != app.active && !app.buffers[index].dirty {
            continue
        }
        if filter_active_root && !buffer_in_active_root(app, index) {
            continue
        }
        if count == len(overlays) {
            return (0, 0, false)
        }
        buffer := &app.buffers[index]
        path := turbo_editor.path_bytes(buffer)
        path_data: rawptr = nil
        if len(path) != 0 {
            path_data = cast[rawptr](&path[0])
        }
        source_data: rawptr = nil
        if buffer.bytes.length != 0 {
            source_data = cast[rawptr](&buffer.bytes.data[0])
        }
        overlays[count] = draft_compiler_api.Overlay{
            path_data = path_data,
            path_length = len(path),
            source_data = source_data,
            source_length = buffer.bytes.length,
        }
        if index == app.active {
            active_overlay = count
            found_active = true
        }
        count += 1
    }
    return (count, active_overlay, found_active)
}

text_destination :: proc(app: ^App, index: usize) -> [^]u8 {
    assert(index < Text_Window_Count, "tooling text index is invalid")
    return cast[[^]u8](&app.tooling_text[index][0])
}

root_name_destination :: proc(app: ^App, index: usize) -> [^]u8 {
    assert(index < Maximum_Root_Packages, "root-package index is invalid")
    return cast[[^]u8](&app.root_package_names[index][0])
}

package_row_destination :: proc(app: ^App, index: usize) -> [^]u8 {
    assert(index < Maximum_Package_Rows, "package row index is invalid")
    return cast[[^]u8](&app.package_rows[index].text[0])
}

// store_root_package_overflow_label replaces a truncated pathname with complete ASCII
// text. The compiler service reports the full required byte count, so retaining
// its fixed-buffer prefix could split a UTF-8 code point and make the entire
// selector row unpaintable. The semantic root index remains authoritative; this
// label affects only the bounded first-version selector.
store_root_package_overflow_label :: proc(app: ^App, index: usize) {
    for byte_index: usize = 0;
        byte_index < len(Root_Package_Overflow_Label);
        byte_index += 1 {
        app.root_package_names[index][byte_index] =
            Root_Package_Overflow_Label[byte_index]
    }
    app.root_package_length[index] = len(Root_Package_Overflow_Label)
}

// store_package_row_overflow_label avoids retaining a truncated UTF-8 prefix
// when an unusually long semantic identity exceeds the first-version display
// table. The row's fixed structural identity remains intact.
store_package_row_overflow_label :: proc(app: ^App, index: usize) {
    for byte_index: usize = 0;
        byte_index < len(Package_Row_Overflow_Label);
        byte_index += 1 {
        app.package_rows[index].text[byte_index] =
            Package_Row_Overflow_Label[byte_index]
    }
    app.package_rows[index].length = len(Package_Row_Overflow_Label)
}

// refresh_root_packages copies the compiler service's deterministic executable
// root table into Draft-owned UI storage. The fixed table is an explicit first-
// version display limit, not a compiler limit. The Build menu may still cycle
// the service's full count when an unusually large workspace exceeds this view.
refresh_root_packages :: proc(app: ^App) {
    app.root_package_count = 0
    if app.host.target != nil {
        target_value := app.host.target(app.host.user)
        if target_value < 4 {
            app.selected_target = cast[usize](target_value)
        }
    }
    if app.host.root_count == nil || app.host.selected_root == nil ||
        app.host.copy_root_name == nil {
        return
    }
    count := app.host.root_count(app.host.user)
    if count > Maximum_Root_Packages {
        count = Maximum_Root_Packages
    }
    app.root_package_count = count
    selected := app.host.selected_root(app.host.user)
    if selected < count {
        app.root_packages.cursor = selected
    } else {
        app.root_packages.cursor = 0
    }
    for index: usize = 0; index < count; index += 1 {
        required := app.host.copy_root_name(
            app.host.user,
            index,
            root_name_destination(app, index),
            Root_Package_Name_Capacity,
        )
        if required >= Root_Package_Name_Capacity {
            store_root_package_overflow_label(app, index)
        } else {
            app.root_package_length[index] = required
        }
    }
}

// refresh_package_tree copies the compiler-owned structured WorkspaceGraph
// projection into bounded application storage. Expansion is preserved by the
// stable semantic package index across ordinary body edits. A newly observed
// package begins expanded so its authored imports are discoverable without an
// extra gesture. Import rows never retain independent expansion state.
refresh_package_tree :: proc(app: ^App) {
    app.package_row_count = 0
    if app.host.package_row_count == nil || app.host.package_row == nil ||
        app.host.copy_package_row_text == nil {
        return
    }
    count := app.host.package_row_count(app.host.user)
    if count > Maximum_Package_Rows {
        count = Maximum_Package_Rows
    }
    next_seen: [Maximum_Package_Rows]bool
    for index: usize = 0; index < count; index += 1 {
        row := &app.package_rows[index]
        node := &app.package_nodes[index]
        app.host.package_row(app.host.user, index, &row.info)
        node.depth = cast[usize](row.info.depth)
        node.has_children = row.info.has_children != 0
        node.expanded = false
        if row.info.kind == .package_node {
            package_index := row.info.package_index
            if package_index < Maximum_Package_Rows {
                if !app.package_seen[package_index] {
                    app.package_expanded[package_index] = true
                }
                node.expanded = app.package_expanded[package_index]
                next_seen[package_index] = true
            } else {
                // The bounded expansion table is a UI limit only. A package
                // beyond it remains open rather than hiding compiler data that
                // the user has no persistent bit with which to reveal.
                node.expanded = true
            }
        }
        required := app.host.copy_package_row_text(
            app.host.user,
            index,
            package_row_destination(app, index),
            Package_Row_Text_Capacity,
        )
        if required >= Package_Row_Text_Capacity {
            store_package_row_overflow_label(app, index)
        } else {
            row.length = required
        }
    }
    for index: usize = 0; index < Maximum_Package_Rows; index += 1 {
        app.package_seen[index] = next_seen[index]
        if !next_seen[index] {
            app.package_expanded[index] = false
        }
    }
    app.package_row_count = count
}

bind_active_buffer_to_host_root :: proc(app: ^App) {
    if app.active >= app.buffer_count || app.host.selected_root == nil {
        return
    }
    app.buffer_root[app.active] = app.host.selected_root(app.host.user)
    app.buffer_has_root[app.active] = true
}

// refresh_tooling_text copies immutable compiler projections into app-owned
// storage. A larger result is explicitly truncated at a UTF-8-independent byte
// boundary; the compiler sections are currently ASCII except for source paths,
// and paint_text_view reports a malformed final grapheme by simply omitting it.
refresh_tooling_text :: proc(app: ^App) {
    for index: usize = 0; index < Text_Window_Count; index += 1 {
        app.tooling_length[index] = 0
        app.tooling_views[index].offset = 0
    }
    app.compiler_configuration_length = 0
    app.compiler_configuration_view.offset = 0
    app.session_summary_length = 0
    if app.host.copy_build_configuration != nil {
        required := app.host.copy_build_configuration(
            app.host.user,
            cast[[^]u8](&app.compiler_configuration[0]),
            Compiler_Configuration_Capacity,
        )
        if required >= Compiler_Configuration_Capacity {
            required = Compiler_Configuration_Capacity - 1
        }
        app.compiler_configuration_length = required
    }
    if app.host.copy_session_summary != nil {
        required := app.host.copy_session_summary(
            app.host.user,
            cast[[^]u8](&app.session_summary[0]),
            Session_Summary_Capacity,
        )
        if required >= Session_Summary_Capacity {
            required = Session_Summary_Capacity - 1
        }
        app.session_summary_length = required
    }
    app.diagnostic_row_count = 0
    if app.host.diagnostic_row_count != nil {
        app.diagnostic_row_count = app.host.diagnostic_row_count(app.host.user)
        if app.diagnostic_row_count == 0 {
            app.diagnostics.cursor = 0
            app.diagnostics.offset = 0
        } else if app.diagnostics.cursor >= app.diagnostic_row_count {
            app.diagnostics.cursor = app.diagnostic_row_count - 1
        }
    }
    if app.host.copy_tooling == nil {
        refresh_package_tree(app)
        return
    }
    // packages (section zero) is a structured tree. The remaining four
    // sections map directly to Declarations through Denials.
    for section_index: usize = 1; section_index < 5; section_index += 1 {
        destination_index := section_index - 1
        required := app.host.copy_tooling(
            app.host.user,
            cast[u8](section_index),
            text_destination(app, destination_index),
            Tooling_Text_Capacity,
        )
        if required >= Tooling_Text_Capacity {
            required = Tooling_Text_Capacity - 1
        }
        app.tooling_length[destination_index] = required
    }
    refresh_package_tree(app)
}

// copy_syntax_spans transfers the service's latest lexical product into the
// active Buffer's byte domain. The service is allowed to return more ranges
// than this first-version UI retains; invalid or stale ranges are omitted
// rather than clipped into a different token.
copy_syntax_spans :: proc(app: ^App, requested_count: usize) {
    buffer := active_buffer(app)
    count := requested_count
    if count > len(app.syntax_spans) {
        count = len(app.syntax_spans)
    }
    app.syntax_span_count = 0
    if app.host.span == nil {
        return
    }
    for index: usize = 0; index < count; index += 1 {
        host_span: draft_compiler_api.Span
        app.host.span(app.host.user, index, &host_span)
        if host_span.start > host_span.end ||
            host_span.end > buffer.bytes.length ||
            host_span.kind >= turbo_editor.Syntax_Kind_Count {
            continue
        }
        app.syntax_spans[app.syntax_span_count] =
            turbo_editor.Syntax_Span{
                start = host_span.start,
                end = host_span.end,
                kind = cast[turbo_editor.Syntax_Kind](host_span.kind),
            }
        app.syntax_span_count += 1
    }
}

// refresh_syntax runs only the compiler's production lexer for the active
// complete buffer. No workspace discovery, package semantics, diagnostics,
// effects, MIR, or native work may enter this foreground editing operation.
refresh_syntax :: proc(app: ^App) {
    app.syntax_span_count = 0
    if app.host.colorize == nil || turbo_editor.is_read_only(active_buffer(app)) {
        return
    }
    buffer := active_buffer(app)
    path := turbo_editor.path_bytes(buffer)
    path_data: rawptr = nil
    if len(path) != 0 {
        path_data = cast[rawptr](&path[0])
    }
    source_data: rawptr = nil
    if buffer.bytes.length != 0 {
        source_data = cast[rawptr](&buffer.bytes.data[0])
    }
    source := draft_compiler_api.Overlay{
        path_data = path_data,
        path_length = len(path),
        source_data = source_data,
        source_length = buffer.bytes.length,
    }
    result: draft_compiler_api.Syntax_Result
    app.host.colorize(app.host.user, &source, &result)
    if result.success != 0 {
        copy_syntax_spans(app, result.span_count)
    }
}

// source_changed is the complete foreground response to an authored edit. It
// marks semantic products stale, refreshes only lexical styling, and leaves
// the expensive complete transaction to an explicit semantic command.
source_changed :: proc(app: ^App) {
    app.semantic_dirty = true
    refresh_syntax(app)
    app.status = "Modified - Check, Build, or Run refreshes diagnostics"
}

// refresh_host synchronously checks current bytes and replaces syntax spans
// only with ranges returned for that exact attempt. A failed semantic check
// still publishes recovery-lexer colors and diagnostics while the compiler
// service retains its last successful program internally. The return value is
// true only when these exact visible bytes form a complete valid program.
refresh_host :: proc(app: ^App) -> bool {
    if app.host.check == nil {
        app.syntax_span_count = 0
        return false
    }
    overlays: [Maximum_Buffers]draft_compiler_api.Overlay
    (overlay_count, active_overlay, valid_overlays) := collect_host_overlays(
        app,
        overlays[:],
    )
    if !valid_overlays {
        app.syntax_span_count = 0
        app.status = "Active file is not part of the active root package"
        return false
    }
    result: draft_compiler_api.Result
    app.host.check(
        app.host.user,
        &overlays[0],
        overlay_count,
        active_overlay,
        &result,
    )
    app.semantic_dirty = false
    app.diagnostic_count = result.diagnostic_count
    copy_syntax_spans(app, result.span_count)
    begin_result_output(
        app,
        "Check",
        result.success != 0,
        result.elapsed_nanoseconds,
    )
    if result.success != 0 {
        set_timed_status(
            app,
            "Check succeeded in ",
            result.elapsed_nanoseconds,
            "",
        )
    } else {
        set_timed_status(
            app,
            "Check failed in ",
            result.elapsed_nanoseconds,
            "; see Diagnostics",
        )
    }
    // A successful graph may replace one reachable path without changing the
    // row count. Copy the authoritative source set after every explicit
    // semantic transaction; on failure the host retains its last-good set.
    refresh_reachable_sources(app)
    refresh_tooling_text(app)
    if result.success == 0 {
        show_diagnostics(app)
    }
    return result.success != 0
}

// save_active_buffer applies the active document's ordinary save policy and
// publishes one complete status transition for every outcome. Save may be
// reached from the global shortcut, editor request, menu, or another command;
// it therefore cannot rely on a preceding input frame to retire an earlier
// byte-formatted status. Using set_plain_status ensures a successful save
// visibly reports `Saved` instead of leaving the renderer on stale storage.
save_active_buffer :: proc(app: ^App) {
    if turbo_editor.is_read_only(active_buffer(app)) {
        set_plain_status(app, "Compiler and dependency sources are read-only")
    } else if turbo_editor.is_unnamed(active_buffer(app)) {
        request_save_as(app)
    } else if turbo_editor.save(active_buffer(app)) {
        set_plain_status(app, "Saved")
    } else if active_buffer(app).disk_conflict {
        set_plain_status(
            app,
            "Disk conflict: Save refused; Alt-X offers overwrite/discard",
        )
    } else {
        set_plain_status(app, "Save failed")
    }
}

// remove_active_document compacts the explicit buffer table after destroying
// exactly one owner. Moving a Buffer here is by convention: each following
// owner record is copied one slot toward the front, then the vacated final slot
// is zeroed so only the compacted record retains its dynamic allocations. The
// application always keeps at least one document by creating a fresh unnamed
// buffer after closing the final row.
remove_active_document :: proc(app: ^App) -> bool {
    if app.active >= app.buffer_count {
        return false
    }
    removed := app.active
    turbo_editor.buffer_destroy(&app.buffers[removed])
    for index := removed; index + 1 < app.buffer_count; index += 1 {
        app.buffers[index] = app.buffers[index + 1]
        app.buffer_root[index] = app.buffer_root[index + 1]
        app.buffer_has_root[index] = app.buffer_has_root[index + 1]
    }
    last := app.buffer_count - 1
    empty_buffer: turbo_editor.Buffer
    app.buffers[last] = empty_buffer
    app.buffer_root[last] = 0
    app.buffer_has_root[last] = false
    app.buffer_count -= 1
    if app.buffer_count == 0 {
        if !init_one_unnamed_buffer(app) {
            return false
        }
        app.active = 0
    } else if removed >= app.buffer_count {
        app.active = app.buffer_count - 1
    } else {
        app.active = removed
    }
    app.open_documents.cursor = app.active
    return activate_buffer(app, app.active)
}

request_close_document :: proc(app: ^App) {
    if active_buffer(app).dirty {
        turbo_ui.show_modal_window(
            &app.ui,
            app.windows[:],
            app.windows[Window_Close_Document].id,
        )
        app.ui.focused_id = 860
        app.status = "Save, discard, or cancel closing this document"
        return
    }
    if remove_active_document(app) {
        app.status = "Document closed"
    } else {
        app.status = "Could not close the document"
    }
}

save_and_close_document :: proc(app: ^App) {
    if turbo_editor.is_unnamed(active_buffer(app)) {
        request_save_as(app)
        app.status = "Choose a path, then close the document again"
        return
    }
    if !turbo_editor.save(active_buffer(app)) {
        app.status = "Could not save the document; close cancelled"
        return
    }
    turbo_ui.hide_window(
        &app.ui,
        app.windows[:],
        app.windows[Window_Close_Document].id,
    )
    if remove_active_document(app) {
        app.status = "Document saved and closed"
    }
}

discard_and_close_document :: proc(app: ^App) {
    turbo_ui.hide_window(
        &app.ui,
        app.windows[:],
        app.windows[Window_Close_Document].id,
    )
    if remove_active_document(app) {
        app.status = "Document changes discarded"
    }
}

delete_selection_or_forward :: proc(app: ^App) {
    if turbo_editor.is_read_only(active_buffer(app)) {
        app.status = "Compiler and dependency sources are read-only"
        return
    }
    changed := turbo_editor.delete_selection(active_buffer(app))
    if !changed {
        changed = turbo_editor.delete_forward(active_buffer(app))
    }
    if changed {
        source_changed(app)
        app.status = "Deleted"
    } else {
        app.status = "Nothing to delete"
    }
}

new_file :: proc(app: ^App) {
    if !init_one_unnamed_buffer(app) {
        app.status = "Could not create another in-memory document"
        return
    }
    app.active = app.buffer_count - 1
    app.open_documents.cursor = app.active
    app.buffer_has_root[app.active] = false
    if !activate_buffer(app, app.active) {
        app.status = "Could not activate the new document"
        return
    }
    app.status = "New document - use Save As to choose its path"
}

copy_selection :: proc(app: ^App) -> bool {
    buffer := active_buffer(app)
    (start, end, selected) := turbo_editor.selection(buffer)
    if !selected {
        app.status = "Nothing is selected"
        return false
    }
    array.clear(&app.clipboard)
    array.reserve(&app.clipboard, end - start)
    bytes := turbo_editor.content(buffer)
    for index := start; index < end; index += 1 {
        array.append(&app.clipboard, bytes[index])
    }
    app.status = "Copied selection to the IDE clipboard"
    return true
}

cut_selection :: proc(app: ^App) {
    if turbo_editor.is_read_only(active_buffer(app)) {
        app.status = "Compiler and dependency sources are read-only"
        return
    }
    if copy_selection(app) && turbo_editor.delete_selection(active_buffer(app)) {
        source_changed(app)
        app.status = "Cut selection to the IDE clipboard"
    }
}

paste_clipboard :: proc(app: ^App) {
    if turbo_editor.is_read_only(active_buffer(app)) {
        app.status = "Compiler and dependency sources are read-only"
        return
    }
    if app.clipboard.length == 0 {
        app.status = "The IDE clipboard is empty"
        return
    }
    turbo_editor.insert(active_buffer(app), array.view(&app.clipboard))
    source_changed(app)
    app.status = "Pasted from the IDE clipboard"
}

select_all :: proc(app: ^App) {
    turbo_editor.select_all(active_buffer(app))
    focus_editor(app)
    app.status = "Selected the complete document"
}

// undo_active/redo_active are application commands rather than editor-view
// key paths. This makes the advertised shortcuts and Edit menu work while a
// a tool or semantic window has focus, then refreshes compiler
// overlays only
// when document bytes actually changed.
undo_active :: proc(app: ^App) {
    if turbo_editor.is_read_only(active_buffer(app)) {
        app.status = "Compiler and dependency sources are read-only"
    } else if turbo_editor.undo(active_buffer(app)) {
        source_changed(app)
        focus_editor(app)
        app.status = "Undid last edit"
    } else {
        app.status = "Nothing to undo"
    }
}

redo_active :: proc(app: ^App) {
    if turbo_editor.is_read_only(active_buffer(app)) {
        app.status = "Compiler and dependency sources are read-only"
    } else if turbo_editor.redo(active_buffer(app)) {
        source_changed(app)
        focus_editor(app)
        app.status = "Redid last edit"
    } else {
        app.status = "Nothing to redo"
    }
}
