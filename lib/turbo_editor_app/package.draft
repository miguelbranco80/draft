// turbo_editor_app is the reusable full-screen application shell shared by the
// standalone editor example and Turbo Draft. It owns editor buffers, terminal
// resources, immediate-mode desktop/menu state, and the user-facing event loop. An
// optional Host_Api supplies synchronous compiler operations, but this package
// does not know whether those calls enter C++, another Draft package, or a test
// fake. The caller retains the host handle for the complete run.
//
// The package depends only on ordinary core, turbo_ui, and turbo_editor APIs.
// It deliberately contains no compiler foreign declaration: that keeps the
// useful file editor buildable without LLVM or the bootstrap compiler service.
package turbo_editor_app

import core/array
import core/format
import core/io
import core/memory
import core/os
import core/process
import core/terminal
import core/time
import core/tui
import lib/draft_compiler_api
import lib/turbo_editor
import lib/turbo_ui
import lib/turbo_ui_terminal

// Root-package selection keeps dirty files open rather than overwriting them.
// Sixty-four slots cover a workspace with many tools/examples while keeping the
// complete owner table small and fixed; document/history bytes remain dynamic
// allocations rather than inflating App's stack footprint.
Maximum_Buffers :: 64
Search_Capacity :: 128
Replacement_Capacity :: 128
Go_Line_Capacity :: 20
Status_Capacity :: 128
Input_Capacity :: 128
Input_Drain_Batch_Limit :: 32
Maximum_Columns :: 300
Maximum_Rows :: 120
Input_Idle_Timeout :: 100 * time.millisecond
Escape_Ambiguity_Timeout :: 25 * time.millisecond
Scrollbar_Initial_Repeat :: 350 * time.millisecond
Scrollbar_Repeat_Interval :: 50 * time.millisecond

Window_Editor :: 0
Window_Sources :: 1
Window_Buffers :: 2
Window_Search :: 3
Window_Quit :: 4
Window_Diagnostics :: 5
Window_Programs :: 6
Window_Declarations :: 7
Window_References :: 8
Window_Effects :: 9
Window_Denials :: 10
Window_Open_Folder :: 11
Window_Folder_Confirm :: 12
Window_Replace :: 13
Window_Go_To_Line :: 14
Window_Help :: 15
Window_Open_File :: 16
Window_Count :: 17

Menu_File :: 520
Menu_File_Popup :: 521
Menu_Edit :: 522
Menu_Edit_Popup :: 523
Menu_Build :: 524
Menu_Build_Popup :: 525
Menu_Window :: 526
Menu_Window_Popup :: 527
Menu_Help :: 528
Menu_Help_Popup :: 529

// Shortcut_Row_Count is the complete authored keyboard reference shown by the
// Help window. The rows deliberately include editor movement and desktop
// manipulation in addition to menu accelerators: these commands are otherwise
// discoverable only by experimenting with a terminal keyboard. shortcut_row
// below is the single text source for the visible table and its coverage test.
Shortcut_Row_Count :: 41

Text_Window_First :: Window_Diagnostics
Text_Window_Count :: 6
Tooling_Text_Capacity :: 32768
Program_Configuration_Capacity :: 32768
Host_Path_Capacity :: 4096

Maximum_Syntax_Spans :: 4096
Maximum_Program_Roots :: 64
Maximum_Workspace_Sources :: 512
Program_Root_Name_Capacity :: 512
Program_Root_Overflow_Label :: "<Program path exceeds IDE display limit>"
Workspace_Source_Copy_Capacity :: 4096
Maximum_Package_Rows :: 512
Package_Row_Text_Capacity :: 512
Package_Row_Overflow_Label :: "<package row exceeds IDE display limit>"
Maximum_Navigation_Rows :: 512
Maximum_Navigation_History :: 64

// Package_Tree_Row keeps the compiler's fixed structural record beside the
// Draft-owned display bytes. The parallel package_nodes table is contiguous so
// turbo_ui can borrow it directly; corresponding indices always describe the
// same service row.
Package_Tree_Row :: struct {
    info: draft_compiler_api.Package_Row,
    text: [Package_Row_Text_Capacity]u8,
    length: usize,
}

// Navigation_Target is an application-owned stable source destination. The
// compiler's source index is intentionally absent: a later successful check may
// replace the complete graph and reuse that process-local number. Copying path
// and exact byte range lets the Usages window and Back/Forward history remain
// valid across those checks. path is explicitly destroyed when its owning row
// or history suffix is replaced.
Navigation_Target :: struct {
    path: memory.Owned_String,
    start: usize,
    end: usize,
    line: usize,
    column: usize,
    editable: bool,
}

// App owns every persistent document and window value. Buffer owns independent
// zero-terminated pathname copies for file operations; source-list names and
// paths are separate copies of compiler-service rows.
App :: struct {
    ui: turbo_ui.State,
    menus: turbo_ui.Menu_State,
    buffers: [Maximum_Buffers]turbo_editor.Buffer,
    buffer_count: usize,
    active: usize,
    buffer_root: [Maximum_Buffers]usize,
    buffer_has_root: [Maximum_Buffers]bool,

    windows: [Window_Count]turbo_ui.Window_State,
    sources: turbo_ui.List_State,
    buffers_list: turbo_ui.List_State,
    shortcut_list: turbo_ui.List_State,
    navigation_list: turbo_ui.List_State,

    search: [Search_Capacity]u8,
    search_box: turbo_ui.Text_Box_State,
    replacement: [Replacement_Capacity]u8,
    replacement_box: turbo_ui.Text_Box_State,
    go_line: [Go_Line_Capacity]u8,
    go_line_box: turbo_ui.Text_Box_State,
    file_path: [Host_Path_Capacity]u8,
    file_box: turbo_ui.Text_Box_State,
    workspace_path: [Host_Path_Capacity]u8,
    workspace_box: turbo_ui.Text_Box_State,
    workspace_error: [512]u8,
    workspace_error_length: usize,
    status: string,
    status_storage: [Status_Capacity]u8,
    status_length: usize,
    status_bytes_active: bool,

    host: draft_compiler_api.Host_Api,
    syntax_spans: [Maximum_Syntax_Spans]turbo_editor.Syntax_Span,
    syntax_span_count: usize,
    diagnostic_count: u32,
    // semantic_dirty means at least one open workspace buffer has changed
    // since the latest complete compiler transaction. Lexical coloring remains
    // current while this bit is set, but diagnostics and semantic tooling are
    // deliberately retained as the last explicit Check/Build/Run result.
    semantic_dirty: bool,
    tooling_text: [Text_Window_Count][Tooling_Text_Capacity]u8,
    tooling_length: [Text_Window_Count]usize,
    tooling_views: [Text_Window_Count]turbo_ui.Text_View_State,
    program_configuration: [Program_Configuration_Capacity]u8,
    program_configuration_length: usize,
    program_configuration_view: turbo_ui.Text_View_State,
    program_root_names: [Maximum_Program_Roots][Program_Root_Name_Capacity]u8,
    program_root_length: [Maximum_Program_Roots]usize,
    program_root_count: usize,
    program_roots: turbo_ui.List_State,
    package_rows: [Maximum_Package_Rows]Package_Tree_Row,
    package_nodes: [Maximum_Package_Rows]turbo_ui.Tree_Node,
    package_row_count: usize,
    package_tree: turbo_ui.List_State,
    package_expanded: [Maximum_Package_Rows]bool,
    package_seen: [Maximum_Package_Rows]bool,
    navigation_rows: [Maximum_Navigation_Rows]Navigation_Target,
    navigation_row_count: usize,
    navigation_history: [Maximum_Navigation_History]Navigation_Target,
    navigation_history_count: usize,
    // navigation_history_index names the currently displayed entry whenever
    // history_count is nonzero. A new semantic jump discards only the forward
    // suffix, exactly like a browser, then appends current and destination.
    navigation_history_index: usize,
    semantic_usages_visible: bool,
    // Workspace source rows are compiler-discovered ordinary files reachable
    // from the selected root package.
    // Each label/path owner is independent because C ABI copy operations
    // return variable-length bytes that cannot borrow compiler storage.
    workspace_source_names: [Maximum_Workspace_Sources]memory.Owned_String,
    workspace_source_paths: [Maximum_Workspace_Sources]memory.Owned_String,
    workspace_source_count: usize,
    run_requested: bool,
    quit_discard_mask: u64,
}

init_windows :: proc(app: ^App) {
    // The document is an ordinary desktop window rather than a privileged
    // background layer. Its content remains the reusable turbo_editor view;
    // only this application decides that the view is closable, zoomable, and
    // eligible for Tile/Cascade beside semantic windows.
    app^.windows[Window_Editor] = turbo_ui.window_init(
        399,
        turbo_ui.Rect{column = 1, row = 1, width = 86, height = 26},
        1,
    )
    // Preserve the old full-desktop editing area on first launch while still
    // giving the editor real chrome and an ordinary restore rectangle. The
    // first Tile/Cascade operation leaves zoom and arranges it normally.
    app^.windows[Window_Editor].zoomed = true
    app^.windows[Window_Editor].focus_id = 600
    app^.windows[Window_Sources] = turbo_ui.tool_window_init(
        400,
        turbo_ui.Rect{column = 2, row = 3, width = 28, height = 15},
        2,
    )
    app^.windows[Window_Buffers] = turbo_ui.tool_window_init(
        401,
        turbo_ui.Rect{column = 18, row = 5, width = 34, height = 13},
        3,
    )
    app^.windows[Window_Search] = turbo_ui.dialog_window_init(
        402,
        turbo_ui.Rect{column = 20, row = 7, width = 44, height = 7},
        10,
    )
    app^.windows[Window_Quit] = turbo_ui.dialog_window_init(
        403,
        turbo_ui.Rect{column = 20, row = 7, width = 48, height = 8},
        11,
    )
    app^.windows[Window_Diagnostics] = turbo_ui.window_init(
        404,
        turbo_ui.Rect{column = 4, row = 4, width = 76, height = 17},
        5,
    )
    app^.windows[Window_Programs] = turbo_ui.window_init(
        405,
        turbo_ui.Rect{column = 3, row = 2, width = 82, height = 25},
        4,
    )
    app^.windows[Window_Declarations] = turbo_ui.window_init(
        406,
        turbo_ui.Rect{column = 8, row = 4, width = 70, height = 19},
        4,
    )
    app^.windows[Window_References] = turbo_ui.window_init(
        407,
        turbo_ui.Rect{column = 10, row = 5, width = 72, height = 19},
        4,
    )
    app^.windows[Window_Effects] = turbo_ui.window_init(
        408,
        turbo_ui.Rect{column = 12, row = 6, width = 68, height = 17},
        4,
    )
    app^.windows[Window_Denials] = turbo_ui.window_init(
        409,
        turbo_ui.Rect{column = 14, row = 7, width = 64, height = 15},
        4,
    )
    app^.windows[Window_Open_Folder] = turbo_ui.dialog_window_init(
        410,
        turbo_ui.Rect{column = 12, row = 6, width = 66, height = 9},
        12,
    )
    app^.windows[Window_Folder_Confirm] = turbo_ui.dialog_window_init(
        411,
        turbo_ui.Rect{column = 14, row = 7, width = 62, height = 8},
        13,
    )
    app^.windows[Window_Replace] = turbo_ui.dialog_window_init(
        412,
        turbo_ui.Rect{column = 14, row = 5, width = 60, height = 11},
        14,
    )
    app^.windows[Window_Go_To_Line] = turbo_ui.dialog_window_init(
        413,
        turbo_ui.Rect{column = 22, row = 8, width = 38, height = 7},
        15,
    )
    app^.windows[Window_Help] = turbo_ui.dialog_window_init(
        414,
        turbo_ui.Rect{column = 10, row = 3, width = 70, height = 25},
        16,
    )
    app^.windows[Window_Open_File] = turbo_ui.dialog_window_init(
        415,
        turbo_ui.Rect{column = 13, row = 6, width = 64, height = 9},
        17,
    )
    app^.windows[Window_Buffers].visible = false
    app^.windows[Window_Search].visible = false
    app^.windows[Window_Quit].visible = false
    for index: usize = Window_Diagnostics; index < Window_Count; index += 1 {
        app^.windows[index].visible = false
    }
}

// shortcut_row returns one stable key/action pair for the Help window. A
// switch is intentionally used instead of parallel global arrays: it keeps the
// table immutable, allocation-free, and impossible to index with mismatched
// key and description counts. Rows are grouped in the order users normally
// need them—discovery, editing, semantic navigation, build, desktop, movement.
shortcut_row :: proc(index: usize) -> (string, string) {
    switch index {
    case 0:
        return ("F1", "Open this keyboard shortcut reference")
    case 1:
        return ("F2", "Show Workspace Sources")
    case 2:
        return ("Alt-0", "Show open Buffers")
    case 3:
        return ("Ctrl-S", "Save the active buffer")
    case 4:
        return ("Ctrl-Z", "Undo one editing operation")
    case 5:
        return ("Ctrl-Y", "Redo one editing operation")
    case 6:
        return ("Ctrl-F", "Open Find")
    case 7:
        return ("F3", "Find next")
    case 8:
        return ("Shift-F3", "Find previous")
    case 9:
        return ("Ctrl-H", "Open Replace")
    case 10:
        return ("Ctrl-R", "Replace current match and find next")
    case 11:
        return ("Ctrl-G", "Go to a one-based line number")
    case 12:
        return ("F12", "Go to definition")
    case 13:
        return ("Shift-F12", "Find usages")
    case 14:
        return ("Alt-Left", "Go back in semantic navigation history")
    case 15:
        return ("Alt-Right", "Go forward in semantic navigation history")
    case 16:
        return ("F5", "Build and run the selected program")
    case 17:
        return ("F6", "Show Programs & Packages")
    case 18:
        return ("F7", "Show Declarations")
    case 19:
        return ("F8", "Show References and calls")
    case 20:
        return ("F9", "Show Effects")
    case 21:
        return ("F10", "Show Denials")
    case 22:
        return ("F11", "Show Diagnostics")
    case 23:
        return ("Ctrl-F6", "Activate the next desktop window")
    case 24:
        return ("Ctrl-Shift-F6", "Activate the previous desktop window")
    case 25:
        return ("Ctrl-F5", "Enter keyboard move/size mode")
    case 26:
        return ("Alt-F3", "Close the active window")
    case 27:
        return ("Alt-F", "Open the File menu")
    case 28:
        return ("Alt-E", "Open the Edit menu")
    case 29:
        return ("Alt-B", "Open the Build menu")
    case 30:
        return ("Alt-W", "Open the Window menu")
    case 31:
        return ("Alt-H", "Open the Help menu")
    case 32:
        return ("Alt-X", "Quit DraftIDE")
    case 33:
        return ("Home / End", "Move to the start / end of the line")
    case 34:
        return ("Ctrl-Home / End", "Move to the start / end of the file")
    case 35:
        return ("Ctrl-Left / Right", "Move by word")
    case 36:
        return ("Shift + movement", "Extend the editor selection")
    case 37:
        return ("Page Up / Down", "Move by the visible editor page")
    case 38:
        return ("Tab", "Insert a tab; move focus inside a dialog")
    case 39:
        return ("Backspace / Delete", "Delete before / after the cursor")
    case 40:
        return ("Esc", "Cancel the current menu, dialog, or operation")
    case:
        assert(false, "shortcut help row index is outside the authored table")
        return ("", "")
    }
}

init_one_buffer :: proc(app: ^App, path: string) -> bool {
    if app^.buffer_count == Maximum_Buffers {
        return false
    }
    index := app^.buffer_count
    turbo_editor.buffer_init(&app^.buffers[index], path)
    load_result := turbo_editor.load(&app^.buffers[index])
    if load_result == .failed {
        turbo_editor.buffer_destroy(&app^.buffers[index])
        return false
    }
    app^.buffer_count += 1
    return true
}

init_one_buffer_bytes :: proc(app: ^App, path: []u8) -> bool {
    if app^.buffer_count == Maximum_Buffers {
        return false
    }
    index := app^.buffer_count
    turbo_editor.buffer_init_bytes(&app^.buffers[index], path)
    load_result := turbo_editor.load(&app^.buffers[index])
    if load_result == .failed {
        turbo_editor.buffer_destroy(&app^.buffers[index])
        return false
    }
    app^.buffer_count += 1
    return true
}

// init_one_read_only_buffer copies one compiler-distributed source into the
// ordinary document table without claiming a filesystem owner. The source can
// therefore participate in the same editor, selection, and navigation code,
// while turbo_editor itself enforces the no-mutation contract beneath every UI
// command.
init_one_read_only_buffer :: proc(
    app: ^App,
    path, source: []u8,
) -> bool {
    if app^.buffer_count == Maximum_Buffers {
        return false
    }
    index := app^.buffer_count
    turbo_editor.buffer_init_read_only_bytes(
        &app^.buffers[index],
        path,
        source,
    )
    app^.buffer_count += 1
    return true
}

init_app :: proc(app: ^App) -> bool {
    init_windows(app)
    arguments := os.args()
    if len(arguments) <= 1 {
        if !init_one_buffer(app, "untitled.draft") {
            return false
        }
    } else {
        for index: usize = 1; index < len(arguments) &&
            app^.buffer_count < Maximum_Buffers; index += 1 {
            if !init_one_buffer(app, arguments[index]) {
                return false
            }
        }
    }
    app^.status = "F1 Help  F2 Sources  Ctrl-S Save  Ctrl-F Find  Alt-X Quit"
    return app^.buffer_count != 0
}

destroy_app :: proc(app: ^App) {
    for index: usize = 0; index < app^.buffer_count; index += 1 {
        turbo_editor.buffer_destroy(&app^.buffers[index])
    }
    app^.buffer_count = 0
    for index: usize = 0; index < app^.workspace_source_count; index += 1 {
        memory.owned_string_destroy(&app^.workspace_source_names[index])
        memory.owned_string_destroy(&app^.workspace_source_paths[index])
    }
    app^.workspace_source_count = 0
    for index: usize = 0; index < app^.navigation_row_count; index += 1 {
        memory.owned_string_destroy(&app^.navigation_rows[index].path)
    }
    app^.navigation_row_count = 0
    for index: usize = 0;
        index < app^.navigation_history_count;
        index += 1 {
        memory.owned_string_destroy(&app^.navigation_history[index].path)
    }
    app^.navigation_history_count = 0
}

active_buffer :: proc(app: ^App) -> ^turbo_editor.Buffer {
    assert(app^.active < app^.buffer_count, "active editor buffer is invalid")
    return &app^.buffers[app^.active]
}

// activate_buffer preserves the compiler-source invariant before exposing an
// older editor buffer. Buffers opened by root switching remember the service
// root which selected their pathname. Re-selecting that buffer first restores
// the same compiler root; otherwise a later check or F5 could submit one root's
// bytes as another root's active source file.
activate_buffer :: proc(app: ^App, index: usize) -> bool {
    if index >= app^.buffer_count {
        return false
    }
    if app^.host.select_root != nil && app^.host.selected_root != nil &&
        app^.buffer_has_root[index] {
        current := app^.host.selected_root(app^.host.user)
        required := app^.buffer_root[index]
        if current != required {
            if app^.host.select_root(app^.host.user, required) == 0 {
                return false
            }
            refresh_program_roots(app)
            refresh_workspace_sources(app)
        }
    }
    app^.active = index
    app^.buffers_list.cursor = index
    editor_focus := cast[turbo_ui.Widget_Id](600 + app^.active)
    app^.windows[Window_Editor].focus_id = editor_focus
    turbo_ui.show_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Editor].id,
    )
    app^.ui.focused_id = editor_focus
    if turbo_editor.is_read_only(&app^.buffers[index]) {
        // Syntax spans are tied to the exact active overlay of the latest host
        // check. A compiler-distributed source is not an editable overlay, so
        // retaining the previous buffer's spans would color unrelated offsets.
        app^.syntax_span_count = 0
    } else if app^.host.colorize != nil {
        refresh_syntax(app)
    }
    return true
}

// refresh_workspace_sources copies the compiler's deterministic editable-source
// table into Draft ownership. The fixed copy buffer is an explicit UI/path
// bound; an overflowing row stops publication rather than retaining a
// truncated path that could name a different file.
refresh_workspace_sources :: proc(app: ^App) {
    for index: usize = 0; index < app^.workspace_source_count; index += 1 {
        memory.owned_string_destroy(&app^.workspace_source_names[index])
        memory.owned_string_destroy(&app^.workspace_source_paths[index])
    }
    app^.workspace_source_count = 0
    if app^.host.source_count == nil || app^.host.copy_source_name == nil ||
        app^.host.copy_source_path_at == nil {
        return
    }
    count := app^.host.source_count(app^.host.user)
    if count > Maximum_Workspace_Sources {
        count = Maximum_Workspace_Sources
    }
    name_storage: [Workspace_Source_Copy_Capacity]u8
    path_storage: [Workspace_Source_Copy_Capacity]u8
    for index: usize = 0; index < count; index += 1 {
        name_length := app^.host.copy_source_name(
            app^.host.user,
            index,
            cast[[^]u8](&name_storage[0]),
            len(name_storage),
        )
        path_length := app^.host.copy_source_path_at(
            app^.host.user,
            index,
            cast[[^]u8](&path_storage[0]),
            len(path_storage),
        )
        if name_length == 0 || name_length >= len(name_storage) ||
            path_length == 0 || path_length >= len(path_storage) {
            break
        }
        memory.owned_string_copy_bytes(
            &app^.workspace_source_names[index],
            name_storage[:name_length],
        )
        memory.owned_string_copy_bytes(
            &app^.workspace_source_paths[index],
            path_storage[:path_length],
        )
        app^.workspace_source_count += 1
    }
    if app^.sources.cursor >= app^.workspace_source_count {
        app^.sources.cursor = 0
        app^.sources.offset = 0
    }
}

buffer_in_workspace :: proc(app: ^App, index: usize) -> bool {
    if index >= app^.buffer_count {
        return false
    }
    path := turbo_editor.path_bytes(&app^.buffers[index])
    for source_index: usize = 0;
        source_index < app^.workspace_source_count;
        source_index += 1 {
        if byte_views_equal(
            path,
            memory.owned_string_bytes(&app^.workspace_source_paths[source_index]),
        ) {
            return true
        }
    }
    return false
}

// collect_host_overlays snapshots the active buffer plus every other dirty
// buffer belonging to the active checked graph. Clean inactive files remain on
// disk inputs; resubmitting them would make the compiler conservatively
// invalidate packages whose bytes did not change. Buffers and path owners
// outlive the synchronous call. active_overlay is an index in this compact
// output table, not the application's buffer table.
collect_host_overlays :: proc(
    app: ^App,
    overlays: []draft_compiler_api.Overlay,
) -> (usize, usize, bool) {
    count: usize
    active_overlay: usize
    found_active := false
    filter_workspace := app^.host.source_count != nil
    for index: usize = 0; index < app^.buffer_count; index += 1 {
        if index != app^.active && !app^.buffers[index].dirty {
            continue
        }
        if filter_workspace && !buffer_in_workspace(app, index) {
            continue
        }
        if count == len(overlays) {
            return (0, 0, false)
        }
        buffer := &app^.buffers[index]
        path := turbo_editor.path_bytes(buffer)
        path_data: rawptr = nil
        if len(path) != 0 {
            path_data = cast[rawptr](&path[0])
        }
        source_data: rawptr = nil
        if buffer^.bytes.length != 0 {
            source_data = cast[rawptr](&buffer^.bytes.data[0])
        }
        overlays[count] = draft_compiler_api.Overlay{
            path_data = path_data,
            path_length = len(path),
            source_data = source_data,
            source_length = buffer^.bytes.length,
        }
        if index == app^.active {
            active_overlay = count
            found_active = true
        }
        count += 1
    }
    return (count, active_overlay, found_active)
}

text_destination :: proc(app: ^App, index: usize) -> [^]u8 {
    assert(index < Text_Window_Count, "tooling text index is invalid")
    return cast[[^]u8](&app^.tooling_text[index][0])
}

root_name_destination :: proc(app: ^App, index: usize) -> [^]u8 {
    assert(index < Maximum_Program_Roots, "program root index is invalid")
    return cast[[^]u8](&app^.program_root_names[index][0])
}

package_row_destination :: proc(app: ^App, index: usize) -> [^]u8 {
    assert(index < Maximum_Package_Rows, "package row index is invalid")
    return cast[[^]u8](&app^.package_rows[index].text[0])
}

// store_program_root_overflow_label replaces a truncated pathname with complete ASCII
// text. The compiler service reports the full required byte count, so retaining
// its fixed-buffer prefix could split a UTF-8 code point and make the entire
// selector row unpaintable. The semantic root index remains authoritative; this
// label affects only the bounded first-version selector.
store_program_root_overflow_label :: proc(app: ^App, index: usize) {
    for byte_index: usize = 0;
        byte_index < len(Program_Root_Overflow_Label);
        byte_index += 1 {
        app^.program_root_names[index][byte_index] =
            Program_Root_Overflow_Label[byte_index]
    }
    app^.program_root_length[index] = len(Program_Root_Overflow_Label)
}

// store_package_row_overflow_label avoids retaining a truncated UTF-8 prefix
// when an unusually long semantic identity exceeds the first-version display
// table. The row's fixed structural identity remains intact.
store_package_row_overflow_label :: proc(app: ^App, index: usize) {
    for byte_index: usize = 0;
        byte_index < len(Package_Row_Overflow_Label);
        byte_index += 1 {
        app^.package_rows[index].text[byte_index] =
            Package_Row_Overflow_Label[byte_index]
    }
    app^.package_rows[index].length = len(Package_Row_Overflow_Label)
}

// refresh_program_roots copies the compiler service's deterministic executable
// root table into Draft-owned UI storage. The fixed table is an explicit first-
// version display limit, not a compiler limit. The Build menu may still cycle
// the service's full count when an unusually large workspace exceeds this view.
refresh_program_roots :: proc(app: ^App) {
    app^.program_root_count = 0
    if app^.host.root_count == nil || app^.host.selected_root == nil ||
        app^.host.copy_root_name == nil {
        return
    }
    count := app^.host.root_count(app^.host.user)
    if count > Maximum_Program_Roots {
        count = Maximum_Program_Roots
    }
    app^.program_root_count = count
    selected := app^.host.selected_root(app^.host.user)
    if selected < count {
        app^.program_roots.cursor = selected
    } else {
        app^.program_roots.cursor = 0
    }
    for index: usize = 0; index < count; index += 1 {
        required := app^.host.copy_root_name(
            app^.host.user,
            index,
            root_name_destination(app, index),
            Program_Root_Name_Capacity,
        )
        if required >= Program_Root_Name_Capacity {
            store_program_root_overflow_label(app, index)
        } else {
            app^.program_root_length[index] = required
        }
    }
}

// refresh_package_tree copies the compiler-owned structured WorkspaceGraph
// projection into bounded application storage. Expansion is preserved by the
// stable semantic package index across ordinary body edits. A newly observed
// package begins expanded so its authored imports are discoverable without an
// extra gesture. Import rows never retain independent expansion state.
refresh_package_tree :: proc(app: ^App) {
    app^.package_row_count = 0
    if app^.host.package_row_count == nil || app^.host.package_row == nil ||
        app^.host.copy_package_row_text == nil {
        return
    }
    count := app^.host.package_row_count(app^.host.user)
    if count > Maximum_Package_Rows {
        count = Maximum_Package_Rows
    }
    next_seen: [Maximum_Package_Rows]bool
    for index: usize = 0; index < count; index += 1 {
        row := &app^.package_rows[index]
        node := &app^.package_nodes[index]
        app^.host.package_row(app^.host.user, index, &row^.info)
        node^.depth = cast[usize](row^.info.depth)
        node^.has_children = row^.info.has_children != 0
        node^.expanded = false
        if row^.info.kind == .package_node {
            package_index := row^.info.package_index
            if package_index < Maximum_Package_Rows {
                if !app^.package_seen[package_index] {
                    app^.package_expanded[package_index] = true
                }
                node^.expanded = app^.package_expanded[package_index]
                next_seen[package_index] = true
            } else {
                // The bounded expansion table is a UI limit only. A package
                // beyond it remains open rather than hiding compiler data that
                // the user has no persistent bit with which to reveal.
                node^.expanded = true
            }
        }
        required := app^.host.copy_package_row_text(
            app^.host.user,
            index,
            package_row_destination(app, index),
            Package_Row_Text_Capacity,
        )
        if required >= Package_Row_Text_Capacity {
            store_package_row_overflow_label(app, index)
        } else {
            row^.length = required
        }
    }
    for index: usize = 0; index < Maximum_Package_Rows; index += 1 {
        app^.package_seen[index] = next_seen[index]
        if !next_seen[index] {
            app^.package_expanded[index] = false
        }
    }
    app^.package_row_count = count
}

bind_active_buffer_to_host_root :: proc(app: ^App) {
    if app^.active >= app^.buffer_count || app^.host.selected_root == nil {
        return
    }
    app^.buffer_root[app^.active] = app^.host.selected_root(app^.host.user)
    app^.buffer_has_root[app^.active] = true
}

// refresh_tooling_text copies immutable compiler projections into app-owned
// storage. A larger result is explicitly truncated at a UTF-8-independent byte
// boundary; the compiler sections are currently ASCII except for source paths,
// and paint_text_view reports a malformed final grapheme by simply omitting it.
refresh_tooling_text :: proc(app: ^App) {
    for index: usize = 0; index < Text_Window_Count; index += 1 {
        app^.tooling_length[index] = 0
        app^.tooling_views[index].offset = 0
    }
    app^.program_configuration_length = 0
    app^.program_configuration_view.offset = 0
    if app^.host.copy_program_configuration != nil {
        required := app^.host.copy_program_configuration(
            app^.host.user,
            cast[[^]u8](&app^.program_configuration[0]),
            Program_Configuration_Capacity,
        )
        if required >= Program_Configuration_Capacity {
            required = Program_Configuration_Capacity - 1
        }
        app^.program_configuration_length = required
    }
    if app^.host.copy_diagnostics != nil {
        required := app^.host.copy_diagnostics(
            app^.host.user,
            text_destination(app, 0),
            Tooling_Text_Capacity,
        )
        if required >= Tooling_Text_Capacity {
            required = Tooling_Text_Capacity - 1
        }
        app^.tooling_length[0] = required
    }
    if app^.host.copy_tooling == nil {
        refresh_package_tree(app)
        return
    }
    for section_index: usize = 0; section_index < 5; section_index += 1 {
        destination_index := section_index + 1
        required := app^.host.copy_tooling(
            app^.host.user,
            cast[u8](section_index),
            text_destination(app, destination_index),
            Tooling_Text_Capacity,
        )
        if required >= Tooling_Text_Capacity {
            required = Tooling_Text_Capacity - 1
        }
        app^.tooling_length[destination_index] = required
    }
    refresh_package_tree(app)
}

// copy_syntax_spans transfers the service's latest lexical product into the
// active Buffer's byte domain. The service is allowed to return more ranges
// than this first-version UI retains; invalid or stale ranges are omitted
// rather than clipped into a different token.
copy_syntax_spans :: proc(app: ^App, requested_count: usize) {
    buffer := active_buffer(app)
    count := requested_count
    if count > len(app^.syntax_spans) {
        count = len(app^.syntax_spans)
    }
    app^.syntax_span_count = 0
    if app^.host.span == nil {
        return
    }
    for index: usize = 0; index < count; index += 1 {
        host_span: draft_compiler_api.Span
        app^.host.span(app^.host.user, index, &host_span)
        if host_span.start > host_span.end ||
            host_span.end > buffer^.bytes.length ||
            host_span.kind >= turbo_editor.Syntax_Kind_Count {
            continue
        }
        app^.syntax_spans[app^.syntax_span_count] =
            turbo_editor.Syntax_Span{
                start = host_span.start,
                end = host_span.end,
                kind = cast[turbo_editor.Syntax_Kind](host_span.kind),
            }
        app^.syntax_span_count += 1
    }
}

// refresh_syntax runs only the compiler's production lexer for the active
// complete buffer. No workspace discovery, package semantics, diagnostics,
// effects, MIR, or native work may enter this foreground editing operation.
refresh_syntax :: proc(app: ^App) {
    app^.syntax_span_count = 0
    if app^.host.colorize == nil || turbo_editor.is_read_only(active_buffer(app)) {
        return
    }
    buffer := active_buffer(app)
    path := turbo_editor.path_bytes(buffer)
    path_data: rawptr = nil
    if len(path) != 0 {
        path_data = cast[rawptr](&path[0])
    }
    source_data: rawptr = nil
    if buffer^.bytes.length != 0 {
        source_data = cast[rawptr](&buffer^.bytes.data[0])
    }
    source := draft_compiler_api.Overlay{
        path_data = path_data,
        path_length = len(path),
        source_data = source_data,
        source_length = buffer^.bytes.length,
    }
    result: draft_compiler_api.Syntax_Result
    app^.host.colorize(app^.host.user, &source, &result)
    if result.success != 0 {
        copy_syntax_spans(app, result.span_count)
    }
}

// source_changed is the complete foreground response to an authored edit. It
// marks semantic products stale, refreshes only lexical styling, and leaves
// the expensive complete transaction to an explicit semantic command.
source_changed :: proc(app: ^App) {
    app^.semantic_dirty = true
    refresh_syntax(app)
    app^.status = "Modified - Check, Build, or Run refreshes diagnostics"
}

// refresh_host synchronously checks current bytes and replaces syntax spans
// only with ranges returned for that exact attempt. A failed semantic check
// still publishes recovery-lexer colors and diagnostics while the compiler
// service retains its last successful program internally. The return value is
// true only when these exact visible bytes form a complete valid program.
refresh_host :: proc(app: ^App) -> bool {
    if app^.host.check == nil {
        app^.syntax_span_count = 0
        return false
    }
    overlays: [Maximum_Buffers]draft_compiler_api.Overlay
    (overlay_count, active_overlay, valid_overlays) := collect_host_overlays(
        app,
        overlays[:],
    )
    if !valid_overlays {
        app^.syntax_span_count = 0
        app^.status = "Active buffer is not in the checked workspace source graph"
        return false
    }
    result: draft_compiler_api.Result
    app^.host.check(
        app^.host.user,
        &overlays[0],
        overlay_count,
        active_overlay,
        &result,
    )
    app^.semantic_dirty = false
    app^.diagnostic_count = result.diagnostic_count
    copy_syntax_spans(app, result.span_count)
    if result.success != 0 {
        app^.status = "Checked  F6 Programs & Packages  F7-F11 semantic views"
        if app^.host.source_count != nil &&
            app^.host.source_count(app^.host.user) != app^.workspace_source_count {
            refresh_workspace_sources(app)
        }
    } else {
        app^.status = "Check failed: diagnostics retain the last good program"
    }
    refresh_tooling_text(app)
    return result.success != 0
}

// Run_Configuration owns every variable-length service string for one
// synchronous child launch. The cstring arrays are ordinary Dynamic values,
// each built only after its corresponding owner list is complete; the complete
// configuration is not exposed unless every field loads successfully. Each
// string's bytes live in an independent allocation and therefore remain stable
// even if growing an owner array relocates its records.
Run_Configuration :: struct {
    argument_owners: array.Dynamic[memory.Owned_String],
    arguments: array.Dynamic[cstring],
    environment_owners: array.Dynamic[memory.Owned_String],
    environment: array.Dynamic[cstring],
    working_directory: memory.Owned_String,
    has_working_directory: bool,
}

// run_configuration_init establishes all four Dynamic owners before any
// service callback can fail. This makes the one destruction path valid after
// every partial load state.
run_configuration_init :: proc(configuration: ^Run_Configuration) {
    array.init(&configuration^.argument_owners)
    array.init(&configuration^.arguments)
    array.init(&configuration^.environment_owners)
    array.init(&configuration^.environment)
}

// run_configuration_destroy releases all service copies and is valid after a
// partially failed load. No cstring pointer is observed after its owner dies.
run_configuration_destroy :: proc(configuration: ^Run_Configuration) {
    array.destroy(&configuration^.environment)
    for index: usize = 0; index < configuration^.environment_owners.length; index += 1 {
        memory.owned_string_destroy(&configuration^.environment_owners.data[index])
    }
    array.destroy(&configuration^.environment_owners)
    array.destroy(&configuration^.arguments)
    for index: usize = 0; index < configuration^.argument_owners.length; index += 1 {
        memory.owned_string_destroy(&configuration^.argument_owners.data[index])
    }
    array.destroy(&configuration^.argument_owners)
    if configuration^.has_working_directory {
        memory.owned_string_destroy(&configuration^.working_directory)
    }
}

// copy_host_text allocates from the service's reported complete size, then
// verifies that the second call observed the same value. A changed result would
// mean the supposedly synchronous selected configuration mutated mid-copy.
copy_host_text :: proc(
    user: rawptr,
    procedure: draft_compiler_api.Copy_Text_Proc,
    owned: ^memory.Owned_String,
) -> bool {
    length := procedure(user, nil, 0)
    if length == ~cast[usize](0) {
        return false
    }
    storage := cast[[^]u8](memory.allocate(length + 1, 1))
    copied := procedure(user, storage, length + 1)
    if copied != length {
        memory.free_bytes(cast[rawptr](storage), length + 1, 1)
        return false
    }
    memory.owned_string_copy_bytes(owned, storage[:length])
    memory.free_bytes(cast[rawptr](storage), length + 1, 1)
    return true
}

// copy_host_indexed_text is the indexed counterpart to copy_host_text. The
// selected configuration must remain unchanged between the sizing/copy calls.
copy_host_indexed_text :: proc(
    user: rawptr,
    procedure: draft_compiler_api.Copy_Indexed_Text_Proc,
    index: usize,
    owned: ^memory.Owned_String,
) -> bool {
    length := procedure(user, index, nil, 0)
    if length == ~cast[usize](0) {
        return false
    }
    storage := cast[[^]u8](memory.allocate(length + 1, 1))
    copied := procedure(user, index, storage, length + 1)
    if copied != length {
        memory.free_bytes(cast[rawptr](storage), length + 1, 1)
        return false
    }
    memory.owned_string_copy_bytes(owned, storage[:length])
    memory.free_bytes(cast[rawptr](storage), length + 1, 1)
    return true
}

navigation_target_destroy :: proc(target: ^Navigation_Target) {
    memory.owned_string_destroy(&target^.path)
    empty: Navigation_Target
    target^ = empty
}

navigation_target_copy :: proc(
    destination: ^Navigation_Target,
    source: ^Navigation_Target,
) {
    assert(destination^.path.data == nil,
        "navigation destination must be empty before copy")
    memory.owned_string_copy_bytes(
        &destination^.path,
        memory.owned_string_bytes(&source^.path),
    )
    destination^.start = source^.start
    destination^.end = source^.end
    destination^.line = source^.line
    destination^.column = source^.column
    destination^.editable = source^.editable
}

navigation_target_equal :: proc(
    left, right: ^Navigation_Target,
) -> bool {
    return left^.start == right^.start && left^.end == right^.end &&
        byte_views_equal(
            memory.owned_string_bytes(&left^.path),
            memory.owned_string_bytes(&right^.path),
        )
}

clear_navigation_rows :: proc(app: ^App) {
    for index: usize = 0; index < app^.navigation_row_count; index += 1 {
        navigation_target_destroy(&app^.navigation_rows[index])
    }
    app^.navigation_row_count = 0
    app^.navigation_list.cursor = 0
    app^.navigation_list.offset = 0
}

truncate_navigation_history :: proc(app: ^App, count: usize) {
    assert(count <= app^.navigation_history_count,
        "navigation history truncation exceeds its row count")
    for index := count; index < app^.navigation_history_count; index += 1 {
        navigation_target_destroy(&app^.navigation_history[index])
    }
    app^.navigation_history_count = count
    if count == 0 {
        app^.navigation_history_index = 0
    } else if app^.navigation_history_index >= count {
        app^.navigation_history_index = count - 1
    }
}

append_navigation_history :: proc(
    app: ^App,
    target: ^Navigation_Target,
) -> bool {
    if app^.navigation_history_count == Maximum_Navigation_History {
        // History is a convenience, not semantic state. Clearing at the fixed
        // bound keeps ownership and ordering obvious without a pointer-moving
        // ring whose oldest entry is practically unreachable in normal use.
        truncate_navigation_history(app, 0)
    }
    index := app^.navigation_history_count
    navigation_target_copy(&app^.navigation_history[index], target)
    app^.navigation_history_count += 1
    app^.navigation_history_index = index
    return true
}

current_navigation_target :: proc(
    app: ^App,
    target: ^Navigation_Target,
) {
    buffer := active_buffer(app)
    memory.owned_string_copy_bytes(
        &target^.path,
        turbo_editor.path_bytes(buffer),
    )
    target^.start = buffer^.cursor
    target^.end = buffer^.cursor
    target^.editable = !turbo_editor.is_read_only(buffer)
}

// record_navigation_transition applies browser-style history semantics. The
// current cursor is appended only when it differs from the indexed entry; all
// forward entries are destroyed before a new branch is created. Destination is
// copied last and becomes the current history index.
record_navigation_transition :: proc(
    app: ^App,
    destination: ^Navigation_Target,
) {
    if app^.navigation_history_count != 0 {
        truncate_navigation_history(app, app^.navigation_history_index + 1)
    }
    current: Navigation_Target
    current_navigation_target(app, &current)
    needs_current := app^.navigation_history_count == 0 ||
        !navigation_target_equal(
            &app^.navigation_history[app^.navigation_history_count - 1],
            &current,
        )
    needs_destination := !navigation_target_equal(&current, destination)
    required_rows: usize
    if needs_current {
        required_rows += 1
    }
    if needs_destination {
        required_rows += 1
    }
    if app^.navigation_history_count + required_rows >
        Maximum_Navigation_History {
        // Reserve the complete current/destination pair before appending it.
        // Letting append_navigation_history clear between those two writes
        // would strand history at the destination and lose the Back entry.
        truncate_navigation_history(app, 0)
        needs_current = true
    }
    if needs_current {
        _ = append_navigation_history(app, &current)
    }
    navigation_target_destroy(&current)
    if app^.navigation_history_count == 0 ||
        !navigation_target_equal(
            &app^.navigation_history[app^.navigation_history_count - 1],
            destination,
        ) {
        _ = append_navigation_history(app, destination)
    }
}

// target_from_host copies every identity/range fact needed after the compiler
// performs another check. A zero/overflowing pathname is rejected rather than
// retaining a truncated file identity which could navigate to the wrong file.
target_from_host :: proc(
    app: ^App,
    location: draft_compiler_api.Navigation_Location,
    target: ^Navigation_Target,
) -> bool {
    if app^.host.copy_navigation_source_path == nil ||
        app^.host.navigation_source_editable == nil ||
        location.end < location.start {
        return false
    }
    if !copy_host_indexed_text(
        app^.host.user,
        app^.host.copy_navigation_source_path,
        location.source,
        &target^.path,
    ) || target^.path.length == 0 {
        navigation_target_destroy(target)
        return false
    }
    target^.start = location.start
    target^.end = location.end
    target^.line = location.line
    target^.column = location.column
    target^.editable = app^.host.navigation_source_editable(
        app^.host.user,
        location.source,
    ) != 0
    return true
}

buffer_index_for_path :: proc(app: ^App, path: []u8) -> usize {
    for index: usize = 0; index < app^.buffer_count; index += 1 {
        if byte_views_equal(turbo_editor.path_bytes(&app^.buffers[index]), path) {
            return index
        }
    }
    return app^.buffer_count
}

// retain_read_only_navigation_source copies a non-workspace source while its
// compiler FileId is still current. Usage rows retain only stable paths/ranges,
// so pre-opening each unique read-only source prevents a later successful check
// from making an old FileId necessary to display that row.
retain_read_only_navigation_source :: proc(
    app: ^App,
    location: draft_compiler_api.Navigation_Location,
    target: ^Navigation_Target,
) -> bool {
    if target^.editable {
        return true
    }
    path := memory.owned_string_bytes(&target^.path)
    if buffer_index_for_path(app, path) < app^.buffer_count {
        return true
    }
    if app^.host.copy_navigation_source_text == nil {
        return false
    }
    source: memory.Owned_String
    if !copy_host_indexed_text(
        app^.host.user,
        app^.host.copy_navigation_source_text,
        location.source,
        &source,
    ) {
        return false
    }
    opened := init_one_read_only_buffer(
        app,
        path,
        memory.owned_string_bytes(&source),
    )
    memory.owned_string_destroy(&source)
    return opened
}

// open_navigation_target reuses unsaved workspace buffers, loads unopened
// editable files normally, and selects exact source bytes. Read-only sources
// must already have been retained while their host FileId was valid. History is
// recorded only after the destination buffer/range has been validated.
open_navigation_target :: proc(
    app: ^App,
    target: ^Navigation_Target,
    record_history: bool,
) -> bool {
    path := memory.owned_string_bytes(&target^.path)
    index := buffer_index_for_path(app, path)
    if index == app^.buffer_count {
        if !target^.editable || !init_one_buffer_bytes(app, path) {
            return false
        }
        index = app^.buffer_count - 1
        if app^.host.selected_root != nil {
            app^.buffer_root[index] = app^.host.selected_root(app^.host.user)
            app^.buffer_has_root[index] = true
        }
    }
    buffer := &app^.buffers[index]
    if target^.end < target^.start || target^.end > buffer^.bytes.length {
        return false
    }
    if record_history {
        record_navigation_transition(app, target)
    }
    if !activate_buffer(app, index) {
        return false
    }
    buffer = active_buffer(app)
    buffer^.anchor = target^.start
    buffer^.cursor = target^.end
    buffer^.selection_active = target^.end != target^.start
    buffer^.preferred_column_valid = false
    buffer^.reveal_cursor = true
    focus_editor(app)
    return true
}

navigation_status_message :: proc(
    app: ^App,
    status: draft_compiler_api.Navigation_Status,
) {
    switch status {
    case .unavailable:
        app^.status = "Semantic navigation is unavailable"
    case .current_check_failed:
        app^.status = "Fix current check errors before semantic navigation"
    case .source_not_found:
        app^.status = "Active buffer is outside the checked source graph"
    case .no_symbol:
        app^.status = "No symbol at the cursor"
    case .no_definition:
        app^.status = "The selected symbol has no source definition"
    case .ready:
        app^.status = "Semantic navigation ready"
    }
}

prepare_navigation :: proc(app: ^App) -> draft_compiler_api.Navigation_Status {
    if app^.host.prepare_navigation == nil {
        return .unavailable
    }
    // Exact semantic locations cannot be read from the retained last-good
    // graph after an edit. Navigation is an explicit semantic command, so it
    // may pay for one complete check here while ordinary typing never does.
    if app^.semantic_dirty && !refresh_host(app) {
        return .current_check_failed
    }
    buffer := active_buffer(app)
    path := turbo_editor.path_bytes(buffer)
    path_data: rawptr = nil
    if len(path) != 0 {
        path_data = cast[rawptr](&path[0])
    }
    raw_status := app^.host.prepare_navigation(
        app^.host.user,
        path_data,
        len(path),
        buffer^.cursor,
    )
    // The public enum has six fixed C-ABI ordinals, unavailable through ready.
    if raw_status > 5 {
        return .unavailable
    }
    return cast[draft_compiler_api.Navigation_Status](raw_status)
}

go_to_definition :: proc(app: ^App) -> bool {
    status := prepare_navigation(app)
    if status != .ready || app^.host.navigation_definition == nil {
        navigation_status_message(app, status)
        return false
    }
    location: draft_compiler_api.Navigation_Location
    app^.host.navigation_definition(app^.host.user, &location)
    target: Navigation_Target
    if !target_from_host(app, location, &target) ||
        !retain_read_only_navigation_source(app, location, &target) {
        navigation_target_destroy(&target)
        app^.status = "Could not retain the definition source"
        return false
    }
    opened := open_navigation_target(app, &target, true)
    navigation_target_destroy(&target)
    if !opened {
        app^.status = "Could not open the definition source range"
        return false
    }
    app^.status = "Definition selected"
    return true
}

find_symbol_usages :: proc(app: ^App) -> bool {
    clear_navigation_rows(app)
    status := prepare_navigation(app)
    if status != .ready || app^.host.navigation_usage_count == nil ||
        app^.host.navigation_usage == nil {
        navigation_status_message(app, status)
        return false
    }
    count := app^.host.navigation_usage_count(app^.host.user)
    if count > Maximum_Navigation_Rows {
        count = Maximum_Navigation_Rows
    }
    for index: usize = 0; index < count; index += 1 {
        location: draft_compiler_api.Navigation_Location
        app^.host.navigation_usage(app^.host.user, index, &location)
        target := &app^.navigation_rows[app^.navigation_row_count]
        if !target_from_host(app, location, target) ||
            !retain_read_only_navigation_source(app, location, target) {
            navigation_target_destroy(target)
            clear_navigation_rows(app)
            app^.status = "Could not retain semantic usage sources"
            return false
        }
        app^.navigation_row_count += 1
    }
    app^.semantic_usages_visible = true
    turbo_ui.show_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_References].id,
    )
    app^.ui.focused_id = 820
    if app^.navigation_row_count == 0 {
        app^.status = "No usages found"
    } else {
        app^.status = "Usages: Enter opens the selected source range"
    }
    return true
}

navigate_history :: proc(app: ^App, forward: bool) -> bool {
    if app^.navigation_history_count == 0 ||
        (!forward && app^.navigation_history_index == 0) ||
        (forward && app^.navigation_history_index + 1 >=
            app^.navigation_history_count) {
        app^.status = "No semantic navigation history in that direction"
        return false
    }
    previous := app^.navigation_history_index
    if forward {
        app^.navigation_history_index += 1
    } else {
        app^.navigation_history_index -= 1
    }
    target := &app^.navigation_history[app^.navigation_history_index]
    if !open_navigation_target(app, target, false) {
        app^.navigation_history_index = previous
        app^.status = "Could not reopen the navigation history location"
        return false
    }
    if forward {
        app^.status = "Moved forward in semantic navigation history"
    } else {
        app^.status = "Moved back in semantic navigation history"
    }
    return true
}

// load_run_rows copies one ordered string list and only then builds the exact
// cstring table borrowed by core/process. Partial owners remain destroyable by
// run_configuration_destroy when a service callback changes or fails.
load_run_rows :: proc(
    user: rawptr,
    count_procedure: draft_compiler_api.Count_Proc,
    copy_procedure: draft_compiler_api.Copy_Indexed_Text_Proc,
    owners: ^array.Dynamic[memory.Owned_String],
    pointers: ^array.Dynamic[cstring],
) -> bool {
    if count_procedure == nil || copy_procedure == nil {
        return true
    }
    count := count_procedure(user)
    for index: usize = 0; index < count; index += 1 {
        owned: memory.Owned_String
        if !copy_host_indexed_text(user, copy_procedure, index, &owned) {
            return false
        }
        array.append(owners, owned)
    }
    array.reserve(pointers, owners^.length)
    for index: usize = 0; index < owners^.length; index += 1 {
        array.append(
            pointers,
            memory.owned_string_cstring(&owners^.data[index]),
        )
    }
    return true
}

// load_run_configuration snapshots the selected root's complete run tail after
// a successful build. It performs no launch and leaves one destroyable owner
// even when a callback fails midway.
load_run_configuration :: proc(
    app: ^App,
    configuration: ^Run_Configuration,
) -> bool {
    run_configuration_init(configuration)
    if !load_run_rows(
        app^.host.user,
        app^.host.run_argument_count,
        app^.host.copy_run_argument,
        &configuration^.argument_owners,
        &configuration^.arguments,
    ) || !load_run_rows(
        app^.host.user,
        app^.host.run_environment_count,
        app^.host.copy_run_environment,
        &configuration^.environment_owners,
        &configuration^.environment,
    ) {
        return false
    }
    if app^.host.copy_run_working_directory != nil {
        length := app^.host.copy_run_working_directory(
            app^.host.user,
            nil,
            0,
        )
        if length != 0 {
            if !copy_host_text(
                app^.host.user,
                app^.host.copy_run_working_directory,
                &configuration^.working_directory,
            ) {
                return false
            }
            configuration^.has_working_directory = true
        }
    }
    return true
}

// execute_host_action submits all open source overlays, then optionally runs
// only a successfully published executable. F5 snapshots run settings after
// the build so artifact path, arguments, environment, and directory all belong
// to the same selected root/configuration.
execute_host_action :: proc(app: ^App, run: bool) {
    procedure := app^.host.build
    if procedure == nil {
        app^.status = "No compiler host is attached"
        return
    }
    overlays: [Maximum_Buffers]draft_compiler_api.Overlay
    (overlay_count, active_overlay, valid_overlays) := collect_host_overlays(
        app,
        overlays[:],
    )
    if !valid_overlays {
        app^.status = "Active buffer is not in the checked workspace source graph"
        return
    }
    result: draft_compiler_api.Result
    procedure(
        app^.host.user,
        &overlays[0],
        overlay_count,
        active_overlay,
        &result,
    )
    app^.semantic_dirty = false
    app^.diagnostic_count = result.diagnostic_count
    copy_syntax_spans(app, result.span_count)
    if result.success != 0 {
        if run {
            artifact_kind: draft_compiler_api.Artifact_Kind = .executable
            if app^.host.artifact_kind != nil {
                artifact_kind = cast[draft_compiler_api.Artifact_Kind](
                    app^.host.artifact_kind(app^.host.user),
                )
            }
            if artifact_kind != .executable {
                app^.status = "Build completed; selected artifact is not executable"
            } else if app^.host.copy_artifact_path == nil {
                app^.status = "Compiler did not expose the built artifact path"
            } else {
                owned_path: memory.Owned_String
                path_copied := copy_host_text(
                    app^.host.user,
                    app^.host.copy_artifact_path,
                    &owned_path,
                )
                if !path_copied || owned_path.length == 0 {
                    if path_copied {
                        memory.owned_string_destroy(&owned_path)
                    }
                    app^.status = "Built artifact path is unavailable"
                } else {
                    run_configuration: Run_Configuration
                    loaded_run := load_run_configuration(app, &run_configuration)
                    if !loaded_run {
                        app^.status = "Could not read the selected run configuration"
                        run_configuration_destroy(&run_configuration)
                        memory.owned_string_destroy(&owned_path)
                        refresh_tooling_text(app)
                        return
                    }
                    working_directory: cstring
                    if run_configuration.has_working_directory {
                        working_directory = memory.owned_string_cstring(
                            &run_configuration.working_directory,
                        )
                    }
                    options := process.Options{
                        arguments = array.view(&run_configuration.arguments),
                        environment = array.view(&run_configuration.environment),
                        working_directory = working_directory,
                    }
                    launched := process.run_with_options(
                        memory.owned_string_cstring(&owned_path),
                        options,
                    )
                    run_configuration_destroy(&run_configuration)
                    memory.owned_string_destroy(&owned_path)
                    if launched.error == .invalid_options {
                        app^.status = "Selected run configuration is invalid"
                    } else if launched.error != .none {
                        app^.status = "Could not launch the built program"
                    } else if !launched.exited {
                        app^.status = "Built program terminated by a signal"
                    } else if launched.exit_code != 0 {
                        app^.status = "Built program returned a nonzero status"
                    } else {
                        app^.status = "Run completed"
                    }
                }
            }
        } else {
            app^.status = "Build completed"
        }
    } else {
        app^.status = "Build/Run failed; see diagnostics"
    }
    refresh_tooling_text(app)
}

host_action :: proc(app: ^App, run: bool) {
    if run {
        if app^.host.build == nil {
            app^.status = "No compiler host is attached"
            return
        }
        app^.run_requested = true
        app^.status = "Run requested"
        return
    }
    execute_host_action(app, false)
}

byte_views_equal :: proc(left, right: []u8) -> bool {
    if len(left) != len(right) {
        return false
    }
    for index: usize = 0; index < len(left); index += 1 {
        if left[index] != right[index] {
            return false
        }
    }
    return true
}

workspace_source_index :: proc(app: ^App, path: []u8) -> usize {
    for index: usize = 0; index < app^.workspace_source_count; index += 1 {
        if byte_views_equal(
            path,
            memory.owned_string_bytes(&app^.workspace_source_paths[index]),
        ) {
            return index
        }
    }
    return app^.workspace_source_count
}

// open_workspace_source turns one compiler-discovered Sources row into an ordinary
// editor buffer. Reopening a path reuses its unsaved owner; a first open reads
// the normal file and binds that buffer to the currently selected run root.
open_workspace_source :: proc(app: ^App, source_index: usize) -> bool {
    if source_index >= app^.workspace_source_count {
        return false
    }
    path := memory.owned_string_bytes(&app^.workspace_source_paths[source_index])
    for index: usize = 0; index < app^.buffer_count; index += 1 {
        if byte_views_equal(turbo_editor.path_bytes(&app^.buffers[index]), path) {
            app^.sources.cursor = source_index
            return activate_buffer(app, index)
        }
    }
    if !init_one_buffer_bytes(app, path) {
        return false
    }
    app^.active = app^.buffer_count - 1
    app^.buffers_list.cursor = app^.active
    app^.sources.cursor = source_index
    bind_active_buffer_to_host_root(app)
    return activate_buffer(app, app^.active)
}

// open_selected_host_source synchronizes the editor's active buffer with the
// source path selected by the compiler service. Existing dirty buffers remain
// open and are reselected without reloading; a new root consumes one ordinary
// buffer slot and follows the same explicit disk-load policy as any file.
open_selected_host_source :: proc(app: ^App) -> bool {
    if app^.host.copy_source_path == nil {
        return false
    }
    storage: [Host_Path_Capacity]u8
    length := app^.host.copy_source_path(
        app^.host.user,
        cast[[^]u8](&storage[0]),
        len(storage),
    )
    if length == 0 || length >= len(storage) {
        return false
    }
    path := storage[:length]
    selected_root := app^.host.selected_root(app^.host.user)
    for index: usize = 0; index < app^.buffer_count; index += 1 {
        if byte_views_equal(turbo_editor.path_bytes(&app^.buffers[index]), path) {
            source_index := workspace_source_index(app, path)
            if source_index < app^.workspace_source_count {
                app^.sources.cursor = source_index
            }
            app^.buffer_root[index] = selected_root
            app^.buffer_has_root[index] = true
            return activate_buffer(app, index)
        }
    }
    if !init_one_buffer_bytes(app, path) {
        return false
    }
    app^.active = app^.buffer_count - 1
    app^.buffers_list.cursor = app^.active
    source_index := workspace_source_index(app, path)
    if source_index < app^.workspace_source_count {
        app^.sources.cursor = source_index
    }
    app^.buffer_root[app^.active] = selected_root
    app^.buffer_has_root[app^.active] = true
    return activate_buffer(app, app^.active)
}

// select_program_root is the single UI transition for the Build menu and the
// Programs & Packages window. The compiler service changes first; the editor then opens or
// reselects the exact source path published for that root. Failure restores the
// previous service root before any editor buffer can be compiled under it.
select_program_root :: proc(app: ^App, selected: usize) -> bool {
    if app^.host.root_count == nil || app^.host.selected_root == nil ||
        app^.host.select_root == nil || selected >= app^.host.root_count(app^.host.user) {
        return false
    }
    previous := app^.host.selected_root(app^.host.user)
    if selected != previous && app^.host.select_root(app^.host.user, selected) == 0 {
        return false
    }
    refresh_program_roots(app)
    refresh_workspace_sources(app)
    if open_selected_host_source(app) {
        if selected < app^.program_root_count {
            app^.program_roots.cursor = selected
        }
        return true
    }
    if selected != previous {
        app^.host.select_root(app^.host.user, previous)
    }
    refresh_program_roots(app)
    refresh_workspace_sources(app)
    return false
}

cycle_program_root :: proc(app: ^App) {
    if app^.host.root_count == nil || app^.host.selected_root == nil ||
        app^.host.select_root == nil {
        app^.status = "No Program selector is attached"
        return
    }
    count := app^.host.root_count(app^.host.user)
    if count <= 1 {
        app^.status = "Workspace has one selectable Program"
        return
    }
    next := (app^.host.selected_root(app^.host.user) + 1) % count
    if !select_program_root(app, next) {
        app^.status = "Selected Program could not be opened; selection restored"
        return
    }
    app^.status = "Active Program changed"
}

cycle_build_target :: proc(app: ^App) {
    if app^.host.target == nil || app^.host.select_target == nil {
        app^.status = "No compiler target selector is attached"
        return
    }
    previous := app^.host.target(app^.host.user)
    if previous >= 4 {
        app^.status = "Compiler service returned an unknown target"
        return
    }
    next := (previous + 1) % 4
    if app^.host.select_target(app^.host.user, cast[u8](next)) == 0 {
        app^.status = "Could not select the next Draft target"
        return
    }
    refresh_program_roots(app)
    refresh_workspace_sources(app)
    if !open_selected_host_source(app) {
        app^.host.select_target(app^.host.user, previous)
        refresh_program_roots(app)
        refresh_workspace_sources(app)
        app^.status = "Selected target could not be opened; selection restored"
        return
    }
    app^.status = "Draft target changed; current graph was rebuilt"
}

has_dirty_buffers :: proc(app: ^App) -> bool {
    for index: usize = 0; index < app^.buffer_count; index += 1 {
        if app^.buffers[index].dirty {
            return true
        }
    }
    return false
}

save_all_dirty_buffers :: proc(app: ^App) -> bool {
    for index: usize = 0; index < app^.buffer_count; index += 1 {
        if app^.buffers[index].dirty &&
            !turbo_editor.save(&app^.buffers[index]) {
            return false
        }
    }
    return true
}

close_folder_dialogs :: proc(app: ^App) {
    turbo_ui.hide_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Open_Folder].id,
    )
    turbo_ui.hide_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Folder_Confirm].id,
    )
}

close_open_file :: proc(app: ^App) {
    turbo_ui.hide_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Open_File].id,
    )
}

// path_is_absolute recognizes the native hosted path roots needed by the Open
// File dialog. DraftIDE does not normalize or reinterpret an absolute spelling:
// the editor passes it to core/os exactly as entered. Windows drive roots and
// UNC/current-drive separators are selected only for the Windows build.
path_is_absolute :: proc(path: []u8) -> bool {
    if len(path) == 0 {
        return false
    }
    when target.os == .windows {
        return path[0] == cast[u8]('/') || path[0] == cast[u8]('\\') ||
            (len(path) >= 2 && path[1] == cast[u8](':'))
    } else {
        return path[0] == cast[u8]('/')
    }
}

// resolve_open_file_path gives relative dialog input one stable and useful
// meaning: it is relative to the current Workspace when a compiler host is
// attached, and otherwise relative to the standalone editor process. The
// result borrows destination only until the caller returns. No truncation is
// permitted because a truncated pathname could open a different file.
resolve_open_file_path :: proc(
    app: ^App,
    input: []u8,
    destination: []u8,
) -> ([]u8, bool) {
    if len(input) == 0 || len(input) > len(destination) {
        return (destination[:0], false)
    }
    if path_is_absolute(input) || app^.host.copy_workspace_path == nil {
        for index: usize = 0; index < len(input); index += 1 {
            destination[index] = input[index]
        }
        return (destination[:len(input)], true)
    }

    workspace_length := app^.host.copy_workspace_path(
        app^.host.user,
        cast[[^]u8](&destination[0]),
        len(destination),
    )
    if workspace_length == 0 || workspace_length >= len(destination) {
        return (destination[:0], false)
    }
    needs_separator := destination[workspace_length - 1] != cast[u8]('/') &&
        destination[workspace_length - 1] != cast[u8]('\\')
    required := workspace_length + len(input)
    if needs_separator {
        required += 1
    }
    if required > len(destination) {
        return (destination[:0], false)
    }
    write_at := workspace_length
    if needs_separator {
        when target.os == .windows {
            destination[write_at] = cast[u8]('\\')
        } else {
            destination[write_at] = cast[u8]('/')
        }
        write_at += 1
    }
    for index: usize = 0; index < len(input); index += 1 {
        destination[write_at + index] = input[index]
    }
    return (destination[:required], true)
}

// submit_open_file opens or creates one ordinary editor buffer. Paths already
// published by Workspace Sources retain the selected Program association;
// arbitrary files remain editing-only and are never submitted as compiler
// overlays. Reopening an exact path reuses the existing owner and its unsaved
// bytes instead of reading disk over it.
submit_open_file :: proc(app: ^App) {
    input := turbo_ui.text_box_bytes(&app^.file_box, app^.file_path[:])
    storage: [Host_Path_Capacity]u8
    (path, valid) := resolve_open_file_path(app, input, storage[:])
    if !valid {
        app^.status = "Enter a valid file path within the IDE path limit"
        return
    }
    index := buffer_index_for_path(app, path)
    if index == app^.buffer_count {
        if !init_one_buffer_bytes(app, path) {
            app^.status = "Could not open the file"
            return
        }
        index = app^.buffer_count - 1
        source_index := workspace_source_index(app, path)
        if source_index < app^.workspace_source_count &&
            app^.host.selected_root != nil {
            app^.buffer_root[index] = app^.host.selected_root(app^.host.user)
            app^.buffer_has_root[index] = true
            app^.sources.cursor = source_index
        }
    }
    close_open_file(app)
    if !activate_buffer(app, index) {
        app^.status = "Could not activate the opened file"
        return
    }
    if workspace_source_index(app, path) < app^.workspace_source_count {
        app^.status = "Workspace source opened"
    } else {
        app^.status = "File opened for editing; it is outside the selected Program"
    }
}

request_open_file :: proc(app: ^App) {
    turbo_ui.show_modal_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Open_File].id,
    )
    app^.ui.focused_id = 830
    app^.status = "Enter a file path; relative paths start at the Workspace"
}

// open_folder_now crosses the one mutable workspace boundary. The host first
// constructs and validates a complete replacement compiler session behind its
// stable user pointer. Only then are old Draft buffers destroyed and the new
// selected source opened. A filesystem race after host validation falls back
// to an ordinary empty buffer so the UI never retains zero documents.
open_folder_now :: proc(app: ^App) -> bool {
    if app^.host.open_workspace == nil {
        return false
    }
    path := turbo_ui.text_box_bytes(&app^.workspace_box, app^.workspace_path[:])
    path_data: rawptr = nil
    if len(path) != 0 {
        path_data = cast[rawptr](&path[0])
    }
    app^.workspace_error_length = 0
    opened := app^.host.open_workspace(
        app^.host.user,
        path_data,
        len(path),
        cast[[^]u8](&app^.workspace_error[0]),
        len(app^.workspace_error),
    )
    if opened == 0 {
        for app^.workspace_error_length < len(app^.workspace_error) &&
            app^.workspace_error[app^.workspace_error_length] != 0 {
            app^.workspace_error_length += 1
        }
        if app^.windows[Window_Folder_Confirm].visible {
            turbo_ui.hide_window(
                &app^.ui,
                app^.windows[:],
                app^.windows[Window_Folder_Confirm].id,
            )
            turbo_ui.show_modal_window(
                &app^.ui,
                app^.windows[:],
                app^.windows[Window_Open_Folder].id,
            )
            app^.ui.focused_id = 570
        }
        app^.status = "Could not open workspace"
        return false
    }

    close_folder_dialogs(app)
    destroy_app(app)
    app^.active = 0
    app^.sources = turbo_ui.List_State{}
    app^.buffers_list = turbo_ui.List_State{}
    app^.package_tree = turbo_ui.List_State{}
    app^.package_row_count = 0
    for index: usize = 0; index < Maximum_Package_Rows; index += 1 {
        app^.package_seen[index] = false
        app^.package_expanded[index] = false
    }
    refresh_program_roots(app)
    refresh_workspace_sources(app)
    if !open_selected_host_source(app) {
        if !init_one_buffer(app, "untitled.draft") {
            return false
        }
        app^.status = "Workspace opened, but its selected source disappeared"
        return true
    }
    if app^.program_root_count > 1 {
        turbo_ui.show_window(
            &app^.ui,
            app^.windows[:],
            app^.windows[Window_Programs].id,
        )
    }
    app^.status = "Workspace opened"
    return true
}

submit_open_folder :: proc(app: ^App) {
    if has_dirty_buffers(app) {
        turbo_ui.hide_window(
            &app^.ui,
            app^.windows[:],
            app^.windows[Window_Open_Folder].id,
        )
        turbo_ui.show_modal_window(
            &app^.ui,
            app^.windows[:],
            app^.windows[Window_Folder_Confirm].id,
        )
        app^.status = "Choose how to handle dirty buffers"
        return
    }
    _ = open_folder_now(app)
}

request_open_folder :: proc(app: ^App) {
    if app^.host.open_workspace == nil || app^.host.copy_workspace_path == nil {
        app^.status = "No workspace-opening host is attached"
        return
    }
    app^.workspace_error_length = 0
    length := app^.host.copy_workspace_path(
        app^.host.user,
        cast[[^]u8](&app^.workspace_path[0]),
        len(app^.workspace_path),
    )
    if length >= len(app^.workspace_path) {
        length = 0
    }
    if !turbo_ui.text_box_set(
        &app^.workspace_box,
        app^.workspace_path[:],
        app^.workspace_path[:length],
    ) {
        app^.status = "Current workspace path cannot be edited"
        return
    }
    turbo_ui.hide_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Folder_Confirm].id,
    )
    turbo_ui.show_modal_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Open_Folder].id,
    )
    app^.ui.focused_id = 570
    app^.status = "Enter a workspace directory"
}

request_search :: proc(app: ^App) {
    turbo_ui.hide_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Quit].id,
    )
    turbo_ui.show_modal_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Search].id,
    )
    app^.ui.focused_id = 500
    app^.status = "Find: type text, Enter searches, Esc cancels"
}

// focus_editor makes the active document and its stable per-buffer focus ID the
// destination after navigation. It does not reload, recheck, or alter window
// geometry; those belong to the operation which produced the destination.
focus_editor :: proc(app: ^App) {
    turbo_ui.show_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Editor].id,
    )
    app^.ui.focused_id = cast[turbo_ui.Widget_Id](600 + app^.active)
}

// perform_find applies the persistent query without reopening a dialog. F3 and
// Shift-F3 share this operation with dialog buttons, including exact wrap and
// no-match feedback.
perform_find :: proc(app: ^App, reverse: bool) -> bool {
    query := turbo_ui.text_box_bytes(&app^.search_box, app^.search[:])
    if len(query) == 0 {
        app^.status = "Find text is empty; use Ctrl-F"
        return false
    }
    result: turbo_editor.Find_Result
    if reverse {
        result = turbo_editor.find_previous(active_buffer(app), query)
    } else {
        result = turbo_editor.find_next(active_buffer(app), query)
    }
    if !result.found {
        app^.status = "No match"
        return false
    }
    focus_editor(app)
    if result.wrapped && reverse {
        app^.status = "Previous match selected (wrapped to end)"
    } else if result.wrapped {
        app^.status = "Next match selected (wrapped to start)"
    } else if reverse {
        app^.status = "Previous match selected"
    } else {
        app^.status = "Next match selected"
    }
    return true
}

request_replace :: proc(app: ^App) {
    turbo_ui.hide_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Search].id,
    )
    turbo_ui.show_modal_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Replace].id,
    )
    app^.ui.focused_id = 580
    app^.status = "Replace: Tab moves fields/buttons; Esc cancels"
}

request_go_to_line :: proc(app: ^App) {
    turbo_ui.show_modal_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Go_To_Line].id,
    )
    app^.ui.focused_id = 590
    app^.status = "Go to one-based line number"
}

// request_shortcut_help opens an informational modal rather than an ordinary
// desktop tool. That preserves the classic F1 contract: the reference captures
// navigation until Close/Escape returns the user to the exact window beneath
// it. The list retains its scroll position between openings.
request_shortcut_help :: proc(app: ^App) {
    turbo_ui.show_modal_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Help].id,
    )
    app^.ui.focused_id = 800
    app^.status = "Keyboard shortcuts: arrows/page keys scroll; Esc closes"
}

close_replace :: proc(app: ^App) {
    turbo_ui.hide_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Replace].id,
    )
    app^.status = "Replace cancelled"
}

close_go_to_line :: proc(app: ^App) {
    turbo_ui.hide_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Go_To_Line].id,
    )
    app^.status = "Go to Line cancelled"
}

close_shortcut_help :: proc(app: ^App) {
    turbo_ui.hide_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Help].id,
    )
    app^.status = "Keyboard shortcut help closed"
}

// set_replace_count_status formats one allocation-free status message. Static
// status assignments remain immutable strings; this bounded byte owner is used
// only when the exact Replace All count is part of user-visible feedback.
set_replace_count_status :: proc(app: ^App, count: usize) {
    app^.status_length = 0
    prefix := "Replaced "
    for index: usize = 0; index < len(prefix); index += 1 {
        app^.status_storage[app^.status_length] = prefix[index]
        app^.status_length += 1
    }
    digits_storage: [20]u8
    (digits, formatted) := format.unsigned_decimal(
        digits_storage[:],
        cast[u64](count),
    )
    if !formatted {
        app^.status = "Replace All completed"
        app^.status_bytes_active = false
        return
    }
    for byte in digits {
        app^.status_storage[app^.status_length] = byte
        app^.status_length += 1
    }
    suffix := " matches"
    if count == 1 {
        suffix = " match"
    }
    for index: usize = 0; index < len(suffix); index += 1 {
        app^.status_storage[app^.status_length] = suffix[index]
        app^.status_length += 1
    }
    app^.status_bytes_active = true
}

// replace_current applies only an already selected exact query. When advance
// is true, the next search begins after the replacement, so replacement bytes
// are never reprocessed by this command. With no current match it selects the
// next one and asks for a second explicit Replace command.
replace_current :: proc(app: ^App, advance: bool) -> bool {
    query := turbo_ui.text_box_bytes(&app^.search_box, app^.search[:])
    replacement := turbo_ui.text_box_bytes(
        &app^.replacement_box,
        app^.replacement[:],
    )
    if len(query) == 0 {
        app^.status = "Replace text is empty"
        return false
    }
    result := turbo_editor.replace_selected(
        active_buffer(app),
        query,
        replacement,
    )
    if result == .selection_mismatch {
        if perform_find(app, false) {
            app^.status = "Match selected; Replace again to change it"
        }
        return false
    }
    if result == .history_limit {
        app^.status = "Replacement exceeds the bounded atomic undo history"
        return false
    }
    if result == .read_only {
        app^.status = "Compiler and dependency sources are read-only"
        return false
    }
    source_changed(app)
    if advance {
        if !perform_find(app, false) {
            app^.status = "Replaced current match; no further match"
        }
    } else {
        focus_editor(app)
        app^.status = "Replaced current match"
    }
    return true
}

replace_every_match :: proc(app: ^App) -> bool {
    query := turbo_ui.text_box_bytes(&app^.search_box, app^.search[:])
    replacement := turbo_ui.text_box_bytes(
        &app^.replacement_box,
        app^.replacement[:],
    )
    if len(query) == 0 {
        app^.status = "Replace text is empty"
        return false
    }
    if turbo_editor.is_read_only(active_buffer(app)) {
        app^.status = "Compiler and dependency sources are read-only"
        return false
    }
    result := turbo_editor.replace_all(active_buffer(app), query, replacement)
    if !result.completed {
        app^.status = "Replace All exceeds the bounded atomic undo history"
        return false
    }
    if result.count != 0 {
        source_changed(app)
        focus_editor(app)
    }
    set_replace_count_status(app, result.count)
    return true
}

parse_line_number :: proc(bytes: []u8) -> (usize, bool) {
    if len(bytes) == 0 {
        return (0, false)
    }
    value: usize
    for byte in bytes {
        if byte < cast[u8]('0') || byte > cast[u8]('9') {
            return (0, false)
        }
        digit := cast[usize](byte - cast[u8]('0'))
        if value > (~cast[usize](0) - digit) / 10 {
            return (0, false)
        }
        value = value * 10 + digit
    }
    return (value, value != 0)
}

submit_go_to_line :: proc(app: ^App) {
    bytes := turbo_ui.text_box_bytes(&app^.go_line_box, app^.go_line[:])
    (line, valid) := parse_line_number(bytes)
    if !valid || !turbo_editor.go_to_line(active_buffer(app), line) {
        app^.status = "Line number is outside this document"
        return
    }
    turbo_ui.hide_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Go_To_Line].id,
    )
    focus_editor(app)
    app^.status = "Moved to line"
}

toggle_window :: proc(app: ^App, index: usize) {
    assert(index < Window_Count, "Turbo Draft window index is invalid")
    id := app^.windows[index].id
    if app^.windows[index].visible {
        turbo_ui.hide_window(&app^.ui, app^.windows[:], id)
    } else {
        turbo_ui.show_window(&app^.ui, app^.windows[:], id)
    }
}

close_search :: proc(app: ^App) {
    turbo_ui.hide_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Search].id,
    )
    app^.status = "Search cancelled"
}

cancel_quit :: proc(app: ^App) {
    turbo_ui.hide_window(
        &app^.ui,
        app^.windows[:],
        app^.windows[Window_Quit].id,
    )
    app^.quit_discard_mask = 0
    app^.status = "Quit cancelled"
}

// continue_quit selects the next dirty buffer which has neither been saved nor
// explicitly discarded during this quit attempt. The bit mask is transient UI
// state: Cancel clears every provisional discard decision without changing any
// Buffer, while completing the sequence exits before those decisions need to
// become durable document state.
continue_quit :: proc(app: ^App) -> bool {
    static_assert(Maximum_Buffers <= 64,
        "quit discard mask must cover every editor buffer")
    for index: usize = 0; index < app^.buffer_count; index += 1 {
        bit := cast[u64](1) << cast[u64](index)
        if app^.buffers[index].dirty && (app^.quit_discard_mask & bit) == 0 {
            if !activate_buffer(app, index) {
                app^.status = "Could not restore the dirty buffer's Program"
                return false
            }
            turbo_ui.hide_window(
                &app^.ui,
                app^.windows[:],
                app^.windows[Window_Search].id,
            )
            turbo_ui.show_modal_window(
                &app^.ui,
                app^.windows[:],
                app^.windows[Window_Quit].id,
            )
            app^.ui.focused_id = 510
            app^.status = "Unsaved buffer requires an explicit choice"
            return false
        }
    }
    return true
}

request_quit :: proc(app: ^App) -> bool {
    app^.quit_discard_mask = 0
    return continue_quit(app)
}

// handle_global_key consumes only editor-wide commands. Other keys reach the
// focused widget/editor during the immediate traversal.
handle_global_key :: proc(app: ^App, event: turbo_ui.Event) -> (turbo_ui.Event, bool) {
    if event.kind != .key {
        return (event, false)
    }
    key := event.key
    // Popups, modal dialogs, and keyboard window manipulation get first
    // refusal. This is essential for Escape dismissal/cancellation, menu
    // arrows, dialog defaults, and text-box Enter; the desktop shortcut layer
    // must not reinterpret those keys as editor commands.
    if app^.ui.popup_id != turbo_ui.No_Widget ||
        app^.ui.keyboard_window != turbo_ui.No_Widget ||
        app^.windows[Window_Search].visible ||
        app^.windows[Window_Quit].visible ||
        app^.windows[Window_Open_Folder].visible ||
        app^.windows[Window_Open_File].visible ||
        app^.windows[Window_Folder_Confirm].visible ||
        app^.windows[Window_Replace].visible ||
        app^.windows[Window_Go_To_Line].visible ||
        app^.windows[Window_Help].visible {
        return (event, false)
    }
    // Raw terminal Control+letter input uses the conventional C0 byte values:
    // Ctrl-F is 6 and Ctrl-S is 19. These commands are application-wide, so a
    // Sources or a semantic window must not disable shortcuts advertised in
    // the File/Edit menus merely because the document editor lacks focus.
    if key.code == .character && key.control && !key.alt {
        if key.byte_value == 6 {
            request_search(app)
            return (turbo_ui.no_event(), false)
        }
        if key.byte_value == 7 {
            request_go_to_line(app)
            return (turbo_ui.no_event(), false)
        }
        if key.byte_value == 18 {
            _ = replace_current(app, true)
            return (turbo_ui.no_event(), false)
        }
        if key.byte_value == 19 {
            save_active_buffer(app)
            return (turbo_ui.no_event(), false)
        }
        if key.byte_value == 25 {
            redo_active(app)
            return (turbo_ui.no_event(), false)
        }
        if key.byte_value == 26 {
            undo_active(app)
            return (turbo_ui.no_event(), false)
        }
    }
    // Ctrl-H shares the ASCII byte 8 with historical terminal Backspace. The
    // terminal decoder preserves the physical byte and control flag, allowing
    // DraftIDE to reserve Ctrl-H for Replace without changing ordinary
    // Backspace or treating every DEL report as the same shortcut.
    if key.code == .backspace && key.control && !key.alt &&
        key.byte_value == 8 {
        request_replace(app)
        return (turbo_ui.no_event(), false)
    }
    if key.code == .character && key.alt && !key.control &&
        key.byte_value == cast[u8]('0') {
        turbo_ui.show_window(
            &app^.ui,
            app^.windows[:],
            app^.windows[Window_Buffers].id,
        )
        app^.ui.focused_id = 532
        app^.status = "Choose an open buffer and press Enter"
        return (turbo_ui.no_event(), false)
    }
    if key.code == .left && key.alt && !key.control {
        _ = navigate_history(app, false)
        return (turbo_ui.no_event(), false)
    }
    if key.code == .right && key.alt && !key.control {
        _ = navigate_history(app, true)
        return (turbo_ui.no_event(), false)
    }
    if key.code == .character && key.alt && !key.control &&
        (key.byte_value == cast[u8]('x') ||
            key.byte_value == cast[u8]('X')) {
        return (turbo_ui.no_event(), request_quit(app))
    }
    if key.code == .escape {
        // Escape is strictly a local cancel key. At the bare desktop there is
        // no operation to cancel, so consuming it is safer than surprising the
        // user with an application-wide quit dialog. Alt-X is the explicit
        // quit command advertised by the File menu and status line.
        app^.status = "Nothing to cancel"
        return (turbo_ui.no_event(), false)
    }
    if key.code == .f2 && !key.alt && !key.control {
        turbo_ui.show_window(
            &app^.ui,
            app^.windows[:],
            app^.windows[Window_Sources].id,
        )
        app^.ui.focused_id = 530
        app^.status = "Choose a workspace source and press Enter"
        return (turbo_ui.no_event(), false)
    }
    if key.code == .f1 && !key.alt && !key.control {
        request_shortcut_help(app)
        return (turbo_ui.no_event(), false)
    }
    if key.code == .f3 && !key.alt && !key.control {
        _ = perform_find(app, key.shift)
        return (turbo_ui.no_event(), false)
    }
    if key.code == .f5 && !key.alt && !key.control {
        host_action(app, true)
        return (turbo_ui.no_event(), false)
    }
    if key.code == .f6 && key.control && !key.alt {
        turbo_ui.activate_next_window(&app^.ui, app^.windows[:], key.shift)
        return (turbo_ui.no_event(), false)
    }
    if key.code == .f6 && !key.alt && !key.control {
        turbo_ui.show_window(
            &app^.ui,
            app^.windows[:],
            app^.windows[Window_Programs].id,
        )
        app^.ui.focused_id = 760
        return (turbo_ui.no_event(), false)
    }
    if key.code == .f7 && !key.alt && !key.control {
        toggle_window(app, Window_Declarations)
        return (turbo_ui.no_event(), false)
    }
    if key.code == .f8 && !key.alt && !key.control {
        app^.semantic_usages_visible = false
        toggle_window(app, Window_References)
        return (turbo_ui.no_event(), false)
    }
    if key.code == .f9 && !key.alt && !key.control {
        toggle_window(app, Window_Effects)
        return (turbo_ui.no_event(), false)
    }
    if key.code == .f10 && !key.alt && !key.control {
        toggle_window(app, Window_Denials)
        return (turbo_ui.no_event(), false)
    }
    if key.code == .f11 && !key.alt && !key.control {
        toggle_window(app, Window_Diagnostics)
        return (turbo_ui.no_event(), false)
    }
    if key.code == .f12 && !key.alt && !key.control {
        if key.shift {
            _ = find_symbol_usages(app)
        } else {
            _ = go_to_definition(app)
        }
        return (turbo_ui.no_event(), false)
    }
    return (event, false)
}

paint_search :: proc(
    app: ^App,
    content: turbo_ui.Rect,
) {
    turbo_ui.write_clipped(
        app^.ui.surface,
        content,
        turbo_ui.Point{column = content.column + 1, row = content.row},
        "Find literal bytes:",
        app^.ui.theme.text,
    )
    find_next_requested := false
    find_previous_requested := false
    if content.height > 2 && content.width > 2 {
        query_bounds := turbo_ui.Rect{
            column = content.column + 1,
            row = content.row + 2,
            width = content.width - 2,
            height = 1,
        }
        result := turbo_ui.text_box(
            &app^.ui,
            500,
            query_bounds,
            &app^.search_box,
            app^.search[:],
        )
        find_next_requested = result.submitted
    }
    if content.height > 3 && content.width > 2 {
        buttons := turbo_ui.layout_begin(
            turbo_ui.Rect{
                column = content.column + 1,
                row = content.row + 3,
                width = content.width - 2,
                height = 2,
            },
            .horizontal,
            0,
            1,
        )
        find_next_requested = find_next_requested || turbo_ui.button(
            &app^.ui,
            501,
            turbo_ui.layout_next(&buttons, 10),
            "Next",
            true,
            .default_action,
            cast[u8]('n'),
        )
        find_previous_requested = turbo_ui.button(
            &app^.ui,
            503,
            turbo_ui.layout_next(&buttons, 12),
            "Previous",
            true,
            .normal,
            cast[u8]('p'),
        )
        if turbo_ui.button(
            &app^.ui,
            502,
            turbo_ui.layout_next(&buttons, 10),
            "Cancel",
            true,
            .cancel_action,
            cast[u8]('c'),
        ) {
            close_search(app)
        }
    } else if turbo_ui.button(
        &app^.ui,
        502,
        turbo_ui.Rect{},
        "Cancel",
        true,
        .cancel_action,
    ) {
        // Preserve Escape dismissal while a tiny resize transient leaves no
        // cells in which to paint the dialog buttons.
        close_search(app)
    }
    if find_next_requested || find_previous_requested {
        if perform_find(app, find_previous_requested) {
            // Search text remains in App after dismissal. F3 and Shift-F3
            // therefore continue this exact query without reopening a modal.
            turbo_ui.hide_window(
                &app^.ui,
                app^.windows[:],
                app^.windows[Window_Search].id,
            )
        }
    }
}

// paint_replace shares the persistent Find query with the Find dialog and
// retains replacement text independently. Replace and Replace All remain open
// for repeated work; every mutation goes through turbo_editor's atomic history
// operations, never through direct App-owned byte manipulation.
paint_replace :: proc(app: ^App, content: turbo_ui.Rect) {
    turbo_ui.write_clipped(
        app^.ui.surface,
        content,
        turbo_ui.Point{column = content.column + 1, row = content.row},
        "Find:",
        app^.ui.theme.text,
    )
    replace_requested := false
    if content.width > 11 && content.height > 1 {
        find_result := turbo_ui.text_box(
            &app^.ui,
            580,
            turbo_ui.Rect{
                column = content.column + 10,
                row = content.row,
                width = content.width - 11,
                height = 1,
            },
            &app^.search_box,
            app^.search[:],
        )
        replace_requested = find_result.submitted
    }
    if content.width > 11 && content.height > 3 {
        turbo_ui.write_clipped(
            app^.ui.surface,
            content,
            turbo_ui.Point{column = content.column + 1, row = content.row + 2},
            "Replace:",
            app^.ui.theme.text,
        )
        replacement_result := turbo_ui.text_box(
            &app^.ui,
            581,
            turbo_ui.Rect{
                column = content.column + 10,
                row = content.row + 2,
                width = content.width - 11,
                height = 1,
            },
            &app^.replacement_box,
            app^.replacement[:],
        )
        replace_requested = replace_requested || replacement_result.submitted
    }

    replace_all_requested := false
    find_next_requested := false
    if content.width > 2 && content.height > 6 {
        buttons := turbo_ui.layout_begin(
            turbo_ui.Rect{
                column = content.column + 1,
                row = content.row + 5,
                width = content.width - 2,
                height = 2,
            },
            .horizontal,
            0,
            1,
        )
        replace_requested = replace_requested || turbo_ui.button(
            &app^.ui,
            582,
            turbo_ui.layout_next(&buttons, 11),
            "Replace",
            true,
            .default_action,
            cast[u8]('r'),
        )
        replace_all_requested = turbo_ui.button(
            &app^.ui,
            583,
            turbo_ui.layout_next(&buttons, 14),
            "Replace All",
            true,
            .normal,
            cast[u8]('a'),
        )
        find_next_requested = turbo_ui.button(
            &app^.ui,
            584,
            turbo_ui.layout_next(&buttons, 11),
            "Find Next",
            true,
            .normal,
            cast[u8]('f'),
        )
        if turbo_ui.button(
            &app^.ui,
            585,
            turbo_ui.layout_next(&buttons, 10),
            "Cancel",
            true,
            .cancel_action,
            cast[u8]('c'),
        ) {
            close_replace(app)
        }
    } else if turbo_ui.button(
        &app^.ui,
        585,
        turbo_ui.Rect{},
        "Cancel",
        true,
        .cancel_action,
    ) {
        close_replace(app)
    }

    if replace_requested {
        _ = replace_current(app, true)
        if app^.windows[Window_Replace].visible {
            app^.ui.focused_id = 580
        }
    } else if replace_all_requested {
        _ = replace_every_match(app)
        if app^.windows[Window_Replace].visible {
            app^.ui.focused_id = 580
        }
    } else if find_next_requested {
        _ = perform_find(app, false)
        if app^.windows[Window_Replace].visible {
            app^.ui.focused_id = 580
        }
    }
}

paint_go_to_line :: proc(app: ^App, content: turbo_ui.Rect) {
    turbo_ui.write_clipped(
        app^.ui.surface,
        content,
        turbo_ui.Point{column = content.column + 1, row = content.row},
        "Line number:",
        app^.ui.theme.text,
    )
    submitted := false
    if content.width > 15 && content.height > 1 {
        result := turbo_ui.text_box(
            &app^.ui,
            590,
            turbo_ui.Rect{
                column = content.column + 14,
                row = content.row,
                width = content.width - 15,
                height = 1,
            },
            &app^.go_line_box,
            app^.go_line[:],
        )
        submitted = result.submitted
    }
    if content.width > 2 && content.height > 3 {
        buttons := turbo_ui.layout_begin(
            turbo_ui.Rect{
                column = content.column + 1,
                row = content.row + 2,
                width = content.width - 2,
                height = 2,
            },
            .horizontal,
            0,
            1,
        )
        submitted = submitted || turbo_ui.button(
            &app^.ui,
            591,
            turbo_ui.layout_next(&buttons, 10),
            "Go To",
            true,
            .default_action,
            cast[u8]('g'),
        )
        if turbo_ui.button(
            &app^.ui,
            592,
            turbo_ui.layout_next(&buttons, 10),
            "Cancel",
            true,
            .cancel_action,
            cast[u8]('c'),
        ) {
            close_go_to_line(app)
        }
    } else if turbo_ui.button(
        &app^.ui,
        592,
        turbo_ui.Rect{},
        "Cancel",
        true,
        .cancel_action,
    ) {
        close_go_to_line(app)
    }
    if submitted {
        submit_go_to_line(app)
    }
}

paint_open_folder :: proc(app: ^App, content: turbo_ui.Rect) {
    turbo_ui.write_clipped(
        app^.ui.surface,
        content,
        turbo_ui.Point{column = content.column + 1, row = content.row},
        "Workspace directory:",
        app^.ui.theme.text,
    )
    submitted := false
    if content.width > 2 && content.height > 2 {
        result := turbo_ui.text_box(
            &app^.ui,
            570,
            turbo_ui.Rect{
                column = content.column + 1,
                row = content.row + 2,
                width = content.width - 2,
                height = 2,
            },
            &app^.workspace_box,
            app^.workspace_path[:],
        )
        submitted = result.submitted
    }
    if app^.workspace_error_length != 0 && content.height > 3 {
        turbo_ui.write_clipped_bytes(
            app^.ui.surface,
            content,
            turbo_ui.Point{column = content.column + 1, row = content.row + 3},
            app^.workspace_error[:app^.workspace_error_length],
            app^.ui.theme.hot,
        )
    }
    if content.width > 2 && content.height > 6 {
        buttons := turbo_ui.layout_begin(
            turbo_ui.Rect{
                column = content.column + 1,
                row = content.row + 5,
                width = content.width - 2,
                height = 2,
            },
            .horizontal,
            0,
            1,
        )
        submitted = submitted || turbo_ui.button(
            &app^.ui,
            571,
            turbo_ui.layout_next(&buttons, 8),
            "Open",
            true,
            .default_action,
            cast[u8]('o'),
        )
        if turbo_ui.button(
            &app^.ui,
            572,
            turbo_ui.layout_next(&buttons, 10),
            "Cancel",
            true,
            .cancel_action,
            cast[u8]('c'),
        ) {
            close_folder_dialogs(app)
            app^.status = "Open Folder cancelled"
        }
    } else if turbo_ui.button(
        &app^.ui,
        572,
        turbo_ui.Rect{},
        "Cancel",
        true,
        .cancel_action,
    ) {
        close_folder_dialogs(app)
        app^.status = "Open Folder cancelled"
    }
    if submitted {
        submit_open_folder(app)
    }
}

paint_open_file :: proc(app: ^App, content: turbo_ui.Rect) {
    turbo_ui.write_clipped(
        app^.ui.surface,
        content,
        turbo_ui.Point{column = content.column + 1, row = content.row},
        "File path (relative paths start at the Workspace):",
        app^.ui.theme.text,
    )
    submitted := false
    if content.width > 2 && content.height > 2 {
        result := turbo_ui.text_box(
            &app^.ui,
            830,
            turbo_ui.Rect{
                column = content.column + 1,
                row = content.row + 2,
                width = content.width - 2,
                height = 2,
            },
            &app^.file_box,
            app^.file_path[:],
        )
        submitted = result.submitted
    }
    if content.width > 2 && content.height > 6 {
        buttons := turbo_ui.layout_begin(
            turbo_ui.Rect{
                column = content.column + 1,
                row = content.row + 5,
                width = content.width - 2,
                height = 2,
            },
            .horizontal,
            0,
            1,
        )
        submitted = submitted || turbo_ui.button(
            &app^.ui,
            831,
            turbo_ui.layout_next(&buttons, 8),
            "Open",
            true,
            .default_action,
            cast[u8]('o'),
        )
        if turbo_ui.button(
            &app^.ui,
            832,
            turbo_ui.layout_next(&buttons, 10),
            "Cancel",
            true,
            .cancel_action,
            cast[u8]('c'),
        ) {
            close_open_file(app)
            app^.status = "Open File cancelled"
        }
    } else if turbo_ui.button(
        &app^.ui,
        832,
        turbo_ui.Rect{},
        "Cancel",
        true,
        .cancel_action,
    ) {
        close_open_file(app)
        app^.status = "Open File cancelled"
    }
    if submitted {
        submit_open_file(app)
    }
}

paint_folder_confirm :: proc(app: ^App, content: turbo_ui.Rect) {
    turbo_ui.write_clipped(
        app^.ui.surface,
        content,
        turbo_ui.Point{column = content.column + 1, row = content.row + 1},
        "Open another workspace with unsaved buffers?",
        app^.ui.theme.text,
    )
    if content.width <= 2 || content.height < 5 {
        return
    }
    buttons := turbo_ui.layout_begin(
        turbo_ui.Rect{
            column = content.column + 1,
            row = content.row + 3,
            width = content.width - 2,
            height = 2,
        },
        .horizontal,
        0,
        1,
    )
    if turbo_ui.button(
        &app^.ui,
        573,
        turbo_ui.layout_next(&buttons, 17),
        "Save all + open",
        true,
        .default_action,
        cast[u8]('s'),
    ) {
        if save_all_dirty_buffers(app) {
            _ = open_folder_now(app)
        } else {
            app^.status = "Save all failed; disk conflicts are not overwritten"
        }
    }
    if turbo_ui.button(
        &app^.ui,
        574,
        turbo_ui.layout_next(&buttons, 18),
        "Discard + open",
        true,
        .normal,
        cast[u8]('d'),
    ) {
        _ = open_folder_now(app)
    }
    if turbo_ui.button(
        &app^.ui,
        575,
        turbo_ui.layout_next(&buttons, 9),
        "Cancel",
        true,
        .cancel_action,
        cast[u8]('c'),
    ) {
        close_folder_dialogs(app)
        app^.status = "Open Folder cancelled"
    }
}

paint_quit :: proc(app: ^App, content: turbo_ui.Rect) -> bool {
    buffer := active_buffer(app)
    message := "The active buffer has unsaved changes."
    save_label := "Save + quit"
    save_width: usize = 12
    save_access := cast[u8]('s')
    if buffer^.disk_conflict {
        message = "Disk also changed. Choose whether to overwrite it."
        save_label = "Overwrite + quit"
        save_width = 17
        save_access = cast[u8]('o')
    }
    turbo_ui.write_clipped(
        app^.ui.surface,
        content,
        turbo_ui.Point{column = content.column + 1, row = content.row + 1},
        message,
        turbo_ui.turbo_theme().text,
    )
    if content.height < 5 || content.width <= 2 {
        if turbo_ui.button(
            &app^.ui,
            512,
            turbo_ui.Rect{},
            "Cancel",
            true,
            .cancel_action,
        ) {
            cancel_quit(app)
        }
        return false
    }
    buttons := turbo_ui.layout_begin(
        turbo_ui.Rect{
            column = content.column + 1,
            row = content.row + 3,
            width = content.width - 2,
            height = 2,
        },
        .horizontal,
        0,
        1,
    )
    if turbo_ui.button(
        &app^.ui,
        510,
        turbo_ui.layout_next(&buttons, save_width),
        save_label,
        true,
        .default_action,
        save_access,
    ) {
        // The conflict-specific label makes this the one explicit overwrite
        // path. Every ordinary Save refuses to replace a changed disk file.
        if turbo_editor.save(buffer, buffer^.disk_conflict) {
            return continue_quit(app)
        }
        app^.status = "Save failed; editor remains open"
    }
    if turbo_ui.button(
        &app^.ui,
        511,
        turbo_ui.layout_next(&buttons, 9),
        "Discard",
        true,
        .normal,
        cast[u8]('d'),
    ) {
        app^.quit_discard_mask |= cast[u64](1) << cast[u64](app^.active)
        return continue_quit(app)
    }
    if turbo_ui.button(
        &app^.ui,
        512,
        turbo_ui.layout_next(&buttons, 8),
        "Cancel",
        true,
        .cancel_action,
        cast[u8]('c'),
    ) {
        cancel_quit(app)
    }
    return false
}

// paint_shortcut_help presents every authored shortcut through the same
// reusable list/scrollbar control as other long application views. The key
// column has a fixed width chosen by this application; the UI library remains
// unaware of keyboard-command semantics. Close is a real cancel button, so
// Escape works from the list without a special event path.
paint_shortcut_help :: proc(app: ^App, content: turbo_ui.Rect) {
    if content.width != 0 && content.height != 0 {
        turbo_ui.fill_rect(
            app^.ui.surface,
            app^.ui.clip,
            turbo_ui.Rect{
                column = content.column,
                row = content.row,
                width = content.width,
                height = 1,
            },
            ' ',
            app^.ui.theme.border,
        )
        turbo_ui.write_clipped(
            app^.ui.surface,
            app^.ui.clip,
            turbo_ui.Point{column = content.column + 1, row = content.row},
            "Key                  Command",
            app^.ui.theme.border,
        )
    }

    if content.width > 2 && content.height > 4 {
        list_bounds := turbo_ui.Rect{
            column = content.column + 1,
            row = content.row + 1,
            width = content.width - 2,
            height = content.height - 4,
        }
        view := turbo_ui.list_view(
            &app^.ui,
            800,
            801,
            list_bounds,
            Shortcut_Row_Count,
            &app^.shortcut_list,
        )
        for index := view.first; index < view.end; index += 1 {
            row := turbo_ui.list_row_begin(&app^.ui, view, index)
            (key, command) := shortcut_row(index)
            key_width: usize = 21
            if key_width > row.bounds.width {
                key_width = row.bounds.width
            }
            key_bounds := row.bounds
            key_bounds.width = key_width
            turbo_ui.write_clipped(
                app^.ui.surface,
                turbo_ui.intersect(app^.ui.clip, key_bounds),
                turbo_ui.Point{
                    column = key_bounds.column,
                    row = key_bounds.row,
                },
                key,
                row.style,
            )
            if row.bounds.width > key_width {
                command_bounds := turbo_ui.Rect{
                    column = row.bounds.column + key_width,
                    row = row.bounds.row,
                    width = row.bounds.width - key_width,
                    height = 1,
                }
                turbo_ui.write_clipped(
                    app^.ui.surface,
                    turbo_ui.intersect(app^.ui.clip, command_bounds),
                    turbo_ui.Point{
                        column = command_bounds.column,
                        row = command_bounds.row,
                    },
                    command,
                    row.style,
                )
            }
        }
    }

    close_bounds: turbo_ui.Rect
    if content.width > 13 && content.height >= 2 {
        close_bounds = turbo_ui.Rect{
            column = content.column + (content.width - 12) / 2,
            row = content.row + content.height - 2,
            width = 12,
            height = 2,
        }
    }
    if turbo_ui.button(
        &app^.ui,
        802,
        close_bounds,
        "Close",
        true,
        .cancel_action,
        cast[u8]('c'),
    ) {
        close_shortcut_help(app)
    }
}

Path_List_Kind :: enum {
    workspace_sources,
    open_buffers,
}

path_list_count :: proc(app: ^App, kind: Path_List_Kind) -> usize {
    if kind == .workspace_sources && app^.host.source_count != nil {
        return app^.workspace_source_count
    }
    return app^.buffer_count
}

path_list_text :: proc(
    app: ^App,
    kind: Path_List_Kind,
    index: usize,
) -> []u8 {
    if kind == .workspace_sources && app^.host.source_count != nil {
        return memory.owned_string_bytes(&app^.workspace_source_names[index])
    }
    return turbo_editor.path_bytes(&app^.buffers[index])
}

activate_path_row :: proc(
    app: ^App,
    kind: Path_List_Kind,
    index: usize,
) -> bool {
    if kind == .workspace_sources && app^.host.source_count != nil {
        return open_workspace_source(app, index)
    }
    return activate_buffer(app, index)
}

// paint_path_list is the application-specific byte-label list used by Sources
// and Buffers. Arrow navigation moves only the list cursor; Enter or one
// primary click opens the selected row. This separation prevents browsing the
// package tree from continuously replacing the editor document. Sources uses
// compiler-owned workspace-relative labels, while Buffers shows the ordinary
// pathname stored by each document owner.
paint_path_list :: proc(
    app: ^App,
    content: turbo_ui.Rect,
    id: turbo_ui.Widget_Id,
    kind: Path_List_Kind,
) {
    count := path_list_count(app, kind)
    if content.width == 0 || content.height == 0 {
        return
    }
    model := &app^.sources
    if kind == .open_buffers {
        model = &app^.buffers_list
    }
    view := turbo_ui.list_view(
        &app^.ui,
        id,
        id + 1,
        content,
        count,
        model,
        .click_and_enter,
    )
    active_path := turbo_editor.path_bytes(active_buffer(app))
    for index := view.first; index < view.end; index += 1 {
        row := turbo_ui.list_row_begin(&app^.ui, view, index)
        marker := "  "
        if kind == .open_buffers {
            if app^.buffers[index].dirty {
                marker = "* "
            } else if turbo_editor.is_read_only(&app^.buffers[index]) {
                marker = "R "
            }
        } else if kind == .workspace_sources && app^.host.source_count != nil {
            source_path := memory.owned_string_bytes(
                &app^.workspace_source_paths[index],
            )
            if byte_views_equal(source_path, active_path) {
                marker = "> "
            }
        }
        turbo_ui.write_clipped(
            app^.ui.surface,
            turbo_ui.intersect(app^.ui.clip, row.bounds),
            turbo_ui.Point{column = row.bounds.column, row = row.bounds.row},
            marker,
            row.style,
        )
        if row.bounds.width > 2 {
            label_bounds := turbo_ui.Rect{
                column = row.bounds.column + 2,
                row = row.bounds.row,
                width = row.bounds.width - 2,
                height = 1,
            }
            turbo_ui.write_clipped_bytes(
                app^.ui.surface,
                turbo_ui.intersect(app^.ui.clip, label_bounds),
                turbo_ui.Point{
                    column = label_bounds.column,
                    row = label_bounds.row,
                },
                path_list_text(app, kind, index),
                row.style,
            )
        }
    }
    if view.activated && view.activated_index < count {
        if activate_path_row(app, kind, view.activated_index) {
            if kind == .workspace_sources && app^.host.source_count != nil {
                app^.status = "Workspace source opened"
            } else {
                app^.status = "Open buffer activated"
            }
        } else {
            app^.status = "Could not open the selected source"
        }
    }
}

// paint_navigation_usages presents compiler-resolved exact locations as an
// ordinary reusable desktop list. Rows remain app-owned across later checks;
// activating one opens its stable pathname and selects the retained byte range.
// The coordinate prefix is formatted into bounded stack storage each frame and
// the path paints directly from its independent owner.
paint_navigation_usages :: proc(app: ^App, content: turbo_ui.Rect) {
    if content.width == 0 || content.height == 0 {
        return
    }
    view := turbo_ui.list_view(
        &app^.ui,
        820,
        821,
        content,
        app^.navigation_row_count,
        &app^.navigation_list,
        .click_and_enter,
    )
    for index := view.first; index < view.end; index += 1 {
        row := turbo_ui.list_row_begin(&app^.ui, view, index)
        target := &app^.navigation_rows[index]
        coordinate: [48]u8
        coordinate_length: usize
        line_storage: [20]u8
        (line, line_ok) := format.unsigned_decimal(
            line_storage[:],
            cast[u64](target^.line),
        )
        if line_ok {
            for byte in line {
                coordinate[coordinate_length] = byte
                coordinate_length += 1
            }
        }
        coordinate[coordinate_length] = cast[u8](':')
        coordinate_length += 1
        column_storage: [20]u8
        (column, column_ok) := format.unsigned_decimal(
            column_storage[:],
            cast[u64](target^.column),
        )
        if column_ok {
            for byte in column {
                coordinate[coordinate_length] = byte
                coordinate_length += 1
            }
        }
        coordinate[coordinate_length] = cast[u8](' ')
        coordinate_length += 1
        clip := turbo_ui.intersect(app^.ui.clip, row.bounds)
        turbo_ui.write_clipped_bytes(
            app^.ui.surface,
            clip,
            turbo_ui.Point{column = row.bounds.column, row = row.bounds.row},
            coordinate[:coordinate_length],
            row.style,
        )
        if coordinate_length < row.bounds.width {
            path_bounds := turbo_ui.Rect{
                column = row.bounds.column + coordinate_length,
                row = row.bounds.row,
                width = row.bounds.width - coordinate_length,
                height = 1,
            }
            turbo_ui.write_clipped_bytes(
                app^.ui.surface,
                turbo_ui.intersect(app^.ui.clip, path_bounds),
                turbo_ui.Point{
                    column = path_bounds.column,
                    row = path_bounds.row,
                },
                memory.owned_string_bytes(&target^.path),
                row.style,
            )
        }
    }
    if view.activated && view.activated_index < app^.navigation_row_count {
        if open_navigation_target(
            app,
            &app^.navigation_rows[view.activated_index],
            true,
        ) {
            app^.status = "Usage selected"
        } else {
            app^.status = "Could not open the selected usage"
        }
    }
}

program_root_name :: proc(app: ^App, index: usize) -> []u8 {
    assert(index < app^.program_root_count, "program root label is invalid")
    return app^.program_root_names[index][:app^.program_root_length[index]]
}

// paint_program_root_picker makes the run-root choice visible and directly
// selectable instead of hiding it behind a menu-only cycle. Arrow keys move the
// cursor, Enter commits it, and a primary click commits one visible row. The
// compiler service remains authoritative; select_program_root performs the
// atomic service/editor transition and restores the old root on failure.
paint_program_root_picker :: proc(app: ^App, bounds: turbo_ui.Rect) {
    if bounds.width == 0 || bounds.height == 0 {
        return
    }
    view := turbo_ui.list_view(
        &app^.ui,
        760,
        761,
        bounds,
        app^.program_root_count,
        &app^.program_roots,
        .click_and_enter,
    )
    active := app^.program_root_count
    if app^.host.selected_root != nil {
        active = app^.host.selected_root(app^.host.user)
    }
    for index := view.first; index < view.end; index += 1 {
        row := turbo_ui.list_row_begin(&app^.ui, view, index)
        marker := "  "
        if index == active {
            marker = "* "
        }
        turbo_ui.write_clipped(
            app^.ui.surface,
            turbo_ui.intersect(app^.ui.clip, row.bounds),
            turbo_ui.Point{column = row.bounds.column, row = row.bounds.row},
            marker,
            row.style,
        )
        if row.bounds.width > 2 {
            label_bounds := turbo_ui.Rect{
                column = row.bounds.column + 2,
                row = row.bounds.row,
                width = row.bounds.width - 2,
                height = 1,
            }
            turbo_ui.write_clipped_bytes(
                app^.ui.surface,
                turbo_ui.intersect(app^.ui.clip, label_bounds),
                turbo_ui.Point{column = label_bounds.column, row = label_bounds.row},
                program_root_name(app, index),
                row.style,
            )
        }
    }
    if view.activated {
        if select_program_root(app, view.activated_index) {
            app^.status = "Active Program changed"
        } else {
            app^.status = "Could not activate the selected Program"
        }
    }
}

// paint_text_view delegates the shared line-scanning, focus, keyboard, wheel,
// and proportional-scrollbar policy to turbo_ui. App retains only the copied
// compiler bytes and one explicit viewport state per semantic window.
paint_text_view :: proc(
    app: ^App,
    window_index: usize,
    content: turbo_ui.Rect,
) {
    assert(window_index >= Text_Window_First && window_index < Window_Count,
        "tooling window index is invalid")
    text_index := window_index - Text_Window_First
    bytes := app^.tooling_text[text_index][:app^.tooling_length[text_index]]
    turbo_ui.text_view_bytes(
        &app^.ui,
        cast[turbo_ui.Widget_Id](700 + text_index),
        cast[turbo_ui.Widget_Id](720 + text_index),
        content,
        bytes,
        &app^.tooling_views[text_index],
    )
}

// paint_package_tree presents the compiler's structured package/import rows
// through turbo_ui's reusable preorder control. The compiler owns graph truth;
// this procedure owns only visibility, expansion, selection, and copied labels.
// A completed click or Enter toggles a package. Left/Right use conventional
// parent/child navigation supplied by tree_view.
paint_package_tree :: proc(app: ^App, content: turbo_ui.Rect) {
    visibility: [Maximum_Package_Rows]usize
    nodes := app^.package_nodes[:app^.package_row_count]
    view := turbo_ui.tree_view(
        &app^.ui,
        770,
        771,
        content,
        nodes,
        visibility[:],
        &app^.package_tree,
        .click_and_enter,
    )
    if view.toggled {
        info := app^.package_rows[view.toggled_node].info
        if info.kind == .package_node &&
            info.package_index < Maximum_Package_Rows {
            app^.package_expanded[info.package_index] =
                app^.package_nodes[view.toggled_node].expanded
        }
    }
    for visible_index := view.list.first;
        visible_index < view.list.end;
        visible_index += 1 {
        row := turbo_ui.tree_row_begin(
            &app^.ui,
            view,
            visible_index,
            nodes,
        )
        if !row.visible {
            continue
        }
        package_row := &app^.package_rows[row.model_index]
        marker := "  "
        if package_row^.info.kind == .package_node &&
            package_row^.info.root != 0 {
            marker = "* "
        }
        turbo_ui.write_clipped(
            app^.ui.surface,
            turbo_ui.intersect(app^.ui.clip, row.content),
            turbo_ui.Point{column = row.content.column, row = row.content.row},
            marker,
            row.style,
        )
        label_bounds := row.content
        if label_bounds.width > 2 {
            label_bounds.column += 2
            label_bounds.width -= 2
            turbo_ui.write_clipped_bytes(
                app^.ui.surface,
                turbo_ui.intersect(app^.ui.clip, label_bounds),
                turbo_ui.Point{
                    column = label_bounds.column,
                    row = label_bounds.row,
                },
                package_row^.text[:package_row^.length],
                row.style,
            )
        }
    }
}

paint_program_configuration :: proc(app: ^App, bounds: turbo_ui.Rect) {
    bytes := app^.program_configuration[
        :app^.program_configuration_length
    ]
    turbo_ui.text_view_bytes(
        &app^.ui,
        780,
        781,
        bounds,
        bytes,
        &app^.program_configuration_view,
    )
}

// paint_programs_view combines three explicit views of one selected Program:
// the root selector, its complete effective Build/Run configuration, and the
// structured reachable package graph. The service supplies configuration text
// after applying workspace/program precedence, so DraftIDE displays policy but
// never recreates manifest semantics. A provider without structured package
// rows still falls back to its retained package text.
paint_programs_view :: proc(app: ^App, content: turbo_ui.Rect) {
    if content.height < 8 {
        paint_text_view(app, Window_Programs, content)
        return
    }
    header := turbo_ui.Rect{
        column = content.column,
        row = content.row,
        width = content.width,
        height = 1,
    }
    turbo_ui.fill_rect(
        app^.ui.surface,
        app^.ui.clip,
        header,
        ' ',
        app^.ui.theme.border,
    )
    turbo_ui.write_clipped(
        app^.ui.surface,
        turbo_ui.intersect(app^.ui.clip, header),
        turbo_ui.Point{column = header.column, row = header.row},
        "Programs (* active; Enter selects)",
        app^.ui.theme.border,
    )
    picker_height: usize = 4
    if content.height < 12 {
        picker_height = 2
    }
    picker := turbo_ui.Rect{
        column = content.column,
        row = content.row + 1,
        width = content.width,
        height = picker_height,
    }
    paint_program_root_picker(app, picker)
    separator_row := picker.row + picker.height
    turbo_ui.fill_rect(
        app^.ui.surface,
        app^.ui.clip,
        turbo_ui.Rect{
            column = content.column,
            row = separator_row,
            width = content.width,
            height = 1,
        },
        ' ',
        app^.ui.theme.border,
    )
    turbo_ui.write_clipped(
        app^.ui.surface,
        turbo_ui.intersect(
            app^.ui.clip,
            turbo_ui.Rect{
                column = content.column,
                row = separator_row,
                width = content.width,
                height = 1,
            },
        ),
        turbo_ui.Point{column = content.column, row = separator_row},
        "Effective Build / Run Configuration",
        app^.ui.theme.border,
    )
    remaining := content.height - picker_height - 2
    configuration_height := remaining / 2
    if configuration_height == 0 {
        configuration_height = 1
    }
    configuration := turbo_ui.Rect{
        column = content.column,
        row = separator_row + 1,
        width = content.width,
        height = configuration_height,
    }
    paint_program_configuration(app, configuration)

    graph_header_row := configuration.row + configuration.height
    graph_header := turbo_ui.Rect{
        column = content.column,
        row = graph_header_row,
        width = content.width,
        height = 1,
    }
    turbo_ui.fill_rect(
        app^.ui.surface,
        app^.ui.clip,
        graph_header,
        ' ',
        app^.ui.theme.border,
    )
    turbo_ui.write_clipped(
        app^.ui.surface,
        turbo_ui.intersect(app^.ui.clip, graph_header),
        turbo_ui.Point{column = graph_header.column, row = graph_header.row},
        "Packages / Dependencies",
        app^.ui.theme.border,
    )
    graph: turbo_ui.Rect
    if graph_header_row + 1 < content.row + content.height {
        graph = turbo_ui.Rect{
            column = content.column,
            row = graph_header_row + 1,
            width = content.width,
            height = content.row + content.height - graph_header_row - 1,
        }
    }
    if graph.height != 0 && app^.package_row_count != 0 {
        paint_package_tree(app, graph)
    } else if graph.height != 0 {
        paint_text_view(app, Window_Programs, graph)
    }
}

save_active_buffer :: proc(app: ^App) {
    if turbo_editor.is_read_only(active_buffer(app)) {
        app^.status = "Compiler and dependency sources are read-only"
    } else if turbo_editor.save(active_buffer(app)) {
        app^.status = "Saved"
    } else if active_buffer(app)^.disk_conflict {
        app^.status = "Disk conflict: Save refused; Alt-X offers overwrite/discard"
    } else {
        app^.status = "Save failed"
    }
}

// undo_active/redo_active are application commands rather than editor-view
// key paths. This makes the advertised shortcuts and Edit menu work while a
// Sources or semantic window has focus, then refreshes compiler overlays only
// when document bytes actually changed.
undo_active :: proc(app: ^App) {
    if turbo_editor.is_read_only(active_buffer(app)) {
        app^.status = "Compiler and dependency sources are read-only"
    } else if turbo_editor.undo(active_buffer(app)) {
        source_changed(app)
        focus_editor(app)
        app^.status = "Undid last edit"
    } else {
        app^.status = "Nothing to undo"
    }
}

redo_active :: proc(app: ^App) {
    if turbo_editor.is_read_only(active_buffer(app)) {
        app^.status = "Compiler and dependency sources are read-only"
    } else if turbo_editor.redo(active_buffer(app)) {
        source_changed(app)
        focus_editor(app)
        app^.status = "Redid last edit"
    } else {
        app^.status = "Nothing to redo"
    }
}

// paint_app_menu_bar is the title pass. The matching drop-down pass runs after
// all desktop windows, allowing the shared popup layer to remain topmost.
paint_app_menu_bar :: proc(app: ^App, surface: ^tui.Surface) {
    turbo_ui.menu_bar(
        &app^.ui,
        &app^.menus,
        turbo_ui.Rect{width = surface^.columns, height = 1},
    )
    turbo_ui.menu_title(
        &app^.ui, &app^.menus,
        Menu_File, Menu_File_Popup,
        turbo_ui.Rect{column = 1, width = 8, height = 1},
        "File", cast[u8]('f'),
        turbo_ui.Rect{column = 1, row = 1, width = 31, height = 9},
    )
    turbo_ui.menu_title(
        &app^.ui, &app^.menus,
        Menu_Edit, Menu_Edit_Popup,
        turbo_ui.Rect{column = 9, width = 8, height = 1},
        "Edit", cast[u8]('e'),
        turbo_ui.Rect{column = 9, row = 1, width = 40, height = 16},
    )
    turbo_ui.menu_title(
        &app^.ui, &app^.menus,
        Menu_Build, Menu_Build_Popup,
        turbo_ui.Rect{column = 17, width = 8, height = 1},
        "Build", cast[u8]('b'),
        turbo_ui.Rect{column = 17, row = 1, width = 31, height = 10},
    )
    turbo_ui.menu_title(
        &app^.ui, &app^.menus,
        Menu_Window, Menu_Window_Popup,
        turbo_ui.Rect{column = 25, width = 10, height = 1},
        "Window", cast[u8]('w'),
        turbo_ui.Rect{column = 25, row = 1, width = 35, height = 17},
    )
    turbo_ui.menu_title(
        &app^.ui, &app^.menus,
        Menu_Help, Menu_Help_Popup,
        turbo_ui.Rect{column = 35, width = 8, height = 1},
        "Help", cast[u8]('h'),
        turbo_ui.Rect{column = 35, row = 1, width = 35, height = 3},
    )
    turbo_ui.menu_bar_end(&app^.ui, &app^.menus)
}

menu_window_toggle :: proc(
    app: ^App,
    menu: ^turbo_ui.Menu_Context,
    item_id: turbo_ui.Widget_Id,
    index: usize,
    label_text, shortcut: string,
    access_key: u8,
) {
    if turbo_ui.menu_check(
        &app^.ui,
        &app^.menus,
        menu,
        item_id,
        label_text,
        &app^.windows[index].visible,
        shortcut,
        access_key = access_key,
    ) {
        if app^.windows[index].visible {
            turbo_ui.show_window(
                &app^.ui,
                app^.windows[:],
                app^.windows[index].id,
            )
        } else {
            turbo_ui.hide_window(
                &app^.ui,
                app^.windows[:],
                app^.windows[index].id,
            )
        }
    }
}

// paint_app_menus contains direct application policy for menu actions. The UI
// returns activations and never retains callbacks, compiler handles, or Buffer
// pointers. Returning true means the complete clean/discard quit policy ended.
paint_app_menus :: proc(app: ^App) -> bool {
    should_quit := false
    file_menu := turbo_ui.begin_menu(
        &app^.ui, &app^.menus,
        Menu_File, Menu_File_Popup,
        turbo_ui.Rect{column = 1, row = 1, width = 31, height = 9},
    )
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &file_menu,
        536, "Workspace Sources...", "F2",
        access_key = cast[u8]('u'),
    ) {
        turbo_ui.show_window(
            &app^.ui,
            app^.windows[:],
            app^.windows[Window_Sources].id,
        )
        app^.ui.focused_id = 530
        app^.status = "Choose a workspace source and press Enter"
    }
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &file_menu,
        537, "Open File...", "",
        access_key = cast[u8]('o'),
    ) {
        request_open_file(app)
    }
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &file_menu,
        538, "Open Folder...", "", app^.host.open_workspace != nil,
        access_key = cast[u8]('f'),
    ) {
        request_open_folder(app)
    }
    turbo_ui.menu_separator(&app^.ui, &file_menu)
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &file_menu,
        540, "Save", "Ctrl-S",
        access_key = cast[u8]('s'),
    ) {
        save_active_buffer(app)
    }
    turbo_ui.menu_separator(&app^.ui, &file_menu)
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &file_menu,
        541, "Quit", "Alt-X",
        access_key = cast[u8]('q'),
    ) {
        should_quit = request_quit(app)
    }
    turbo_ui.end_menu(&app^.ui, &app^.menus, file_menu)

    edit_menu := turbo_ui.begin_menu(
        &app^.ui, &app^.menus,
        Menu_Edit, Menu_Edit_Popup,
        turbo_ui.Rect{column = 9, row = 1, width = 40, height = 16},
    )
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &edit_menu,
        542, "Undo", "Ctrl-Z",
        access_key = cast[u8]('u'),
    ) {
        undo_active(app)
    }
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &edit_menu,
        543, "Redo", "Ctrl-Y",
        access_key = cast[u8]('r'),
    ) {
        redo_active(app)
    }
    turbo_ui.menu_separator(&app^.ui, &edit_menu)
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &edit_menu,
        563, "Find...", "Ctrl-F",
        access_key = cast[u8]('f'),
    ) {
        request_search(app)
    }
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &edit_menu,
        564, "Find Next", "F3",
        access_key = cast[u8]('n'),
    ) {
        _ = perform_find(app, false)
    }
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &edit_menu,
        565, "Find Previous", "Shift-F3",
        access_key = cast[u8]('p'),
    ) {
        _ = perform_find(app, true)
    }
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &edit_menu,
        566, "Replace...", "Ctrl-H",
        access_key = cast[u8]('l'),
    ) {
        request_replace(app)
    }
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &edit_menu,
        567, "Replace Current", "Ctrl-R",
        access_key = cast[u8]('c'),
    ) {
        _ = replace_current(app, true)
    }
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &edit_menu,
        568, "Go to Line...", "Ctrl-G",
        access_key = cast[u8]('g'),
    ) {
        request_go_to_line(app)
    }
    turbo_ui.menu_separator(&app^.ui, &edit_menu)
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &edit_menu,
        569, "Go to Definition", "F12",
        app^.host.prepare_navigation != nil,
        access_key = cast[u8]('d'),
    ) {
        _ = go_to_definition(app)
    }
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &edit_menu,
        571, "Find Usages", "Shift-F12",
        app^.host.prepare_navigation != nil,
        access_key = cast[u8]('i'),
    ) {
        _ = find_symbol_usages(app)
    }
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &edit_menu,
        572, "Navigation Back", "Alt-Left",
        app^.navigation_history_count != 0 &&
            app^.navigation_history_index != 0,
        access_key = cast[u8]('b'),
    ) {
        _ = navigate_history(app, false)
    }
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &edit_menu,
        573, "Navigation Forward", "Alt-Right",
        app^.navigation_history_count != 0 &&
            app^.navigation_history_index + 1 <
                app^.navigation_history_count,
        access_key = cast[u8]('v'),
    ) {
        _ = navigate_history(app, true)
    }
    turbo_ui.end_menu(&app^.ui, &app^.menus, edit_menu)

    build_menu := turbo_ui.begin_menu(
        &app^.ui, &app^.menus,
        Menu_Build, Menu_Build_Popup,
        turbo_ui.Rect{column = 17, row = 1, width = 31, height = 10},
    )
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &build_menu,
        544, "Check", "", app^.host.check != nil,
        access_key = cast[u8]('c'),
    ) {
        refresh_host(app)
    }
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &build_menu,
        545, "Build", "", app^.host.build != nil,
        access_key = cast[u8]('b'),
    ) {
        host_action(app, false)
    }
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &build_menu,
        546, "Build and run", "F5", app^.host.build != nil,
        access_key = cast[u8]('r'),
    ) {
        host_action(app, true)
    }
    turbo_ui.menu_separator(&app^.ui, &build_menu)
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &build_menu,
        549, "Programs & packages...", "F6", app^.host.select_root != nil,
        access_key = cast[u8]('s'),
    ) {
        turbo_ui.show_window(
            &app^.ui,
            app^.windows[:],
            app^.windows[Window_Programs].id,
        )
        app^.ui.focused_id = 760
    }
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &build_menu,
        547, "Next Program", "", app^.host.select_root != nil,
        access_key = cast[u8]('n'),
    ) {
        cycle_program_root(app)
    }
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &build_menu,
        548, "Next target", "", app^.host.select_target != nil,
        access_key = cast[u8]('t'),
    ) {
        cycle_build_target(app)
    }
    turbo_ui.end_menu(&app^.ui, &app^.menus, build_menu)

    window_menu := turbo_ui.begin_menu(
        &app^.ui, &app^.menus,
        Menu_Window, Menu_Window_Popup,
        turbo_ui.Rect{column = 25, row = 1, width = 35, height = 17},
    )
    menu_window_toggle(
        app, &window_menu, 561, Window_Editor, "Editor", "", cast[u8]('e'),
    )
    menu_window_toggle(
        app, &window_menu, 550, Window_Sources,
        "Workspace Sources", "F2", cast[u8]('s'),
    )
    menu_window_toggle(
        app, &window_menu, 551, Window_Buffers,
        "Buffers", "Alt-0", cast[u8]('b'),
    )
    turbo_ui.menu_separator(&app^.ui, &window_menu)
    menu_window_toggle(
        app, &window_menu, 552, Window_Programs,
        "Programs & Packages", "F6", cast[u8]('p'),
    )
    menu_window_toggle(
        app, &window_menu, 553, Window_Declarations,
        "Declarations", "F7", cast[u8]('d'),
    )
    menu_window_toggle(
        app, &window_menu, 554, Window_References,
        "References", "F8", cast[u8]('r'),
    )
    menu_window_toggle(
        app, &window_menu, 555, Window_Effects, "Effects", "F9", cast[u8]('c'),
    )
    menu_window_toggle(
        app, &window_menu, 556, Window_Denials, "Denials", "F10", cast[u8]('n'),
    )
    menu_window_toggle(
        app, &window_menu, 557, Window_Diagnostics,
        "Diagnostics", "F11", cast[u8]('g'),
    )
    turbo_ui.menu_separator(&app^.ui, &window_menu)
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &window_menu,
        558, "Tile", "",
        access_key = cast[u8]('t'),
    ) {
        turbo_ui.tile_windows(app^.windows[:], app^.ui.desktop)
    }
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &window_menu,
        559, "Cascade", "",
        access_key = cast[u8]('a'),
    ) {
        turbo_ui.cascade_windows(app^.windows[:], app^.ui.desktop)
    }
    turbo_ui.menu_separator(&app^.ui, &window_menu)
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &window_menu,
        560, "Next window", "Ctrl-F6",
        access_key = cast[u8]('w'),
    ) {
        turbo_ui.activate_next_window(&app^.ui, app^.windows[:])
    }
    turbo_ui.end_menu(&app^.ui, &app^.menus, window_menu)

    help_menu := turbo_ui.begin_menu(
        &app^.ui, &app^.menus,
        Menu_Help, Menu_Help_Popup,
        turbo_ui.Rect{column = 35, row = 1, width = 35, height = 3},
    )
    if turbo_ui.menu_action(
        &app^.ui, &app^.menus, &help_menu,
        562, "Keyboard Shortcuts...", "F1",
        access_key = cast[u8]('k'),
    ) {
        request_shortcut_help(app)
    }
    turbo_ui.end_menu(&app^.ui, &app^.menus, help_menu)
    return should_quit
}

// paint_app performs one full desktop traversal and returns true only when an
// explicit clean/discard/save-and-quit path has completed.
paint_app :: proc(
    app: ^App,
    surface: ^tui.Surface,
    supplied_event: turbo_ui.Event,
) -> bool {
    // A formatted byte status must survive the event-free repaint requested by
    // immediate controls, but any later physical input begins a new command
    // and may replace it with an ordinary immutable status string.
    if supplied_event.kind != .none {
        app^.status_bytes_active = false
        app^.status_length = 0
    }
    (event, quit) := handle_global_key(app, supplied_event)
    if quit {
        return true
    }
    theme := turbo_ui.turbo_theme()
    editor_theme := turbo_editor.turbo_editor_theme()
    tui.clear(surface, theme.desktop)
    desktop := turbo_ui.Rect{row = 1, width = surface^.columns}
    if surface^.rows > 2 {
        desktop.height = surface^.rows - 2
    }
    modal := turbo_ui.No_Widget
    if app^.windows[Window_Quit].visible {
        modal = app^.windows[Window_Quit].id
    } else if app^.windows[Window_Help].visible {
        modal = app^.windows[Window_Help].id
    } else if app^.windows[Window_Replace].visible {
        modal = app^.windows[Window_Replace].id
    } else if app^.windows[Window_Go_To_Line].visible {
        modal = app^.windows[Window_Go_To_Line].id
    } else if app^.windows[Window_Search].visible {
        modal = app^.windows[Window_Search].id
    } else if app^.windows[Window_Folder_Confirm].visible {
        modal = app^.windows[Window_Folder_Confirm].id
    } else if app^.windows[Window_Open_Folder].visible {
        modal = app^.windows[Window_Open_Folder].id
    } else if app^.windows[Window_Open_File].visible {
        modal = app^.windows[Window_Open_File].id
    }
    turbo_ui.begin_window_frame(
        &app^.ui,
        surface,
        event,
        theme,
        app^.windows[:],
        desktop,
        modal,
    )
    paint_app_menu_bar(app, surface)

    order: [Window_Count]usize
    count := turbo_ui.window_order(app^.windows[:], order[:])
    should_quit := false
    for order_index: usize = 0; order_index < count; order_index += 1 {
        index := order[order_index]
        window := &app^.windows[index]
        title := "Workspace Sources (F2)"
        if index == Window_Editor {
            if turbo_editor.is_read_only(active_buffer(app)) {
                title = "Editor [read-only]"
            } else {
                title = "Editor"
            }
        } else if index == Window_Buffers {
            title = "Buffers"
        } else if index == Window_Search {
            title = "Find"
        } else if index == Window_Quit {
            title = "Unsaved changes"
        } else if index == Window_Diagnostics {
            title = "Diagnostics (F11)"
        } else if index == Window_Programs {
            title = "Programs & Packages (F6)"
        } else if index == Window_Declarations {
            title = "Declarations / visibility (F7)"
        } else if index == Window_References {
            if app^.semantic_usages_visible {
                title = "Symbol Usages (Shift-F12)"
            } else {
                title = "References / calls (F8)"
            }
        } else if index == Window_Effects {
            title = "Effects (F9)"
        } else if index == Window_Denials {
            title = "Denials (F10)"
        } else if index == Window_Open_Folder {
            title = "Open Folder"
        } else if index == Window_Open_File {
            title = "Open File"
        } else if index == Window_Folder_Confirm {
            title = "Unsaved buffers"
        } else if index == Window_Help {
            title = "Keyboard Shortcuts (F1)"
        } else if index == Window_Replace {
            title = "Replace"
        } else if index == Window_Go_To_Line {
            title = "Go to Line"
        }
        window_context: turbo_ui.Window_Context
        if index == Window_Search || index == Window_Quit ||
            index == Window_Open_Folder ||
            index == Window_Open_File ||
            index == Window_Folder_Confirm || index == Window_Help ||
            index == Window_Replace || index == Window_Go_To_Line {
            window_context = turbo_ui.dialog_begin(&app^.ui, window, title)
        } else {
            window_context = turbo_ui.begin_window(&app^.ui, window, title)
        }
        if window_context.visible {
            switch index {
            case Window_Editor:
                edit_result := turbo_editor.edit(
                    active_buffer(app),
                    &app^.ui,
                    cast[turbo_ui.Widget_Id](600 + app^.active),
                    window_context.content,
                    app^.syntax_spans[:app^.syntax_span_count],
                    editor_theme,
                )
                if edit_result.save_requested {
                    save_active_buffer(app)
                }
                if edit_result.search_requested {
                    request_search(app)
                }
                if edit_result.changed {
                    source_changed(app)
                }
            case Window_Sources:
                paint_path_list(
                    app,
                    window_context.content,
                    530,
                    .workspace_sources,
                )
            case Window_Buffers:
                paint_path_list(
                    app,
                    window_context.content,
                    532,
                    .open_buffers,
                )
            case Window_Search:
                paint_search(app, window_context.content)
            case Window_Quit:
                should_quit = paint_quit(app, window_context.content)
            case Window_Diagnostics:
                paint_text_view(app, index, window_context.content)
            case Window_Programs:
                paint_programs_view(app, window_context.content)
            case Window_Declarations:
                paint_text_view(app, index, window_context.content)
            case Window_References:
                if app^.semantic_usages_visible {
                    paint_navigation_usages(app, window_context.content)
                } else {
                    paint_text_view(app, index, window_context.content)
                }
            case Window_Effects:
                paint_text_view(app, index, window_context.content)
            case Window_Denials:
                paint_text_view(app, index, window_context.content)
            case Window_Open_Folder:
                paint_open_folder(app, window_context.content)
            case Window_Open_File:
                paint_open_file(app, window_context.content)
            case Window_Folder_Confirm:
                paint_folder_confirm(app, window_context.content)
            case Window_Help:
                paint_shortcut_help(app, window_context.content)
            case Window_Replace:
                paint_replace(app, window_context.content)
            case Window_Go_To_Line:
                paint_go_to_line(app, window_context.content)
            case:
            }
        }
        turbo_ui.end_window(&app^.ui, window_context)
        if window_context.close_requested {
            if index == Window_Search {
                close_search(app)
            } else if index == Window_Quit {
                cancel_quit(app)
            } else if index == Window_Open_Folder ||
                index == Window_Folder_Confirm {
                close_folder_dialogs(app)
                app^.status = "Open Folder cancelled"
            } else if index == Window_Open_File {
                close_open_file(app)
                app^.status = "Open File cancelled"
            } else if index == Window_Help {
                close_shortcut_help(app)
            } else if index == Window_Replace {
                close_replace(app)
            } else if index == Window_Go_To_Line {
                close_go_to_line(app)
            } else {
                turbo_ui.hide_window(&app^.ui, app^.windows[:], window^.id)
            }
        }
    }

    should_quit = should_quit || paint_app_menus(app)

    if surface^.rows != 0 {
        status_bounds := turbo_ui.Rect{
            row = surface^.rows - 1,
            width = surface^.columns,
            height = 1,
        }
        if app^.status_bytes_active {
            turbo_ui.status_bar_bytes(
                &app^.ui,
                status_bounds,
                app^.status_storage[:app^.status_length],
            )
        } else {
            turbo_ui.status_bar(&app^.ui, status_bounds, app^.status)
        }
    }
    turbo_ui.end_frame(&app^.ui)
    // A command result belongs to the physical input traversal which produced
    // it. Closing a popup can request one event-free visual reconciliation,
    // but that later traversal cannot reproduce an application exit command.
    // Preserve the completed command before considering repaint; otherwise a
    // mouse click visibly closes File while its true Quit result is replaced
    // by the false result of the no-event frame.
    if should_quit {
        return true
    }
    if turbo_ui.needs_repaint(&app^.ui) {
        // Some immediate controls resolve focus or menu selection after the
        // affected row has painted. Repaint once without reapplying the input
        // event so the desired surface and persistent interaction state agree
        // before the renderer publishes either one.
        return paint_app(app, surface, turbo_ui.no_event())
    }
    return should_quit
}

render_size :: proc(size: terminal.Size) -> (usize, usize, bool) {
    if size.columns == 0 || size.rows == 0 {
        return (0, 0, false)
    }
    columns := size.columns
    rows := size.rows
    if columns > Maximum_Columns {
        columns = Maximum_Columns
    }
    if rows > Maximum_Rows {
        rows = Maximum_Rows
    }
    return (columns, rows, true)
}

text_equal :: proc(left, right: string) -> bool {
    if len(left) != len(right) {
        return false
    }
    for index: usize = 0; index < len(left); index += 1 {
        if left[index] != right[index] {
            return false
        }
    }
    return true
}

has_smoke_argument :: proc() -> bool {
    for argument in os.args() {
        if text_equal(argument, "--smoke") {
            return true
        }
    }
    return false
}

run_smoke :: proc() -> int {
    app: App
    init_windows(&app)
    if !init_one_buffer(&app, "turbo-editor-smoke.draft") {
        return 1
    }
    defer destroy_app(&app)
    turbo_editor.insert_text(active_buffer(&app), "main :: proc() -> int { return 0 }\n")
    surface: tui.Surface
    tui.surface_init(&surface, 90, 30)
    defer tui.surface_destroy(&surface)
    paint_app(&app, &surface, turbo_ui.no_event())
    (cell, valid) := tui.cell_at(&surface, 5, 1)
    if !valid || cell.value == cast[rune](0) {
        return 1
    }
    if os.write_text_all(os.standard_output, "turbo editor smoke ok\n") != .none {
        return 1
    }
    return 0
}

// same_motion_observation identifies terminal motion reports which cannot
// change hover, drag, or modifier state. All-motion reporting may repeat the
// same cell many times; skipping those events avoids rebuilding a complete
// immediate-mode frame when the observable pointer state is unchanged.
same_motion_observation :: proc(left, right: turbo_ui.Mouse_Event) -> bool {
    return left.position.column == right.position.column &&
        left.position.row == right.position.row &&
        left.primary_down == right.primary_down &&
        left.shift == right.shift && left.alt == right.alt &&
        left.control == right.control
}

// shorten_timeout retains the smallest nonnegative event-loop deadline. A due
// deadline produces a zero-duration native poll; a future deadline cannot make
// the normal idle wait longer.
shorten_timeout :: proc(
    timeout: ^time.Duration,
    now, deadline: time.Duration,
) {
    remaining: time.Duration
    if deadline > now {
        remaining = deadline - now
    }
    if remaining < timeout^ {
        timeout^ = remaining
    }
}

// begin_run_output marks the primary terminal as child-owned before launch.
// stdout and stderr remain inherited rather than captured, which preserves
// interactive console programs and exact stream ordering. The header is
// emitted only after raw mode and the alternate screen have been suspended.
begin_run_output :: proc() -> io.Error {
    return os.write_text_all(
        os.standard_output,
        "\n--- DraftIDE Program Output ---\n",
    )
}

// wait_after_run leaves the child's output visible until the user acknowledges
// it. Input is in its restored cooked mode, so one read receives an ordinary
// line rather than terminal escape fragments. EOF is a valid acknowledgement;
// any other read/write failure prevents a safe return to the full-screen IDE.
wait_after_run :: proc(app: ^App) -> io.Error {
    if os.write_text_all(os.standard_output, "\n--- DraftIDE: ") != .none ||
        os.write_text_all(os.standard_output, app^.status) != .none ||
        os.write_text_all(
            os.standard_output,
            " ---\nPress Enter to return to DraftIDE...",
        ) != .none {
        return .unavailable
    }
    input: [128]u8
    for {
        (count, error) := os.read(os.standard_input, input[:])
        if error == .end_of_input {
            return .none
        }
        if error != .none {
            return error
        }
        for index: usize = 0; index < count; index += 1 {
            if input[index] == cast[u8]('\n') ||
                input[index] == cast[u8]('\r') {
                return .none
            }
        }
    }
    return .none
}

run_interactive :: proc(
    app: ^App,
    session: ^terminal.Session,
    screen: ^terminal.Screen,
    reporting: ^terminal.Mouse_Reporting,
    watcher: ^terminal.Resize_Watcher,
    initial_size: terminal.Size,
) -> io.Error {
    (columns, rows, available) := render_size(initial_size)
    if !available {
        return .unavailable
    }
    renderer: tui.Renderer
    tui.renderer_init(&renderer, columns, rows)
    defer tui.renderer_destroy(&renderer)
    decoder: terminal.Decoder
    input: [Input_Capacity]u8
    next_disk_poll := time.monotonic_now() + 1 * time.second
    escape_deadline: time.Duration
    scrollbar_repeat_deadline: time.Duration
    last_motion: turbo_ui.Mouse_Event
    last_motion_valid := false

    paint_app(app, tui.surface(&renderer), turbo_ui.no_event())
    if tui.present(&renderer, screen) != .none {
        return .unavailable
    }
    for {
        (size, changed, size_error) := terminal.poll_resize(watcher)
        if size_error != .none {
            return size_error
        }
        if changed {
            (new_columns, new_rows, new_available) := render_size(size)
            if !new_available {
                return .unavailable
            }
            tui.renderer_resize(&renderer, new_columns, new_rows)
            paint_app(app, tui.surface(&renderer), turbo_ui_terminal.resize(size))
            if tui.present(&renderer, screen) != .none {
                return .unavailable
            }
        }

        repaint := false
        now := time.monotonic_now()
        if now >= next_disk_poll {
            disk := turbo_editor.poll_disk(active_buffer(app))
            if disk == .conflict {
                app^.status = "Disk changed while buffer is dirty: explicit conflict"
                paint_app(app, tui.surface(&renderer), turbo_ui.no_event())
                repaint = true
            } else if disk == .reloaded {
                app^.status = "Reloaded changed file from disk"
                paint_app(app, tui.surface(&renderer), turbo_ui.no_event())
                repaint = true
            }
            next_disk_poll = now + 1 * time.second
        }

        // The ordinary idle wait remains coarse, but precise pending
        // interaction deadlines shorten it. Escape therefore resolves after
        // 25 ms even under continuous mouse traffic, and a held scrollbar
        // arrow repeats at its own UI cadence without a busy loop.
        read_timeout := Input_Idle_Timeout
        if terminal.decoder_pending(&decoder) {
            if escape_deadline == 0 {
                escape_deadline = now + Escape_Ambiguity_Timeout
            }
            shorten_timeout(&read_timeout, now, escape_deadline)
        } else {
            escape_deadline = 0
        }
        if turbo_ui.scrollbar_repeat_active(&app^.ui) {
            if scrollbar_repeat_deadline == 0 {
                scrollbar_repeat_deadline = now + Scrollbar_Initial_Repeat
            }
            shorten_timeout(&read_timeout, now, scrollbar_repeat_deadline)
        } else {
            scrollbar_repeat_deadline = 0
        }
        (count, read_error) := terminal.read(
            session,
            input[:],
            read_timeout,
        )
        if read_error == .end_of_input {
            return .none
        }
        if read_error != .none {
            return read_error
        }
        pending_motion: turbo_ui.Event
        motion_pending := false
        batch_count := count
        drained_batches: usize
        for {
            for index: usize = 0; index < batch_count; index += 1 {
                event := turbo_ui_terminal.decode(&decoder, input[index])
                if event.kind == .none {
                    continue
                }
                if event.kind == .mouse && event.mouse.action == .move {
                    // Motion is coalesced across every immediately queued
                    // native read, not merely within the first 128-byte batch.
                    // A press/release/wheel/key still flushes prior motion so
                    // capture and activation order remain exact.
                    pending_motion = event
                    motion_pending = true
                    continue
                }
                if motion_pending {
                    if !last_motion_valid || !same_motion_observation(
                        pending_motion.mouse,
                        last_motion,
                    ) {
                        if paint_app(
                            app,
                            tui.surface(&renderer),
                            pending_motion,
                        ) {
                            return .none
                        }
                        last_motion = pending_motion.mouse
                        last_motion_valid = true
                        repaint = true
                    }
                    motion_pending = false
                }
                if paint_app(app, tui.surface(&renderer), event) {
                    return .none
                }
                if event.kind == .mouse {
                    last_motion = event.mouse
                    last_motion_valid = true
                }
                repaint = true
            }
            drained_batches += 1
            if drained_batches == Input_Drain_Batch_Limit {
                // A terminal may generate motion indefinitely. Bound one
                // publication batch so fresh motion cannot starve rendering,
                // resize polling, disk polling, or Escape/repeat deadlines.
                break
            }
            (batch_count, read_error) = terminal.read(session, input[:], 0)
            if read_error == .end_of_input {
                return .none
            }
            if read_error != .none {
                return read_error
            }
            if batch_count == 0 {
                break
            }
        }
        if motion_pending {
            if !last_motion_valid || !same_motion_observation(
                pending_motion.mouse,
                last_motion,
            ) {
                if paint_app(app, tui.surface(&renderer), pending_motion) {
                    return .none
                }
                last_motion = pending_motion.mouse
                last_motion_valid = true
                repaint = true
            }
        }

        // Escape is both a complete key and the prefix of every terminal
        // control sequence. Resolve the private pending decoder state against
        // an explicit short deadline instead of waiting for a 100-ms empty
        // read. The time comparison runs after draining motion, so mouse input
        // cannot indefinitely postpone dialog/menu cancellation.
        now = time.monotonic_now()
        if terminal.decoder_pending(&decoder) {
            if escape_deadline == 0 {
                escape_deadline = now + Escape_Ambiguity_Timeout
            }
        } else {
            escape_deadline = 0
        }
        if escape_deadline != 0 && now >= escape_deadline {
            event := turbo_ui_terminal.flush(&decoder)
            escape_deadline = 0
            if event.kind != .none {
                if paint_app(app, tui.surface(&renderer), event) {
                    return .none
                }
                repaint = true
            }
        }

        if turbo_ui.scrollbar_repeat_active(&app^.ui) {
            if scrollbar_repeat_deadline == 0 {
                scrollbar_repeat_deadline = now + Scrollbar_Initial_Repeat
            } else if now >= scrollbar_repeat_deadline {
                if paint_app(
                    app,
                    tui.surface(&renderer),
                    turbo_ui.repeat_event(),
                ) {
                    return .none
                }
                repaint = true
                scrollbar_repeat_deadline = now + Scrollbar_Repeat_Interval
            }
        } else {
            scrollbar_repeat_deadline = 0
        }
        if app^.run_requested {
            app^.run_requested = false
            // Publish the "Run requested" frame before yielding the terminal,
            // then restore primary screen/input for the child process. Resume
            // in acquisition order and invalidate the renderer because the
            // child may have changed any visible cell.
            if repaint && tui.present(&renderer, screen) != .none {
                return .unavailable
            }
            mouse_suspended := terminal.suspend_mouse_reporting(reporting)
            screen_suspended := mouse_suspended &&
                terminal.suspend_screen(screen)
            input_suspended := screen_suspended && terminal.suspend(session)
            run_io_error: io.Error
            if mouse_suspended && screen_suspended && input_suspended {
                run_io_error = begin_run_output()
                if run_io_error == .none {
                    execute_host_action(app, true)
                    run_io_error = wait_after_run(app)
                }
            }
            input_resumed := input_suspended && terminal.resume(session)
            screen_resumed := input_resumed && terminal.resume_screen(screen)
            mouse_resumed := screen_resumed &&
                terminal.resume_mouse_reporting(reporting)
            tui.invalidate(&renderer)
            if !mouse_suspended || !screen_suspended || !input_suspended ||
                !input_resumed || !screen_resumed || !mouse_resumed {
                return .unavailable
            }
            if run_io_error != .none {
                return run_io_error
            }
            paint_app(app, tui.surface(&renderer), turbo_ui.no_event())
            if tui.present(&renderer, screen) != .none {
                return .unavailable
            }
            repaint = false
        }
        if repaint && tui.present(&renderer, screen) != .none {
            return .unavailable
        }
    }
    return .none
}

report_error :: proc(message: string) {
    error := os.write_text_all(os.standard_error, message)
    if error != .none {
        return
    }
}

// run_app_terminal is the one terminal-resource owner shared by every caller.
// Resources are acquired in input, resize, screen, mouse order and every
// resource cleanup runs in exact reverse order. After disabling mouse reports,
// the app discards reports already queued in raw input before returning that
// descriptor to the shell's cooked mode.
run_app_terminal :: proc(app: ^App) -> int {
    session: terminal.Session
    if terminal.begin_raw(&session, os.standard_input) != .none {
        report_error("turbo-editor: input is not a terminal; use --smoke\n")
        return 1
    }
    watcher: terminal.Resize_Watcher
    (initial_size, resize_error) := terminal.begin_resize_watch(
        &watcher,
        os.standard_output,
    )
    screen: terminal.Screen
    reporting: terminal.Mouse_Reporting
    run_error: io.Error = .unavailable
    if resize_error == .none &&
        terminal.begin_screen(&screen, os.standard_output) == .none &&
        terminal.begin_mouse_reporting(&reporting, &screen) == .none {
        run_error = run_interactive(
            app,
            &session,
            &screen,
            &reporting,
            &watcher,
            initial_size,
        )
    }

    mouse_restored := terminal.restore_mouse_reporting(&reporting)
    input_discarded := terminal.discard_pending_input(&session) == .none
    screen_restored := terminal.restore_screen(&screen)
    watch_ended := terminal.end_resize_watch(&watcher)
    input_restored := terminal.restore(&session)
    if !mouse_restored || !input_discarded || !screen_restored ||
        !watch_ended || !input_restored {
        report_error("turbo-editor: terminal cleanup failed\n")
        return 1
    }
    if run_error != .none {
        report_error("turbo-editor: terminal I/O failed\n")
        return 1
    }
    return 0
}

// run_with_host opens one caller-selected source file and attaches a synchronous
// compiler service for the lifetime of the ordinary Draft event loop. The host
// handle and procedure pointers are borrowed; the application copies neither.
pub run_with_host :: proc(
    source_path: string,
    host: draft_compiler_api.Host_Api,
) -> int {
    if len(source_path) == 0 {
        return 1
    }
    app: App
    init_windows(&app)
    if !init_one_buffer(&app, source_path) {
        return 1
    }
    defer destroy_app(&app)
    app.host = host
    bind_active_buffer_to_host_root(&app)
    refresh_program_roots(&app)
    refresh_workspace_sources(&app)
    app.status = "Turbo Draft compiler session attached"
    refresh_host(&app)
    if app.program_root_count > 1 {
        turbo_ui.show_window(
            &app.ui,
            app.windows[:],
            app.windows[Window_Programs].id,
        )
        app.ui.focused_id = 760
        app.status = "Choose the active Program in Programs & Packages"
    }
    return run_app_terminal(&app)
}

// run_with_host_bytes is the mutable-path counterpart used by a native service
// which writes its canonical source path into caller-owned Draft storage.
pub run_with_host_bytes :: proc(
    source_path: []u8,
    host: draft_compiler_api.Host_Api,
) -> int {
    if len(source_path) == 0 {
        return 1
    }
    app: App
    init_windows(&app)
    if !init_one_buffer_bytes(&app, source_path) {
        return 1
    }
    defer destroy_app(&app)
    app.host = host
    bind_active_buffer_to_host_root(&app)
    refresh_program_roots(&app)
    refresh_workspace_sources(&app)
    app.status = "Turbo Draft compiler session attached"
    refresh_host(&app)
    if app.program_root_count > 1 {
        turbo_ui.show_window(
            &app.ui,
            app.windows[:],
            app.windows[Window_Programs].id,
        )
        app.ui.focused_id = 760
        app.status = "Choose the active Program in Programs & Packages"
    }
    if has_smoke_argument() {
        if app.diagnostic_count != 0 || app.syntax_span_count == 0 ||
            app.tooling_length[1] == 0 || app.tooling_length[2] == 0 ||
            app.package_row_count == 0 {
            return 1
        }
        // The integration smoke exercises the same Build operation as F5,
        // including continuation of the manifest-selected root through native
        // publication. Merely painting compiler text would not prove that the
        // durable root-package selection is sufficient to build the program.
        execute_host_action(&app, false)
        artifact: [Host_Path_Capacity]u8
        if app.host.copy_artifact_path == nil ||
            app.host.copy_artifact_path(
                app.host.user,
                cast[[^]u8](&artifact[0]),
                len(artifact),
            ) == 0 {
            return 1
        }
        app.windows[Window_Programs].visible = true
        surface: tui.Surface
        tui.surface_init(&surface, 100, 30)
        defer tui.surface_destroy(&surface)
        paint_app(&app, &surface, turbo_ui.no_event())
        if os.write_text_all(os.standard_output, "draftide smoke ok\n") != .none {
            return 1
        }
        return 0
    }
    return run_app_terminal(&app)
}

// run_standalone is the complete example application entry below a tiny root
// package. It deliberately attaches no compiler host.
pub run_standalone :: proc() -> int {
    if has_smoke_argument() {
        return run_smoke()
    }
    app: App
    if !init_app(&app) {
        report_error("turbo-editor: could not open the requested buffers\n")
        return 1
    }
    defer destroy_app(&app)
    return run_app_terminal(&app)
}
