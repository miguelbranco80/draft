// Host integration contains the optional compiler-facing state transitions for
// DraftIDE. It copies variable-length service results into Draft ownership,
// maintains stable semantic navigation destinations, restores each document's
// root package before a compiler action, and translates Build/Run results into one
// explicit child-process request.
//
// The Host_Api remains a borrowed synchronous procedure table. No compiler or
// C ABI type beyond that public Draft record enters application state, and the
// standalone editor can link this module with an all-zero host.
package turbo_editor_app

import core/array
import core/format
import core/memory
import core/process
import core/time
import core/tui
import lib/draft_compiler_api
import lib/turbo_editor
import lib/turbo_ui

// Run_Configuration owns every variable-length service string for one
// synchronous child launch. The cstring arrays are ordinary Dynamic values,
// each built only after its corresponding owner list is complete; the complete
// configuration is not exposed unless every field loads successfully. Each
// string's bytes live in an independent allocation and therefore remain stable
// even if growing an owner array relocates its records.
Run_Configuration :: struct {
    argument_owners: array.Dynamic[memory.Owned_String],
    arguments: array.Dynamic[cstring],
    environment_owners: array.Dynamic[memory.Owned_String],
    environment: array.Dynamic[cstring],
    working_directory: memory.Owned_String,
    has_working_directory: bool,
}

// Prepared_Run owns the exact artifact path and run configuration copied after
// one successful F5 build. The event loop prepares this value while DraftIDE
// still owns the alternate screen, then suspends the terminal only when an
// executable is genuinely ready. This ownership boundary prevents a compiler
// failure from flashing an empty Program Output screen.
Prepared_Run :: struct {
    configuration: Run_Configuration,
    artifact_path: memory.Owned_String,
    has_artifact_path: bool,
}

// run_configuration_init establishes all four Dynamic owners before any
// service callback can fail. This makes the one destruction path valid after
// every partial load state.
run_configuration_init :: proc(configuration: ^Run_Configuration) {
    array.init(&configuration.argument_owners)
    array.init(&configuration.arguments)
    array.init(&configuration.environment_owners)
    array.init(&configuration.environment)
}

// run_configuration_destroy releases all service copies and is valid after a
// partially failed load. No cstring pointer is observed after its owner dies.
run_configuration_destroy :: proc(configuration: ^Run_Configuration) {
    array.destroy(&configuration.environment)
    for index: usize = 0; index < configuration.environment_owners.length; index += 1 {
        memory.owned_string_destroy(&configuration.environment_owners.data[index])
    }
    array.destroy(&configuration.environment_owners)
    array.destroy(&configuration.arguments)
    for index: usize = 0; index < configuration.argument_owners.length; index += 1 {
        memory.owned_string_destroy(&configuration.argument_owners.data[index])
    }
    array.destroy(&configuration.argument_owners)
    if configuration.has_working_directory {
        memory.owned_string_destroy(&configuration.working_directory)
    }
}

prepared_run_init :: proc(run: ^Prepared_Run) {
    run.has_artifact_path = false
}

prepared_run_destroy :: proc(run: ^Prepared_Run) {
    run_configuration_destroy(&run.configuration)
    if run.has_artifact_path {
        memory.owned_string_destroy(&run.artifact_path)
    }
}

// copy_host_text allocates from the service's reported complete size, then
// verifies that the second call observed the same value. A changed result would
// mean the supposedly synchronous selected configuration mutated mid-copy.
copy_host_text :: proc(
    user: rawptr,
    procedure: draft_compiler_api.Copy_Text_Proc,
    owned: ^memory.Owned_String,
) -> bool {
    length := procedure(user, nil, 0)
    if length == ~cast[usize](0) {
        return false
    }
    storage := cast[[^]u8](memory.allocate(length + 1, 1))
    copied := procedure(user, storage, length + 1)
    if copied != length {
        memory.free_bytes(cast[rawptr](storage), length + 1, 1)
        return false
    }
    memory.owned_string_copy_bytes(owned, storage[:length])
    memory.free_bytes(cast[rawptr](storage), length + 1, 1)
    return true
}

// append_bounded_text and append_bounded_bytes are the allocation-free writer
// used by status and Build Output. A false result leaves the already-written
// prefix intact and lets the caller replace it with a short static fallback;
// no compiler result is ever represented by an unterminated hidden owner.
append_bounded_text :: proc(
    destination: []u8,
    length: ^usize,
    source: string,
) -> bool {
    if length^ > len(destination) ||
        len(source) > len(destination) - length^ {
        return false
    }
    for index: usize = 0; index < len(source); index += 1 {
        destination[length^] = source[index]
        length^ += 1
    }
    return true
}

append_bounded_bytes :: proc(
    destination: []u8,
    length: ^usize,
    source: []u8,
) -> bool {
    if length^ > len(destination) ||
        len(source) > len(destination) - length^ {
        return false
    }
    for byte in source {
        destination[length^] = byte
        length^ += 1
    }
    return true
}

// append_elapsed formats monotonic nanoseconds as rounded hundredths of a
// second. Hundredths keep a status line stable while still distinguishing the
// fast interactive path; the underlying exact count remains in the service
// result and tests.
append_elapsed :: proc(
    destination: []u8,
    length: ^usize,
    nanoseconds: u64,
) -> bool {
    hundredths := nanoseconds / 10_000_000
    if nanoseconds % 10_000_000 >= 5_000_000 {
        hundredths += 1
    }
    whole := hundredths / 100
    fraction := hundredths % 100
    digits_storage: [20]u8
    (digits, formatted) := format.unsigned_decimal(digits_storage[:], whole)
    if !formatted || !append_bounded_bytes(destination, length, digits) ||
        !append_bounded_text(destination, length, ".") {
        return false
    }
    if fraction < 10 && !append_bounded_text(destination, length, "0") {
        return false
    }
    (digits, formatted) = format.unsigned_decimal(
        digits_storage[:],
        fraction,
    )
    return formatted && append_bounded_bytes(destination, length, digits) &&
        append_bounded_text(destination, length, "s")
}

begin_result_output :: proc(
    app: ^App,
    operation: string,
    succeeded: bool,
    elapsed_nanoseconds: u64,
) {
    app.build_output_length = 0
    app.build_output_view.offset = 0
    _ = append_bounded_text(
        app.build_output[:],
        &app.build_output_length,
        operation,
    )
    outcome := " failed in "
    if succeeded {
        outcome = " succeeded in "
    }
    _ = append_bounded_text(
        app.build_output[:],
        &app.build_output_length,
        outcome,
    )
    _ = append_elapsed(
        app.build_output[:],
        &app.build_output_length,
        elapsed_nanoseconds,
    )
    _ = append_bounded_text(
        app.build_output[:],
        &app.build_output_length,
        "\n",
    )
}

append_result_detail :: proc(app: ^App, label: string, value: []u8) {
    _ = append_bounded_text(
        app.build_output[:],
        &app.build_output_length,
        label,
    )
    _ = append_bounded_bytes(
        app.build_output[:],
        &app.build_output_length,
        value,
    )
    _ = append_bounded_text(
        app.build_output[:],
        &app.build_output_length,
        "\n",
    )
}

set_timed_status :: proc(
    app: ^App,
    prefix: string,
    elapsed_nanoseconds: u64,
    suffix: string,
) {
    app.status_length = 0
    valid := append_bounded_text(
        app.status_storage[:],
        &app.status_length,
        prefix,
    ) && append_elapsed(
        app.status_storage[:],
        &app.status_length,
        elapsed_nanoseconds,
    ) && append_bounded_text(
        app.status_storage[:],
        &app.status_length,
        suffix,
    )
    if !valid {
        app.status = "Compiler operation completed"
        app.status_length = 0
        app.status_bytes_active = false
        return
    }
    app.status_bytes_active = true
}

set_build_success_status :: proc(
    app: ^App,
    elapsed_nanoseconds: u64,
    artifact: []u8,
) {
    app.status_length = 0
    valid := append_bounded_text(
        app.status_storage[:],
        &app.status_length,
        "Build succeeded in ",
    ) && append_elapsed(
        app.status_storage[:],
        &app.status_length,
        elapsed_nanoseconds,
    ) && append_bounded_text(
        app.status_storage[:],
        &app.status_length,
        " → ",
    ) && append_bounded_bytes(
        app.status_storage[:],
        &app.status_length,
        artifact,
    )
    if !valid {
        app.status = "Build succeeded; artifact path exceeds status capacity"
        app.status_length = 0
        app.status_bytes_active = false
        return
    }
    app.status_bytes_active = true
}

// set_plain_status ends any earlier byte-formatted status explicitly. Several
// F5 phases run without an intervening input event, so assigning app.status
// alone would leave the status bar painting the earlier Build message.
set_plain_status :: proc(app: ^App, text: string) {
    app.status = text
    app.status_length = 0
    app.status_bytes_active = false
}

show_diagnostics :: proc(app: ^App) {
    turbo_ui.show_window(
        &app.ui,
        app.windows[:],
        app.windows[Window_Diagnostics].id,
    )
    app.ui.focused_id = 870
}

// activate_diagnostic copies one row while it belongs to the latest compiler
// attempt, retains non-workspace bytes as a read-only document, and reuses the
// ordinary navigation operation to select the exact half-open range. No text
// parsing or line-to-byte reconstruction occurs in the UI.
activate_diagnostic :: proc(app: ^App, index: usize) -> bool {
    if index >= app.diagnostic_row_count || app.host.diagnostic_row == nil ||
        app.host.copy_diagnostic_source_path == nil {
        app.status = "Diagnostic row is unavailable"
        return false
    }
    row: draft_compiler_api.Diagnostic_Row
    app.host.diagnostic_row(app.host.user, index, &row)
    if row.navigable == 0 {
        app.status = "This diagnostic has no source location"
        return false
    }
    target: Navigation_Target
    if !copy_host_indexed_text(
        app.host.user,
        app.host.copy_diagnostic_source_path,
        index,
        &target.path,
    ) || target.path.length == 0 || row.end < row.start {
        navigation_target_destroy(&target)
        app.status = "Diagnostic source path is unavailable"
        return false
    }
    target.start = row.start
    target.end = row.end
    target.line = row.line
    target.column = row.column
    target.editable = row.editable != 0
    path := memory.owned_string_bytes(&target.path)
    if !target.editable && buffer_index_for_path(app, path) == app.buffer_count {
        if app.host.copy_diagnostic_source_text == nil {
            navigation_target_destroy(&target)
            app.status = "Diagnostic source bytes are unavailable"
            return false
        }
        source: memory.Owned_String
        copied := copy_host_indexed_text(
            app.host.user,
            app.host.copy_diagnostic_source_text,
            index,
            &source,
        )
        if !copied || !init_one_read_only_buffer(
            app,
            path,
            memory.owned_string_bytes(&source),
        ) {
            if copied {
                memory.owned_string_destroy(&source)
            }
            navigation_target_destroy(&target)
            app.status = "Could not retain diagnostic source bytes"
            return false
        }
        memory.owned_string_destroy(&source)
    }
    opened := open_navigation_target(app, &target, true)
    navigation_target_destroy(&target)
    if !opened {
        app.status = "Could not open the diagnostic source range"
        return false
    }
    app.status = "Diagnostic source range selected"
    return true
}

// copy_host_indexed_text is the indexed counterpart to copy_host_text. The
// selected configuration must remain unchanged between the sizing/copy calls.
copy_host_indexed_text :: proc(
    user: rawptr,
    procedure: draft_compiler_api.Copy_Indexed_Text_Proc,
    index: usize,
    owned: ^memory.Owned_String,
) -> bool {
    length := procedure(user, index, nil, 0)
    if length == ~cast[usize](0) {
        return false
    }
    storage := cast[[^]u8](memory.allocate(length + 1, 1))
    copied := procedure(user, index, storage, length + 1)
    if copied != length {
        memory.free_bytes(cast[rawptr](storage), length + 1, 1)
        return false
    }
    memory.owned_string_copy_bytes(owned, storage[:length])
    memory.free_bytes(cast[rawptr](storage), length + 1, 1)
    return true
}

navigation_target_destroy :: proc(target: ^Navigation_Target) {
    memory.owned_string_destroy(&target.path)
    empty: Navigation_Target
    target^ = empty
}

navigation_target_copy :: proc(
    destination: ^Navigation_Target,
    source: ^Navigation_Target,
) {
    assert(destination.path.data == nil,
        "navigation destination must be empty before copy")
    memory.owned_string_copy_bytes(
        &destination.path,
        memory.owned_string_bytes(&source.path),
    )
    destination.start = source.start
    destination.end = source.end
    destination.line = source.line
    destination.column = source.column
    destination.editable = source.editable
}

navigation_target_equal :: proc(
    left, right: ^Navigation_Target,
) -> bool {
    return left.start == right.start && left.end == right.end &&
        byte_views_equal(
            memory.owned_string_bytes(&left.path),
            memory.owned_string_bytes(&right.path),
        )
}

clear_navigation_rows :: proc(app: ^App) {
    for index: usize = 0; index < app.navigation_row_count; index += 1 {
        navigation_target_destroy(&app.navigation_rows[index])
    }
    app.navigation_row_count = 0
    app.navigation_list.cursor = 0
    app.navigation_list.offset = 0
}

truncate_navigation_history :: proc(app: ^App, count: usize) {
    assert(count <= app.navigation_history_count,
        "navigation history truncation exceeds its row count")
    for index := count; index < app.navigation_history_count; index += 1 {
        navigation_target_destroy(&app.navigation_history[index])
    }
    app.navigation_history_count = count
    if count == 0 {
        app.navigation_history_index = 0
    } else if app.navigation_history_index >= count {
        app.navigation_history_index = count - 1
    }
}

append_navigation_history :: proc(
    app: ^App,
    target: ^Navigation_Target,
) -> bool {
    if app.navigation_history_count == Maximum_Navigation_History {
        // History is a convenience, not semantic state. Clearing at the fixed
        // bound keeps ownership and ordering obvious without a pointer-moving
        // ring whose oldest entry is practically unreachable in normal use.
        truncate_navigation_history(app, 0)
    }
    index := app.navigation_history_count
    navigation_target_copy(&app.navigation_history[index], target)
    app.navigation_history_count += 1
    app.navigation_history_index = index
    return true
}

current_navigation_target :: proc(
    app: ^App,
    target: ^Navigation_Target,
) {
    buffer := active_buffer(app)
    memory.owned_string_copy_bytes(
        &target.path,
        turbo_editor.path_bytes(buffer),
    )
    target.start = buffer.cursor
    target.end = buffer.cursor
    target.editable = !turbo_editor.is_read_only(buffer)
}

// record_navigation_transition applies browser-style history semantics. The
// current cursor is appended only when it differs from the indexed entry; all
// forward entries are destroyed before a new branch is created. Destination is
// copied last and becomes the current history index.
record_navigation_transition :: proc(
    app: ^App,
    destination: ^Navigation_Target,
) {
    if app.navigation_history_count != 0 {
        truncate_navigation_history(app, app.navigation_history_index + 1)
    }
    current: Navigation_Target
    current_navigation_target(app, &current)
    needs_current := app.navigation_history_count == 0 ||
        !navigation_target_equal(
            &app.navigation_history[app.navigation_history_count - 1],
            &current,
        )
    needs_destination := !navigation_target_equal(&current, destination)
    required_rows: usize
    if needs_current {
        required_rows += 1
    }
    if needs_destination {
        required_rows += 1
    }
    if app.navigation_history_count + required_rows >
        Maximum_Navigation_History {
        // Reserve the complete current/destination pair before appending it.
        // Letting append_navigation_history clear between those two writes
        // would strand history at the destination and lose the Back entry.
        truncate_navigation_history(app, 0)
        needs_current = true
    }
    if needs_current {
        _ = append_navigation_history(app, &current)
    }
    navigation_target_destroy(&current)
    if app.navigation_history_count == 0 ||
        !navigation_target_equal(
            &app.navigation_history[app.navigation_history_count - 1],
            destination,
        ) {
        _ = append_navigation_history(app, destination)
    }
}

// target_from_host copies every identity/range fact needed after the compiler
// performs another check. A zero/overflowing pathname is rejected rather than
// retaining a truncated file identity which could navigate to the wrong file.
target_from_host :: proc(
    app: ^App,
    location: draft_compiler_api.Navigation_Location,
    target: ^Navigation_Target,
) -> bool {
    if app.host.copy_navigation_source_path == nil ||
        app.host.navigation_source_editable == nil ||
        location.end < location.start {
        return false
    }
    if !copy_host_indexed_text(
        app.host.user,
        app.host.copy_navigation_source_path,
        location.source,
        &target.path,
    ) || target.path.length == 0 {
        navigation_target_destroy(target)
        return false
    }
    target.start = location.start
    target.end = location.end
    target.line = location.line
    target.column = location.column
    target.editable = app.host.navigation_source_editable(
        app.host.user,
        location.source,
    ) != 0
    return true
}

buffer_index_for_path :: proc(app: ^App, path: []u8) -> usize {
    for index: usize = 0; index < app.buffer_count; index += 1 {
        if byte_views_equal(turbo_editor.path_bytes(&app.buffers[index]), path) {
            return index
        }
    }
    return app.buffer_count
}

// retain_read_only_navigation_source copies a non-workspace source while its
// compiler FileId is still current. Usage rows retain only stable paths/ranges,
// so pre-opening each unique read-only source prevents a later successful check
// from making an old FileId necessary to display that row.
retain_read_only_navigation_source :: proc(
    app: ^App,
    location: draft_compiler_api.Navigation_Location,
    target: ^Navigation_Target,
) -> bool {
    if target.editable {
        return true
    }
    path := memory.owned_string_bytes(&target.path)
    if buffer_index_for_path(app, path) < app.buffer_count {
        return true
    }
    if app.host.copy_navigation_source_text == nil {
        return false
    }
    source: memory.Owned_String
    if !copy_host_indexed_text(
        app.host.user,
        app.host.copy_navigation_source_text,
        location.source,
        &source,
    ) {
        return false
    }
    opened := init_one_read_only_buffer(
        app,
        path,
        memory.owned_string_bytes(&source),
    )
    memory.owned_string_destroy(&source)
    return opened
}

// open_navigation_target reuses unsaved workspace buffers, loads unopened
// editable files normally, and selects exact source bytes. Read-only sources
// must already have been retained while their host FileId was valid. History is
// recorded only after the destination buffer/range has been validated.
open_navigation_target :: proc(
    app: ^App,
    target: ^Navigation_Target,
    record_history: bool,
) -> bool {
    path := memory.owned_string_bytes(&target.path)
    index := buffer_index_for_path(app, path)
    if index == app.buffer_count {
        if !target.editable || !init_one_buffer_bytes(app, path) {
            return false
        }
        index = app.buffer_count - 1
        if app.host.selected_root != nil {
            app.buffer_root[index] = app.host.selected_root(app.host.user)
            app.buffer_has_root[index] = true
        }
    }
    buffer := &app.buffers[index]
    if target.end < target.start || target.end > buffer.bytes.length {
        return false
    }
    if record_history {
        record_navigation_transition(app, target)
    }
    if !activate_buffer(app, index) {
        return false
    }
    buffer = active_buffer(app)
    buffer.anchor = target.start
    buffer.cursor = target.end
    buffer.selection_active = target.end != target.start
    buffer.preferred_column_valid = false
    buffer.reveal_cursor = true
    focus_editor(app)
    return true
}

navigation_status_message :: proc(
    app: ^App,
    status: draft_compiler_api.Navigation_Status,
) {
    switch status {
    case .unavailable:
        app.status = "Semantic navigation is unavailable"
    case .current_check_failed:
        app.status = "Fix current check errors before semantic navigation"
    case .source_not_found:
        app.status = "Active document is outside the checked source graph"
    case .no_symbol:
        app.status = "No symbol at the cursor"
    case .no_definition:
        app.status = "The selected symbol has no source definition"
    case .ready:
        app.status = "Semantic navigation ready"
    }
}

prepare_navigation :: proc(app: ^App) -> draft_compiler_api.Navigation_Status {
    if app.host.prepare_navigation == nil {
        return .unavailable
    }
    // Exact semantic locations cannot be read from the retained last-good
    // graph after an edit. Navigation is an explicit semantic command, so it
    // may pay for one complete check here while ordinary typing never does.
    if app.semantic_dirty && !refresh_host(app) {
        return .current_check_failed
    }
    buffer := active_buffer(app)
    path := turbo_editor.path_bytes(buffer)
    path_data: rawptr = nil
    if len(path) != 0 {
        path_data = cast[rawptr](&path[0])
    }
    raw_status := app.host.prepare_navigation(
        app.host.user,
        path_data,
        len(path),
        buffer.cursor,
    )
    // The public enum has six fixed C-ABI ordinals, unavailable through ready.
    if raw_status > 5 {
        return .unavailable
    }
    return cast[draft_compiler_api.Navigation_Status](raw_status)
}

go_to_definition :: proc(app: ^App) -> bool {
    status := prepare_navigation(app)
    if status != .ready || app.host.navigation_definition == nil {
        navigation_status_message(app, status)
        return false
    }
    location: draft_compiler_api.Navigation_Location
    app.host.navigation_definition(app.host.user, &location)
    target: Navigation_Target
    if !target_from_host(app, location, &target) ||
        !retain_read_only_navigation_source(app, location, &target) {
        navigation_target_destroy(&target)
        app.status = "Could not retain the definition source"
        return false
    }
    opened := open_navigation_target(app, &target, true)
    navigation_target_destroy(&target)
    if !opened {
        app.status = "Could not open the definition source range"
        return false
    }
    app.status = "Definition selected"
    return true
}

find_symbol_usages :: proc(app: ^App) -> bool {
    clear_navigation_rows(app)
    status := prepare_navigation(app)
    if status != .ready || app.host.navigation_usage_count == nil ||
        app.host.navigation_usage == nil {
        navigation_status_message(app, status)
        return false
    }
    count := app.host.navigation_usage_count(app.host.user)
    if count > Maximum_Navigation_Rows {
        count = Maximum_Navigation_Rows
    }
    for index: usize = 0; index < count; index += 1 {
        location: draft_compiler_api.Navigation_Location
        app.host.navigation_usage(app.host.user, index, &location)
        target := &app.navigation_rows[app.navigation_row_count]
        if !target_from_host(app, location, target) ||
            !retain_read_only_navigation_source(app, location, target) {
            navigation_target_destroy(target)
            clear_navigation_rows(app)
            app.status = "Could not retain semantic usage sources"
            return false
        }
        app.navigation_row_count += 1
    }
    app.semantic_usages_visible = true
    turbo_ui.show_window(
        &app.ui,
        app.windows[:],
        app.windows[Window_References].id,
    )
    app.ui.focused_id = 820
    if app.navigation_row_count == 0 {
        app.status = "No usages found"
    } else {
        app.status = "Usages: Enter opens the selected source range"
    }
    return true
}

navigate_history :: proc(app: ^App, forward: bool) -> bool {
    if app.navigation_history_count == 0 ||
        (!forward && app.navigation_history_index == 0) ||
        (forward && app.navigation_history_index + 1 >=
            app.navigation_history_count) {
        app.status = "No semantic navigation history in that direction"
        return false
    }
    previous := app.navigation_history_index
    if forward {
        app.navigation_history_index += 1
    } else {
        app.navigation_history_index -= 1
    }
    target := &app.navigation_history[app.navigation_history_index]
    if !open_navigation_target(app, target, false) {
        app.navigation_history_index = previous
        app.status = "Could not reopen the navigation history location"
        return false
    }
    if forward {
        app.status = "Moved forward in semantic navigation history"
    } else {
        app.status = "Moved back in semantic navigation history"
    }
    return true
}

// load_run_rows copies one ordered string list and only then builds the exact
// cstring table borrowed by core/process. Partial owners remain destroyable by
// run_configuration_destroy when a service callback changes or fails.
load_run_rows :: proc(
    user: rawptr,
    count_procedure: draft_compiler_api.Count_Proc,
    copy_procedure: draft_compiler_api.Copy_Indexed_Text_Proc,
    owners: ^array.Dynamic[memory.Owned_String],
    pointers: ^array.Dynamic[cstring],
) -> bool {
    if count_procedure == nil || copy_procedure == nil {
        return true
    }
    count := count_procedure(user)
    for index: usize = 0; index < count; index += 1 {
        owned: memory.Owned_String
        if !copy_host_indexed_text(user, copy_procedure, index, &owned) {
            return false
        }
        array.append(owners, owned)
    }
    array.reserve(pointers, owners.length)
    for index: usize = 0; index < owners.length; index += 1 {
        array.append(
            pointers,
            memory.owned_string_cstring(&owners.data[index]),
        )
    }
    return true
}

// copy_run_working_directory_override gives an IDE-entered relative path the
// same meaning as a relative `draft.workspace` value: both are anchored at the
// active Workspace, never at whichever shell directory launched DraftIDE. An
// absolute spelling remains exact. The complete path is formed before an owner
// is installed, so overflow or a missing Workspace coordinate cannot launch a
// child in an accidental directory.
copy_run_working_directory_override :: proc(
    app: ^App,
    working: []u8,
    destination: ^memory.Owned_String,
) -> bool {
    if path_is_absolute(working) {
        memory.owned_string_copy_bytes(destination, working)
        return true
    }
    if !app.workspace_open || app.host.copy_workspace_path == nil {
        return false
    }
    workspace_storage: [Host_Path_Capacity]u8
    workspace_length := app.host.copy_workspace_path(
        app.host.user,
        cast[[^]u8](&workspace_storage[0]),
        len(workspace_storage),
    )
    if workspace_length == 0 || workspace_length >= len(workspace_storage) {
        return false
    }
    resolved_storage: [Host_Path_Capacity]u8
    (resolved, valid) := join_path(
        workspace_storage[:workspace_length],
        working,
        resolved_storage[:],
    )
    if !valid {
        return false
    }
    memory.owned_string_copy_bytes(destination, resolved)
    return true
}

// load_run_configuration snapshots the selected root's complete run tail after
// a successful build. It performs no launch and leaves one destroyable owner
// even when a callback fails midway.
load_run_configuration :: proc(
    app: ^App,
    configuration: ^Run_Configuration,
) -> bool {
    run_configuration_init(configuration)
    if app.run_configuration_loaded && app.run_configuration_overridden &&
        app.host.selected_root != nil &&
        app.run_configuration_root == app.host.selected_root(app.host.user) {
        for index: usize = 0; index < app.run_argument_count; index += 1 {
            owned: memory.Owned_String
            memory.owned_string_copy_bytes(
                &owned,
                run_argument_bytes(app, index),
            )
            array.append(&configuration.argument_owners, owned)
        }
        array.reserve(
            &configuration.arguments,
            configuration.argument_owners.length,
        )
        for index: usize = 0;
            index < configuration.argument_owners.length;
            index += 1 {
            array.append(
                &configuration.arguments,
                memory.owned_string_cstring(
                    &configuration.argument_owners.data[index],
                ),
            )
        }
        for index: usize = 0; index < app.run_environment_count; index += 1 {
            row := run_environment_bytes(app, index)
            if !environment_row_valid(row) {
                return false
            }
            owned: memory.Owned_String
            memory.owned_string_copy_bytes(&owned, row)
            array.append(&configuration.environment_owners, owned)
        }
        array.reserve(
            &configuration.environment,
            configuration.environment_owners.length,
        )
        for index: usize = 0;
            index < configuration.environment_owners.length;
            index += 1 {
            array.append(
                &configuration.environment,
                memory.owned_string_cstring(
                    &configuration.environment_owners.data[index],
                ),
            )
        }
        working := turbo_ui.text_box_bytes(
            &app.run_working_directory_box,
            app.run_working_directory[:],
        )
        if len(working) != 0 {
            if !copy_run_working_directory_override(
                app,
                working,
                &configuration.working_directory,
            ) {
                app.status = "Run working directory is not a valid Workspace path"
                return false
            }
            configuration.has_working_directory = true
        }
        return true
    }
    if !load_run_rows(
        app.host.user,
        app.host.run_argument_count,
        app.host.copy_run_argument,
        &configuration.argument_owners,
        &configuration.arguments,
    ) || !load_run_rows(
        app.host.user,
        app.host.run_environment_count,
        app.host.copy_run_environment,
        &configuration.environment_owners,
        &configuration.environment,
    ) {
        return false
    }
    if app.host.copy_run_working_directory != nil {
        length := app.host.copy_run_working_directory(
            app.host.user,
            nil,
            0,
        )
        if length != 0 {
            if !copy_host_text(
                app.host.user,
                app.host.copy_run_working_directory,
                &configuration.working_directory,
            ) {
                return false
            }
            configuration.has_working_directory = true
        }
    }
    return true
}

// build_active submits all current root-owned overlays and publishes one
// complete Build Output replacement. A compiler failure raises Diagnostics;
// success never changes its visibility. When artifact_output is non-nil,
// ownership of the copied artifact path moves to the caller for F5 preparation.
build_active :: proc(
    app: ^App,
    artifact_output: ^memory.Owned_String = nil,
) -> bool {
    if app.host.build == nil {
        app.status = "No compiler host is attached"
        return false
    }
    overlays: [Maximum_Buffers]draft_compiler_api.Overlay
    (overlay_count, active_overlay, valid_overlays) := collect_host_overlays(
        app,
        overlays[:],
    )
    if !valid_overlays {
        app.status = "Active file is not part of the active root package"
        return false
    }
    result: draft_compiler_api.Result
    app.host.build(
        app.host.user,
        &overlays[0],
        overlay_count,
        active_overlay,
        &result,
    )
    app.semantic_dirty = false
    app.diagnostic_count = result.diagnostic_count
    copy_syntax_spans(app, result.span_count)
    begin_result_output(
        app,
        "Build",
        result.success != 0,
        result.elapsed_nanoseconds,
    )
    refresh_tooling_text(app)
    if result.success == 0 {
        _ = append_bounded_text(
            app.build_output[:],
            &app.build_output_length,
            "See Diagnostics for compiler errors.\n",
        )
        set_timed_status(
            app,
            "Build failed in ",
            result.elapsed_nanoseconds,
            "; see Diagnostics",
        )
        show_diagnostics(app)
        return false
    }
    if app.host.copy_artifact_path == nil {
        set_plain_status(
            app,
            "Build succeeded, but no artifact path was published",
        )
        _ = append_bounded_text(
            app.build_output[:],
            &app.build_output_length,
            "Artifact path unavailable.\n",
        )
        turbo_ui.show_window(
            &app.ui,
            app.windows[:],
            app.windows[Window_Build_Output].id,
        )
        return false
    }
    owned_path: memory.Owned_String
    path_copied := copy_host_text(
        app.host.user,
        app.host.copy_artifact_path,
        &owned_path,
    )
    if !path_copied || owned_path.length == 0 {
        if path_copied {
            memory.owned_string_destroy(&owned_path)
        }
        set_plain_status(
            app,
            "Build succeeded, but its artifact path is unavailable",
        )
        _ = append_bounded_text(
            app.build_output[:],
            &app.build_output_length,
            "Artifact path unavailable.\n",
        )
        turbo_ui.show_window(
            &app.ui,
            app.windows[:],
            app.windows[Window_Build_Output].id,
        )
        return false
    }
    path := memory.owned_string_bytes(&owned_path)
    append_result_detail(app, "Artifact: ", path)
    set_build_success_status(app, result.elapsed_nanoseconds, path)
    if artifact_output == nil {
        memory.owned_string_destroy(&owned_path)
    } else {
        artifact_output^ = owned_path
    }
    return true
}

// prepare_run keeps all build and configuration work inside the IDE screen.
// Its caller must initialize and later destroy prepared. A false return means
// no child should be launched and, for compiler failures, Diagnostics is
// already visible and active.
prepare_run :: proc(app: ^App, prepared: ^Prepared_Run) -> bool {
    if !build_active(app, &prepared.artifact_path) {
        return false
    }
    prepared.has_artifact_path = true
    artifact_kind: draft_compiler_api.Artifact_Kind = .executable
    if app.host.artifact_kind != nil {
        artifact_kind = cast[draft_compiler_api.Artifact_Kind](
            app.host.artifact_kind(app.host.user),
        )
    }
    if artifact_kind != .executable {
        set_plain_status(
            app,
            "Build succeeded; the selected artifact is not executable",
        )
        _ = append_bounded_text(
            app.build_output[:],
            &app.build_output_length,
            "Run not started: selected artifact is not executable.\n",
        )
        turbo_ui.show_window(
            &app.ui,
            app.windows[:],
            app.windows[Window_Build_Output].id,
        )
        return false
    }
    if !load_run_configuration(app, &prepared.configuration) {
        set_plain_status(
            app,
            "Build succeeded; run configuration could not be read",
        )
        _ = append_bounded_text(
            app.build_output[:],
            &app.build_output_length,
            "Run not started: run configuration is unavailable.\n",
        )
        turbo_ui.show_window(
            &app.ui,
            app.windows[:],
            app.windows[Window_Build_Output].id,
        )
        return false
    }
    return true
}

// execute_prepared_run owns only child execution and Run Results. It never
// refreshes compiler diagnostics or changes the Diagnostics window, so a
// nonzero exit or signal remains runtime output rather than masquerading as a
// language error.
execute_prepared_run :: proc(app: ^App, prepared: ^Prepared_Run) {
    working_directory: cstring
    if prepared.configuration.has_working_directory {
        working_directory = memory.owned_string_cstring(
            &prepared.configuration.working_directory,
        )
    }
    options := process.Options{
        arguments = array.view(&prepared.configuration.arguments),
        environment = array.view(&prepared.configuration.environment),
        working_directory = working_directory,
    }
    started := time.monotonic_now()
    launched := process.run_with_options(
        memory.owned_string_cstring(&prepared.artifact_path),
        options,
    )
    finished := time.monotonic_now()
    elapsed_nanoseconds: u64
    if finished >= started {
        elapsed_nanoseconds = cast[u64](cast[i64](finished - started))
    }
    _ = append_bounded_text(
        app.build_output[:],
        &app.build_output_length,
        "\nRun ",
    )
    succeeded := launched.error == .none && launched.exited &&
        launched.exit_code == 0
    outcome := "failed in "
    if succeeded {
        outcome = "succeeded in "
    }
    _ = append_bounded_text(
        app.build_output[:],
        &app.build_output_length,
        outcome,
    )
    _ = append_elapsed(
        app.build_output[:],
        &app.build_output_length,
        elapsed_nanoseconds,
    )
    _ = append_bounded_text(
        app.build_output[:],
        &app.build_output_length,
        "\n",
    )
    if launched.error == .invalid_options {
        set_plain_status(app, "Run failed: selected configuration is invalid")
        _ = append_bounded_text(
            app.build_output[:],
            &app.build_output_length,
            "Result: invalid run configuration.\n",
        )
    } else if launched.error != .none {
        set_plain_status(app, "Run failed: could not launch the built program")
        _ = append_bounded_text(
            app.build_output[:],
            &app.build_output_length,
            "Result: child process could not be launched.\n",
        )
    } else if !launched.exited {
        set_plain_status(app, "Run failed: program terminated by a signal")
        _ = append_bounded_text(
            app.build_output[:],
            &app.build_output_length,
            "Result: program terminated by a signal.\n",
        )
    } else if launched.exit_code != 0 {
        set_plain_status(app, "Run failed: program returned a nonzero status")
        _ = append_bounded_text(
            app.build_output[:],
            &app.build_output_length,
            "Result: program returned a nonzero status.\n",
        )
    } else {
        set_timed_status(
            app,
            "Run succeeded in ",
            elapsed_nanoseconds,
            "",
        )
        _ = append_bounded_text(
            app.build_output[:],
            &app.build_output_length,
            "Result: exit status 0.\n",
        )
    }
}

host_action :: proc(app: ^App, run: bool) {
    if run {
        if app.host.build == nil {
            app.status = "No compiler host is attached"
            return
        }
        app.run_requested = true
        app.status = "Run requested"
        return
    }
    _ = build_active(app)
}

// build_all_programs builds each compiler-discovered executable root exactly
// once in the service's deterministic order. Root selection remains the one
// transactional operation used everywhere else, so each build sees only the
// overlays associated with that root. The user's original root and document
// are restored even when an intermediate root fails.
build_all_programs :: proc(app: ^App) {
    if app.host.root_count == nil || app.host.selected_root == nil ||
        app.host.select_root == nil || app.host.build == nil {
        app.status = "No compiler workspace is attached"
        return
    }
    count := app.host.root_count(app.host.user)
    if count == 0 {
        app.status = "Workspace contains no buildable programs"
        return
    }
    original_root := app.host.selected_root(app.host.user)
    original_document := app.active
    completed: usize
    for index: usize = 0; index < count; index += 1 {
        if !select_root_package(app, index) || !build_active(app) {
            break
        }
        completed += 1
    }
    _ = select_root_package(app, original_root)
    if original_document < app.buffer_count {
        _ = activate_buffer(app, original_document)
    }
    if completed == count {
        app.status = "Built all workspace programs"
    } else {
        app.status = "Build All stopped at the first failed program"
    }
    app.status_bytes_active = false
    app.status_length = 0
}

byte_views_equal :: proc(left, right: []u8) -> bool {
    if len(left) != len(right) {
        return false
    }
    for index: usize = 0; index < len(left); index += 1 {
        if left[index] != right[index] {
            return false
        }
    }
    return true
}

reachable_source_index :: proc(app: ^App, path: []u8) -> usize {
    for index: usize = 0; index < app.reachable_source_count; index += 1 {
        if byte_views_equal(
            path,
            memory.owned_string_bytes(&app.reachable_source_paths[index]),
        ) {
            return index
        }
    }
    return app.reachable_source_count
}

// open_selected_host_source synchronizes the editor's active buffer with the
// source path selected by the compiler service. Existing dirty buffers remain
// open and are reselected without reloading; a new root consumes one ordinary
// buffer slot and follows the same explicit disk-load policy as any file.
open_selected_host_source :: proc(app: ^App) -> bool {
    if app.host.copy_source_path == nil {
        return false
    }
    storage: [Host_Path_Capacity]u8
    length := app.host.copy_source_path(
        app.host.user,
        cast[[^]u8](&storage[0]),
        len(storage),
    )
    if length == 0 || length >= len(storage) {
        return false
    }
    path := storage[:length]
    selected_root := app.host.selected_root(app.host.user)
    for index: usize = 0; index < app.buffer_count; index += 1 {
        if byte_views_equal(turbo_editor.path_bytes(&app.buffers[index]), path) {
            app.buffer_root[index] = selected_root
            app.buffer_has_root[index] = true
            return activate_buffer(app, index)
        }
    }
    if !init_one_buffer_bytes(app, path) {
        return false
    }
    app.active = app.buffer_count - 1
    app.open_documents.cursor = app.active
    app.buffer_root[app.active] = selected_root
    app.buffer_has_root[app.active] = true
    return activate_buffer(app, app.active)
}

// select_root_package is the single UI transition for Compiler Options.
// The compiler service changes first; the editor then opens or reselects the
// exact source path published for that root. Failure restores the previous
// service root before any editor buffer can be compiled under it.
select_root_package :: proc(app: ^App, selected: usize) -> bool {
    if app.host.root_count == nil || app.host.selected_root == nil ||
        app.host.select_root == nil || selected >= app.host.root_count(app.host.user) {
        return false
    }
    previous := app.host.selected_root(app.host.user)
    if selected != previous && app.host.select_root(app.host.user, selected) == 0 {
        return false
    }
    refresh_root_packages(app)
    refresh_reachable_sources(app)
    if open_selected_host_source(app) {
        app.semantic_dirty = true
        app.run_configuration_loaded = false
        app.run_configuration_overridden = false
        refresh_tooling_text(app)
        if selected < app.root_package_count {
            app.root_packages.cursor = selected
        }
        return true
    }
    if selected != previous {
        app.host.select_root(app.host.user, previous)
    }
    refresh_root_packages(app)
    refresh_reachable_sources(app)
    return false
}

// select_build_target is the exact Compiler Options transition. It performs
// the same transactional restore as root selection: the service changes first,
// then Draft-owned root/source tables and the selected source are refreshed;
// failure puts the previous target and UI rows back before returning.
select_build_target :: proc(app: ^App, selected: usize) -> bool {
    if app.host.target == nil || app.host.select_target == nil || selected >= 4 {
        return false
    }
    previous := app.host.target(app.host.user)
    if previous >= 4 {
        return false
    }
    if selected != cast[usize](previous) &&
        app.host.select_target(app.host.user, cast[u8](selected)) == 0 {
        return false
    }
    refresh_root_packages(app)
    refresh_reachable_sources(app)
    if open_selected_host_source(app) {
        app.selected_target = selected
        app.semantic_dirty = true
        app.run_configuration_loaded = false
        app.run_configuration_overridden = false
        refresh_tooling_text(app)
        return true
    }
    if selected != cast[usize](previous) {
        app.host.select_target(app.host.user, previous)
    }
    refresh_root_packages(app)
    refresh_reachable_sources(app)
    app.selected_target = cast[usize](previous)
    return false
}
