// The real compiler-service test proves native Build. This same-package test
// proves the Draft-owned half of Run: the application consumes an artifact
// path through the host table and launches it through core/process rather than
// delegating process policy back to C++.
test_draft_owned_run :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-editor-run-test.draft"))
    defer destroy_app(&app)
    app.host.build = fake_build
    app.host.copy_artifact_path = fake_artifact_path
    app.host.artifact_kind = fake_artifact_kind
    app.host.run_argument_count = fake_run_argument_count
    app.host.copy_run_argument = fake_run_argument
    app.host.run_environment_count = fake_run_environment_count
    app.host.copy_run_environment = fake_run_environment
    app.host.copy_run_working_directory = fake_run_working_directory
    prepared: Prepared_Run
    prepared_run_init(&prepared)
    testing.expect(test, prepare_run(&app, &prepared))
    diagnostics_was_visible := app.windows[Window_Diagnostics].visible
    execute_prepared_run(&app, &prepared)
    prepared_run_destroy(&prepared)
    testing.expect(
        test,
        app.windows[Window_Diagnostics].visible == diagnostics_was_visible,
    )
    testing.expect(test, app.diagnostic_count == 0)
    when target.os == .windows {
        testing.expect(
            test,
            text_equal(app.status, "Run failed: program returned a nonzero status"),
        )
    } else {
        testing.expect(test, app.status_bytes_active)
    }
}

// A launched program's nonzero exit belongs to Program Output and the
// persistent Run Result. It must not manufacture compiler diagnostics or raise
// the Diagnostics window after a successful build.
test_runtime_failure_remains_run_output :: proc(test: ^testing.Test) {
    when target.os != .windows {
        app: App
        init_windows(&app)
        testing.expect(test, init_one_buffer(&app, "turbo-run-failure.draft"))
        defer destroy_app(&app)
        app.host.build = fake_build
        app.host.copy_artifact_path = fake_artifact_path
        app.host.artifact_kind = fake_artifact_kind
        app.host.run_argument_count = fake_failing_run_argument_count
        app.host.copy_run_argument = fake_failing_run_argument

        prepared: Prepared_Run
        prepared_run_init(&prepared)
        testing.expect(test, prepare_run(&app, &prepared))
        testing.expect(test, !app.windows[Window_Diagnostics].visible)
        build_length := app.build_output_length
        execute_prepared_run(&app, &prepared)
        prepared_run_destroy(&prepared)
        testing.expect(test, text_equal(
            app.status,
            "Run failed: program returned a nonzero status",
        ))
        testing.expect(test, !app.windows[Window_Diagnostics].visible)
        testing.expect(test, app.diagnostic_count == 0)
        testing.expect(test, app.build_output_length > build_length)
    }
}

// Build results, diagnostic visibility, and exact activation form one UI
// contract. Success updates the persistent transcript and path-bearing status
// without opening a window. Failure raises Diagnostics, and a later success
// updates its rows without hiding the window the user chose to retain.
test_build_results_and_activatable_diagnostics :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-diagnostic-test.draft"))
    defer destroy_app(&app)
    turbo_editor.insert_text(active_buffer(&app), "0123456789ABC")

    diagnostic_path := "turbo-diagnostic-test.draft"
    diagnostic_source := "0123456789ABC"
    state := Fake_Root_State{
        diagnostic_path = cast[rawptr](raw_data(diagnostic_path)),
        diagnostic_path_length = len(diagnostic_path),
        diagnostic_source = cast[rawptr](raw_data(diagnostic_source)),
        diagnostic_source_length = len(diagnostic_source),
    }
    app.host.user = cast[rawptr](&state)
    app.host.build = fake_build
    app.host.copy_artifact_path = fake_artifact_path
    app.host.diagnostic_row_count = fake_diagnostic_row_count
    app.host.diagnostic_row = fake_diagnostic_row
    app.host.copy_diagnostic_row_text = fake_diagnostic_text
    app.host.copy_diagnostic_source_path = fake_diagnostic_path
    app.host.copy_diagnostic_source_text = fake_diagnostic_source

    testing.expect(test, !app.windows[Window_Build_Output].visible)
    testing.expect(test, build_active(&app))
    testing.expect(test, !app.windows[Window_Build_Output].visible)
    testing.expect(test, app.build_output_length != 0)
    testing.expect(test, app.status_bytes_active)
    expected_status := "Build succeeded in 0.36s → /bin/sh"
    when target.os == .windows {
        expected_status = "Build succeeded in 0.36s → C:\\Windows\\System32\\where.exe"
    }
    testing.expect(test, bytes_equal_string(
        app.status_storage[:app.status_length],
        expected_status,
    ))

    state.fail_build = 1
    testing.expect(test, !build_active(&app))
    testing.expect(test, app.windows[Window_Diagnostics].visible)
    testing.expect(
        test,
        app.ui.active_window == app.windows[Window_Diagnostics].id,
    )
    testing.expect(test, app.diagnostic_row_count == 1)
    testing.expect(test, !app.windows[Window_Build_Output].visible)
    testing.expect(test, activate_diagnostic(&app, 0))
    testing.expect(test, active_buffer(&app).anchor == 4)
    testing.expect(test, active_buffer(&app).cursor == 10)
    testing.expect(test, active_buffer(&app).selection_active)

    // F5 preparation stops at the same compiler boundary. No artifact/config
    // is prepared, so the terminal event loop has nothing it can launch.
    prepared: Prepared_Run
    prepared_run_init(&prepared)
    testing.expect(test, !prepare_run(&app, &prepared))
    testing.expect(test, !prepared.has_artifact_path)
    prepared_run_destroy(&prepared)

    state.fail_build = 0
    testing.expect(test, build_active(&app))
    testing.expect(test, app.windows[Window_Diagnostics].visible)
    testing.expect(test, app.diagnostic_row_count == 0)
}

// Run Configuration keeps argv, environment, and working directory as three
// distinct field types. Values containing spaces remain one argument, invalid
// environment names never enter the row table, and the explicit workspace-
// default action replaces every local override together.
test_structured_run_configuration_editing :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    defer destroy_app(&app)
    roots: Fake_Root_State
    app.host.user = cast[rawptr](&roots)
    app.host.selected_root = fake_selected_root
    app.host.run_argument_count = fake_run_argument_count
    app.host.copy_run_argument = fake_run_argument
    app.host.run_environment_count = fake_run_environment_count
    app.host.copy_run_environment = fake_run_environment
    app.host.copy_run_working_directory = fake_run_working_directory
    testing.expect(test, load_workspace_run_configuration(&app))
    original_arguments := app.run_argument_count
    original_environment := app.run_environment_count

    testing.expect(test, turbo_ui.text_box_set_text(
        &app.run_argument_box,
        app.run_argument_edit[:],
        "one argument with spaces",
    ))
    add_run_argument(&app)
    testing.expect(test, app.run_argument_count == original_arguments + 1)
    testing.expect(test,
        len(run_argument_bytes(&app, app.run_argument_count - 1)) ==
            len("one argument with spaces"))

    testing.expect(test, turbo_ui.text_box_set_text(
        &app.run_environment_box,
        app.run_environment_edit[:],
        "NOT VALID",
    ))
    add_run_environment(&app)
    testing.expect(test, app.run_environment_count == original_environment)
    testing.expect(test, turbo_ui.text_box_set_text(
        &app.run_environment_box,
        app.run_environment_edit[:],
        "DRAFT_MODE=interactive",
    ))
    add_run_environment(&app)
    testing.expect(test, app.run_environment_count == original_environment + 1)
    testing.expect(test, app.run_configuration_overridden)

    testing.expect(test, turbo_ui.text_box_set_text(
        &app.run_environment_box,
        app.run_environment_edit[:],
        "EMPTY_VALUE=",
    ))
    add_run_environment(&app)
    testing.expect(test, app.run_environment_count == original_environment + 2)

    reset_run_configuration(&app)
    testing.expect(test, app.run_argument_count == original_arguments)
    testing.expect(test, app.run_environment_count == original_environment)
    testing.expect(test, !app.run_configuration_overridden)
}

// A relative working-directory override has the same stable coordinate as a
// relative manifest value. It must not inherit the shell directory from which
// DraftIDE happened to start, because that would make one saved workspace run
// differently across terminals and shortcuts.
test_run_override_working_directory_is_workspace_relative :: proc(
    test: ^testing.Test,
) {
    app: App
    init_windows(&app)
    defer destroy_app(&app)
    roots: Fake_Root_State
    app.host.user = cast[rawptr](&roots)
    app.host.selected_root = fake_selected_root
    app.host.copy_workspace_path = fake_workspace_path
    app.workspace_open = true
    app.run_configuration_loaded = true
    app.run_configuration_overridden = true
    testing.expect(test, turbo_ui.text_box_set_text(
        &app.run_working_directory_box,
        app.run_working_directory[:],
        "assets",
    ))

    configuration: Run_Configuration
    testing.expect(test, load_run_configuration(&app, &configuration))
    defer run_configuration_destroy(&configuration)
    testing.expect(test, configuration.has_working_directory)
    expected := "/tmp/draft-open-workspace/assets"
    when target.os == .windows {
        expected = "C:\\draft-open-workspace\\assets"
    }
    actual := memory.owned_string_bytes(&configuration.working_directory)
    testing.expect(test, len(actual) == len(expected))
    for index: usize = 0; index < len(expected); index += 1 {
        testing.expect(test, actual[index] == expected[index])
    }
}

// Quit is a workspace-wide operation even though the dialog shows one buffer
// at a time. Provisional discard bits let the user cancel a later prompt
// without mutating the earlier dirty buffers or silently losing their state.
test_all_dirty_buffers_require_quit_decisions :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-quit-first.draft"))
    testing.expect(test, init_one_buffer(&app, "turbo-quit-second.draft"))
    defer destroy_app(&app)
    app.buffers[0].dirty = true
    app.buffers[1].dirty = true

    testing.expect(test, !request_quit(&app))
    testing.expect(test, app.active == 0)
    testing.expect(test, app.windows[Window_Quit].visible)
    app.quit_discard_mask |= 1
    testing.expect(test, !continue_quit(&app))
    testing.expect(test, app.active == 1)
    testing.expect(test, app.buffers[0].dirty)
    app.quit_discard_mask |= 2
    testing.expect(test, continue_quit(&app))

    app.quit_discard_mask = 0
    app.windows[Window_Quit].visible = false
    testing.expect(test, !request_quit(&app))
    testing.expect(test, app.active == 0)
}

// Exiting an unnamed document cannot invoke ordinary Save because its visible
// label is deliberately not a filesystem path. The default dialog action must
// lead to Save As and keep the process alive; Discard remains the only direct
// exit path for such a document.
test_unnamed_quit_routes_to_save_as :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_unnamed_buffer(&app))
    defer destroy_app(&app)
    testing.expect(test, !request_quit(&app))

    surface: tui.Surface
    tui.surface_init(&surface, 80, 24)
    defer tui.surface_destroy(&surface)
    should_quit := paint_app(
        &app,
        &surface,
        turbo_ui.key_event(turbo_ui.Key_Event{
            code = .character,
            byte_value = cast[u8]('a'),
            alt = true,
        }),
    )
    testing.expect(test, !should_quit)
    testing.expect(test, !app.windows[Window_Quit].visible)
    testing.expect(test, app.windows[Window_File_Browser].visible)
    testing.expect(test, app.browser_mode == .save_as)
}

// Every compiler-backed buffer is tied to the root which published its source
// path. This regression proves that choosing an older buffer restores that root
// before the editor can later send its bytes to Check or F5.
test_buffer_activation_restores_compiler_root :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-root-zero.draft"))
    testing.expect(test, init_one_buffer(&app, "turbo-root-one.draft"))
    defer destroy_app(&app)

    roots := Fake_Root_State{selected = 0}
    app.host.user = cast[rawptr](&roots)
    app.host.selected_root = fake_selected_root
    app.host.select_root = fake_select_root
    app.buffer_has_root[0] = true
    app.buffer_root[0] = 0
    app.buffer_has_root[1] = true
    app.buffer_root[1] = 1

    testing.expect(test, activate_buffer(&app, 1))
    testing.expect(test, app.active == 1)
    testing.expect(test, roots.selected == 1)

    roots.fail_selection = 1
    testing.expect(test, !activate_buffer(&app, 0))
    testing.expect(test, app.active == 1)
    testing.expect(test, roots.selected == 1)
}

// Build All is a real workspace operation rather than a decorative menu row.
// It visits every deterministic root once and restores both the original root
// and document after the final build.
test_build_all_programs_restores_selection :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-build-all.draft"))
    defer destroy_app(&app)
    source_path := turbo_editor.path_bytes(active_buffer(&app))
    roots := Fake_Root_State{
        selected = 0,
        source_path = cast[rawptr](&source_path[0]),
        source_length = len(source_path),
    }
    app.host.user = cast[rawptr](&roots)
    app.host.root_count = fake_root_count
    app.host.selected_root = fake_selected_root
    app.host.select_root = fake_select_root
    app.host.copy_root_name = fake_root_name
    app.host.copy_source_path = fake_root_source_path
    app.host.build = fake_build
    app.host.copy_artifact_path = fake_artifact_path

    build_all_programs(&app)

    testing.expect(test, roots.build_count == 2)
    testing.expect(test, roots.selected == 0)
    testing.expect(test, app.active == 0)
    testing.expect(test, text_equal(app.status, "Built all workspace programs"))
}

// Compiler Options owns exact root and target selectors. A target transition
// refreshes the same source/root products as the real service and restores the
// old value when the service rejects a later choice.
test_compiler_target_selection_is_transactional :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-target-select.draft"))
    defer destroy_app(&app)
    source_path := turbo_editor.path_bytes(active_buffer(&app))
    roots := Fake_Root_State{
        source_path = cast[rawptr](&source_path[0]),
        source_length = len(source_path),
    }
    app.host.user = cast[rawptr](&roots)
    app.host.root_count = fake_root_count
    app.host.selected_root = fake_selected_root
    app.host.select_root = fake_select_root
    app.host.copy_root_name = fake_root_name
    app.host.copy_source_path = fake_root_source_path
    app.host.target = fake_target
    app.host.select_target = fake_select_target

    testing.expect(test, select_build_target(&app, 2))
    testing.expect(test, roots.target == 2 && app.selected_target == 2)
    roots.fail_selection = 1
    testing.expect(test, !select_build_target(&app, 3))
    testing.expect(test, roots.target == 2 && app.selected_target == 2)
}

// Compiler Options displays effective build configuration copied from the host;
// it does not reinterpret draft.workspace fields in Draft. This regression
// fixes that ownership boundary and the complete-copy length contract.
test_refreshes_effective_build_configuration :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    defer destroy_app(&app)
    app.host.copy_build_configuration = fake_build_configuration

    refresh_tooling_text(&app)

    expected := "root package: examples/editor\ntarget: aarch64-macos\noptimization: O2\n"
    testing.expect(test, app.compiler_configuration_length == len(expected))
    for index: usize = 0; index < len(expected); index += 1 {
        testing.expect(test, app.compiler_configuration[index] == expected[index])
    }
}

// Open File resolves a relative spelling against the Workspace, creates one
// ordinary editing-only buffer, and reuses that same owner on a second open.
// No filesystem fixture is created: a nonexistent path is a valid new buffer.
test_open_file_dialog_resolves_and_reuses_workspace_path :: proc(
    test: ^testing.Test,
) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-open-existing.draft"))
    defer destroy_app(&app)
    app.host.copy_workspace_path = fake_workspace_path
    app.workspace_open = true

    request_open_file(&app)
    testing.expect(test, app.windows[Window_File_Browser].visible)
    testing.expect(test, app.ui.focused_id == 830)
    surface: tui.Surface
    tui.surface_init(&surface, 100, 30)
    defer tui.surface_destroy(&surface)
    _ = paint_app(&app, &surface, turbo_ui.no_event())
    // DraftIDE's application theme is deliberately flat: the browser keeps a
    // complete compact action face without paying a second row or right-hand
    // column for classic shade decoration.
    testing.expect(test, surface_contains(&surface, "Open"))
    testing.expect(test, !surface_has_black_shadow(&surface))
    testing.expect(test, turbo_ui.text_box_set_text(
        &app.browser_name_box,
        app.browser_name[:],
        "notes.draft",
    ))
    commit_file_browser(&app)

    expected := "/tmp/draft-open-workspace/notes.draft"
    when target.os == .windows {
        expected = "C:\\draft-open-workspace\\notes.draft"
    }
    testing.expect(test, app.buffer_count == 2)
    testing.expect(test, !app.windows[Window_File_Browser].visible)
    path := turbo_editor.path_bytes(active_buffer(&app))
    testing.expect(test, len(path) == len(expected))
    for index: usize = 0; index < len(expected); index += 1 {
        testing.expect(test, path[index] == expected[index])
    }
    testing.expect(test, !app.buffer_has_root[app.active])

    request_open_file(&app)
    testing.expect(test, turbo_ui.text_box_set_text(
        &app.browser_name_box,
        app.browser_name[:],
        "notes.draft",
    ))
    commit_file_browser(&app)
    testing.expect(test, app.buffer_count == 2)
}

// Workspace Files keeps its synthetic parent row fixed while sorting native
// entries by the visible contract: directories first, then ordinary files,
// then entries whose native kind is unknown; names are bytewise within a kind.
// Exercising the shared operation directly makes the deterministic rule
// independent of whatever order one host filesystem happens to enumerate.
test_workspace_files_directory_order_is_deterministic :: proc(
    test: ^testing.Test,
) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-workspace-order.draft"))
    defer destroy_app(&app)

    memory.owned_string_copy(&app.workspace_file_entry_names[0], "..")
    app.workspace_file_entry_kind[0] = .directory
    memory.owned_string_copy(&app.workspace_file_entry_names[1], "zeta.draft")
    app.workspace_file_entry_kind[1] = .regular_file
    memory.owned_string_copy(&app.workspace_file_entry_names[2], "beta")
    app.workspace_file_entry_kind[2] = .directory
    memory.owned_string_copy(&app.workspace_file_entry_names[3], "alpha")
    app.workspace_file_entry_kind[3] = .directory
    memory.owned_string_copy(&app.workspace_file_entry_names[4], "link")
    app.workspace_file_entry_kind[4] = .unknown
    app.workspace_file_entry_count = 5

    sort_directory_entries(
        app.workspace_file_entry_names[:],
        app.workspace_file_entry_kind[:],
        app.workspace_file_entry_count,
        1,
    )

    expected := [5]string{"..", "alpha", "beta", "zeta.draft", "link"}
    expected_kinds := [5]filesystem.Entry_Kind{
        .directory,
        .directory,
        .directory,
        .regular_file,
        .unknown,
    }
    for index: usize = 0; index < len(expected); index += 1 {
        actual := memory.owned_string_bytes(
            &app.workspace_file_entry_names[index],
        )
        testing.expect(test, len(actual) == len(expected[index]))
        for byte_index: usize = 0;
            byte_index < len(expected[index]);
            byte_index += 1 {
            testing.expect(
                test,
                actual[byte_index] == expected[index][byte_index],
            )
        }
        testing.expect(
            test,
            app.workspace_file_entry_kind[index] == expected_kinds[index],
        )
    }
}

// The persistent tool paints its compiler-owned root, refuses to navigate
// above that boundary, and sends a selected ordinary file through the normal
// document-opening command. The file is deliberately absent from the active
// root source table, proving that browsing the Workspace does not silently
// replace compiler scope or enroll unrelated files in overlays. On POSIX the
// same rendered double-click path then enters the stable system /tmp directory,
// covering the folder-navigation regression without creating shared scratch.
test_workspace_files_opens_an_editing_only_document :: proc(
    test: ^testing.Test,
) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-workspace-existing.draft"))
    defer destroy_app(&app)
    app.workspace_open = true
    app.host.copy_workspace_path = fake_workspace_path

    testing.expect(test, initialize_workspace_files(&app))
    root_length := app.workspace_files_root_length
    // Initialization publishes only the boundary. Hidden Workspace Files must
    // not enumerate the filesystem during compiler-session startup.
    testing.expect(test, root_length != 0)
    testing.expect(test, app.workspace_file_entry_count == 0)
    memory.owned_string_copy(
        &app.workspace_file_entry_names[0],
        "notes.draft",
    )
    app.workspace_file_entry_kind[0] = .regular_file
    app.workspace_file_entry_count = 1
    app.workspace_files_truncated = true

    testing.expect(test, workspace_files_at_root(&app))
    testing.expect(test, !workspace_files_go_up(&app))
    testing.expect(test, app.workspace_files_location_length == root_length)
    sibling := "/tmp/draft-open-workspace-other"
    when target.os == .windows {
        sibling = "C:\\draft-open-workspace-other"
    }
    sibling_owner: memory.Owned_String
    memory.owned_string_copy(&sibling_owner, sibling)
    defer memory.owned_string_destroy(&sibling_owner)
    testing.expect(
        test,
        !path_is_at_or_below(
            workspace_files_root_bytes(&app),
            memory.owned_string_bytes(&sibling_owner),
        ),
    )

    turbo_ui.show_window(
        &app.ui,
        app.windows[:],
        app.windows[Window_Workspace_Files].id,
    )
    surface: tui.Surface
    tui.surface_init(&surface, 100, 35)
    defer tui.surface_destroy(&surface)
    _ = paint_app(&app, &surface, turbo_ui.no_event())
    testing.expect(test, surface_contains(&surface, "Workspace Files"))
    testing.expect(test, surface_contains(&surface, "Workspace /"))
    testing.expect(test, surface_contains(&surface, "notes.draft"))
    testing.expect(
        test,
        surface_contains(&surface, "Directory truncated: 512-row limit"),
    )

    // A single click selects without opening. The caller-classified second
    // release activates the same row through paint_workspace_files, proving
    // the application did not accidentally leave the list Enter-only.
    file_point := turbo_ui.Point{
        column = app.windows[Window_Workspace_Files].bounds.column + 3,
        row = app.windows[Window_Workspace_Files].bounds.row + 4,
    }
    _ = paint_app(&app, &surface, turbo_ui.mouse_event(turbo_ui.Mouse_Event{
        position = file_point,
        action = .press,
        button = .primary,
        primary_down = true,
    }))
    _ = paint_app(&app, &surface, turbo_ui.mouse_event(turbo_ui.Mouse_Event{
        position = file_point,
        action = .release,
        button = .primary,
        click_count = 1,
    }))
    testing.expect(test, app.buffer_count == 1)
    _ = paint_app(&app, &surface, turbo_ui.mouse_event(turbo_ui.Mouse_Event{
        position = file_point,
        action = .press,
        button = .primary,
        primary_down = true,
    }))
    _ = paint_app(&app, &surface, turbo_ui.mouse_event(turbo_ui.Mouse_Event{
        position = file_point,
        action = .release,
        button = .primary,
        click_count = 2,
    }))
    expected_path := "/tmp/draft-open-workspace/notes.draft"
    when target.os == .windows {
        expected_path = "C:\\draft-open-workspace\\notes.draft"
    }
    path := turbo_editor.path_bytes(active_buffer(&app))
    testing.expect(test, len(path) == len(expected_path))
    for index: usize = 0; index < len(expected_path); index += 1 {
        testing.expect(test, path[index] == expected_path[index])
    }
    testing.expect(test, app.buffer_count == 2)
    testing.expect(test, !app.buffer_has_root[app.active])

    when target.os == .macos || target.os == .linux {
        clear_workspace_file_entries(&app)
        app.workspace_files_root[0] = cast[u8]('/')
        app.workspace_files_root_length = 1
        app.workspace_files_location[0] = cast[u8]('/')
        app.workspace_files_location_length = 1
        memory.owned_string_copy(
            &app.workspace_file_entry_names[0],
            "tmp",
        )
        app.workspace_file_entry_kind[0] = .directory
        app.workspace_file_entry_count = 1
        turbo_ui.show_window(
            &app.ui,
            app.windows[:],
            app.windows[Window_Workspace_Files].id,
        )

        _ = paint_app(&app, &surface, turbo_ui.mouse_event(turbo_ui.Mouse_Event{
            position = file_point,
            action = .press,
            button = .primary,
            primary_down = true,
        }))
        _ = paint_app(&app, &surface, turbo_ui.mouse_event(turbo_ui.Mouse_Event{
            position = file_point,
            action = .release,
            button = .primary,
            click_count = 1,
        }))
        testing.expect(test, app.workspace_files_location_length == 1)
        _ = paint_app(&app, &surface, turbo_ui.mouse_event(turbo_ui.Mouse_Event{
            position = file_point,
            action = .press,
            button = .primary,
            primary_down = true,
        }))
        _ = paint_app(&app, &surface, turbo_ui.mouse_event(turbo_ui.Mouse_Event{
            position = file_point,
            action = .release,
            button = .primary,
            click_count = 2,
        }))
        expected_directory := "/tmp"
        actual_directory := workspace_files_location_bytes(&app)
        testing.expect(test, len(actual_directory) == len(expected_directory))
        for index: usize = 0; index < len(expected_directory); index += 1 {
            testing.expect(
                test,
                actual_directory[index] == expected_directory[index],
            )
        }
        _ = paint_app(&app, &surface, turbo_ui.no_event())
        testing.expect(test, surface_contains(&surface, "Workspace /tmp"))
    }
}

// Check and Build must see every open workspace buffer in one call, while syntax
// spans still belong to the active row. This test fixes the Draft-owned pointer
// table and compact active index independently of the native service test.
test_collects_all_open_workspace_overlays :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-overlay-first.draft"))
    testing.expect(test, init_one_buffer(&app, "turbo-overlay-second.draft"))
    defer destroy_app(&app)

    app.host.source_count = fake_source_count
    app.reachable_source_count = 2
    memory.owned_string_copy_bytes(
        &app.reachable_source_paths[0],
        turbo_editor.path_bytes(&app.buffers[0]),
    )
    memory.owned_string_copy_bytes(
        &app.reachable_source_paths[1],
        turbo_editor.path_bytes(&app.buffers[1]),
    )
    memory.owned_string_copy(&app.reachable_source_names[0], "first.draft")
    memory.owned_string_copy(&app.reachable_source_names[1], "second.draft")
    app.buffers[0].dirty = true
    app.buffers[1].dirty = true
    app.active = 1

    overlays: [Maximum_Buffers]draft_compiler_api.Overlay
    (count, active, valid) := collect_host_overlays(&app, overlays[:])
    testing.expect(test, valid)
    testing.expect(test, count == 2)
    testing.expect(test, active == 1)
    testing.expect(
        test,
        overlays[0].path_length == len(turbo_editor.path_bytes(&app.buffers[0])),
    )
    testing.expect(
        test,
        overlays[1].path_length == len(turbo_editor.path_bytes(&app.buffers[1])),
    )
}

// An authored edit must never enter package semantics on the event/render
// thread. Semantic navigation is an explicit command and therefore performs
// exactly one current-byte check before it asks the service for a location.
test_typing_only_runs_foreground_lexing :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-typing-path.draft"))
    defer destroy_app(&app)

    state: Fake_Foreground_State
    app.host.user = cast[rawptr](&state)
    app.host.check = fake_check
    app.host.colorize = fake_colorize
    app.host.prepare_navigation = fake_prepare_navigation

    source_changed(&app)
    testing.expect(test, state.colorize_count == 1)
    testing.expect(test, state.check_count == 0)
    testing.expect(test, app.semantic_dirty)

    testing.expect(test, prepare_navigation(&app) == .ready)
    testing.expect(test, state.colorize_count == 1)
    testing.expect(test, state.check_count == 1)
    testing.expect(test, !app.semantic_dirty)
}

// Open Workspace never discards dirty document owners directly. Submission
// first enters the explicit Save all / Discard / Cancel modal, preserving the
// candidate pathname while the user decides.
test_open_workspace_requires_dirty_buffer_choice :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-workspace-dirty.draft"))
    defer destroy_app(&app)
    app.buffers[0].dirty = true

    destination: memory.Owned_String
    memory.owned_string_copy(&destination, "/tmp/next-draft-workspace")
    defer memory.owned_string_destroy(&destination)
    begin_workspace_transition(
        &app,
        .open_workspace,
        memory.owned_string_bytes(&destination),
    )
    testing.expect(test, app.windows[Window_Workspace_Confirm].visible)
    testing.expect(
        test,
        app.ui.active_window == app.windows[Window_Workspace_Confirm].id,
    )
}

// Workspace replacement destroys paths and semantic navigation but not the
// IDE-local clipboard, whose lifetime belongs to the process. This exercises
// the narrower owner boundary used after a replacement compiler session has
// already been validated.
test_workspace_replacement_preserves_clipboard :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-workspace-owner.draft"))
    defer destroy_app(&app)
    turbo_editor.insert_text(active_buffer(&app), "draft")
    turbo_editor.select_all(active_buffer(&app))
    testing.expect(test, copy_selection(&app))
    testing.expect(test, app.clipboard.length == len("draft"))

    destroy_workspace_documents(&app)
    testing.expect(test, app.buffer_count == 0)
    testing.expect(test, app.clipboard.length == len("draft"))
}

// The editor is a normal desktop window, while source and buffer browsers are
// auxiliary tools. This fixes the application policy independently of the
// reusable editor view: Tile owns the document and semantic windows, does not
// move a tool pane, and activating any buffer reopens the document if the user
// previously closed it.
test_editor_is_a_normal_tileable_window :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-window-test.draft"))
    defer destroy_app(&app)

    editor := &app.windows[Window_Editor]
    files := &app.windows[Window_Open_Documents]
    workspace_files := &app.windows[Window_Workspace_Files]
    files_bounds := files.bounds
    testing.expect(test, editor.flags.tileable)
    testing.expect(test, editor.flags.zoomable)
    testing.expect(test, editor.zoomed)
    testing.expect(test, !files.flags.tileable)
    testing.expect(test, !workspace_files.flags.tileable)

    desktop := turbo_ui.Rect{column = 0, row = 1, width = 80, height = 22}
    testing.expect(test, turbo_ui.tile_windows(app.windows[:], desktop) == 1)
    testing.expect(test, turbo_ui.rect_equal(editor.bounds, desktop))
    testing.expect(test, !editor.zoomed)
    testing.expect(test, turbo_ui.rect_equal(files.bounds, files_bounds))

    turbo_ui.hide_window(&app.ui, app.windows[:], editor.id)
    testing.expect(test, !editor.visible)
    testing.expect(test, activate_buffer(&app, 0))
    testing.expect(test, editor.visible)
    testing.expect(test, app.ui.active_window == editor.id)
    testing.expect(test, app.ui.focused_id == Editor_Body_Id_Base)

    // Startup shows one understandable document surface, not a pile of
    // compiler inspectors. Its title is the actual document path so the user
    // never has to infer which open file the generic word "Editor" represents.
    visible: usize
    for window in app.windows {
        if window.visible {
            visible += 1
        }
    }
    testing.expect(test, visible == 1)
    surface: tui.Surface
    tui.surface_init(&surface, 80, 24)
    defer tui.surface_destroy(&surface)
    _ = paint_app(&app, &surface, turbo_ui.no_event())
    (title, title_valid) := tui.cell_at(&surface, 4, 1)
    testing.expect(test, title_valid && title.value == 't')
}

// Menu shortcut commands belong to the application rather than the currently
// focused control. This regression starts outside the editor and proves the
// final Open Documents, Find, Compiler Options, Escape, and Exit contracts.
test_advertised_shortcuts_are_application_wide :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-shortcut-test.draft"))
    defer destroy_app(&app)
    turbo_editor.insert_text(active_buffer(&app), "draft")

    (remaining, quit) := handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{
            code = .character,
            byte_value = cast[u8]('0'),
            alt = true,
        },
    ))
    testing.expect(test, !quit && remaining.kind == .none)
    testing.expect(test, app.windows[Window_Open_Documents].visible)
    testing.expect(
        test,
        app.ui.active_window == app.windows[Window_Open_Documents].id,
    )
    testing.expect(test, app.ui.focused_id == 532)

    (remaining, quit) = handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{
            code = .character,
            byte_value = 6,
            control = true,
        },
    ))
    testing.expect(test, !quit && remaining.kind == .none)
    testing.expect(test, app.windows[Window_Find].visible)
    testing.expect(test, app.ui.active_window == app.windows[Window_Find].id)
    testing.expect(test, app.ui.focused_id == 500)

    // Escape cancels local UI only; it never acts as the application exit
    // command. Once the modal is closed, a bare Escape is consumed harmlessly,
    // while the advertised Alt-X completes a clean workspace exit.
    close_search(&app)
    app.workspace_open = true
    app.host.check = fake_check
    (remaining, quit) = handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{code = .escape},
    ))
    testing.expect(test, !quit && remaining.kind == .none)
    (remaining, quit) = handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{code = .f6},
    ))
    testing.expect(test, !quit && remaining.kind == .none)
    testing.expect(test, app.windows[Window_Compiler_Options].visible)
    active_buffer(&app).dirty = false
    (remaining, quit) = handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{
            code = .character,
            byte_value = cast[u8]('x'),
            alt = true,
        },
    ))
    testing.expect(test, quit && remaining.kind == .none)
}

// Editing accelerators are application commands even when a tool window owns
// focus. This test proves the exact C0 spellings, persistent forward/reverse
// search and atomic replace without relying
// on a real terminal decoder or menu traversal.
test_editing_shortcuts_apply_the_advertised_commands :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-edit-shortcuts.draft"))
    defer destroy_app(&app)
    buffer := active_buffer(&app)
    turbo_editor.insert_text(buffer, "one two one\nlast")
    testing.expect(test, buffer.bytes.length == len("one two one\nlast"))

    (remaining, quit) := handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{
            code = .character,
            byte_value = 26,
            control = true,
        },
    ))
    testing.expect(test, !quit && remaining.kind == .none)
    testing.expect(test, buffer.bytes.length == 0)
    (remaining, quit) = handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{
            code = .character,
            byte_value = 25,
            control = true,
        },
    ))
    testing.expect(test, !quit && remaining.kind == .none)
    testing.expect(test, buffer.bytes.length == len("one two one\nlast"))

    testing.expect(test, turbo_ui.text_box_set_text(
        &app.search_box,
        app.search[:],
        "one",
    ))
    testing.expect(test, turbo_ui.text_box_set_text(
        &app.replacement_box,
        app.replacement[:],
        "ONE",
    ))
    turbo_editor.move_file_start(buffer)
    (remaining, quit) = handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{code = .f3},
    ))
    (first_start, first_end, first_selected) := turbo_editor.selection(buffer)
    testing.expect(test, !quit && remaining.kind == .none)
    testing.expect(test, first_selected && first_start == 0 && first_end == 3)

    (remaining, quit) = handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{code = .f3},
    ))
    (second_start, second_end, second_selected) := turbo_editor.selection(buffer)
    testing.expect(test, second_selected && second_start == 8 && second_end == 11)
    (remaining, quit) = handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{code = .f3, shift = true},
    ))
    (previous_start, previous_end, previous_selected) :=
        turbo_editor.selection(buffer)
    testing.expect(
        test,
        previous_selected && previous_start == 0 && previous_end == 3,
    )

    (remaining, quit) = handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{code = .f4},
    ))
    testing.expect(test, !quit && remaining.kind == .none)
    testing.expect(test, buffer.bytes.data[0] == cast[u8]('O'))
    (second_start, second_end, second_selected) = turbo_editor.selection(buffer)
    testing.expect(test, second_selected && second_start == 8 && second_end == 11)

    (remaining, quit) = handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{
            code = .character,
            byte_value = 18,
            control = true,
        },
    ))
    testing.expect(test, !quit && remaining.kind == .none)
    testing.expect(test, app.windows[Window_Replace].visible)
    close_replace(&app)

    (remaining, quit) = handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{
            code = .character,
            byte_value = 7,
            control = true,
        },
    ))
    testing.expect(test, !quit && remaining.kind == .none)
    testing.expect(test, app.windows[Window_Go_To_Line].visible)
    testing.expect(test, turbo_ui.text_box_set_text(
        &app.go_line_box,
        app.go_line[:],
        "2",
    ))
    submit_go_to_line(&app)
    testing.expect(test, !app.windows[Window_Go_To_Line].visible)
    testing.expect(test, buffer.cursor == 12)
}

// New/Cut/Copy/Paste are ordinary document operations, not placeholder menu
// rows. This regression drives the same C0 shortcuts produced by a raw local or
// SSH terminal and proves the IDE-owned clipboard survives between documents.
test_document_and_clipboard_shortcuts_are_real :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-clipboard.draft"))
    defer destroy_app(&app)
    buffer := active_buffer(&app)
    turbo_editor.insert_text(buffer, "draft")

    keys := [4]u8{1, 3, 24, 22}
    for index: usize = 0; index < len(keys); index += 1 {
        (remaining, quit) := handle_global_key(
            &app,
            turbo_ui.key_event(turbo_ui.Key_Event{
                code = .character,
                byte_value = keys[index],
                control = true,
            }),
        )
        testing.expect(test, !quit && remaining.kind == .none)
        if index == 1 {
            testing.expect(test, app.clipboard.length == len("draft"))
        } else if index == 2 {
            testing.expect(test, buffer.bytes.length == 0)
        } else if index == 3 {
            testing.expect(test, buffer.bytes.length == len("draft"))
        }
    }

    (remaining, quit) := handle_global_key(
        &app,
        turbo_ui.key_event(turbo_ui.Key_Event{
            code = .character,
            byte_value = 14,
            control = true,
        }),
    )
    testing.expect(test, !quit && remaining.kind == .none)
    testing.expect(test, app.buffer_count == 2 && app.active == 1)
    testing.expect(test, turbo_editor.is_unnamed(active_buffer(&app)))
    testing.expect(test, active_buffer(&app).dirty)

    paste_clipboard(&app)
    testing.expect(test,
        active_buffer(&app).bytes.length == len("draft"))
}

// Semantic shortcuts consume structured host locations, preserve exact byte
// selections, populate the reusable Usages list, and follow browser-style
// Back/Forward history. No formatted compiler dump participates in the test.
test_semantic_navigation_shortcuts_and_history :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-nav-first.draft"))
    testing.expect(test, init_one_buffer(&app, "turbo-nav-second.draft"))
    defer destroy_app(&app)
    turbo_editor.insert_text(&app.buffers[0], "use first")
    turbo_editor.insert_text(&app.buffers[1], "pub answer")
    app.active = 0
    app.open_documents.cursor = 0
    app.buffers[0].cursor = 2

    first := turbo_editor.path_bytes(&app.buffers[0])
    second := turbo_editor.path_bytes(&app.buffers[1])
    navigation := Fake_Navigation_State{
        first_path = cast[rawptr](&first[0]),
        first_length = len(first),
        second_path = cast[rawptr](&second[0]),
        second_length = len(second),
    }
    app.host.user = cast[rawptr](&navigation)
    app.host.prepare_navigation = fake_prepare_navigation
    app.host.navigation_definition = fake_navigation_definition
    app.host.navigation_usage_count = fake_navigation_usage_count
    app.host.navigation_usage = fake_navigation_usage
    app.host.copy_navigation_source_path = fake_navigation_path
    app.host.navigation_source_editable = fake_navigation_editable

    (remaining, quit) := handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{code = .f12},
    ))
    testing.expect(test, !quit && remaining.kind == .none)
    testing.expect(test, app.active == 1)
    (start, end, selected) := turbo_editor.selection(active_buffer(&app))
    testing.expect(test, selected && start == 4 && end == 10)
    testing.expect(test, app.navigation_history_count == 2)
    testing.expect(test, app.navigation_history_index == 1)

    (remaining, quit) = handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{code = .left, alt = true},
    ))
    testing.expect(test, !quit && remaining.kind == .none)
    testing.expect(test, app.active == 0 && app.buffers[0].cursor == 2)
    (remaining, quit) = handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{code = .right, alt = true},
    ))
    testing.expect(test, app.active == 1)

    (remaining, quit) = handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{code = .f12, shift = true},
    ))
    testing.expect(test, !quit && remaining.kind == .none)
    testing.expect(test, app.semantic_usages_visible)
    testing.expect(test, app.navigation_row_count == 2)
    testing.expect(test, app.windows[Window_References].visible)
    testing.expect(test, app.ui.focused_id == 820)
}

// Reaching the fixed history bound must preserve a complete Back/Forward pair.
// This catches the subtle case where appending the current row filled the table
// and appending the destination independently cleared that current row.
test_navigation_history_bound_preserves_back_entry :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-history-current.draft"))
    defer destroy_app(&app)

    destination: Navigation_Target
    memory.owned_string_copy(&destination.path, "turbo-history-destination.draft")
    defer navigation_target_destroy(&destination)
    for index: usize = 0; index < 40; index += 1 {
        destination.start = index
        destination.end = index
        record_navigation_transition(&app, &destination)
    }

    testing.expect(test, app.navigation_history_count >= 2)
    testing.expect(
        test,
        app.navigation_history_count <= Maximum_Navigation_History,
    )
    testing.expect(
        test,
        app.navigation_history_index == app.navigation_history_count - 1,
    )
    testing.expect(test, navigate_history(&app, false))
    testing.expect(
        test,
        app.navigation_history_index + 1 == app.navigation_history_count - 1,
    )
}

// The rendered menu is the user-visible command contract. This exhaustive
