expect_surface_text :: proc(
    test: ^testing.Test,
    surface: ^tui.Surface,
    column, row: usize,
    expected: string,
) {
    for index: usize = 0; index < len(expected); index += 1 {
        (cell, valid) := tui.cell_at(surface, column + index, row)
        testing.expect(
            test,
            valid && cell.value == cast[rune](expected[index]),
        )
    }
}

// surface_contains scans rendered ASCII labels without depending on a dialog's
// clamped origin. Dialog placement changes at the 80x24 compatibility boundary,
// but a field disappearing entirely is always a contract failure.
surface_contains :: proc(surface: ^tui.Surface, expected: string) -> bool {
    if len(expected) == 0 || len(expected) > surface.columns {
        return false
    }
    for row: usize = 0; row < surface.rows; row += 1 {
        for column: usize = 0;
            column + len(expected) <= surface.columns;
            column += 1 {
            matches := true
            for index: usize = 0; index < len(expected); index += 1 {
                (cell, valid) := tui.cell_at(surface, column + index, row)
                if !valid || cell.value != cast[rune](expected[index]) {
                    matches = false
                    break
                }
            }
            if matches {
                return true
            }
        }
    }
    return false
}

bytes_equal_string :: proc(bytes: []u8, expected: string) -> bool {
    if len(bytes) != len(expected) {
        return false
    }
    for index: usize = 0; index < len(expected); index += 1 {
        if bytes[index] != expected[index] {
            return false
        }
    }
    return true
}

// surface_has_black_shadow identifies the exact decoration emitted by the
// classic Turbo UI shadow style: a light-shade glyph with RGB black on RGB
// black. Disabled scrollbars use the same glyph but a different
// foreground/background pair, so this check does not confuse ordinary control
// content with a forbidden DraftIDE window, popup, or button shadow.
surface_has_black_shadow :: proc(surface: ^tui.Surface) -> bool {
    for row: usize = 0; row < surface.rows; row += 1 {
        for column: usize = 0; column < surface.columns; column += 1 {
            (cell, valid) := tui.cell_at(surface, column, row)
            if valid && cell.value == '░' &&
                cell.style.foreground.kind == .rgb &&
                cell.style.foreground.red == 0 &&
                cell.style.foreground.green == 0 &&
                cell.style.foreground.blue == 0 &&
                cell.style.background.kind == .rgb &&
                cell.style.background.red == 0 &&
                cell.style.background.green == 0 &&
                cell.style.background.blue == 0 {
                return true
            }
        }
    }
    return false
}

open_menu_for_test :: proc(
    app: ^App,
    surface: ^tui.Surface,
    access_key: u8,
) {
    _ = paint_app(
        app,
        surface,
        turbo_ui.key_event(turbo_ui.Key_Event{
            code = .character,
            byte_value = access_key,
            alt = true,
        }),
    )
}

Fake_Root_State :: c struct {
    selected: usize,
    fail_selection: u8,
    target: u8,
    build_count: usize,
    fail_build: u8,
    diagnostic_path: rawptr,
    diagnostic_path_length: usize,
    diagnostic_source: rawptr,
    diagnostic_source_length: usize,
    source_path: rawptr,
    source_length: usize,
}

Fake_Navigation_State :: c struct {
    first_path: rawptr,
    first_length: usize,
    second_path: rawptr,
    second_length: usize,
}

// Fake_Foreground_State distinguishes the lexical typing path from an explicit
// semantic transaction. The counters cross the same C callback table as the
// real embedded compiler, so the regression cannot accidentally pass through
// a private editor-only shortcut.
Fake_Foreground_State :: c struct {
    check_count: usize,
    colorize_count: usize,
}

fake_check :: c proc(
    user: rawptr,
    overlays: ^draft_compiler_api.Overlay,
    overlay_count: usize,
    active_overlay: usize,
    result: ^draft_compiler_api.Result,
) {
    _ = overlays
    _ = overlay_count
    _ = active_overlay
    state := cast[^Fake_Foreground_State](user)
    state.check_count += 1
    result.success = 1
}

fake_colorize :: c proc(
    user: rawptr,
    source: ^draft_compiler_api.Overlay,
    result: ^draft_compiler_api.Syntax_Result,
) {
    _ = source
    state := cast[^Fake_Foreground_State](user)
    state.colorize_count += 1
    result.success = 1
}

fake_selected_root :: c proc(user: rawptr) -> usize {
    state := cast[^Fake_Root_State](user)
    return state.selected
}

fake_select_root :: c proc(user: rawptr, index: usize) -> u8 {
    state := cast[^Fake_Root_State](user)
    if state.fail_selection != 0 {
        return 0
    }
    state.selected = index
    return 1
}

fake_root_count :: c proc(user: rawptr) -> usize {
    _ = user
    return 2
}

fake_root_name :: c proc(
    user: rawptr,
    index: usize,
    destination: [^]u8,
    capacity: usize,
) -> usize {
    _ = user
    name := "apps/one"
    if index == 1 {
        name = "apps/two"
    }
    return fake_copy_bytes(
        cast[rawptr](raw_data(name)),
        len(name),
        destination,
        capacity,
    )
}

fake_root_source_path :: c proc(
    user: rawptr,
    destination: [^]u8,
    capacity: usize,
) -> usize {
    state := cast[^Fake_Root_State](user)
    return fake_copy_bytes(
        state.source_path,
        state.source_length,
        destination,
        capacity,
    )
}

fake_target :: c proc(user: rawptr) -> u8 {
    return cast[^Fake_Root_State](user).target
}

fake_select_target :: c proc(user: rawptr, target_value: u8) -> u8 {
    state := cast[^Fake_Root_State](user)
    if state.fail_selection != 0 {
        return 0
    }
    state.target = target_value
    return 1
}

fake_prepare_navigation :: c proc(
    user: rawptr,
    path_data: rawptr,
    path_length: usize,
    byte_offset: usize,
) -> u8 {
    _ = user
    _ = path_data
    _ = path_length
