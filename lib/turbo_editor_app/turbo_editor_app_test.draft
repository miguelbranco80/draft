// Every modal owns enough authored rows for its fields and compact one-row
// action faces at the 100x35 design size. Dialogs remain movable and closable
// but cannot accidentally enter resize/zoom/tile code; Compiler Options is
// intentionally the contrasting ordinary inspector window.
test_dialog_geometry_and_window_roles :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-dialog-layout.draft"))
    defer destroy_app(&app)
    dialogs := [10]usize{
        Window_Find,
        Window_Quit,
        Window_File_Browser,
        Window_Workspace_Confirm,
        Window_Replace,
        Window_Go_To_Line,
        Window_Shortcut_Help,
        Window_Run_Configuration,
        Window_Close_Document,
        Window_About,
    }
    for index in dialogs {
        window := app.windows[index]
        testing.expect(test, window.flags.movable)
        testing.expect(test, window.flags.closable)
        testing.expect(test, !window.flags.resizable)
        testing.expect(test, !window.flags.zoomable)
        testing.expect(test, !window.flags.tileable)
        testing.expect(test, window.bounds.width >= window.minimum_width)
        testing.expect(test, window.bounds.height >= window.minimum_height)
        testing.expect(test, turbo_ui.rect_right(window.bounds) <= 100)
        testing.expect(test, turbo_ui.rect_bottom(window.bounds) <= 35)
    }
    compiler := app.windows[Window_Compiler_Options]
    testing.expect(test, compiler.flags.resizable)
    testing.expect(test, compiler.flags.zoomable)
    testing.expect(test, compiler.flags.tileable)
    testing.expect(test,
        app.windows[Window_Run_Configuration].bounds.height == 20)
    testing.expect(test,
        app.windows[Window_Quit].bounds.width >=
            len("Disk also changed. Choose whether to overwrite it.") + 2)
    testing.expect(test,
        app.windows[Window_Workspace_Confirm].bounds.width >=
            len("This file belongs to another compiler scope. Switch and open it?") + 2)

    // 80x24 is the smallest conventional full-screen terminal we promise to
    // make useful. Render every dialog through the real application pass so
    // begin_window's clamping, dialog content insets, fields, and button rows
    // are exercised together rather than inferred from initial rectangles.
    expected_fields := [10]string{
        "Find literal bytes:",
        "The active document has unsaved changes.",
        "Location:",
        "Save or discard modified documents before continuing?",
        "Replace:",
        "Line number:",
        "Key                  Command",
        "Arguments (one exact argv row)",
        "The active document has unsaved changes.",
        "DraftIDE is the default IDE for Draft.",
    }
    expected_actions := [10]string{
        "Next",
        "Save + exit",
        "Open",
        "Save All",
        "Replace All",
        "Go To",
        "Close",
        "Done",
        "Save",
        "Close",
    }
    surface: tui.Surface
    tui.surface_init(&surface, 80, 24)
    defer tui.surface_destroy(&surface)
    app_theme := draftide_theme()
    testing.expect(test, !app_theme.shadows)
    testing.expect(test,
        app_theme.window.background.kind == .rgb &&
        app_theme.window.background.red == 0x00 &&
        app_theme.window.background.green == 0x00 &&
        app_theme.window.background.blue == 0xaa)
    for ordinal: usize = 0; ordinal < len(dialogs); ordinal += 1 {
        index := dialogs[ordinal]
        turbo_ui.show_modal_window(
            &app.ui,
            app.windows[:],
            app.windows[index].id,
        )
        _ = paint_app(&app, &surface, turbo_ui.no_event())
        bounds := app.windows[index].bounds
        testing.expect(test, bounds.row >= 1)
        testing.expect(test, turbo_ui.rect_right(bounds) <= 80)
        testing.expect(test, turbo_ui.rect_bottom(bounds) <= 23)
        has_field := surface_contains(&surface, expected_fields[ordinal])
        has_action := surface_contains(&surface, expected_actions[ordinal])
        testing.expect(test, has_field)
        testing.expect(test, has_action)
        if index == Window_About {
            testing.expect(test,
                surface_contains(&surface, "Created by Miguel Branco"))
            testing.expect(test,
                surface_contains(&surface, "msb@spacebase.org"))
        }
        testing.expect(test, !surface_has_black_shadow(&surface))
        turbo_ui.hide_window(&app.ui, app.windows[:], app.windows[index].id)
    }

    // Render each non-modal application window as the active window as well.
    // This covers every Window_State entry exactly once across the two loops,
    // including tool panes, semantic inspectors, the editor, and Compiler
    // Options. Checking the visible title and clamped rectangle catches both a
    // missing content pass and chrome that spills outside the conventional
    // terminal, while the style scan enforces one visual policy everywhere.
    desktop_windows := [11]usize{
        Window_Editor,
        Window_Open_Documents,
        Window_Workspace_Files,
        Window_Diagnostics,
        Window_Build_Output,
        Window_Packages,
        Window_Declarations,
        Window_References,
        Window_Effects,
        Window_Denials,
        Window_Compiler_Options,
    }
    expected_titles := [11]string{
        "turbo-dialog-layout.draft",
        "Open Documents (Alt-0)",
        "Workspace Files",
        "Diagnostics (F8)",
        "Build Output",
        "Packages and Imports",
        "Declarations and Visibility",
        "References and Calls",
        "Effects",
        "Denials",
        "Compiler Options (F6)",
    }
    for ordinal: usize = 0; ordinal < len(desktop_windows); ordinal += 1 {
        index := desktop_windows[ordinal]
        turbo_ui.show_window(&app.ui, app.windows[:], app.windows[index].id)
        _ = paint_app(&app, &surface, turbo_ui.no_event())
        bounds := app.windows[index].bounds
        testing.expect(test, bounds.row >= 1)
        testing.expect(test, turbo_ui.rect_right(bounds) <= 80)
        testing.expect(test, turbo_ui.rect_bottom(bounds) <= 23)
        has_title := surface_contains(&surface, expected_titles[ordinal])
        testing.expect(test, has_title)
        testing.expect(test, !surface_has_black_shadow(&surface))
        turbo_ui.hide_window(&app.ui, app.windows[:], app.windows[index].id)
    }

    turbo_ui.show_window(
        &app.ui,
        app.windows[:],
        app.windows[Window_Compiler_Options].id,
    )
    _ = paint_app(&app, &surface, turbo_ui.no_event())
    testing.expect(test, surface_contains(&surface, "Root Package (* active)"))
    testing.expect(test, surface_contains(&surface, "Target Platform"))
    testing.expect(test,
        surface_contains(&surface, "Effective Build Configuration"))

    // A resize can transiently leave only frame cells. Every modal still
    // registers its cancel role against an empty paint rectangle, so Escape
    // must dismiss all ten without relying on a visible button or performing
    // unsigned geometry below zero.
    tiny: tui.Surface
    tui.surface_init(&tiny, 12, 5)
    defer tui.surface_destroy(&tiny)
    for index in dialogs {
        turbo_ui.show_modal_window(
            &app.ui,
            app.windows[:],
            app.windows[index].id,
        )
        _ = paint_app(&app, &tiny, turbo_ui.no_event())
        _ = paint_app(
            &app,
            &tiny,
            turbo_ui.key_event(turbo_ui.Key_Event{code = .escape}),
        )
        hidden := !app.windows[index].visible
        testing.expect(test, hidden)
    }
}

// Terminal protocols report presses and releases but no click count. The event
// loop classifies one exact same-cell pair within the monotonic interval, then
// consumes it so a third release cannot become another double click. Different
// cells and expired intervals always begin a fresh sequence.
test_pointer_click_classification_is_bounded :: proc(test: ^testing.Test) {
    clicks: Pointer_Click_State
    event := turbo_ui.mouse_event(turbo_ui.Mouse_Event{
        position = turbo_ui.Point{column = 4, row = 7},
        action = .release,
        button = .primary,
    })
    first_at := 10 * time.second
    classify_pointer_click(&event, &clicks, first_at)
    testing.expect(test, event.mouse.click_count == 1 && clicks.valid)

    event = turbo_ui.mouse_event(turbo_ui.Mouse_Event{
        position = turbo_ui.Point{column = 4, row = 7},
        action = .release,
        button = .primary,
    })
    classify_pointer_click(&event, &clicks, first_at + 100 * time.millisecond)
    testing.expect(test, event.mouse.click_count == 2 && !clicks.valid)

    event = turbo_ui.mouse_event(turbo_ui.Mouse_Event{
        position = turbo_ui.Point{column = 4, row = 7},
        action = .release,
        button = .primary,
    })
    classify_pointer_click(&event, &clicks, first_at + 200 * time.millisecond)
    testing.expect(test, event.mouse.click_count == 1 && clicks.valid)

    event = turbo_ui.mouse_event(turbo_ui.Mouse_Event{
        position = turbo_ui.Point{column = 5, row = 7},
        action = .release,
        button = .primary,
    })
    classify_pointer_click(&event, &clicks, first_at + 250 * time.millisecond)
    testing.expect(test, event.mouse.click_count == 1 && clicks.valid)

    event = turbo_ui.mouse_event(turbo_ui.Mouse_Event{
        position = turbo_ui.Point{column = 5, row = 7},
        action = .release,
        button = .primary,
    })
    classify_pointer_click(
        &event,
        &clicks,
        first_at + 250 * time.millisecond + Double_Click_Interval +
            time.nanosecond,
    )
    testing.expect(test, event.mouse.click_count == 1 && clicks.valid)
}

// Help is both a discoverable menu and the authoritative in-application
// shortcut reference. This test walks every authored row, opens Help through
// its underlined menu title, activates Keyboard Shortcuts with Enter, and then
// proves Escape closes only that modal rather than quitting the application.
test_help_menu_lists_and_closes_all_shortcuts :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-help-test.draft"))
    defer destroy_app(&app)

    for index: usize = 0; index < Shortcut_Row_Count; index += 1 {
        (key, command) := shortcut_row(index)
        testing.expect(test, len(key) != 0)
        testing.expect(test, len(command) != 0)
    }
    (definition_key, definition_command) := shortcut_row(17)
    testing.expect(test, text_equal(definition_key, "F12 / Shift-F12"))
    testing.expect(test,
        text_equal(definition_command, "Go to definition / find usages"))
    (cancel_key, cancel_command) := shortcut_row(42)
    testing.expect(test, text_equal(cancel_key, "Esc"))
    testing.expect(
        test,
        text_equal(
            cancel_command,
            "Cancel the current menu, dialog, or operation",
        ),
    )

    surface: tui.Surface
    tui.surface_init(&surface, 100, 35)
    defer tui.surface_destroy(&surface)
    (remaining, quit) := handle_global_key(&app, turbo_ui.key_event(
        turbo_ui.Key_Event{code = .f1},
    ))
    testing.expect(test, !quit && remaining.kind == .none)
    testing.expect(test, app.windows[Window_Shortcut_Help].visible)
    close_shortcut_help(&app)

    _ = paint_app(
        &app,
        &surface,
        turbo_ui.key_event(turbo_ui.Key_Event{
            code = .character,
            byte_value = cast[u8]('h'),
            alt = true,
        }),
    )
    testing.expect(test, app.menus.open_title == Menu_Help)

    _ = paint_app(
        &app,
        &surface,
        turbo_ui.key_event(turbo_ui.Key_Event{code = .enter}),
    )
    testing.expect(test, app.windows[Window_Shortcut_Help].visible)
    testing.expect(test,
        app.ui.modal_window == app.windows[Window_Shortcut_Help].id)
    testing.expect(test, app.ui.focused_id == 800)

    should_quit := paint_app(
        &app,
        &surface,
        turbo_ui.key_event(turbo_ui.Key_Event{code = .escape}),
    )
    testing.expect(test, !should_quit)
    testing.expect(test, !app.windows[Window_Shortcut_Help].visible)
}

// test_raw_mouse_quit crosses the boundary that the earlier menu and command
// tests skipped: exact SGR bytes pass through core/terminal, the shared adapter,
// window/popup routing, the File menu, and finally application exit policy. A
// release over Quit must survive the event-free repaint requested when the
// popup closes. Returning only that repaint's result used to discard the true
// quit result even though the menu visibly disappeared.
test_raw_mouse_quit :: proc(test: ^testing.Test) {
    app: App
    init_windows(&app)
    testing.expect(test, init_one_buffer(&app, "turbo-mouse-quit-test.draft"))
    defer destroy_app(&app)

    surface: tui.Surface
    tui.surface_init(&surface, 100, 35)
    defer tui.surface_destroy(&surface)
    decoder: terminal.Decoder
    should_quit := false

    // SGR coordinates are one based. Column 4, row 1 is the File title;
    // column 4, terminal row 14 is the Exit row in the bordered File popup.
    title_click := "\x1b[<0;4;1M\x1b[<0;4;1m"
    for index: usize = 0; index < len(title_click); index += 1 {
        event := turbo_ui_terminal.decode(&decoder, title_click[index])
        if event.kind != .none {
            should_quit = should_quit || paint_app(&app, &surface, event)
        }
    }
    testing.expect(test, !should_quit)
    testing.expect(test, app.menus.open_title == Menu_File)

    quit_click := "\x1b[<0;4;14M\x1b[<0;4;14m"
    for index: usize = 0; index < len(quit_click); index += 1 {
        event := turbo_ui_terminal.decode(&decoder, quit_click[index])
        if event.kind != .none {
            should_quit = should_quit || paint_app(&app, &surface, event)
        }
    }
    testing.expect(test, should_quit)
}
