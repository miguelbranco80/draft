        source = 1,
        start = 4,
        end = 10,
        line = 1,
        column = 5,
    }
}

fake_navigation_usage_count :: c proc(user: rawptr) -> usize {
    _ = user
    return 2
}

fake_navigation_usage :: c proc(
    user: rawptr,
    index: usize,
    result: ^draft_compiler_api.Navigation_Location,
) {
    _ = user
    if index == 0 {
        result^ = draft_compiler_api.Navigation_Location{
            source = 0,
            start = 0,
            end = 3,
            line = 1,
            column = 1,
        }
    } else {
        result^ = draft_compiler_api.Navigation_Location{
            source = 1,
            start = 4,
            end = 10,
            line = 1,
            column = 5,
        }
    }
}

fake_navigation_path :: c proc(
    user: rawptr,
    index: usize,
    destination: [^]u8,
    capacity: usize,
) -> usize {
    state := cast[^Fake_Navigation_State](user)
    if index == 0 {
        return fake_copy_bytes(
            state.first_path,
            state.first_length,
            destination,
            capacity,
        )
    }
    return fake_copy_bytes(
        state.second_path,
        state.second_length,
        destination,
        capacity,
    )
}

fake_navigation_editable :: c proc(user: rawptr, index: usize) -> u8 {
    _ = user
    _ = index
    return 1
}

fake_source_count :: c proc(user: rawptr) -> usize {
    _ = user
    return 2
}

fake_build :: c proc(
    user: rawptr,
    overlays: ^draft_compiler_api.Overlay,
    overlay_count: usize,
    active_overlay: usize,
    result: ^draft_compiler_api.Result,
) {
    if user != nil {
        state := cast[^Fake_Root_State](user)
        state.build_count += 1
        result.success = 0 if state.fail_build != 0 else 1
        result.diagnostic_count = 1 if state.fail_build != 0 else 0
    } else {
        result.success = 1
    }
    _ = overlays
    _ = overlay_count
    _ = active_overlay
    result.elapsed_nanoseconds = 360_000_000
}

fake_diagnostic_row_count :: c proc(user: rawptr) -> usize {
    if user == nil || cast[^Fake_Root_State](user).fail_build == 0 {
        return 0
    }
    return 1
}

fake_diagnostic_row :: c proc(
    user: rawptr,
    index: usize,
    result: ^draft_compiler_api.Diagnostic_Row,
) {
    _ = user
    if index != 0 {
        return
