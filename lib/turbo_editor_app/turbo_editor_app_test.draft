fake_artifact_path :: c proc(
    user: rawptr,
    destination: [^]u8,
    capacity: usize,
) -> usize {
    _ = user
    path := "/bin/sh"
    when target.os == .windows {
        path = "C:\\Windows\\System32\\where.exe"
    }
    if capacity != 0 && destination != nil {
        count := len(path)
        if count >= capacity {
            count = capacity - 1
        }
        data := raw_data(path)
        for index: usize = 0; index < count; index += 1 {
            destination[index] = data[index]
        }
        destination[count] = 0
    }
    return len(path)
}

fake_copy_bytes :: c proc(
    data: rawptr,
    length: usize,
    destination: [^]u8,
    capacity: usize,
) -> usize {
    if capacity != 0 && destination != nil {
        count := length
        if count >= capacity {
            count = capacity - 1
        }
        bytes := cast[[^]u8](data)
        for index: usize = 0; index < count; index += 1 {
            destination[index] = bytes[index]
        }
        destination[count] = 0
    }
    return length
}

// fake_build_configuration supplies the already-resolved compiler policy
// through the same bounded copy contract as the native compiler service. The
// application must retain this text independently of later host calls because
// painting never borrows storage across the C boundary.
fake_build_configuration :: c proc(
    user: rawptr,
    destination: [^]u8,
    capacity: usize,
) -> usize {
    _ = user
    text := "root package: examples/editor\ntarget: aarch64-macos\noptimization: O2\n"
    return fake_copy_bytes(
        cast[rawptr](raw_data(text)),
        len(text),
        destination,
        capacity,
    )
}

