// Application views paint modal dialogs, document/program lists, and compiler
// inspection windows into caller-selected content rectangles. They borrow all
// rows and text from App for one immediate frame and retain only the explicit
// List_State/Text_View_State values already owned there.
//
// This module contains presentation and widget-result handling only. File,
// workspace, search, compiler, and exit semantics are named command procedures
// in sibling modules rather than callbacks hidden inside reusable UI controls.
package turbo_editor_app

import core/format
import core/memory
import lib/turbo_editor
import lib/turbo_ui

// action_row creates the one-row, right-aligned footer used by modal actions.
// total_width includes every button face and inter-button gap. If a transiently
// narrow content rectangle cannot fit the authored row, layout_next returns
// empty rectangles for the excess controls; their default/cancel keyboard roles
// remain registered, so resizing never traps the user inside a modal.
action_row :: proc(
    content: turbo_ui.Rect,
    row, total_width: usize,
    gap: usize = 1,
) -> turbo_ui.Layout {
    bounds := turbo_ui.Rect{
        column = content.column,
        row = row,
        width = content.width,
        height = 1,
    }
    if total_width < bounds.width {
        bounds.column += bounds.width - total_width
        bounds.width = total_width
    }
    return turbo_ui.layout_begin(bounds, .horizontal, 0, gap)
}

paint_search :: proc(
    app: ^App,
    content: turbo_ui.Rect,
) {
    turbo_ui.write_clipped(
        app.ui.surface,
        content,
        turbo_ui.Point{column = content.column + 1, row = content.row},
        "Find literal bytes:",
        app.ui.theme.text,
    )
    find_next_requested := false
    find_previous_requested := false
    if content.height > 2 && content.width > 2 {
        query_bounds := turbo_ui.Rect{
            column = content.column + 1,
            row = content.row + 2,
            width = content.width - 2,
            height = 1,
        }
        result := turbo_ui.text_box(
            &app.ui,
            500,
            query_bounds,
            &app.search_box,
            app.search[:],
        )
        find_next_requested = result.submitted
    }
    if content.height > 3 && content.width > 2 {
        next_width := turbo_ui.compact_button_width("Next")
        previous_width := turbo_ui.compact_button_width("Previous")
        cancel_width := turbo_ui.compact_button_width("Cancel")
        buttons := action_row(
            content,
            content.row + 3,
            next_width + previous_width + cancel_width + 2,
        )
        find_next_requested = find_next_requested || turbo_ui.button(
            &app.ui,
            501,
            turbo_ui.layout_next(&buttons, next_width),
            "Next",
            true,
            .default_action,
            cast[u8]('n'),
        )
        find_previous_requested = turbo_ui.button(
            &app.ui,
            503,
            turbo_ui.layout_next(&buttons, previous_width),
            "Previous",
            true,
            .normal,
            cast[u8]('p'),
        )
        if turbo_ui.button(
            &app.ui,
            502,
            turbo_ui.layout_next(&buttons, cancel_width),
            "Cancel",
            true,
            .cancel_action,
            cast[u8]('c'),
        ) {
            close_search(app)
        }
    } else if turbo_ui.button(
        &app.ui,
        502,
        turbo_ui.Rect{},
        "Cancel",
        true,
        .cancel_action,
    ) {
        // Preserve Escape dismissal while a tiny resize transient leaves no
        // cells in which to paint the dialog buttons.
        close_search(app)
    }
    if find_next_requested || find_previous_requested {
        // Finding is a repeatable dialog action. The shared command updates the
        // document selection underneath this modal, then restores this dialog
        // and its query focus; only Cancel/Escape/window-close dismisses it.
        _ = perform_find(app, find_previous_requested)
    }
}

// paint_replace shares the persistent Find query with the Find dialog and
// retains replacement text independently. Replace and Replace All remain open
// for repeated work; every mutation goes through turbo_editor's atomic history
// operations, never through direct App-owned byte manipulation.
paint_replace :: proc(app: ^App, content: turbo_ui.Rect) {
    turbo_ui.write_clipped(
        app.ui.surface,
        content,
        turbo_ui.Point{column = content.column + 1, row = content.row},
        "Find:",
        app.ui.theme.text,
    )
    replace_requested := false
    if content.width > 11 && content.height > 1 {
        find_result := turbo_ui.text_box(
            &app.ui,
            580,
            turbo_ui.Rect{
                column = content.column + 10,
                row = content.row,
                width = content.width - 11,
                height = 1,
            },
            &app.search_box,
            app.search[:],
        )
        replace_requested = find_result.submitted
    }
    if content.width > 11 && content.height > 3 {
        turbo_ui.write_clipped(
            app.ui.surface,
            content,
            turbo_ui.Point{column = content.column + 1, row = content.row + 2},
            "Replace:",
            app.ui.theme.text,
        )
        replacement_result := turbo_ui.text_box(
            &app.ui,
            581,
            turbo_ui.Rect{
                column = content.column + 10,
                row = content.row + 2,
                width = content.width - 11,
                height = 1,
            },
            &app.replacement_box,
            app.replacement[:],
        )
        replace_requested = replace_requested || replacement_result.submitted
    }

    replace_all_requested := false
    find_next_requested := false
    if content.width > 2 && content.height > 5 {
        replace_width := turbo_ui.compact_button_width("Replace")
        all_width := turbo_ui.compact_button_width("Replace All")
        next_width := turbo_ui.compact_button_width("Find Next")
        cancel_width := turbo_ui.compact_button_width("Cancel")
        buttons := action_row(
            content,
            content.row + 5,
            replace_width + all_width + next_width + cancel_width + 3,
        )
        replace_requested = replace_requested || turbo_ui.button(
            &app.ui,
            582,
            turbo_ui.layout_next(&buttons, replace_width),
            "Replace",
            true,
            .default_action,
            cast[u8]('r'),
        )
        replace_all_requested = turbo_ui.button(
            &app.ui,
            583,
            turbo_ui.layout_next(&buttons, all_width),
            "Replace All",
            true,
            .normal,
            cast[u8]('a'),
        )
        find_next_requested = turbo_ui.button(
            &app.ui,
            584,
            turbo_ui.layout_next(&buttons, next_width),
            "Find Next",
            true,
            .normal,
            cast[u8]('f'),
        )
        if turbo_ui.button(
            &app.ui,
            585,
            turbo_ui.layout_next(&buttons, cancel_width),
            "Cancel",
            true,
            .cancel_action,
            cast[u8]('c'),
        ) {
            close_replace(app)
        }
    } else if turbo_ui.button(
        &app.ui,
        585,
        turbo_ui.Rect{},
        "Cancel",
        true,
        .cancel_action,
    ) {
        close_replace(app)
    }

    if replace_requested {
        _ = replace_current(app, true)
        if app.windows[Window_Replace].visible {
            app.ui.focused_id = 580
        }
    } else if replace_all_requested {
        _ = replace_every_match(app)
        if app.windows[Window_Replace].visible {
            app.ui.focused_id = 580
        }
    } else if find_next_requested {
        _ = perform_find(app, false)
        if app.windows[Window_Replace].visible {
            app.ui.focused_id = 580
        }
    }
}

paint_go_to_line :: proc(app: ^App, content: turbo_ui.Rect) {
    turbo_ui.write_clipped(
        app.ui.surface,
        content,
        turbo_ui.Point{column = content.column + 1, row = content.row},
        "Line number:",
        app.ui.theme.text,
    )
    submitted := false
    if content.width > 15 && content.height > 1 {
        result := turbo_ui.text_box(
            &app.ui,
            590,
            turbo_ui.Rect{
                column = content.column + 14,
                row = content.row,
                width = content.width - 15,
                height = 1,
            },
            &app.go_line_box,
            app.go_line[:],
            true,
            .unsigned_integer,
        )
        submitted = result.submitted
    }
    if content.width > 2 && content.height > 2 {
        go_width := turbo_ui.compact_button_width("Go To")
        cancel_width := turbo_ui.compact_button_width("Cancel")
        buttons := action_row(
            content,
            content.row + 2,
            go_width + cancel_width + 1,
        )
        submitted = submitted || turbo_ui.button(
            &app.ui,
            591,
            turbo_ui.layout_next(&buttons, go_width),
            "Go To",
            true,
            .default_action,
            cast[u8]('g'),
        )
        if turbo_ui.button(
            &app.ui,
            592,
            turbo_ui.layout_next(&buttons, cancel_width),
            "Cancel",
            true,
            .cancel_action,
            cast[u8]('c'),
        ) {
            close_go_to_line(app)
        }
    } else if turbo_ui.button(
        &app.ui,
        592,
        turbo_ui.Rect{},
        "Cancel",
        true,
        .cancel_action,
    ) {
        close_go_to_line(app)
    }
    if submitted {
        submit_go_to_line(app)
    }
}

// paint_file_browser composes ordinary reusable controls over the browser
// model. Location is a pathname field, entries are a selection list, Name is a
// filename field only in file modes. Its toolbar and footer use exact one-row
// faces, directories use compact disclosure markers, and unneeded scrollbars
// remain visually absent. Enter or a true double click on a directory navigates;
// the same activation on a file commits the default operation.
paint_file_browser :: proc(app: ^App, content: turbo_ui.Rect) {
    if content.width < 20 || content.height < 10 {
        if turbo_ui.button(
            &app.ui,
            839,
            turbo_ui.Rect{},
            "Cancel",
            true,
            .cancel_action,
        ) {
            close_file_browser(app)
            app.status = "File operation cancelled"
        }
        return
    }
    turbo_ui.write_clipped(
        app.ui.surface,
        content,
        turbo_ui.Point{column = content.column + 1, row = content.row},
        "Location:",
        app.ui.theme.text,
    )
    location_result := turbo_ui.text_box(
        &app.ui,
        832,
        turbo_ui.Rect{
            column = content.column + 11,
            row = content.row,
            width = content.width - 12,
            height = 1,
        },
        &app.browser_location_box,
        app.browser_location[:],
    )
    if location_result.submitted {
        _ = refresh_file_browser(app)
    }
    navigation := turbo_ui.layout_begin(
        turbo_ui.Rect{
            column = content.column + 1,
            row = content.row + 1,
            width = content.width - 2,
            height = 1,
        },
        .horizontal,
        0,
        1,
    )
    if turbo_ui.button(
        &app.ui,
        833,
        turbo_ui.layout_next(&navigation, turbo_ui.compact_button_width("Up")),
        "Up",
        true,
        .normal,
        cast[u8]('u'),
    ) {
        _ = enter_browser_directory(app, 0)
    }
    if turbo_ui.button(
        &app.ui,
        834,
        turbo_ui.layout_next(
            &navigation,
            turbo_ui.compact_button_width("Refresh"),
        ),
        "Refresh",
        true,
        .normal,
        cast[u8]('r'),
    ) {
        _ = refresh_file_browser(app)
    }

    bottom_rows: usize = 2
    if app.browser_mode != .open_workspace {
        bottom_rows = 3
    }
    list_bounds := turbo_ui.Rect{
        column = content.column + 1,
        row = content.row + 3,
        width = content.width - 2,
        height = content.height - bottom_rows - 3,
    }
    view := turbo_ui.list_view(
        &app.ui,
        830,
        831,
        list_bounds,
        app.browser_entry_count,
        &app.browser_list,
        .double_click_and_enter,
        .when_needed,
    )
    for index := view.first; index < view.end; index += 1 {
        row := turbo_ui.list_row_begin(&app.ui, view, index)
        marker := "? "
        if app.browser_entry_kind[index] == .directory {
            marker = "▸ "
        } else if app.browser_entry_kind[index] == .regular_file {
            marker = "  "
        }
        turbo_ui.write_clipped(
            app.ui.surface,
            turbo_ui.intersect(app.ui.clip, row.bounds),
            turbo_ui.Point{column = row.bounds.column, row = row.bounds.row},
            marker,
            row.style,
        )
        if row.bounds.width > 2 {
            name_bounds := row.bounds
            name_bounds.column += 2
            name_bounds.width -= 2
            turbo_ui.write_clipped_bytes(
                app.ui.surface,
                turbo_ui.intersect(app.ui.clip, name_bounds),
                turbo_ui.Point{column = name_bounds.column, row = name_bounds.row},
                browser_entry_name(app, index),
                row.style,
            )
        }
    }
    if view.selection_changed && view.cursor < app.browser_entry_count &&
        app.browser_mode != .open_workspace {
        if browser_entry_is_directory(app, view.cursor) {
            _ = turbo_ui.text_box_set_text(
                &app.browser_name_box,
                app.browser_name[:],
                "",
            )
        } else {
            _ = turbo_ui.text_box_set(
                &app.browser_name_box,
                app.browser_name[:],
                browser_entry_name(app, view.cursor),
            )
        }
    }
    if view.activated && view.activated_index < app.browser_entry_count {
        index := view.activated_index
        if browser_entry_is_directory(app, index) {
            _ = enter_browser_directory(app, index)
        } else if app.browser_mode == .open_workspace {
            app.status = "Choose a directory for the workspace"
        } else {
            _ = turbo_ui.text_box_set(
                &app.browser_name_box,
                app.browser_name[:],
                browser_entry_name(app, index),
            )
            commit_file_browser(app)
        }
    }

    button_row := content.row + content.height - 1
    if app.browser_mode != .open_workspace {
        turbo_ui.write_clipped(
            app.ui.surface,
            content,
            turbo_ui.Point{
                column = content.column + 1,
                row = content.row + content.height - 3,
            },
            "Name:",
            app.ui.theme.text,
        )
        name_result := turbo_ui.text_box(
            &app.ui,
            835,
            turbo_ui.Rect{
                column = content.column + 8,
                row = content.row + content.height - 3,
                width = content.width - 9,
                height = 1,
            },
            &app.browser_name_box,
            app.browser_name[:],
        )
        if name_result.submitted {
            commit_file_browser(app)
        }
    }
    action_label := "Open"
    action_key := cast[u8]('o')
    if app.browser_mode == .save_as {
        action_label = "Save"
        action_key = cast[u8]('s')
    } else if app.browser_mode == .open_workspace {
        action_label = "Select Workspace"
        action_key = cast[u8]('w')
    }
    selected_directory := app.browser_list.cursor < app.browser_entry_count &&
        browser_entry_is_directory(app, app.browser_list.cursor)
    action_enabled := app.browser_mode == .open_workspace ||
        (app.browser_mode == .open_file && selected_directory) ||
        len(browser_name_bytes(app)) != 0
    action_width := turbo_ui.compact_button_width(action_label)
    cancel_width := turbo_ui.compact_button_width("Cancel")
    buttons := action_row(
        content,
        button_row,
        action_width + cancel_width + 1,
    )
    if turbo_ui.button(
        &app.ui,
        838,
        turbo_ui.layout_next(&buttons, action_width),
        action_label,
        action_enabled,
        .default_action,
        action_key,
    ) {
        if app.browser_mode == .open_file && selected_directory {
            _ = enter_browser_directory(app, app.browser_list.cursor)
        } else {
            commit_file_browser(app)
        }
    }
    if turbo_ui.button(
        &app.ui,
        839,
        turbo_ui.layout_next(&buttons, cancel_width),
        "Cancel",
        true,
        .cancel_action,
        cast[u8]('c'),
    ) {
        close_file_browser(app)
        app.status = "File operation cancelled"
    }
}

// paint_workspace_files presents a persistent, workspace-rooted directory
// snapshot. Unlike the modal file selector, its location is read-only and its
// Up operation stops at the compiler-published Workspace boundary. Selecting a
// row never changes the active root package: Enter or double-click navigates a
// directory or opens the exact file as an ordinary document, which may remain
// editing-only. The compact toolbar deliberately uses one-row buttons and hides
// an unneeded scrollbar; dialog shadows and a full-height disabled track would
// waste most of a small file pane.
paint_workspace_files :: proc(app: ^App, content: turbo_ui.Rect) {
    if content.width < 16 || content.height < 6 {
        turbo_ui.write_clipped(
            app.ui.surface,
            content,
            turbo_ui.Point{column = content.column, row = content.row},
            "Workspace Files",
            app.ui.theme.text,
        )
        return
    }
    if app.workspace_files_root_length == 0 {
        turbo_ui.write_clipped(
            app.ui.surface,
            content,
            turbo_ui.Point{column = content.column + 1, row = content.row + 1},
            "No compiler Workspace is open",
            app.ui.theme.text,
        )
        return
    }

    turbo_ui.write_clipped(
        app.ui.surface,
        content,
        turbo_ui.Point{column = content.column + 1, row = content.row},
        "Workspace /",
        app.ui.theme.text,
    )
    location_bounds := turbo_ui.Rect{
        column = content.column + 12,
        row = content.row,
        width = content.width - 13,
        height = 1,
    }
    turbo_ui.write_clipped_bytes(
        app.ui.surface,
        turbo_ui.intersect(app.ui.clip, location_bounds),
        turbo_ui.Point{
            column = location_bounds.column,
            row = location_bounds.row,
        },
        workspace_files_relative_location(app),
        app.ui.theme.text,
    )

    navigation := turbo_ui.layout_begin(
        turbo_ui.Rect{
            column = content.column + 1,
            row = content.row + 1,
            width = content.width - 2,
            height = 1,
        },
        .horizontal,
        0,
        1,
    )
    if turbo_ui.button(
        &app.ui,
        852,
        turbo_ui.layout_next(
            &navigation,
            turbo_ui.compact_button_width("Up"),
        ),
        "Up",
        !workspace_files_at_root(app),
        .normal,
        cast[u8]('u'),
    ) {
        _ = workspace_files_go_up(app)
    }
    if turbo_ui.button(
        &app.ui,
        853,
        turbo_ui.layout_next(
            &navigation,
            turbo_ui.compact_button_width("Refresh"),
        ),
        "Refresh",
        true,
        .normal,
        cast[u8]('r'),
    ) {
        if refresh_workspace_files(app) {
            app.status = "Workspace Files refreshed"
        }
    }

    footer_height: usize
    if app.workspace_files_truncated {
        footer_height = 1
    }
    list_bounds := turbo_ui.Rect{
        column = content.column + 1,
        row = content.row + 3,
        width = content.width - 2,
        height = content.height - 3 - footer_height,
    }
    view := turbo_ui.list_view(
        &app.ui,
        850,
        851,
        list_bounds,
        app.workspace_file_entry_count,
        &app.workspace_files_list,
        .double_click_and_enter,
        .when_needed,
    )
    for index := view.first; index < view.end; index += 1 {
        row := turbo_ui.list_row_begin(&app.ui, view, index)
        marker := "? "
        if app.workspace_file_entry_kind[index] == .directory {
            marker = "▸ "
        } else if app.workspace_file_entry_kind[index] == .regular_file {
            marker = "  "
        }
        turbo_ui.write_clipped(
            app.ui.surface,
            turbo_ui.intersect(app.ui.clip, row.bounds),
            turbo_ui.Point{column = row.bounds.column, row = row.bounds.row},
            marker,
            row.style,
        )
        if row.bounds.width > 2 {
            name_bounds := row.bounds
            name_bounds.column += 2
            name_bounds.width -= 2
            turbo_ui.write_clipped_bytes(
                app.ui.surface,
                turbo_ui.intersect(app.ui.clip, name_bounds),
                turbo_ui.Point{
                    column = name_bounds.column,
                    row = name_bounds.row,
                },
                workspace_file_entry_name(app, index),
                row.style,
            )
        }
    }
    if view.activated && view.activated_index < app.workspace_file_entry_count {
        _ = activate_workspace_file_entry(app, view.activated_index)
    }
    if app.workspace_files_truncated {
        turbo_ui.write_clipped(
            app.ui.surface,
            content,
            turbo_ui.Point{
                column = content.column + 1,
                row = content.row + content.height - 1,
            },
            "Directory truncated: 512-row limit",
            app.ui.theme.text,
        )
    }
}

paint_workspace_confirm :: proc(app: ^App, content: turbo_ui.Rect) {
    message := "Save or discard modified documents before continuing?"
    if app.confirming_scope_change {
        message = "This file belongs to another compiler scope. Switch and open it?"
    }
    turbo_ui.write_clipped(
        app.ui.surface,
        content,
        turbo_ui.Point{column = content.column + 1, row = content.row + 1},
        message,
        app.ui.theme.text,
    )
    cancel_requested := false
    if content.width <= 2 || content.height < 4 {
        cancel_requested = turbo_ui.button(
            &app.ui, 575, turbo_ui.Rect{}, "Cancel", true, .cancel_action,
        )
    } else {
        cancel_width := turbo_ui.compact_button_width("Cancel")
        buttons_width := cancel_width
        if app.confirming_scope_change {
            buttons_width +=
                turbo_ui.compact_button_width("Switch and Open") + 1
        } else {
            buttons_width += turbo_ui.compact_button_width("Save All") +
                turbo_ui.compact_button_width("Discard") + 2
        }
        buttons := action_row(content, content.row + 3, buttons_width)
        if app.confirming_scope_change {
            if turbo_ui.button(
                &app.ui,
                573,
                turbo_ui.layout_next(
                    &buttons,
                    turbo_ui.compact_button_width("Switch and Open"),
                ),
                "Switch and Open",
                true,
                .default_action,
                cast[u8]('s'),
            ) {
                if has_dirty_buffers(app) {
                    show_workspace_dirty_confirmation(app)
                } else {
                    _ = perform_workspace_transition(app)
                }
            }
        } else {
            if turbo_ui.button(
                &app.ui,
                573,
                turbo_ui.layout_next(
                    &buttons,
                    turbo_ui.compact_button_width("Save All"),
                ),
                "Save All",
                true,
                .default_action,
                cast[u8]('s'),
            ) {
                turbo_ui.hide_window(
                    &app.ui,
                    app.windows[:],
                    app.windows[Window_Workspace_Confirm].id,
                )
                save_all_documents(app)
                if !has_dirty_buffers(app) {
                    _ = perform_workspace_transition(app)
                }
            }
            if turbo_ui.button(
                &app.ui,
                574,
                turbo_ui.layout_next(
                    &buttons,
                    turbo_ui.compact_button_width("Discard"),
                ),
                "Discard",
                true,
                .normal,
                cast[u8]('d'),
            ) {
                _ = perform_workspace_transition(app)
            }
        }
        cancel_requested = turbo_ui.button(
            &app.ui,
            575,
            turbo_ui.layout_next(&buttons, cancel_width),
            "Cancel",
            true,
            .cancel_action,
            cast[u8]('c'),
        )
    }
    if cancel_requested {
        close_workspace_dialogs(app)
        app.pending_workspace_transition = .none
        app.confirming_scope_change = false
        app.status = "Workspace operation cancelled"
    }
}

paint_quit :: proc(app: ^App, content: turbo_ui.Rect) -> bool {
    buffer := active_buffer(app)
    message := "The active document has unsaved changes."
    save_label := "Save + exit"
    save_width := turbo_ui.compact_button_width(save_label)
    save_access := cast[u8]('s')
    unnamed := turbo_editor.is_unnamed(buffer)
    if unnamed {
        message = "Choose a path before saving this document."
        save_label = "Save As"
        save_width = turbo_ui.compact_button_width(save_label)
        save_access = cast[u8]('a')
    } else if buffer.disk_conflict {
        message = "Disk also changed. Choose whether to overwrite it."
        save_label = "Overwrite + exit"
        save_width = turbo_ui.compact_button_width(save_label)
        save_access = cast[u8]('o')
    }
    turbo_ui.write_clipped(
        app.ui.surface,
        content,
        turbo_ui.Point{column = content.column + 1, row = content.row + 1},
        message,
        app.ui.theme.text,
    )
    if content.height < 4 || content.width <= 2 {
        if turbo_ui.button(
            &app.ui,
            512,
            turbo_ui.Rect{},
            "Cancel",
            true,
            .cancel_action,
        ) {
            cancel_quit(app)
        }
        return false
    }
    discard_width := turbo_ui.compact_button_width("Discard")
    cancel_width := turbo_ui.compact_button_width("Cancel")
    buttons := action_row(
        content,
        content.row + 3,
        save_width + discard_width + cancel_width + 2,
    )
    if turbo_ui.button(
        &app.ui,
        510,
        turbo_ui.layout_next(&buttons, save_width),
        save_label,
        true,
        .default_action,
        save_access,
    ) {
        if unnamed {
            // Save As owns the path decision. Leave Exit pending only in the
            // user's intent, not hidden modal state: after a successful save,
            // a second Exit is explicit and cannot race another dirty file.
            cancel_quit(app)
            request_save_as(app)
            return false
        }
        // The conflict-specific label makes this the one explicit overwrite
        // path. Every ordinary Save refuses to replace a changed disk file.
        if turbo_editor.save(buffer, buffer.disk_conflict) {
            return continue_quit(app)
        }
        app.status = "Save failed; editor remains open"
    }
    if turbo_ui.button(
        &app.ui,
        511,
        turbo_ui.layout_next(&buttons, discard_width),
        "Discard",
        true,
        .normal,
        cast[u8]('d'),
    ) {
        app.quit_discard_mask |= cast[u64](1) << cast[u64](app.active)
        return continue_quit(app)
    }
    if turbo_ui.button(
        &app.ui,
        512,
        turbo_ui.layout_next(&buttons, cancel_width),
        "Cancel",
        true,
        .cancel_action,
        cast[u8]('c'),
    ) {
        cancel_quit(app)
    }
    return false
}

// paint_shortcut_help presents every authored shortcut through the same
// reusable list/scrollbar control as other long application views. The key
// column has a fixed width chosen by this application; the UI library remains
// unaware of keyboard-command semantics. Close is a real cancel button, so
// Escape works from the list without a special event path.
paint_shortcut_help :: proc(app: ^App, content: turbo_ui.Rect) {
    if content.width != 0 && content.height != 0 {
        turbo_ui.fill_rect(
            app.ui.surface,
            app.ui.clip,
            turbo_ui.Rect{
                column = content.column,
                row = content.row,
                width = content.width,
                height = 1,
            },
            ' ',
            app.ui.theme.border,
        )
        turbo_ui.write_clipped(
            app.ui.surface,
            app.ui.clip,
            turbo_ui.Point{column = content.column + 1, row = content.row},
            "Key                  Command",
            app.ui.theme.border,
        )
    }

    if content.width > 2 && content.height > 3 {
        list_bounds := turbo_ui.Rect{
            column = content.column + 1,
            row = content.row + 1,
            width = content.width - 2,
            height = content.height - 3,
        }
        view := turbo_ui.list_view(
            &app.ui,
            800,
            801,
            list_bounds,
            Shortcut_Row_Count,
            &app.shortcut_list,
            .enter_only,
            .when_needed,
        )
        for index := view.first; index < view.end; index += 1 {
            row := turbo_ui.list_row_begin(&app.ui, view, index)
            (key, command) := shortcut_row(index)
            key_width: usize = 21
            if key_width > row.bounds.width {
                key_width = row.bounds.width
            }
            key_bounds := row.bounds
            key_bounds.width = key_width
            turbo_ui.write_clipped(
                app.ui.surface,
                turbo_ui.intersect(app.ui.clip, key_bounds),
                turbo_ui.Point{
                    column = key_bounds.column,
                    row = key_bounds.row,
                },
                key,
                row.style,
            )
            if row.bounds.width > key_width {
                command_bounds := turbo_ui.Rect{
                    column = row.bounds.column + key_width,
                    row = row.bounds.row,
                    width = row.bounds.width - key_width,
                    height = 1,
                }
                turbo_ui.write_clipped(
                    app.ui.surface,
                    turbo_ui.intersect(app.ui.clip, command_bounds),
                    turbo_ui.Point{
                        column = command_bounds.column,
                        row = command_bounds.row,
                    },
                    command,
                    row.style,
                )
            }
        }
    }

    close_width := turbo_ui.compact_button_width("Close")
    close_bounds: turbo_ui.Rect
    if content.width >= close_width && content.height != 0 {
        close_row := action_row(
            content,
            content.row + content.height - 1,
            close_width,
        )
        close_bounds = turbo_ui.layout_next(&close_row, close_width)
    }
    if turbo_ui.button(
        &app.ui,
        802,
        close_bounds,
        "Close",
        true,
        .cancel_action,
        cast[u8]('c'),
    ) {
        close_shortcut_help(app)
    }
}

// editor_title_bytes prefers the workspace-relative label already published
// for a file in the active root. The Buffer retains its canonical path for
// I/O and conflict detection, but exposing that entire host path in the title
// wastes the scarce terminal columns which distinguish nearby source files.
// Editing-only, read-only dependency, and unnamed documents fall back to their
// own stored labels because they have no active-root row.
editor_title_bytes :: proc(app: ^App) -> []u8 {
    path := turbo_editor.path_bytes(active_buffer(app))
    for index: usize = 0; index < app.reachable_source_count; index += 1 {
        source_path := memory.owned_string_bytes(
            &app.reachable_source_paths[index],
        )
        if byte_views_equal(path, source_path) {
            return memory.owned_string_bytes(
                &app.reachable_source_names[index],
            )
        }
    }
    return path
}

// paint_open_documents shows only buffers the editor currently owns. Filesystem
// discovery belongs to Open File; semantic package discovery belongs to the
// Packages and Imports view. Keeping those concepts separate makes every row's
// activation predictable.
paint_open_documents :: proc(app: ^App, content: turbo_ui.Rect) {
    count := app.buffer_count
    if content.width == 0 || content.height == 0 {
        return
    }
    view := turbo_ui.list_view(
        &app.ui,
        532,
        533,
        content,
        count,
        &app.open_documents,
        .click_and_enter,
        .when_needed,
    )
    for index := view.first; index < view.end; index += 1 {
        row := turbo_ui.list_row_begin(&app.ui, view, index)
        marker := "  "
        if app.buffers[index].dirty {
            marker = "* "
        } else if turbo_editor.is_read_only(&app.buffers[index]) {
            marker = "R "
        } else if index == app.active {
            marker = "> "
        }
        turbo_ui.write_clipped(
            app.ui.surface,
            turbo_ui.intersect(app.ui.clip, row.bounds),
            turbo_ui.Point{column = row.bounds.column, row = row.bounds.row},
            marker,
            row.style,
        )
        if row.bounds.width > 2 {
            label_bounds := turbo_ui.Rect{
                column = row.bounds.column + 2,
                row = row.bounds.row,
                width = row.bounds.width - 2,
                height = 1,
            }
            turbo_ui.write_clipped_bytes(
                app.ui.surface,
                turbo_ui.intersect(app.ui.clip, label_bounds),
                turbo_ui.Point{
                    column = label_bounds.column,
                    row = label_bounds.row,
                },
                turbo_editor.path_bytes(&app.buffers[index]),
                row.style,
            )
        }
    }
    if view.activated && view.activated_index < count {
        if activate_buffer(app, view.activated_index) {
            app.status = "Open document activated"
        } else {
            app.status = "Could not activate the selected document"
        }
    }
}

// paint_navigation_usages presents compiler-resolved exact locations as an
// ordinary reusable desktop list. Rows remain app-owned across later checks;
// activating one opens its stable pathname and selects the retained byte range.
// The coordinate prefix is formatted into bounded stack storage each frame and
// the path paints directly from its independent owner.
paint_navigation_usages :: proc(app: ^App, content: turbo_ui.Rect) {
    if content.width == 0 || content.height == 0 {
        return
    }
    view := turbo_ui.list_view(
        &app.ui,
        820,
        821,
        content,
        app.navigation_row_count,
        &app.navigation_list,
        .click_and_enter,
        .when_needed,
    )
    for index := view.first; index < view.end; index += 1 {
        row := turbo_ui.list_row_begin(&app.ui, view, index)
        target := &app.navigation_rows[index]
        coordinate: [48]u8
        coordinate_length: usize
        line_storage: [20]u8
        (line, line_ok) := format.unsigned_decimal(
            line_storage[:],
            cast[u64](target.line),
        )
        if line_ok {
            for byte in line {
                coordinate[coordinate_length] = byte
                coordinate_length += 1
            }
        }
        coordinate[coordinate_length] = cast[u8](':')
        coordinate_length += 1
        column_storage: [20]u8
        (column, column_ok) := format.unsigned_decimal(
            column_storage[:],
            cast[u64](target.column),
        )
        if column_ok {
            for byte in column {
                coordinate[coordinate_length] = byte
                coordinate_length += 1
            }
        }
        coordinate[coordinate_length] = cast[u8](' ')
        coordinate_length += 1
        clip := turbo_ui.intersect(app.ui.clip, row.bounds)
        turbo_ui.write_clipped_bytes(
            app.ui.surface,
            clip,
            turbo_ui.Point{column = row.bounds.column, row = row.bounds.row},
            coordinate[:coordinate_length],
            row.style,
        )
        if coordinate_length < row.bounds.width {
            path_bounds := turbo_ui.Rect{
                column = row.bounds.column + coordinate_length,
                row = row.bounds.row,
                width = row.bounds.width - coordinate_length,
                height = 1,
            }
            turbo_ui.write_clipped_bytes(
                app.ui.surface,
                turbo_ui.intersect(app.ui.clip, path_bounds),
                turbo_ui.Point{
                    column = path_bounds.column,
                    row = path_bounds.row,
                },
                memory.owned_string_bytes(&target.path),
                row.style,
            )
        }
    }
    if view.activated && view.activated_index < app.navigation_row_count {
        if open_navigation_target(
            app,
            &app.navigation_rows[view.activated_index],
            true,
        ) {
            app.status = "Usage selected"
        } else {
            app.status = "Could not open the selected usage"
        }
    }
}

root_package_name :: proc(app: ^App, index: usize) -> []u8 {
    assert(index < app.root_package_count, "root-package label is invalid")
    return app.root_package_names[index][:app.root_package_length[index]]
}

// paint_root_package_picker makes the compiler root choice visible and directly
// selectable instead of hiding it behind a menu-only cycle. Arrow keys move the
// cursor, Enter commits it, and a primary click commits one visible row. The
// compiler service remains authoritative; select_root_package performs the
// atomic service/editor transition and restores the old root on failure.
paint_root_package_picker :: proc(app: ^App, bounds: turbo_ui.Rect) {
    if bounds.width == 0 || bounds.height == 0 {
        return
    }
    view := turbo_ui.list_view(
        &app.ui,
        760,
        761,
        bounds,
        app.root_package_count,
        &app.root_packages,
        .click_and_enter,
        .when_needed,
    )
    active := app.root_package_count
    if app.host.selected_root != nil {
        active = app.host.selected_root(app.host.user)
    }
    for index := view.first; index < view.end; index += 1 {
        row := turbo_ui.list_row_begin(&app.ui, view, index)
        marker := "  "
        if index == active {
            marker = "* "
        }
        turbo_ui.write_clipped(
            app.ui.surface,
            turbo_ui.intersect(app.ui.clip, row.bounds),
            turbo_ui.Point{column = row.bounds.column, row = row.bounds.row},
            marker,
            row.style,
        )
        if row.bounds.width > 2 {
            label_bounds := turbo_ui.Rect{
                column = row.bounds.column + 2,
                row = row.bounds.row,
                width = row.bounds.width - 2,
                height = 1,
            }
            turbo_ui.write_clipped_bytes(
                app.ui.surface,
                turbo_ui.intersect(app.ui.clip, label_bounds),
                turbo_ui.Point{column = label_bounds.column, row = label_bounds.row},
                root_package_name(app, index),
                row.style,
            )
        }
    }
    if view.activated {
        if select_root_package(app, view.activated_index) {
            app.status = "Active root package changed"
        } else {
            app.status = "Could not activate the selected root package"
        }
    }
}

// paint_text_view delegates the shared line-scanning, focus, keyboard, wheel,
// and proportional-scrollbar policy to turbo_ui. App retains only the copied
// compiler bytes and one explicit viewport state per semantic window.
paint_text_view :: proc(
    app: ^App,
    window_index: usize,
    content: turbo_ui.Rect,
) {
    assert(window_index >= Text_Window_First &&
        window_index < Text_Window_First + Text_Window_Count,
        "tooling window index is invalid")
    text_index := window_index - Text_Window_First
    bytes := app.tooling_text[text_index][:app.tooling_length[text_index]]
    turbo_ui.text_view_bytes(
        &app.ui,
        cast[turbo_ui.Widget_Id](700 + text_index),
        cast[turbo_ui.Widget_Id](720 + text_index),
        content,
        bytes,
        &app.tooling_views[text_index],
        .when_needed,
    )
}

// paint_diagnostics presents one selectable row per structured compiler
// diagnostic. Labels are copied into bounded frame-local storage only for
// visible rows; activation asks the host integration to open the exact retained
// source range. The empty state is explicit so a manually retained Diagnostics
// window remains meaningful after the next successful operation.
paint_diagnostics :: proc(app: ^App, content: turbo_ui.Rect) {
    if content.width == 0 || content.height == 0 {
        return
    }
    if app.diagnostic_row_count == 0 {
        turbo_ui.write_clipped(
            app.ui.surface,
            turbo_ui.intersect(app.ui.clip, content),
            turbo_ui.Point{column = content.column, row = content.row},
            "No diagnostics from the latest compiler operation.",
            app.ui.theme.text,
        )
        return
    }
    view := turbo_ui.list_view(
        &app.ui,
        870,
        871,
        content,
        app.diagnostic_row_count,
        &app.diagnostics,
        .click_and_enter,
        .when_needed,
    )
    for index := view.first; index < view.end; index += 1 {
        row := turbo_ui.list_row_begin(&app.ui, view, index)
        storage: [Diagnostic_Row_Text_Capacity]u8
        length: usize
        if app.host.copy_diagnostic_row_text != nil {
            length = app.host.copy_diagnostic_row_text(
                app.host.user,
                index,
                cast[[^]u8](&storage[0]),
                len(storage),
            )
            if length >= len(storage) {
                length = len(storage) - 1
            }
        }
        if length == 0 {
            turbo_ui.write_clipped(
                app.ui.surface,
                turbo_ui.intersect(app.ui.clip, row.bounds),
                turbo_ui.Point{
                    column = row.bounds.column,
                    row = row.bounds.row,
                },
                "<diagnostic text unavailable>",
                row.style,
            )
        } else {
            turbo_ui.write_clipped_bytes(
                app.ui.surface,
                turbo_ui.intersect(app.ui.clip, row.bounds),
                turbo_ui.Point{
                    column = row.bounds.column,
                    row = row.bounds.row,
                },
                storage[:length],
                row.style,
            )
        }
    }
    if view.activated && view.activated_index < app.diagnostic_row_count {
        _ = activate_diagnostic(app, view.activated_index)
    }
}

// paint_build_output is the persistent transcript for the latest explicit
// compiler operation plus an optional Run Result. Updating these bytes never
// changes window visibility; users may keep the view open, close it, or inspect
// it later unless an operation explicitly raises the window for a result which
// has no compiler diagnostic row, such as a negative judgment verdict.
paint_build_output :: proc(app: ^App, content: turbo_ui.Rect) {
    turbo_ui.text_view_bytes(
        &app.ui,
        872,
        873,
        content,
        app.build_output[:app.build_output_length],
        &app.build_output_view,
        .when_needed,
    )
}

// paint_package_tree presents the compiler's structured package/import rows
// through turbo_ui's reusable preorder control. The compiler owns graph truth;
// this procedure owns only visibility, expansion, selection, and copied labels.
// A completed click or Enter toggles a package. Left/Right use conventional
// parent/child navigation supplied by tree_view.
paint_package_tree :: proc(app: ^App, content: turbo_ui.Rect) {
    visibility: [Maximum_Package_Rows]usize
    nodes := app.package_nodes[:app.package_row_count]
    view := turbo_ui.tree_view(
        &app.ui,
        770,
        771,
        content,
        nodes,
        visibility[:],
        &app.package_tree,
        .click_and_enter,
        .when_needed,
    )
    if view.toggled {
        info := app.package_rows[view.toggled_node].info
        if info.kind == .package_node &&
            info.package_index < Maximum_Package_Rows {
            app.package_expanded[info.package_index] =
                app.package_nodes[view.toggled_node].expanded
        }
    }
    for visible_index := view.list.first;
        visible_index < view.list.end;
        visible_index += 1 {
        row := turbo_ui.tree_row_begin(
            &app.ui,
            view,
            visible_index,
            nodes,
        )
        if !row.visible {
            continue
        }
        package_row := &app.package_rows[row.model_index]
        marker := "  "
        if package_row.info.kind == .package_node &&
            package_row.info.root != 0 {
            marker = "* "
        }
        turbo_ui.write_clipped(
            app.ui.surface,
            turbo_ui.intersect(app.ui.clip, row.content),
            turbo_ui.Point{column = row.content.column, row = row.content.row},
            marker,
            row.style,
        )
        label_bounds := row.content
        if label_bounds.width > 2 {
            label_bounds.column += 2
            label_bounds.width -= 2
            turbo_ui.write_clipped_bytes(
                app.ui.surface,
                turbo_ui.intersect(app.ui.clip, label_bounds),
                turbo_ui.Point{
                    column = label_bounds.column,
                    row = label_bounds.row,
                },
                package_row.text[:package_row.length],
                row.style,
            )
        }
    }
}

paint_compiler_configuration :: proc(app: ^App, bounds: turbo_ui.Rect) {
    bytes := app.compiler_configuration[
        :app.compiler_configuration_length
    ]
    turbo_ui.text_view_bytes(
        &app.ui,
        780,
        781,
        bounds,
        bytes,
        &app.compiler_configuration_view,
        .when_needed,
    )
}

target_name :: proc(index: usize) -> string {
    switch index {
    case 0:
        return "AArch64 macOS"
    case 1:
        return "AArch64 Linux"
    case 2:
        return "x86-64 Linux"
    case 3:
        return "x86-64 Windows"
    case:
        return "Unknown target"
    }
}

// paint_compiler_options separates active compiler selection from read-only
// effective policy. Root package is a list, target platform is a radio group,
// and optimization/artifact/output/assertion/provider facts remain an exact
// projection of draft.workspace below them. Run-only arguments, environment,
// and working directory belong to the separate Run Configuration dialog.
paint_compiler_options :: proc(app: ^App, content: turbo_ui.Rect) {
    if content.height < 12 || content.width < 50 {
        paint_compiler_configuration(app, content)
        return
    }
    split := content.width / 2
    roots_header := turbo_ui.Rect{
        column = content.column,
        row = content.row,
        width = split - 1,
        height = 1,
    }
    turbo_ui.fill_rect(
        app.ui.surface,
        app.ui.clip,
        roots_header,
        ' ',
        app.ui.theme.border,
    )
    turbo_ui.write_clipped(
        app.ui.surface,
        turbo_ui.intersect(app.ui.clip, roots_header),
        turbo_ui.Point{column = roots_header.column, row = roots_header.row},
        "Root Package (* active)",
        app.ui.theme.border,
    )
    target_header := turbo_ui.Rect{
        column = content.column + split,
        row = content.row,
        width = content.width - split,
        height = 1,
    }
    turbo_ui.fill_rect(
        app.ui.surface,
        app.ui.clip,
        target_header,
        ' ',
        app.ui.theme.border,
    )
    turbo_ui.write_clipped(
        app.ui.surface,
        turbo_ui.intersect(app.ui.clip, target_header),
        turbo_ui.Point{column = target_header.column, row = target_header.row},
        "Target Platform",
        app.ui.theme.border,
    )
    picker_height: usize = 6
    picker := turbo_ui.Rect{
        column = content.column,
        row = content.row + 1,
        width = split - 1,
        height = picker_height,
    }
    paint_root_package_picker(app, picker)
    for target_index: usize = 0; target_index < 4; target_index += 1 {
        selected := app.selected_target
        if turbo_ui.radio_button(
            &app.ui,
            cast[turbo_ui.Widget_Id](790 + target_index),
            turbo_ui.Rect{
                column = content.column + split,
                row = content.row + 1 + target_index,
                width = content.width - split,
                height = 1,
            },
            target_name(target_index),
            &selected,
            target_index,
            app.workspace_open && app.host.select_target != nil,
        ) {
            if select_build_target(app, selected) {
                app.status = "Compiler target changed"
            } else {
                app.status = "Could not select that compiler target"
            }
        }
    }
    separator_row := picker.row + picker.height
    turbo_ui.fill_rect(
        app.ui.surface,
        app.ui.clip,
        turbo_ui.Rect{
            column = content.column,
            row = separator_row,
            width = content.width,
            height = 1,
        },
        ' ',
        app.ui.theme.border,
    )
    turbo_ui.write_clipped(
        app.ui.surface,
        turbo_ui.intersect(
            app.ui.clip,
            turbo_ui.Rect{
                column = content.column,
                row = separator_row,
                width = content.width,
                height = 1,
            },
        ),
        turbo_ui.Point{column = content.column, row = separator_row},
        "Effective Build Configuration (from draft.workspace)",
        app.ui.theme.border,
    )
    configuration_height := content.height - picker_height - 2
    configuration := turbo_ui.Rect{
        column = content.column,
        row = separator_row + 1,
        width = content.width,
        height = configuration_height,
    }
    paint_compiler_configuration(app, configuration)
}

// paint_run_row_list paints exact argument/environment rows and copies a newly
// selected row into its edit field. Empty arguments remain valid and are shown
// explicitly; an empty environment row is never accepted by command code.
paint_run_argument_list :: proc(app: ^App, bounds: turbo_ui.Rect) {
    view := turbo_ui.list_view(
        &app.ui,
        880,
        881,
        bounds,
        app.run_argument_count,
        &app.run_arguments,
        .enter_only,
        .when_needed,
    )
    for index := view.first; index < view.end; index += 1 {
        bytes := run_argument_bytes(app, index)
        if len(bytes) == 0 {
            turbo_ui.list_row_text(&app.ui, view, index, "<empty>")
        } else {
            turbo_ui.list_row_bytes(&app.ui, view, index, bytes)
        }
    }
    if view.selection_changed {
        select_run_argument_for_edit(app)
    }
}

paint_run_environment_list :: proc(app: ^App, bounds: turbo_ui.Rect) {
    view := turbo_ui.list_view(
        &app.ui,
        890,
        891,
        bounds,
        app.run_environment_count,
        &app.run_environment,
        .enter_only,
        .when_needed,
    )
    for index := view.first; index < view.end; index += 1 {
        turbo_ui.list_row_bytes(
            &app.ui,
            view,
            index,
            run_environment_bytes(app, index),
        )
    }
    if view.selection_changed {
        select_run_environment_for_edit(app)
    }
}

paint_run_configuration :: proc(app: ^App, content: turbo_ui.Rect) {
    if content.width < 60 || content.height < 18 {
        if turbo_ui.button(
            &app.ui,
            899,
            turbo_ui.Rect{},
            "Done",
            true,
            .cancel_action,
        ) {
            close_run_configuration(app)
        }
        return
    }
    half := (content.width - 1) / 2
    arguments := turbo_ui.Rect{
        column = content.column,
        row = content.row,
        width = half,
        height = 1,
    }
    environment := turbo_ui.Rect{
        column = content.column + half + 1,
        row = content.row,
        width = content.width - half - 1,
        height = 1,
    }
    turbo_ui.label(&app.ui, arguments, "Arguments (one exact argv row)")
    turbo_ui.label(&app.ui, environment, "Environment (NAME=value)")
    arguments.row += 2
    arguments.height = 6
    environment.row += 2
    environment.height = 6
    paint_run_argument_list(app, arguments)
    paint_run_environment_list(app, environment)

    argument_edit := turbo_ui.text_box(
        &app.ui,
        882,
        turbo_ui.Rect{
            column = arguments.column,
            row = arguments.row + arguments.height + 1,
            width = arguments.width,
            height = 1,
        },
        &app.run_argument_box,
        app.run_argument_edit[:],
    )
    if argument_edit.submitted {
        replace_run_argument(app)
    }
    environment_edit := turbo_ui.text_box(
        &app.ui,
        892,
        turbo_ui.Rect{
            column = environment.column,
            row = environment.row + environment.height + 1,
            width = environment.width,
            height = 1,
        },
        &app.run_environment_box,
        app.run_environment_edit[:],
    )
    if environment_edit.submitted {
        replace_run_environment(app)
    }
    argument_buttons := turbo_ui.layout_begin(
        turbo_ui.Rect{
            column = arguments.column,
            row = arguments.row + arguments.height + 3,
            width = arguments.width,
            height = 1,
        },
        .horizontal,
        0,
        1,
    )
    if turbo_ui.button(
        &app.ui, 883,
        turbo_ui.layout_next(
            &argument_buttons,
            turbo_ui.compact_button_width("Add"),
        ),
        "Add", app.run_argument_count < Maximum_Run_Arguments,
        .normal, cast[u8]('a'),
    ) {
        add_run_argument(app)
    }
    if turbo_ui.button(
        &app.ui, 884,
        turbo_ui.layout_next(
            &argument_buttons,
            turbo_ui.compact_button_width("Replace"),
        ),
        "Replace", app.run_argument_count != 0,
        .normal, cast[u8]('r'),
    ) {
        replace_run_argument(app)
    }
    if turbo_ui.button(
        &app.ui, 885,
        turbo_ui.layout_next(
            &argument_buttons,
            turbo_ui.compact_button_width("Remove"),
        ),
        "Remove", app.run_argument_count != 0, .normal, cast[u8]('m'),
    ) {
        remove_run_argument(app)
    }
    environment_buttons := turbo_ui.layout_begin(
        turbo_ui.Rect{
            column = environment.column,
            row = environment.row + environment.height + 3,
            width = environment.width,
            height = 1,
        },
        .horizontal,
        0,
        1,
    )
    environment_bytes := turbo_ui.text_box_bytes(
        &app.run_environment_box,
        app.run_environment_edit[:],
    )
    environment_valid := environment_row_valid(environment_bytes)
    if turbo_ui.button(
        &app.ui, 893,
        turbo_ui.layout_next(
            &environment_buttons,
            turbo_ui.compact_button_width("Add"),
        ),
        "Add", environment_valid &&
            app.run_environment_count < Maximum_Run_Environment,
        .normal, cast[u8]('d'),
    ) {
        add_run_environment(app)
    }
    if turbo_ui.button(
        &app.ui, 894,
        turbo_ui.layout_next(
            &environment_buttons,
            turbo_ui.compact_button_width("Replace"),
        ),
        "Replace", environment_valid && app.run_environment_count != 0,
        .normal, cast[u8]('p'),
    ) {
        replace_run_environment(app)
    }
    if turbo_ui.button(
        &app.ui, 895,
        turbo_ui.layout_next(
            &environment_buttons,
            turbo_ui.compact_button_width("Remove"),
        ),
        "Remove", app.run_environment_count != 0, .normal, cast[u8]('v'),
    ) {
        remove_run_environment(app)
    }

    working_row := content.row + 13
    turbo_ui.label(
        &app.ui,
        turbo_ui.Rect{
            column = content.column,
            row = working_row,
            width = 20,
            height = 1,
        },
        "Working directory:",
    )
    working := turbo_ui.text_box(
        &app.ui,
        896,
        turbo_ui.Rect{
            column = content.column + 20,
            row = working_row,
            width = content.width - 20,
            height = 1,
        },
        &app.run_working_directory_box,
        app.run_working_directory[:],
    )
    if working.changed {
        mark_run_working_directory_changed(app)
    }
    defaults_width := turbo_ui.compact_button_width("Use Workspace Defaults")
    done_width := turbo_ui.compact_button_width("Done")
    footer := action_row(
        content,
        content.row + content.height - 1,
        defaults_width + done_width + 2,
        2,
    )
    if turbo_ui.button(
        &app.ui, 898,
        turbo_ui.layout_next(
            &footer,
            defaults_width,
        ),
        "Use Workspace Defaults", true, .normal, cast[u8]('w'),
    ) {
        reset_run_configuration(app)
    }
    if turbo_ui.button(
        &app.ui, 899,
        turbo_ui.layout_next(&footer, done_width),
        "Done", true, .cancel_action, cast[u8]('o'),
    ) {
        close_run_configuration(app)
    }
}

paint_close_document :: proc(app: ^App, content: turbo_ui.Rect) {
    turbo_ui.label(
        &app.ui,
        content,
        "The active document has unsaved changes.",
    )
    cancel_requested := false
    if content.width < 30 || content.height < 4 {
        cancel_requested = turbo_ui.button(
            &app.ui,
            862,
            turbo_ui.Rect{},
            "Cancel",
            true,
            .cancel_action,
        )
    } else {
        save_width := turbo_ui.compact_button_width("Save")
        discard_width := turbo_ui.compact_button_width("Discard")
        cancel_width := turbo_ui.compact_button_width("Cancel")
        buttons := action_row(
            content,
            content.row + 3,
            save_width + discard_width + cancel_width + 2,
        )
        if turbo_ui.button(
            &app.ui, 860,
            turbo_ui.layout_next(&buttons, save_width),
            "Save", true, .default_action, cast[u8]('s'),
        ) {
            save_and_close_document(app)
        }
        if turbo_ui.button(
            &app.ui, 861,
            turbo_ui.layout_next(&buttons, discard_width),
            "Discard", true, .normal, cast[u8]('d'),
        ) {
            discard_and_close_document(app)
        }
        cancel_requested = turbo_ui.button(
            &app.ui, 862,
            turbo_ui.layout_next(&buttons, cancel_width),
            "Cancel", true, .cancel_action, cast[u8]('c'),
        )
    }
    if cancel_requested {
        turbo_ui.hide_window(
            &app.ui,
            app.windows[:],
            app.windows[Window_Close_Document].id,
        )
        app.status = "Close document cancelled"
    }
}

// paint_about presents only DraftIDE's product role and authorship plus one
// local close action. It borrows the current dialog content rectangle, retains
// no label storage, and changes application state only when Close is activated.
paint_about :: proc(app: ^App, content: turbo_ui.Rect) {
    lines := [3]string{
        "DraftIDE is the default IDE for Draft.",
        "Created by Miguel Branco",
        "msb@spacebase.org",
    }
    for index: usize = 0; index < len(lines); index += 1 {
        turbo_ui.label(
            &app.ui,
            turbo_ui.Rect{
                column = content.column,
                row = content.row + index,
                width = content.width,
                height = 1,
            },
            lines[index],
        )
    }
    close_requested := false
    if content.height < 5 {
        close_requested = turbo_ui.button(
            &app.ui,
            9100,
            turbo_ui.Rect{},
            "Close",
            true,
            .cancel_action,
        )
    } else {
        close_width := turbo_ui.compact_button_width("Close")
        close := action_row(
            content,
            content.row + content.height - 1,
            close_width,
        )
        close_requested = turbo_ui.button(
            &app.ui,
            9100,
            turbo_ui.layout_next(&close, close_width),
            "Close",
            true,
            .cancel_action,
            cast[u8]('c'),
        )
    }
    if close_requested {
        turbo_ui.hide_window(
            &app.ui,
            app.windows[:],
            app.windows[Window_About].id,
        )
        app.status = "About closed"
    }
}

// paint_packages_view exposes the checked semantic package/import graph only
// when the user asks for that compiler view. A host without structured rows
// falls back to its deterministic textual package report.
paint_packages_view :: proc(app: ^App, content: turbo_ui.Rect) {
    if content.height == 0 {
        return
    }
    header := turbo_ui.Rect{
        column = content.column,
        row = content.row,
        width = content.width,
        height = 1,
    }
    turbo_ui.fill_rect(
        app.ui.surface,
        app.ui.clip,
        header,
        ' ',
        app.ui.theme.border,
    )
    turbo_ui.write_clipped(
        app.ui.surface,
        turbo_ui.intersect(app.ui.clip, header),
        turbo_ui.Point{column = header.column, row = header.row},
        "Packages and authored imports (* active root)",
        app.ui.theme.border,
    )
    graph: turbo_ui.Rect
    if content.height > 1 {
        graph = turbo_ui.Rect{
            column = content.column,
            row = content.row + 1,
            width = content.width,
            height = content.height - 1,
        }
    }
    if graph.height != 0 && app.package_row_count != 0 {
        paint_package_tree(app, graph)
    } else if graph.height != 0 {
        turbo_ui.write_clipped(
            app.ui.surface,
            turbo_ui.intersect(app.ui.clip, graph),
            turbo_ui.Point{column = graph.column, row = graph.row},
            "No checked package graph is available.",
            app.ui.theme.text,
        )
    }
}
