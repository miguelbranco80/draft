// These tests fix the complete v1 project-manifest grammar independently from
// terminal I/O and compiler embedding. Each fixture is copied into caller-owned
// bytes because parse intentionally accepts the same mutable byte view produced
// by core/os reads in Turbo Draft.
package draft_project

import core/testing

copy_text :: proc(destination: []u8, source: string) -> []u8 {
    assert(len(source) <= len(destination), "project test fixture is too large")
    for index: usize = 0; index < len(source); index += 1 {
        destination[index] = source[index]
    }
    return destination[:len(source)]
}

bytes_equal_text :: proc(bytes: []u8, text: string) -> bool {
    if len(bytes) != len(text) {
        return false
    }
    for index: usize = 0; index < len(text); index += 1 {
        if bytes[index] != text[index] {
            return false
        }
    }
    return true
}

test_manifest_selects_root_and_source :: proc(test: ^testing.Test) {
    storage: [256]u8
    source := copy_text(
        storage[:],
        "# Turbo Draft project\ndraft-project-v1\n\nroot = examples/turbo-editor\nsource = package.draft\n",
    )
    parsed := parse(source)
    testing.expect(test, parsed.error == .none)
    testing.expect(test, parsed.line == 0)
    testing.expect(
        test,
        bytes_equal_text(value(source, parsed.manifest.root), "examples/turbo-editor"),
    )
    testing.expect(test, parsed.manifest.source_present)
    testing.expect(
        test,
        bytes_equal_text(value(source, parsed.manifest.source), "package.draft"),
    )
}

test_manifest_source_is_optional :: proc(test: ^testing.Test) {
    storage: [64]u8
    source := copy_text(storage[:], "draft-project-v1\nroot = .\n")
    parsed := parse(source)
    testing.expect(test, parsed.error == .none)
    testing.expect(test, !parsed.manifest.source_present)
}

expect_error :: proc(test: ^testing.Test, text: string, expected: Error) {
    storage: [256]u8
    source := copy_text(storage[:], text)
    parsed := parse(source)
    testing.expect(test, parsed.error == expected)
    testing.expect(test, parsed.line != 0)
}

test_manifest_rejects_ambiguous_or_escaping_configuration :: proc(
    test: ^testing.Test,
) {
    expect_error(test, "root = app\n", .invalid_header)
    expect_error(test, "draft-project-v1\nsource = package.draft\n", .missing_root)
    expect_error(test, "draft-project-v1\nroot app\n", .missing_equals)
    expect_error(test, "draft-project-v1\nroot = ../app\n", .invalid_root)
    expect_error(test, "draft-project-v1\nroot = app\\tool\n", .invalid_root)
    expect_error(test, "draft-project-v1\nroot = app\nroot = tool\n", .duplicate_root)
    expect_error(test, "draft-project-v1\nroot = app\nsource = sub/package.draft\n", .invalid_source)
    expect_error(test, "draft-project-v1\nroot = app\nmode = debug\n", .unknown_key)
}
