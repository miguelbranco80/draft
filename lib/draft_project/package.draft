// draft_project defines the small durable project-selection file consumed by
// Turbo Draft. The manifest chooses the initial executable root and active
// source file inside an already explicit workspace; it does not enumerate
// packages, alter import resolution, or act as a dependency manager.
//
// Parsing borrows one complete caller-owned byte buffer and returns half-open
// ranges into it. The caller must keep those bytes alive until it has copied or
// synchronously consumed the selected values. The parser allocates nothing,
// accepts only a closed versioned vocabulary, and reports the one-based source
// line of the first error. Package and program semantics remain those of Draft
// specification sections 3 and 6; this file is operator configuration only.
package draft_project

// Manifest_Name is fixed so opening a workspace has one deterministic project
// configuration path and never searches parent directories or environment
// variables.
pub Manifest_Name :: "draft.project"

// Value_Range names one half-open byte range in the exact parsed input. A zero
// value is valid only when the corresponding `*_present` flag is false.
pub Value_Range :: struct {
    begin: usize,
    end: usize,
}

// Manifest is the first project-file contract. root is required. source is
// optional and defaults to `package.draft` in the consuming tool. Both values
// are normalized relative paths; source is one direct package child.
pub Manifest :: struct {
    root: Value_Range,
    source: Value_Range,
    source_present: bool,
}

// Error is intentionally structural and closed. The application turns it into
// a stable short message without retaining parser implementation details.
pub Error :: enum u8 {
    none,
    invalid_header,
    missing_equals,
    empty_key,
    empty_value,
    unknown_key,
    duplicate_root,
    duplicate_source,
    missing_root,
    invalid_root,
    invalid_source,
}

// Parse_Result owns no storage. line is one-based and identifies the first
// malformed line; a successful result uses line zero.
pub Parse_Result :: struct {
    manifest: Manifest,
    error: Error,
    line: usize,
}

ascii_space :: proc(value: u8) -> bool {
    return value == 32 || value == 9 || value == 13
}

trim_range :: proc(source: []u8, begin, end: usize) -> Value_Range {
    first := begin
    last := end
    for first < last && ascii_space(source[first]) {
        first += 1
    }
    for last > first && ascii_space(source[last - 1]) {
        last -= 1
    }
    return Value_Range{begin = first, end = last}
}

range_equals :: proc(source: []u8, value: Value_Range, text: string) -> bool {
    if value.end - value.begin != len(text) {
        return false
    }
    for index: usize = 0; index < len(text); index += 1 {
        if source[value.begin + index] != text[index] {
            return false
        }
    }
    return true
}

// valid_root accepts `.` or one slash-separated normalized relative path. The
// compiler service still canonicalizes and checks containment; this early rule
// makes project-file diagnostics local and target-independent.
valid_root :: proc(source: []u8, value: Value_Range) -> bool {
    if range_equals(source, value, ".") {
        return true
    }
    if value.begin == value.end || source[value.begin] == 47 ||
        source[value.end - 1] == 47 {
        return false
    }
    component_begin := value.begin
    index := value.begin
    for index <= value.end {
        at_end := index == value.end
        separator := !at_end && source[index] == 47
        if at_end || separator {
            component := Value_Range{begin = component_begin, end = index}
            if component.begin == component.end ||
                range_equals(source, component, ".") ||
                range_equals(source, component, "..") {
                return false
            }
            component_begin = index + 1
        } else if source[index] == 0 || source[index] == 92 {
            return false
        }
        index += 1
    }
    return true
}

// valid_source permits exactly one direct package-child filename. Target
// qualifiers remain part of that filename; directory selection belongs to
// root, never source.
valid_source :: proc(source: []u8, value: Value_Range) -> bool {
    if value.begin == value.end || range_equals(source, value, ".") ||
        range_equals(source, value, "..") {
        return false
    }
    for index: usize = value.begin; index < value.end; index += 1 {
        if source[index] == 0 || source[index] == 47 || source[index] == 92 {
            return false
        }
    }
    return true
}

parse_error :: proc(error: Error, line: usize) -> Parse_Result {
    return Parse_Result{error = error, line = line}
}

// parse checks `draft-project-v1`, then a closed sequence of `key = value`
// rows. Empty lines and whole-line `#` comments are ignored. root is required
// exactly once; source is optional exactly once. Values are bare path bytes so
// there is no quoting, escaping, interpolation, or host-dependent expansion.
pub parse :: proc(source: []u8) -> Parse_Result {
    result: Parse_Result
    header_seen := false
    root_seen := false
    line_number: usize = 1
    line_begin: usize
    for line_begin <= len(source) {
        line_end := line_begin
        for line_end < len(source) && source[line_end] != 10 {
            line_end += 1
        }
        line := trim_range(source, line_begin, line_end)
        if line.begin != line.end && source[line.begin] != 35 {
            if !header_seen {
                if !range_equals(source, line, "draft-project-v1") {
                    return parse_error(.invalid_header, line_number)
                }
                header_seen = true
            } else {
                equals := line.end
                for index: usize = line.begin; index < line.end; index += 1 {
                    if source[index] == 61 {
                        equals = index
                        break
                    }
                }
                if equals == line.end {
                    return parse_error(.missing_equals, line_number)
                }
                key := trim_range(source, line.begin, equals)
                value := trim_range(source, equals + 1, line.end)
                if key.begin == key.end {
                    return parse_error(.empty_key, line_number)
                }
                if value.begin == value.end {
                    return parse_error(.empty_value, line_number)
                }
                if range_equals(source, key, "root") {
                    if root_seen {
                        return parse_error(.duplicate_root, line_number)
                    }
                    if !valid_root(source, value) {
                        return parse_error(.invalid_root, line_number)
                    }
                    result.manifest.root = value
                    root_seen = true
                } else if range_equals(source, key, "source") {
                    if result.manifest.source_present {
                        return parse_error(.duplicate_source, line_number)
                    }
                    if !valid_source(source, value) {
                        return parse_error(.invalid_source, line_number)
                    }
                    result.manifest.source = value
                    result.manifest.source_present = true
                } else {
                    return parse_error(.unknown_key, line_number)
                }
            }
        }
        if line_end == len(source) {
            break
        }
        line_begin = line_end + 1
        line_number += 1
    }
    if !header_seen {
        return parse_error(.invalid_header, 1)
    }
    if !root_seen {
        return parse_error(.missing_root, line_number)
    }
    return result
}

// value returns the borrowed bytes named by one range from the same source
// passed to parse. Callers must not mix ranges and source buffers.
pub value :: proc(source: []u8, range: Value_Range) -> []u8 {
    assert(range.begin <= range.end && range.end <= len(source),
        "project value range does not belong to this source")
    return source[range.begin:range.end]
}

pub error_message :: proc(error: Error) -> string {
    switch error {
    case .none:
        return "no error"
    case .invalid_header:
        return "expected draft-project-v1 header"
    case .missing_equals:
        return "expected key = value"
    case .empty_key:
        return "project key is empty"
    case .empty_value:
        return "project value is empty"
    case .unknown_key:
        return "unknown project key"
    case .duplicate_root:
        return "root is declared more than once"
    case .duplicate_source:
        return "source is declared more than once"
    case .missing_root:
        return "project has no root"
    case .invalid_root:
        return "root must be a normalized workspace-relative package path"
    case .invalid_source:
        return "source must be one direct package-child filename"
    }
}
