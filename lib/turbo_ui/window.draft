// Windows implement the reusable desktop interaction model: persistent active
// selection, deterministic z-order, capability-controlled chrome, mouse and
// keyboard move/resize, zoom/restore, close requests, and modal focus routing.
// The caller owns every Window_State and decides what closing means; turbo_ui
// owns no document, callback, allocation, or application lifetime.
package turbo_ui

import core/tui

// Window_Flags state which frame and desktop operations are meaningful for one
// window. tileable is intentionally independent from direct movement and
// resizing: an auxiliary pane may permit manual sizing while remaining fixed
// during whole-desktop Tile/Cascade. This is deliberately a plain group of
// booleans rather than an open-ended class hierarchy. Dialog and tool
// constructors merely choose useful defaults.
pub Window_Flags :: struct {
    movable: bool,
    resizable: bool,
    closable: bool,
    zoomable: bool,
    tileable: bool,
}

// Window_State is freely movable application state. bounds is the current
// visible rectangle; restore_bounds remembers the pre-zoom rectangle. focus_id
// preserves keyboard focus independently for each desktop window. The caller
// owns visibility and must not reuse id for another live window.
pub Window_State :: struct {
    id: Widget_Id,
    bounds: Rect,
    restore_bounds: Rect,
    z: u32,
    visible: bool,
    zoomed: bool,
    flags: Window_Flags,
    focus_id: Widget_Id,
    minimum_width: usize,
    minimum_height: usize,
}

// Window_Context is the balanced begin/end token. close_requested is policy,
// not destruction: the application may hide immediately, ask about unsaved
// data, or reject the request. content excludes all frame chrome.
pub Window_Context :: struct {
    visible: bool,
    painted: bool,
    close_requested: bool,
    content: Rect,
    previous_clip: Rect,
}

// The vertical and horizontal arrows are text-default pictographs. Draft's
// pinned width policy and ordinary terminals therefore assign each one one
// column; emoji presentation would require an explicit VS16. Keeping the
// measured width beside the chrome geometry prevents a model/terminal mismatch
// from shifting the upper-right corner and leaving stale shadow cells behind.
Zoom_Glyph_Columns :: 1

// zoom_control_rect returns the complete one-cell hit and paint rectangle
// immediately before the upper-right corner. A narrow frame may have no room
// for both a left corner, the control, and a right corner; the empty result
// makes that control unavailable rather than allowing unsigned subtraction or
// overlapping structural border cells.
zoom_control_rect :: proc(bounds: Rect) -> Rect {
    if bounds.width < Zoom_Glyph_Columns + 2 || bounds.height == 0 {
        return Rect{}
    }
    return Rect{
        column = rect_right(bounds) - 1 - Zoom_Glyph_Columns,
        row = bounds.row,
        width = Zoom_Glyph_Columns,
        height = 1,
    }
}

// window_title_rect returns the title-text slot between the left-side close
// control and the right-side zoom control. Both begin_window and the byte-title
// operation must use this exact geometry: computing the slot twice previously
// made a future chrome change capable of clipping the static and owned title
// forms differently. An empty rectangle means that the current narrow window
// has room for structural chrome but no title text.
window_title_rect :: proc(window: ^Window_State) -> Rect {
    title_column := window.bounds.column + 2
    if window.flags.closable {
        title_column += 2
    }

    title_end := rect_right(window.bounds) - 1
    zoom_rect := zoom_control_rect(window.bounds)
    close_point := Point{
        column = window.bounds.column + 1,
        row = window.bounds.row,
    }
    zoom_visible := window.flags.zoomable && !rect_empty(zoom_rect) &&
        (!window.flags.closable || !point_in_rect(close_point, zoom_rect))
    if zoom_visible {
        // Preserve one border cell between title text and the zoom glyph. The
        // glyph rectangle itself already excludes the upper-right corner.
        title_end = zoom_rect.column - 1
    }
    if title_end <= title_column {
        return Rect{}
    }
    return Rect{
        column = title_column,
        row = window.bounds.row,
        width = title_end - title_column,
        height = 1,
    }
}

pub window_init :: proc(id: Widget_Id, bounds: Rect, z: u32) -> Window_State {
    assert(id != No_Widget, "turbo_ui window ID zero is reserved")
    return Window_State{
        id = id,
        bounds = bounds,
        restore_bounds = bounds,
        z = z,
        visible = true,
        flags = Window_Flags{
            movable = true,
            resizable = true,
            closable = true,
            zoomable = true,
            tileable = true,
        },
        minimum_width = 16,
        minimum_height = 6,
    }
}

// tool_window_init keeps ordinary movement, growth, and closing but omits zoom
// and automatic arrangement for auxiliary panes which should not replace or
// consume a cell in the complete document desktop.
pub tool_window_init :: proc(
    id: Widget_Id,
    bounds: Rect,
    z: u32,
) -> Window_State {
    result := window_init(id, bounds, z)
    result.flags.zoomable = false
    result.flags.tileable = false
    return result
}

// dialog_window_init selects the conventional fixed-size movable dialog frame.
// Modality is supplied separately to begin_window_frame because whether a
// dialog blocks its owner is an application state transition, not decoration.
pub dialog_window_init :: proc(
    id: Widget_Id,
    bounds: Rect,
    z: u32,
) -> Window_State {
    result := window_init(id, bounds, z)
    result.flags.resizable = false
    result.flags.zoomable = false
    result.flags.tileable = false
    result.minimum_width = 20
    result.minimum_height = 6
    return result
}

window_index :: proc(windows: []Window_State, id: Widget_Id) -> usize {
    for index: usize = 0; index < len(windows); index += 1 {
        if windows[index].id == id {
            return index
        }
    }
    return len(windows)
}

top_visible_window :: proc(windows: []Window_State) -> Widget_Id {
    selected := No_Widget
    selected_index: usize
    selected_z: u32
    found := false
    for index: usize = 0; index < len(windows); index += 1 {
        window := windows[index]
        if window.visible && (!found || window.z > selected_z ||
            (window.z == selected_z && index > selected_index)) {
            selected = window.id
            selected_index = index
            selected_z = window.z
            found = true
        }
    }
    return selected
}

// point_in_window_footprint matches the cells painted by begin_window. Window
// shadows sit one cell to the right and below the frame; treating those cells
// as empty would let a visually covered rear resize handle receive a click.
// The two unpainted bounding-box corners remain transparent.
point_in_window_footprint :: proc(point: Point, window: Window_State) -> bool {
    if point_in_rect(point, window.bounds) {
        return true
    }
    right_shadow := Rect{
        column = rect_right(window.bounds),
        row = saturated_add(window.bounds.row, 1),
        width = 1,
        height = window.bounds.height,
    }
    bottom_shadow := Rect{
        column = saturated_add(window.bounds.column, 1),
        row = rect_bottom(window.bounds),
        width = window.bounds.width,
        height = 1,
    }
    return point_in_rect(point, right_shadow) ||
        point_in_rect(point, bottom_shadow)
}

// top_window_at returns the visible painted window footprint with greatest z
// at point. Equal z values resolve by later slice position, matching
// window_order exactly.
top_window_at :: proc(windows: []Window_State, point: Point) -> Widget_Id {
    selected := No_Widget
    selected_z: u32
    found := false
    for window in windows {
        if window.visible && point_in_window_footprint(point, window) &&
            (!found || window.z >= selected_z) {
            selected = window.id
            selected_z = window.z
            found = true
        }
    }
    return selected
}

// raise_window moves one window above all visible peers. Reaching u32's final
// value would require billions of activations in one process; at that boundary
// the function deterministically rebases every entry to slice order, then
// raises the requested window. This avoids wraparound without hidden storage.
raise_window :: proc(windows: []Window_State, id: Widget_Id) {
    maximum: u32
    target := window_index(windows, id)
    if target == len(windows) {
        return
    }
    for window in windows {
        if window.visible && window.z > maximum {
            maximum = window.z
        }
    }
    if maximum == ~cast[u32](0) {
        for index: usize = 0; index < len(windows); index += 1 {
            windows[index].z = cast[u32](index)
        }
        maximum = cast[u32](len(windows))
    }
    windows[target].z = maximum + 1
}

save_active_focus :: proc(state: ^State, windows: []Window_State) {
    if state.active_window == No_Widget {
        state.desktop_focus = state.focused_id
        return
    }
    index := window_index(windows, state.active_window)
    if index != len(windows) {
        windows[index].focus_id = state.focused_id
    }
}

// activate_window changes keyboard scope and restores the window's previous
// focused control. Passing No_Widget activates the desktop behind all windows.
pub activate_window :: proc(
    state: ^State,
    windows: []Window_State,
    id: Widget_Id,
) -> bool {
    if id != No_Widget {
        index := window_index(windows, id)
        if index == len(windows) || !windows[index].visible {
            return false
        }
    }
    if state.active_window == id {
        if id != No_Widget {
            raise_window(windows, id)
        }
        return true
    }
    save_active_focus(state, windows)
    state.active_window = id
    if id == No_Widget {
        state.focused_id = state.desktop_focus
    } else {
        index := window_index(windows, id)
        state.focused_id = windows[index].focus_id
        raise_window(windows, id)
    }
    // Applications may activate a window while painting another window's
    // control—for example, a file list can open and raise an editor whose
    // earlier z-order pass has already run. A no-event traversal is then
    // required so pixels and hit-testing observe the same new ordering.
    if state.frame_open {
        state.repaint_requested = true
    }
    return true
}

pub show_window :: proc(
    state: ^State,
    windows: []Window_State,
    id: Widget_Id,
) -> bool {
    index := window_index(windows, id)
    if index == len(windows) {
        return false
    }
    was_visible := windows[index].visible
    windows[index].visible = true
    activated := activate_window(state, windows, id)
    if state.frame_open && !was_visible {
        state.repaint_requested = true
    }
    return activated
}

// show_modal_window records the currently active owner before activating the
// dialog. begin_window_frame later enforces modality from the caller's selected
// modal ID and restores this owner when the dialog disappears.
pub show_modal_window :: proc(
    state: ^State,
    windows: []Window_State,
    id: Widget_Id,
) -> bool {
    if window_index(windows, id) == len(windows) {
        return false
    }
    if state.modal_window == No_Widget && state.active_window != id {
        state.modal_return_window = state.active_window
    }
    return show_window(state, windows, id)
}

// hide_window keeps application storage intact, closes an owned popup, and
// selects the remaining topmost window when the hidden one was active.
pub hide_window :: proc(
    state: ^State,
    windows: []Window_State,
    id: Widget_Id,
) -> bool {
    index := window_index(windows, id)
    if index == len(windows) {
        return false
    }
    was_visible := windows[index].visible
    windows[index].visible = false
    if state.popup_id != No_Widget && state.popup_owner == id {
        popup_close(state)
    }
    if state.active_id == id &&
        (state.active_kind == .window_drag ||
            state.active_kind == .window_resize ||
            state.active_kind == .window_close ||
            state.active_kind == .window_zoom) {
        state.active_id = No_Widget
        state.active_kind = .none
    }
    if state.keyboard_window == id {
        state.keyboard_window = No_Widget
    }
    if state.active_window == id {
        state.active_window = No_Widget
        state.focused_id = state.desktop_focus
        next := top_visible_window(windows)
        if next != No_Widget {
            activate_window(state, windows, next)
        }
    }
    if state.frame_open && was_visible {
        state.repaint_requested = true
    }
    return true
}

// activate_next_window cycles visible windows in their deterministic z-order.
// reverse selects the previous entry. It is intentionally a callable command
// rather than a hard-coded F6 shortcut, because host applications own keys.
pub activate_next_window :: proc(
    state: ^State,
    windows: []Window_State,
    reverse: bool = false,
) -> bool {
    candidate := No_Widget
    candidate_index: usize
    found := false
    active_index := window_index(windows, state.active_window)
    active_z: u32
    if active_index != len(windows) {
        active_z = windows[active_index].z
    }

    for index: usize = 0; index < len(windows); index += 1 {
        window := windows[index]
        if !window.visible || window.id == state.active_window {
            continue
        }
        after := active_index == len(windows) || window.z > active_z ||
            (window.z == active_z && index > active_index)
        eligible := after
        if reverse {
            eligible = active_index == len(windows) || window.z < active_z ||
                (window.z == active_z && index < active_index)
        }
        candidate_after := found && (window.z > windows[candidate_index].z ||
            (window.z == windows[candidate_index].z && index > candidate_index))
        candidate_before := found && (window.z < windows[candidate_index].z ||
            (window.z == windows[candidate_index].z && index < candidate_index))
        if eligible && (!found || (!reverse && candidate_before) ||
            (reverse && candidate_after)) {
            candidate = window.id
            candidate_index = index
            found = true
        }
    }
    if !found {
        // Wrap to the lowest window when moving forward and the highest when
        // moving backward.
        for index: usize = 0; index < len(windows); index += 1 {
            window := windows[index]
            if !window.visible {
                continue
            }
            candidate_after := found && (window.z > windows[candidate_index].z ||
                (window.z == windows[candidate_index].z && index > candidate_index))
            candidate_before := found && (window.z < windows[candidate_index].z ||
                (window.z == windows[candidate_index].z && index < candidate_index))
            if !found || (!reverse && candidate_before) ||
                (reverse && candidate_after) {
                candidate = window.id
                candidate_index = index
                found = true
            }
        }
    }
    if !found {
        return false
    }
    return activate_window(state, windows, candidate)
}

// window_order writes indices in stable back-to-front order. Invisible entries
// remain in the result because begin_window owns the visibility test.
pub window_order :: proc(windows: []Window_State, output: []usize) -> usize {
    count := len(windows)
    if count > len(output) {
        count = len(output)
    }
    for index: usize = 0; index < count; index += 1 {
        output[index] = index
        cursor := index
        for cursor > 0 {
            left := output[cursor - 1]
            right := output[cursor]
            ordered := windows[left].z < windows[right].z ||
                (windows[left].z == windows[right].z && left < right)
            if ordered {
                break
            }
            output[cursor - 1] = right
            output[cursor] = left
            cursor -= 1
        }
    }
    return count
}

// arrangeable_window applies the explicit desktop policy. Direct move/resize
// capabilities do not imply participation: fixed dialogs and manually sized
// tool panes remain where the application placed them unless it deliberately
// marks them tileable.
arrangeable_window :: proc(window: Window_State) -> bool {
    return window.visible && window.flags.tileable
}

// tile_windows partitions desktop into a near-square grid and places every
// visible tileable window into one cell in stable slice order. Hidden and
// non-tileable windows are untouched. Tiling ends zoom because the arranged
// rectangle becomes the new ordinary restore position. The return value is the
// number of windows placed, allowing an application to report a no-op without
// rediscovering the eligible set.
pub tile_windows :: proc(
    windows: []Window_State,
    desktop: Rect,
) -> usize {
    count: usize
    for window in windows {
        if arrangeable_window(window) {
            count += 1
        }
    }
    if count == 0 || rect_empty(desktop) {
        return 0
    }

    // The smallest column count whose square contains all windows produces a
    // compact grid without requiring floating-point square-root support.
    columns: usize = 1
    for columns < count && columns * columns < count {
        columns += 1
    }
    rows := (count + columns - 1) / columns

    ordinal: usize
    for index: usize = 0; index < len(windows); index += 1 {
        if !arrangeable_window(windows[index]) {
            continue
        }
        column := ordinal % columns
        row := ordinal / columns
        left := desktop.width * column / columns
        right := desktop.width * (column + 1) / columns
        top := desktop.height * row / rows
        bottom := desktop.height * (row + 1) / rows
        bounds := Rect{
            column = desktop.column + left,
            row = desktop.row + top,
            width = right - left,
            height = bottom - top,
        }
        windows[index].bounds = bounds
        windows[index].restore_bounds = bounds
        windows[index].zoomed = false
        windows[index].z = cast[u32](ordinal + 1)
        ordinal += 1
    }
    return ordinal
}

// cascade_windows gives each visible ordinary window three quarters of the
// desktop and offsets successive frames by two cells. Offsets wrap before the
// frame would leave the desktop, so every title and resize corner remains
// reachable. Fixed dialogs and hidden windows retain both geometry and z.
pub cascade_windows :: proc(
    windows: []Window_State,
    desktop: Rect,
) -> usize {
    if rect_empty(desktop) {
        return 0
    }
    width := desktop.width * 3 / 4
    height := desktop.height * 3 / 4
    if width == 0 {
        width = desktop.width
    }
    if height == 0 {
        height = desktop.height
    }
    maximum_column := desktop.width - width
    maximum_row := desktop.height - height

    ordinal: usize
    for index: usize = 0; index < len(windows); index += 1 {
        if !arrangeable_window(windows[index]) {
            continue
        }
        column_offset := ordinal * 2 % (maximum_column + 1)
        row_offset := ordinal * 2 % (maximum_row + 1)
        bounds := Rect{
            column = desktop.column + column_offset,
            row = desktop.row + row_offset,
            width = width,
            height = height,
        }
        windows[index].bounds = bounds
        windows[index].restore_bounds = bounds
        windows[index].zoomed = false
        windows[index].z = cast[u32](ordinal + 1)
        ordinal += 1
    }
    return ordinal
}

moved_origin :: proc(pointer, offset: usize) -> usize {
    if pointer < offset {
        return 0
    }
    return pointer - offset
}

resized_extent :: proc(
    original_extent, original_pointer, current_pointer, minimum: usize,
) -> usize {
    result := original_extent
    if current_pointer >= original_pointer {
        result = saturated_add(result, current_pointer - original_pointer)
    } else {
        reduction := original_pointer - current_pointer
        if reduction >= result {
            result = 0
        } else {
            result -= reduction
        }
    }
    if result < minimum {
        result = minimum
    }
    return result
}

toggle_zoom :: proc(window: ^Window_State, desktop: Rect) {
    if !window.flags.zoomable {
        return
    }
    if window.zoomed {
        window.bounds = clamp_rect(window.restore_bounds, desktop)
        window.zoomed = false
    } else {
        window.restore_bounds = window.bounds
        window.bounds = desktop
        window.zoomed = true
    }
}

// apply_keyboard_window_command implements the classic explicit size/move mode.
// Ctrl-F5 enters it for the active window, arrows move, Shift-arrows resize,
// Enter accepts, and Escape restores the entry rectangle. Host applications
// may keep F5 for another purpose because the modifier is required here.
apply_keyboard_window_command :: proc(
    state: ^State,
    windows: []Window_State,
) {
    if state.popup_id != No_Widget || state.event.kind != .key {
        return
    }
    key := state.event.key
    if state.keyboard_window == No_Widget && key.code == .f5 && key.control &&
        state.active_window != No_Widget {
        index := window_index(windows, state.active_window)
        if index != len(windows) && (windows[index].flags.movable ||
            windows[index].flags.resizable) {
            state.keyboard_window = state.active_window
            state.drag_start_rect = windows[index].bounds
            state.event_handled = true
        }
        return
    }
    if state.keyboard_window == No_Widget {
        if key.code == .f3 && key.alt && state.active_window != No_Widget {
            state.window_close_command = state.active_window
            state.event_handled = true
        }
        return
    }

    index := window_index(windows, state.keyboard_window)
    if index == len(windows) || !windows[index].visible {
        state.keyboard_window = No_Widget
        return
    }
    window := &windows[index]
    if key.code == .escape {
        window.bounds = state.drag_start_rect
        state.keyboard_window = No_Widget
        state.event_handled = true
        return
    }
    if key.code == .enter {
        state.keyboard_window = No_Widget
        state.event_handled = true
        return
    }
    if key.code != .left && key.code != .right &&
        key.code != .up && key.code != .down {
        return
    }
    if key.shift && window.flags.resizable && !window.zoomed {
        if key.code == .left && window.bounds.width > window.minimum_width {
            window.bounds.width -= 1
        } else if key.code == .right {
            window.bounds.width += 1
        } else if key.code == .up &&
            window.bounds.height > window.minimum_height {
            window.bounds.height -= 1
        } else if key.code == .down {
            window.bounds.height += 1
        }
    } else if !key.shift && window.flags.movable && !window.zoomed {
        if key.code == .left && window.bounds.column > state.desktop.column {
            window.bounds.column -= 1
        } else if key.code == .right {
            window.bounds.column += 1
        } else if key.code == .up && window.bounds.row > state.desktop.row {
            window.bounds.row -= 1
        } else if key.code == .down {
            window.bounds.row += 1
        }
    }
    window.bounds = clamp_rect(window.bounds, state.desktop)
    state.event_handled = true
}

// begin_window_frame establishes one complete desktop input transaction.
// desktop is the area windows may occupy, normally excluding menu/status rows;
// the exact zero Rect{} selects the complete Surface. Other empty rectangles
// remain empty, allowing an application to survive a one-row resize without
// drawing windows over its menu. modal_window is either zero or one visible
// window whose scope exclusively receives input this frame.
pub begin_window_frame :: proc(
    state: ^State,
    surface: ^tui.Surface,
    event: Event,
    theme: Theme,
    windows: []Window_State,
    desktop: Rect = Rect{},
    modal_window: Widget_Id = No_Widget,
) {
    previous_modal := state.modal_window
    begin_frame(state, surface, event, theme)
    state.modal_window = previous_modal
    state.desktop = intersect(desktop, surface_bounds(surface))
    if rect_equal(desktop, Rect{}) {
        state.desktop = surface_bounds(surface)
    }

    requested_modal := modal_window
    modal_index := window_index(windows, requested_modal)
    if requested_modal != No_Widget &&
        (modal_index == len(windows) || !windows[modal_index].visible) {
        requested_modal = No_Widget
    }
    if requested_modal != state.modal_window {
        if requested_modal != No_Widget {
            if state.modal_window == No_Widget &&
                state.active_window != requested_modal {
                state.modal_return_window = state.active_window
            }
            activate_window(state, windows, requested_modal)
        } else {
            restore := state.modal_return_window
            state.modal_return_window = No_Widget
            state.modal_window = No_Widget
            if !activate_window(state, windows, restore) {
                activate_window(state, windows, top_visible_window(windows))
            }
        }
        state.modal_window = requested_modal
    }

    active_index := window_index(windows, state.active_window)
    if state.active_window != No_Widget &&
        (active_index == len(windows) || !windows[active_index].visible) {
        state.active_window = No_Widget
    }
    if state.active_window == No_Widget && requested_modal == No_Widget {
        top := top_visible_window(windows)
        if top != No_Widget {
            activate_window(state, windows, top)
        }
    }

    if state.popup_id != No_Widget {
        owner_valid := state.popup_owner == requested_modal
        if requested_modal == No_Widget {
            owner_valid = state.popup_owner == No_Widget ||
                state.popup_owner == state.active_window
        }
        if !owner_valid {
            popup_close(state)
        }
    }

    state.input_scope = state.active_window
    if requested_modal != No_Widget {
        state.input_scope = requested_modal
    }
    if state.popup_id != No_Widget {
        state.input_scope = state.popup_id
    }

    if event.kind == .mouse {
        // Terminal focus changes and multiplexers can occasionally lose a
        // release report. A later no-button motion is authoritative evidence
        // that no drag remains; a new primary press starts a fresh hit test.
        // Without this repair, target routing below would keep sending every
        // future mouse event to the stale window captured by active_id.
        window_capture := state.active_kind == .window_drag ||
            state.active_kind == .window_resize ||
            state.active_kind == .window_close ||
            state.active_kind == .window_zoom
        stale_motion := event.mouse.action == .move &&
            !event.mouse.primary_down
        fresh_press := event.mouse.action == .press &&
            event.mouse.button == .primary
        if window_capture && (stale_motion || fresh_press) {
            state.active_id = No_Widget
            state.active_kind = .none
        }
        if state.active_kind == .window_drag ||
            state.active_kind == .window_resize ||
            state.active_kind == .window_close ||
            state.active_kind == .window_zoom {
            state.target_window = state.active_id
        } else if state.popup_id != No_Widget {
            state.target_window = state.popup_id
        } else if requested_modal != No_Widget {
            state.target_window = requested_modal
        } else {
            state.target_window = top_window_at(windows, event.mouse.position)
            if event.mouse.action == .press &&
                event.mouse.button == .primary {
                activate_window(state, windows, state.target_window)
                state.input_scope = state.active_window
            }
        }
    }
    apply_keyboard_window_command(state, windows)
}

// begin_window handles frame chrome and installs the content scope. The close
// box occupies the upper-left frame, zoom the upper-right, and a visible lower-
// right marker is the resize handle. A zoomed window fills desktop and cannot
// be moved or resized until restored.
pub begin_window :: proc(
    state: ^State,
    window: ^Window_State,
    title: string,
) -> Window_Context {
    assert(state.frame_open, "turbo_ui window outside a frame")
    assert(state.current_window == No_Widget,
        "turbo_ui windows may not be nested")
    result := Window_Context{painted = true}
    if !window.visible {
        return result
    }
    assert(window.id != No_Widget, "turbo_ui window ID zero is reserved")

    // A zero-sized desktop can occur transiently while a terminal is being
    // resized. Avoid subtracting frame coordinates from zero; no chrome or
    // content exists to interact with until a later nonempty frame.
    if rect_empty(state.desktop) {
        state.current_window = window.id
        result.visible = true
        result.previous_clip = state.clip
        state.clip = state.desktop
        return result
    }

    minimum_width := window.minimum_width
    if minimum_width == 0 {
        minimum_width = 16
    }
    minimum_height := window.minimum_height
    if minimum_height == 0 {
        minimum_height = 6
    }
    if minimum_width > state.desktop.width {
        minimum_width = state.desktop.width
    }
    if minimum_height > state.desktop.height {
        minimum_height = state.desktop.height
    }
    if window.zoomed {
        window.bounds = state.desktop
    } else {
        if window.bounds.width < minimum_width {
            window.bounds.width = minimum_width
        }
        if window.bounds.height < minimum_height {
            window.bounds.height = minimum_height
        }
        window.bounds = clamp_rect(window.bounds, state.desktop)
    }

    // Extremely narrow resize transients cannot represent a complete border,
    // let alone two title controls. Paint the available cells and expose an
    // empty content clip until the desktop becomes large enough again.
    if window.bounds.width < 3 || window.bounds.height < 2 {
        state.current_window = window.id
        result.visible = true
        result.previous_clip = state.clip
        state.clip = Rect{}
        result.painted = fill_rect(
            state.surface,
            surface_bounds(state.surface),
            window.bounds,
            ' ',
            state.theme.window,
        )
        return result
    }

    active := state.active_window == window.id
    is_target := state.target_window == window.id
    right := rect_right(window.bounds)
    bottom := rect_bottom(window.bounds)
    close_point := Point{column = window.bounds.column + 1, row = window.bounds.row}
    zoom_rect := zoom_control_rect(window.bounds)
    zoom_point := Point{column = zoom_rect.column, row = zoom_rect.row}
    resize_point := Point{column = right - 1, row = bottom - 1}
    close_visible := window.flags.closable
    zoom_visible := window.flags.zoomable && !rect_empty(zoom_rect) &&
        (!close_visible || !point_in_rect(close_point, zoom_rect))
    state.current_window = window.id
    state.clip = state.desktop

    if state.window_close_command == window.id {
        if window.flags.closable {
            result.close_requested = true
        }
        state.window_close_command = No_Widget
    }
    if is_target && state.event.kind == .mouse &&
        !rect_empty(window.bounds) {
        mouse := state.event.mouse
        on_close := close_visible && mouse.position.column == close_point.column &&
            mouse.position.row == close_point.row
        on_zoom := zoom_visible && point_in_rect(mouse.position, zoom_rect)
        on_resize := window.flags.resizable && !window.zoomed &&
            mouse.position.column == resize_point.column &&
            mouse.position.row == resize_point.row
        title_begin := window.bounds.column + 1
        if close_visible {
            title_begin += 2
        }
        title_end := right - 1
        if zoom_visible {
            // Leave one horizontal border cell between a draggable title and
            // the complete zoom control.
            title_end = zoom_rect.column - 1
        }
        on_title := window.flags.movable && !window.zoomed &&
            mouse.position.row == window.bounds.row &&
            mouse.position.column >= title_begin &&
            mouse.position.column < title_end

        if !state.event_handled && mouse.action == .press &&
            mouse.button == .primary &&
            (on_close || on_zoom || on_resize || on_title) {
            state.active_id = window.id
            state.active_kind = .window_drag
            if on_close {
                state.active_kind = .window_close
            } else if on_zoom {
                state.active_kind = .window_zoom
            } else if on_resize {
                state.active_kind = .window_resize
            }
            state.drag_start = mouse.position
            state.drag_start_rect = window.bounds
            state.drag_column_offset = mouse.position.column - window.bounds.column
            state.drag_row_offset = mouse.position.row - window.bounds.row
            state.event_handled = true
        } else if state.active_id == window.id &&
            state.active_kind == .window_drag &&
            mouse.action == .move && mouse.primary_down {
            window.bounds.column = moved_origin(
                mouse.position.column,
                state.drag_column_offset,
            )
            window.bounds.row = moved_origin(
                mouse.position.row,
                state.drag_row_offset,
            )
            state.event_handled = true
        } else if state.active_id == window.id &&
            state.active_kind == .window_resize &&
            mouse.action == .move && mouse.primary_down {
            window.bounds.width = resized_extent(
                state.drag_start_rect.width,
                state.drag_start.column,
                mouse.position.column,
                minimum_width,
            )
            window.bounds.height = resized_extent(
                state.drag_start_rect.height,
                state.drag_start.row,
                mouse.position.row,
                minimum_height,
            )
            state.event_handled = true
        } else if state.active_id == window.id &&
            (state.active_kind == .window_drag ||
                state.active_kind == .window_resize ||
                state.active_kind == .window_close ||
                state.active_kind == .window_zoom) &&
            mouse.action == .release && mouse.button == .primary {
            if state.active_kind == .window_close && on_close {
                result.close_requested = true
            } else if state.active_kind == .window_zoom && on_zoom {
                toggle_zoom(window, state.desktop)
            }
            state.active_id = No_Widget
            state.active_kind = .none
            state.event_handled = true
        }
    }

    if window.zoomed {
        window.bounds = state.desktop
    } else {
        window.bounds = clamp_rect(window.bounds, state.desktop)
    }
    right = rect_right(window.bounds)
    bottom = rect_bottom(window.bounds)
    close_point = Point{column = window.bounds.column + 1, row = window.bounds.row}
    zoom_rect = zoom_control_rect(window.bounds)
    zoom_point = Point{column = zoom_rect.column, row = zoom_rect.row}
    resize_point = Point{column = right - 1, row = bottom - 1}
    close_visible = window.flags.closable
    zoom_visible = window.flags.zoomable && !rect_empty(zoom_rect) &&
        (!close_visible || !point_in_rect(close_point, zoom_rect))

    result.visible = true
    result.previous_clip = state.clip
    result.content = inset(window.bounds, 1)
    state.clip = result.content

    border_kind: Border_Kind = .single
    if active {
        border_kind = .double
    }
    result.painted = draw_shadow(
        state.surface,
        surface_bounds(state.surface),
        window.bounds,
        state.theme.shadow,
    ) && fill_rect(
        state.surface,
        surface_bounds(state.surface),
        window.bounds,
        ' ',
        state.theme.window,
    ) && draw_border(
        state.surface,
        surface_bounds(state.surface),
        window.bounds,
        border_kind,
        state.theme.border,
    )

    title_style := state.theme.title
    if active {
        title_style = state.theme.active_title
    }
    if close_visible {
        put_clipped(state.surface, state.desktop, close_point, '■', title_style)
    }
    if zoom_visible {
        zoom_glyph := '↕'
        if window.zoomed {
            zoom_glyph = '↔'
        }
        put_clipped(state.surface, state.desktop, zoom_point, zoom_glyph, title_style)
    }
    title_clip := window_title_rect(window)
    if !rect_empty(title_clip) {
        result.painted = result.painted && write_clipped(
            state.surface,
            title_clip,
            Point{column = title_clip.column, row = title_clip.row},
            title,
            title_style,
        )
    }
    if window.flags.resizable && !window.zoomed {
        put_clipped(
            state.surface,
            state.desktop,
            resize_point,
            '◢',
            state.theme.active_title,
        )
    }
    return result
}

// window_title_bytes paints an application-owned byte label into the title
// slot established by the immediately preceding begin_window call. It exists
// because Draft 1 intentionally cannot reinterpret a mutable byte slice as an
// immutable string: file paths and generated document labels are ordinarily
// stored in owned byte buffers. begin_window must receive an empty static title
// when this operation is used, so the freshly painted border remains the clean
// background behind clipped bytes. The bytes are interpreted as UTF-8 by the
// same cell painter as other UI text and are borrowed only for this call.
pub window_title_bytes :: proc(
    state: ^State,
    window: ^Window_State,
    title: []u8,
) -> bool {
    assert(state.frame_open, "turbo_ui window title outside a frame")
    assert(state.current_window == window.id,
        "turbo_ui byte title must follow its window begin")
    if !window.visible || rect_empty(window.bounds) ||
        window.bounds.width < 3 || window.bounds.height < 2 {
        return true
    }

    title_clip := window_title_rect(window)
    if rect_empty(title_clip) {
        return true
    }
    title_style := state.theme.title
    if state.active_window == window.id {
        title_style = state.theme.active_title
    }
    return write_clipped_bytes(
        state.surface,
        title_clip,
        Point{column = title_clip.column, row = title_clip.row},
        title,
        title_style,
    )
}

// end_window restores desktop clipping. The caller may inspect the context's
// close request before or after this balanced restoration.
pub end_window :: proc(state: ^State, window_context: Window_Context) {
    if !window_context.visible {
        return
    }
    assert(state.current_window != No_Widget,
        "turbo_ui window context is not active")
    state.clip = window_context.previous_clip
    state.current_window = No_Widget
}
