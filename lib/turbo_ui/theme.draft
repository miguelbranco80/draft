// Theme is the complete visual policy used by reusable widgets. Cell styles use
// core/tui values and shadows selects whether buttons, windows, and popups paint
// their optional shade-glyph decoration. The value may be copied freely. The
// default constructor recreates the high-contrast blue, cyan, white, yellow,
// and shadowed look of classic Borland text interfaces without hard-coding
// those choices in widget algorithms; an application can supply another
// complete Theme per frame.
package turbo_ui

import core/tui

pub Theme :: struct {
    desktop: tui.Style,
    window: tui.Style,
    border: tui.Style,
    title: tui.Style,
    active_title: tui.Style,
    shadow: tui.Style,
    text: tui.Style,
    disabled: tui.Style,
    button: tui.Style,
    hot: tui.Style,
    active: tui.Style,
    selected: tui.Style,
    menu: tui.Style,
    menu_selected: tui.Style,
    menu_disabled: tui.Style,
    menu_shortcut: tui.Style,
    input: tui.Style,
    input_focused: tui.Style,
    input_cursor: tui.Style,
    dialog: tui.Style,
    status: tui.Style,
    shadows: bool,
}

// turbo_color maps one logical IBM PC palette entry to its canonical EGA sRGB
// value. Explicit RGB avoids delegating the application's appearance to each
// terminal profile's configurable ANSI entries: logical blue is #0000AA in
// Apple Terminal, Ghostty, a multiplexer, and every other truecolor terminal.
// Values outside the closed 0..15 palette are an application-authored invariant
// failure, not terminal input. The switch is intentionally direct so the exact
// palette remains inspectable without decoding a packed integer table.
pub turbo_color :: proc(index: u8) -> tui.Color {
    assert(index < 16, "turbo_ui logical color must be in the 16-color palette")
    red, green, blue: u8
    switch index {
    case 0:
        red = 0x00
        green = 0x00
        blue = 0x00
    case 1:
        red = 0x00
        green = 0x00
        blue = 0xaa
    case 2:
        red = 0x00
        green = 0xaa
        blue = 0x00
    case 3:
        red = 0x00
        green = 0xaa
        blue = 0xaa
    case 4:
        red = 0xaa
        green = 0x00
        blue = 0x00
    case 5:
        red = 0xaa
        green = 0x00
        blue = 0xaa
    case 6:
        red = 0xaa
        green = 0x55
        blue = 0x00
    case 7:
        red = 0xaa
        green = 0xaa
        blue = 0xaa
    case 8:
        red = 0x55
        green = 0x55
        blue = 0x55
    case 9:
        red = 0x55
        green = 0x55
        blue = 0xff
    case 10:
        red = 0x55
        green = 0xff
        blue = 0x55
    case 11:
        red = 0x55
        green = 0xff
        blue = 0xff
    case 12:
        red = 0xff
        green = 0x55
        blue = 0x55
    case 13:
        red = 0xff
        green = 0x55
        blue = 0xff
    case 14:
        red = 0xff
        green = 0xff
        blue = 0x55
    case 15:
        red = 0xff
        green = 0xff
        blue = 0xff
    case:
        // The assertion above makes this path unreachable in checked builds;
        // retain a valid color when assertions are disabled.
        red = 0x00
        green = 0x00
        blue = 0x00
    }
    return tui.rgb_color(red, green, blue)
}

style :: proc(foreground, background: u8, bold: bool = false) -> tui.Style {
    return tui.Style{
        foreground = turbo_color(foreground),
        background = turbo_color(background),
        bold = bold,
    }
}

pub turbo_theme :: proc() -> Theme {
    return Theme{
        desktop = style(7, 1),
        window = style(15, 1),
        border = style(15, 1, true),
        title = style(0, 7, true),
        active_title = style(14, 1, true),
        shadow = style(0, 0),
        text = style(15, 1),
        disabled = style(8, 1),
        button = style(0, 7, true),
        hot = style(14, 1, true),
        active = style(15, 4, true),
        selected = style(0, 3, true),
        menu = style(0, 7),
        menu_selected = style(15, 4, true),
        menu_disabled = style(8, 7),
        menu_shortcut = style(8, 7),
        input = style(0, 7),
        input_focused = style(15, 0),
        input_cursor = style(0, 15, true),
        dialog = style(15, 1),
        status = style(0, 7),
        shadows = true,
    }
}
