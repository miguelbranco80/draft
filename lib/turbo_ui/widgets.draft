// Widgets are direct immediate-mode procedures: each performs hit testing,
// updates explicit caller-owned values, and paints into the current frame.
// They allocate nothing, retain no label/item storage, and invoke no callback.
// A true result always means the user changed or activated that control in the
// current frame, never merely that it was redrawn.
package turbo_ui

import core/tui

// control_style selects the visual state shared by button-like widgets.
control_style :: proc(
    state: ^State,
    interaction: Interaction,
    enabled: bool,
) -> tui.Style {
    if !enabled {
        return state^.theme.disabled
    }
    if interaction.held {
        return state^.theme.active
    }
    if interaction.hot {
        return state^.theme.hot
    }
    return state^.theme.button
}

// paint_label paints one clipped label with one leading cell of breathing room.
// It deliberately avoids measuring/truncating bytes; write_clipped applies the
// package's grapheme-aware terminal-column policy.
paint_label :: proc(
    state: ^State,
    bounds: Rect,
    label: string,
    style_value: tui.Style,
) -> bool {
    if !fill_rect(state^.surface, state^.clip, bounds, ' ', style_value) {
        return false
    }
    if bounds.width < 2 || bounds.height == 0 {
        return true
    }
    label_clip := Rect{
        column = bounds.column + 1,
        row = bounds.row,
        width = bounds.width - 2,
        height = 1,
    }
    return write_clipped(
        state^.surface,
        intersect(state^.clip, label_clip),
        Point{column = label_clip.column, row = label_clip.row},
        label,
        style_value,
    )
}

// button is a focusable press/release or Enter/Space control. disabled buttons
// still paint but do not register focus or consume the event.
pub button :: proc(
    state: ^State,
    id: Widget_Id,
    bounds: Rect,
    label: string,
    enabled: bool = true,
) -> bool {
    interaction: Interaction
    if enabled {
        interaction = interact(state, id, bounds)
    }
    paint_label(state, bounds, label, control_style(state, interaction, enabled))
    return enabled && interaction.activated
}

// menu_bar paints a noninteractive horizontal menu background. Individual
// menu_item calls placed inside it own activation and focus.
pub menu_bar :: proc(state: ^State, bounds: Rect) {
    fill_rect(state^.surface, state^.clip, bounds, ' ', state^.theme.menu)
}

// menu_item is a compact button with menu colors. The caller decides whether
// activation opens a menu, performs an action, or toggles application state.
pub menu_item :: proc(
    state: ^State,
    id: Widget_Id,
    bounds: Rect,
    label: string,
    enabled: bool = true,
) -> bool {
    interaction: Interaction
    if enabled {
        interaction = interact(state, id, bounds)
    }
    style_value := state^.theme.menu
    if !enabled {
        style_value = state^.theme.disabled
    } else if interaction.hot || interaction.held ||
        state^.focused_id == id {
        style_value = state^.theme.menu_selected
    }
    paint_label(state, bounds, label, style_value)
    return enabled && interaction.activated
}

// checkbox toggles one caller-owned boolean on activation. The textual mark is
// painted separately from the borrowed label so no formatting allocation is
// required.
pub checkbox :: proc(
    state: ^State,
    id: Widget_Id,
    bounds: Rect,
    label: string,
    value: ^bool,
    enabled: bool = true,
) -> bool {
    interaction: Interaction
    if enabled {
        interaction = interact(state, id, bounds)
    }
    style_value := control_style(state, interaction, enabled)
    fill_rect(state^.surface, state^.clip, bounds, ' ', style_value)
    marker := "[ ]"
    if value^ {
        marker = "[x]"
    }
    write_clipped(
        state^.surface,
        intersect(state^.clip, bounds),
        Point{column = bounds.column, row = bounds.row},
        marker,
        style_value,
    )
    if bounds.width > 4 {
        label_bounds := Rect{
            column = bounds.column + 4,
            row = bounds.row,
            width = bounds.width - 4,
            height = 1,
        }
        write_clipped(
            state^.surface,
            intersect(state^.clip, label_bounds),
            Point{column = label_bounds.column, row = label_bounds.row},
            label,
            style_value,
        )
    }
    if enabled && interaction.activated {
        value^ = !value^
        return true
    }
    return false
}

// maximum_scroll returns the greatest valid first visible item. Keeping this
// rule shared prevents list and scrollbar from disagreeing at the final page.
maximum_scroll :: proc(total, visible: usize) -> usize {
    if total <= visible {
        return 0
    }
    return total - visible
}

// list presents borrowed labels and mutates caller-owned selection/scroll.
// Selection is clamped before painting, arrow/page/home/end move it, and a
// primary press selects the visible row under the pointer. Empty lists retain
// selection zero. The return value reports a selection change.
pub list :: proc(
    state: ^State,
    id: Widget_Id,
    bounds: Rect,
    items: []string,
    selected: ^usize,
    scroll: ^usize,
) -> bool {
    assert(id != No_Widget, "turbo_ui widget ID zero is reserved")
    assert(state^.frame_open, "turbo_ui list outside a frame")
    register_focus(state, id)
    old_selected := selected^
    if len(items) == 0 {
        selected^ = 0
        scroll^ = 0
    } else if selected^ >= len(items) {
        selected^ = len(items) - 1
    }
    maximum := maximum_scroll(len(items), bounds.height)
    if scroll^ > maximum {
        scroll^ = maximum
    }

    reaches := mouse_reaches_current_scope(state, bounds)
    if reaches {
        state^.hot_id = id
    }
    if !state^.event_handled && reaches && state^.event.mouse.action == .press &&
        state^.event.mouse.button == .primary {
        row := state^.event.mouse.position.row - bounds.row
        index := scroll^ + row
        if index < len(items) {
            selected^ = index
            state^.focused_id = id
        }
        state^.event_handled = true
    }
    if !state^.event_handled && state^.focused_id == id &&
        state^.event.kind == .key && len(items) != 0 {
        old := selected^
        switch state^.event.key.code {
        case .up:
            if selected^ > 0 {
                selected^ -= 1
            }
        case .down:
            if selected^ + 1 < len(items) {
                selected^ += 1
            }
        case .home:
            selected^ = 0
        case .end:
            selected^ = len(items) - 1
        case .page_up:
            if selected^ > bounds.height {
                selected^ -= bounds.height
            } else {
                selected^ = 0
            }
        case .page_down:
            selected^ += bounds.height
            if selected^ >= len(items) {
                selected^ = len(items) - 1
            }
        case:
            // Other keys leave selection unchanged and remain available to
            // application-level shortcuts after the list paints.
        }
        if selected^ != old {
            state^.event_handled = true
        }
    }

    if selected^ < scroll^ {
        scroll^ = selected^
    } else if bounds.height != 0 && selected^ >= scroll^ + bounds.height {
        scroll^ = selected^ - bounds.height + 1
    }

    fill_rect(state^.surface, state^.clip, bounds, ' ', state^.theme.window)
    for row: usize = 0; row < bounds.height; row += 1 {
        index := scroll^ + row
        if index >= len(items) {
            break
        }
        row_rect := Rect{
            column = bounds.column,
            row = bounds.row + row,
            width = bounds.width,
            height = 1,
        }
        style_value := state^.theme.text
        if index == selected^ {
            style_value = state^.theme.selected
            fill_rect(state^.surface, state^.clip, row_rect, ' ', style_value)
        }
        write_clipped(
            state^.surface,
            intersect(state^.clip, row_rect),
            Point{column = row_rect.column, row = row_rect.row},
            items[index],
            style_value,
        )
    }
    return selected^ != old_selected
}

// scrollbar_vertical maps one explicit scroll offset to a vertical track. A
// click or drag positions the thumb proportionally; wheel events adjust one
// item per notch. total and visible describe the same domain as list.
pub scrollbar_vertical :: proc(
    state: ^State,
    id: Widget_Id,
    bounds: Rect,
    total, visible: usize,
    offset: ^usize,
) -> bool {
    assert(id != No_Widget, "turbo_ui widget ID zero is reserved")
    maximum := maximum_scroll(total, visible)
    if offset^ > maximum {
        offset^ = maximum
    }
    old := offset^
    reaches := mouse_reaches_current_scope(state, bounds)
    if reaches {
        state^.hot_id = id
    }
    if !state^.event_handled && reaches && state^.event.kind == .mouse {
        mouse := state^.event.mouse
        if mouse.action == .press && mouse.button == .primary {
            state^.active_id = id
            state^.active_kind = .scrollbar
            state^.focused_id = id
            state^.event_handled = true
        } else if mouse.action == .wheel {
            if mouse.wheel_delta < 0 && offset^ > 0 {
                offset^ -= 1
            } else if mouse.wheel_delta > 0 && offset^ < maximum {
                offset^ += 1
            }
            state^.event_handled = true
        }
    }
    dragging := state^.active_id == id && state^.active_kind == .scrollbar &&
        state^.event.kind == .mouse
    if dragging && (state^.event.mouse.action == .press ||
        state^.event.mouse.action == .move) && bounds.height != 0 {
        row := state^.event.mouse.position.row
        if row < bounds.row {
            row = bounds.row
        }
        if row >= rect_bottom(bounds) {
            row = rect_bottom(bounds) - 1
        }
        relative := row - bounds.row
        if bounds.height > 1 {
            offset^ = relative * maximum / (bounds.height - 1)
        }
    }
    if dragging && state^.event.mouse.action == .release &&
        state^.event.mouse.button == .primary {
        state^.active_id = No_Widget
        state^.active_kind = .none
        state^.event_handled = true
    }

    fill_rect(state^.surface, state^.clip, bounds, '░', state^.theme.disabled)
    if bounds.height != 0 {
        thumb_row := bounds.row
        if maximum != 0 && bounds.height > 1 {
            thumb_row += offset^ * (bounds.height - 1) / maximum
        }
        fill_rect(
            state^.surface,
            state^.clip,
            Rect{column = bounds.column, row = thumb_row, width = bounds.width, height = 1},
            '█',
            state^.theme.selected,
        )
    }
    return offset^ != old
}

// splitter mutates one caller-owned leading-pane extent. bounds is the full
// movement track, axis identifies the pane arrangement, and minimum/maximum
// express application constraints. The current separator is painted at value.
pub splitter :: proc(
    state: ^State,
    id: Widget_Id,
    bounds: Rect,
    axis: Axis,
    value: ^usize,
    minimum, maximum: usize,
) -> bool {
    assert(id != No_Widget, "turbo_ui widget ID zero is reserved")
    if value^ < minimum {
        value^ = minimum
    }
    if value^ > maximum {
        value^ = maximum
    }
    old := value^
    separator := Rect{column = bounds.column + value^, row = bounds.row, width = 1, height = bounds.height}
    if axis == .vertical {
        separator = Rect{column = bounds.column, row = bounds.row + value^, width = bounds.width, height = 1}
    }
    reaches := mouse_reaches_current_scope(state, separator)
    if reaches {
        state^.hot_id = id
    }
    if !state^.event_handled && reaches && state^.event.kind == .mouse &&
        state^.event.mouse.action == .press &&
        state^.event.mouse.button == .primary {
        state^.active_id = id
        state^.active_kind = .splitter
        state^.event_handled = true
    }
    dragging := state^.active_id == id && state^.active_kind == .splitter &&
        state^.event.kind == .mouse
    if dragging && state^.event.mouse.action == .move &&
        state^.event.mouse.primary_down {
        coordinate := state^.event.mouse.position.column
        origin := bounds.column
        if axis == .vertical {
            coordinate = state^.event.mouse.position.row
            origin = bounds.row
        }
        if coordinate < origin {
            value^ = minimum
        } else {
            value^ = coordinate - origin
            if value^ < minimum {
                value^ = minimum
            }
            if value^ > maximum {
                value^ = maximum
            }
        }
        state^.event_handled = true
    }
    if dragging && state^.event.mouse.action == .release &&
        state^.event.mouse.button == .primary {
        state^.active_id = No_Widget
        state^.active_kind = .none
        state^.event_handled = true
    }
    separator = Rect{column = bounds.column + value^, row = bounds.row, width = 1, height = bounds.height}
    glyph := '│'
    if axis == .vertical {
        separator = Rect{column = bounds.column, row = bounds.row + value^, width = bounds.width, height = 1}
        glyph = '─'
    }
    fill_rect(state^.surface, state^.clip, separator, glyph, state^.theme.border)
    return value^ != old
}

// status_bar paints one application-owned message across a single rectangle.
pub status_bar :: proc(state: ^State, bounds: Rect, text: string) {
    paint_label(state, bounds, text, state^.theme.status)
}

// dialog_begin uses the ordinary window mechanism and then repaints its content
// with the dialog style. Modality remains application policy: the caller passes
// only the dialog window to begin_window_frame when it should capture input.
pub dialog_begin :: proc(
    state: ^State,
    window: ^Window_State,
    title: string,
) -> Window_Context {
    result := begin_window(state, window, title)
    if result.visible {
        result.painted = result.painted && fill_rect(
            state^.surface,
            state^.clip,
            result.content,
            ' ',
            state^.theme.dialog,
        )
    }
    return result
}
