// Widgets are direct immediate-mode procedures: each performs hit testing,
// updates explicit caller-owned values, and paints into the current frame.
// They allocate nothing, retain no label/item storage, and invoke no callback.
// A true result always means the user changed or activated that control in the
// current frame, never merely that it was redrawn.
package turbo_ui

import core/tui

// Button_Role adds dialog keyboard policy without changing ownership or
// requiring callbacks. A default button accepts an otherwise-unhandled Enter
// anywhere in its active scope; a cancel button similarly accepts Escape.
pub Button_Role :: enum u8 {
    normal,
    default_action,
    cancel_action,
}

// control_style selects the visual state shared by button-like widgets.
control_style :: proc(
    state: ^State,
    interaction: Interaction,
    enabled: bool,
) -> tui.Style {
    if !enabled {
        return state^.theme.disabled
    }
    if interaction.held {
        return state^.theme.active
    }
    if interaction.hot {
        return state^.theme.hot
    }
    return state^.theme.button
}

// paint_label paints one clipped label with one leading cell of breathing room.
// It deliberately avoids measuring/truncating bytes; write_clipped applies the
// package's grapheme-aware terminal-column policy.
paint_label :: proc(
    state: ^State,
    bounds: Rect,
    label: string,
    style_value: tui.Style,
) -> bool {
    if !fill_rect(state^.surface, state^.clip, bounds, ' ', style_value) {
        return false
    }
    if bounds.width < 2 || bounds.height == 0 {
        return true
    }
    label_clip := Rect{
        column = bounds.column + 1,
        row = bounds.row,
        width = bounds.width - 2,
        height = 1,
    }
    return write_clipped(
        state^.surface,
        intersect(state^.clip, label_clip),
        Point{column = label_clip.column, row = label_clip.row},
        label,
        style_value,
    )
}

// label paints noninteractive text with the same clipping and theme policy as
// controls. It registers no focus and never consumes the current event.
pub label :: proc(
    state: ^State,
    bounds: Rect,
    text: string,
    enabled: bool = true,
) -> bool {
    style_value := state^.theme.text
    if !enabled {
        style_value = state^.theme.disabled
    }
    return paint_label(state, bounds, text, style_value)
}

// button is a focusable press/release or Enter/Space control. disabled buttons
// still paint but do not register focus or consume the event.
pub button :: proc(
    state: ^State,
    id: Widget_Id,
    bounds: Rect,
    label: string,
    enabled: bool = true,
    role: Button_Role = .normal,
) -> bool {
    interaction: Interaction
    if enabled {
        interaction = interact(state, id, bounds)
    }
    activated := enabled && interaction.activated
    if enabled && !activated && scope_accepts_keyboard(state) &&
        !state^.event_handled && state^.event.kind == .key {
        key := state^.event.key
        if (role == .default_action && key.code == .enter) ||
            (role == .cancel_action && key.code == .escape) {
            activated = true
            state^.event_handled = true
        }
    }
    paint_label(state, bounds, label, control_style(state, interaction, enabled))
    return activated
}

// checkbox toggles one caller-owned boolean on activation. The textual mark is
// painted separately from the borrowed label so no formatting allocation is
// required.
pub checkbox :: proc(
    state: ^State,
    id: Widget_Id,
    bounds: Rect,
    label: string,
    value: ^bool,
    enabled: bool = true,
) -> bool {
    interaction: Interaction
    if enabled {
        interaction = interact(state, id, bounds)
    }
    style_value := control_style(state, interaction, enabled)
    fill_rect(state^.surface, state^.clip, bounds, ' ', style_value)
    marker := "[ ]"
    if value^ {
        marker = "[x]"
    }
    write_clipped(
        state^.surface,
        intersect(state^.clip, bounds),
        Point{column = bounds.column, row = bounds.row},
        marker,
        style_value,
    )
    if bounds.width > 4 {
        label_bounds := Rect{
            column = bounds.column + 4,
            row = bounds.row,
            width = bounds.width - 4,
            height = 1,
        }
        write_clipped(
            state^.surface,
            intersect(state^.clip, label_bounds),
            Point{column = label_bounds.column, row = label_bounds.row},
            label,
            style_value,
        )
    }
    if enabled && interaction.activated {
        value^ = !value^
        return true
    }
    return false
}

// radio_button assigns one caller-owned choice on activation. Choices are
// ordinary usize values so applications can use dense enum ordinals or their
// own stable IDs without a generic wrapper or hidden group object.
pub radio_button :: proc(
    state: ^State,
    id: Widget_Id,
    bounds: Rect,
    label_text: string,
    value: ^usize,
    choice: usize,
    enabled: bool = true,
) -> bool {
    interaction: Interaction
    if enabled {
        interaction = interact(state, id, bounds)
    }
    style_value := control_style(state, interaction, enabled)
    fill_rect(state^.surface, state^.clip, bounds, ' ', style_value)
    marker := "( )"
    if value^ == choice {
        marker = "(•)"
    }
    write_clipped(
        state^.surface,
        intersect(state^.clip, bounds),
        Point{column = bounds.column, row = bounds.row},
        marker,
        style_value,
    )
    if bounds.width > 4 {
        label_bounds := Rect{
            column = bounds.column + 4,
            row = bounds.row,
            width = bounds.width - 4,
            height = 1,
        }
        write_clipped(
            state^.surface,
            intersect(state^.clip, label_bounds),
            Point{column = label_bounds.column, row = label_bounds.row},
            label_text,
            style_value,
        )
    }
    if enabled && interaction.activated && value^ != choice {
        value^ = choice
        return true
    }
    return false
}

// splitter mutates one caller-owned leading-pane extent. bounds is the full
// movement track, axis identifies the pane arrangement, and minimum/maximum
// express application constraints. The current separator is painted at value.
pub splitter :: proc(
    state: ^State,
    id: Widget_Id,
    bounds: Rect,
    axis: Axis,
    value: ^usize,
    minimum, maximum: usize,
) -> bool {
    assert(id != No_Widget, "turbo_ui widget ID zero is reserved")
    if value^ < minimum {
        value^ = minimum
    }
    if value^ > maximum {
        value^ = maximum
    }
    old := value^
    separator := Rect{column = bounds.column + value^, row = bounds.row, width = 1, height = bounds.height}
    if axis == .vertical {
        separator = Rect{column = bounds.column, row = bounds.row + value^, width = bounds.width, height = 1}
    }
    reaches := mouse_reaches_current_scope(state, separator)
    if reaches {
        state^.hot_id = id
    }
    if !state^.event_handled && reaches && state^.event.kind == .mouse &&
        state^.event.mouse.action == .press &&
        state^.event.mouse.button == .primary {
        state^.active_id = id
        state^.active_kind = .splitter
        state^.event_handled = true
    }
    dragging := state^.active_id == id && state^.active_kind == .splitter &&
        state^.event.kind == .mouse
    if dragging && state^.event.mouse.action == .move &&
        state^.event.mouse.primary_down {
        coordinate := state^.event.mouse.position.column
        origin := bounds.column
        if axis == .vertical {
            coordinate = state^.event.mouse.position.row
            origin = bounds.row
        }
        if coordinate < origin {
            value^ = minimum
        } else {
            value^ = coordinate - origin
            if value^ < minimum {
                value^ = minimum
            }
            if value^ > maximum {
                value^ = maximum
            }
        }
        state^.event_handled = true
    }
    if dragging && state^.event.mouse.action == .release &&
        state^.event.mouse.button == .primary {
        state^.active_id = No_Widget
        state^.active_kind = .none
        state^.event_handled = true
    }
    separator = Rect{column = bounds.column + value^, row = bounds.row, width = 1, height = bounds.height}
    glyph := '│'
    if axis == .vertical {
        separator = Rect{column = bounds.column, row = bounds.row + value^, width = bounds.width, height = 1}
        glyph = '─'
    }
    fill_rect(state^.surface, state^.clip, separator, glyph, state^.theme.border)
    return value^ != old
}

// status_bar paints one application-owned message across a single rectangle.
pub status_bar :: proc(state: ^State, bounds: Rect, text: string) {
    paint_label(state, bounds, text, state^.theme.status)
}

// dialog_begin uses the ordinary window mechanism and then repaints its content
// with the dialog style. Modality remains application policy: the caller passes
// only the dialog window to begin_window_frame when it should capture input.
pub dialog_begin :: proc(
    state: ^State,
    window: ^Window_State,
    title: string,
) -> Window_Context {
    result := begin_window(state, window, title)
    if result.visible {
        result.painted = result.painted && fill_rect(
            state^.surface,
            state^.clip,
            result.content,
            ' ',
            state^.theme.dialog,
        )
    }
    return result
}
