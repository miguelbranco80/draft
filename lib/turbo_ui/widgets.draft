// Widgets are direct immediate-mode procedures: each performs hit testing,
// updates explicit caller-owned values, and paints into the current frame.
// They allocate nothing, retain no label/item storage, and invoke no callback.
// A true result always means the user changed or activated that control in the
// current frame, never merely that it was redrawn.
//
// Buttons use an explicit caller-supplied footprint. A footprint at least two
// rows high reserves its final row and column for a classic one-cell shadow;
// the face remains the only hit target. This makes dialog geometry, overlap,
// and stale-cell erasure ordinary immediate-mode layout facts rather than
// invisible drawing outside the bounds the application provided.
package turbo_ui

import core/tui
import core/unicode

// Button_Role adds dialog keyboard policy without changing ownership or
// requiring callbacks. A default button accepts an otherwise-unhandled Enter
// anywhere in its active scope; a cancel button similarly accepts Escape.
// Every role may also expose one underlined Alt mnemonic through button's
// access_key argument.
pub Button_Role :: enum u8 {
    normal,
    default_action,
    cancel_action,
}

// control_style selects the visual state shared by button-like widgets.
// Keyboard focus is visible even when the mouse is elsewhere. held wins over
// focus because the pressed offset is the immediate state the user is acting
// on; hover wins over focus for the same reason.
control_style :: proc(
    state: ^State,
    id: Widget_Id,
    interaction: Interaction,
    enabled: bool,
) -> tui.Style {
    if !enabled {
        return state.theme.disabled
    }
    if interaction.held {
        return state.theme.active
    }
    if interaction.hot {
        return state.theme.hot
    }
    if scope_accepts_keyboard(state) && state.focused_id == id {
        return state.theme.selected
    }
    return state.theme.button
}

// text_columns measures one trusted widget label using the same pinned
// grapheme policy as clipped painting. A malformed/nonprinting label is an
// application bug; returning false lets button retain a valid frame while the
// debug assertion identifies the authored control.
text_columns :: proc(text: string) -> (usize, bool) {
    columns: usize
    offset: usize
    for offset < len(text) {
        (end, width, error) := unicode.next_grapheme(text, offset)
        if error != .none || end <= offset {
            return (0, false)
        }
        columns = saturated_add(columns, width)
        offset = end
    }
    return (columns, true)
}

// button_width returns the smallest two-row footprint which can display the
// complete label, both face brackets, and the one-cell right shadow. Dialog
// layout should use this operation instead of repeating byte-count arithmetic:
// UTF-8 byte length is not terminal width, and forgetting the shadow column
// visibly truncates the final label cell.
pub button_width :: proc(label: string) -> usize {
    (columns, valid) := text_columns(label)
    assert(valid, "turbo_ui button label must be printable UTF-8")
    if !valid {
        return 3
    }
    return saturated_add(columns, 3)
}

// compact_button_width returns the exact one-row bracketed face width. Use it
// only with a one-row button footprint; unlike button_width it reserves no
// right-shadow column. Toolbars can therefore use ordinary button interaction
// without importing the two-row dialog visual weight.
pub compact_button_width :: proc(label: string) -> usize {
    (columns, valid) := text_columns(label)
    assert(valid, "turbo_ui button label must be printable UTF-8")
    if !valid {
        return 2
    }
    return saturated_add(columns, 2)
}

// button_face returns the painted and interactive face inside one explicit
// footprint. The ordinary resting face is followed by a bottom/right shadow.
// A held face moves one cell down/right and covers that shadow, which gives the
// classic pressed feedback without changing the widget's caller-owned bounds.
button_face :: proc(bounds: Rect, held: bool) -> (Rect, bool) {
    shadowed := bounds.width >= 4 && bounds.height >= 2
    face := bounds
    face.height = 1 if bounds.height != 0 else 0
    if shadowed {
        face.width -= 1
        if held {
            face.column += 1
            face.row += 1
        }
    }
    return (face, shadowed)
}

// paint_button draws one complete button footprint. Brackets distinguish an
// ordinary/cancel action from the angle-bracketed default action; the same
// access_key value both underlines its label character and drives button's
// Alt-key transition. Labels are centered by terminal columns,
// not UTF-8 bytes. The shadow is real glyph content so moving or hiding a
// dialog changes the differential renderer's cell value as well as its style.
paint_button :: proc(
    state: ^State,
    id: Widget_Id,
    bounds: Rect,
    label_text: string,
    access_key: u8,
    role: Button_Role,
    interaction: Interaction,
    enabled: bool,
) -> bool {
    (face, shadowed) := button_face(bounds, interaction.held)
    style_value := control_style(state, id, interaction, enabled)
    if !fill_rect(state.surface, state.clip, face, ' ', style_value) {
        return false
    }
    if shadowed && !interaction.held {
        shadow := Rect{
            column = bounds.column + 1,
            row = bounds.row + 1,
            width = bounds.width - 1,
            height = 1,
        }
        if !fill_rect(
            state.surface,
            state.clip,
            shadow,
            Shadow_Glyph,
            state.theme.shadow,
        ) {
            return false
        }
    }
    if face.width == 0 || face.height == 0 {
        return true
    }

    left := '['
    right := ']'
    if role == .default_action {
        left = '<'
        right = '>'
    }
    painted := put_clipped(
        state.surface,
        state.clip,
        Point{column = face.column, row = face.row},
        left,
        style_value,
    )
    if face.width > 1 {
        painted = painted && put_clipped(
            state.surface,
            state.clip,
            Point{column = rect_right(face) - 1, row = face.row},
            right,
            style_value,
        )
    }
    if !painted {
        return false
    }
    if face.width <= 2 {
        return true
    }
    interior := Rect{
        column = face.column + 1,
        row = face.row,
        width = face.width - 2,
        height = 1,
    }
    (label_columns, valid_label) := text_columns(label_text)
    assert(valid_label, "turbo_ui button label must be printable UTF-8")
    origin := Point{column = interior.column, row = interior.row}
    if valid_label && label_columns < interior.width {
        origin.column += (interior.width - label_columns) / 2
    }
    return write_access_text(
        state.surface,
        intersect(state.clip, interior),
        origin,
        label_text,
        access_key,
        style_value,
    )
}

// paint_label paints one clipped label with one leading cell of breathing room.
// It deliberately avoids measuring/truncating bytes; write_clipped applies the
// package's grapheme-aware terminal-column policy.
paint_label :: proc(
    state: ^State,
    bounds: Rect,
    label: string,
    style_value: tui.Style,
) -> bool {
    if !fill_rect(state.surface, state.clip, bounds, ' ', style_value) {
        return false
    }
    if bounds.width < 2 || bounds.height == 0 {
        return true
    }
    label_clip := Rect{
        column = bounds.column + 1,
        row = bounds.row,
        width = bounds.width - 2,
        height = 1,
    }
    return write_clipped(
        state.surface,
        intersect(state.clip, label_clip),
        Point{column = label_clip.column, row = label_clip.row},
        label,
        style_value,
    )
}

// label paints noninteractive text with the same clipping and theme policy as
// controls. It registers no focus and never consumes the current event.
pub label :: proc(
    state: ^State,
    bounds: Rect,
    text: string,
    enabled: bool = true,
) -> bool {
    style_value := state.theme.text
    if !enabled {
        style_value = state.theme.disabled
    }
    return paint_label(state, bounds, text, style_value)
}

// button is a focusable press/release or Enter/Space control. disabled buttons
// still paint but do not register focus or consume the event. bounds is the
// complete face-plus-shadow footprint; access_key zero omits a mnemonic.
pub button :: proc(
    state: ^State,
    id: Widget_Id,
    bounds: Rect,
    label: string,
    enabled: bool = true,
    role: Button_Role = .normal,
    access_key: u8 = 0,
) -> bool {
    interaction: Interaction
    if enabled {
        (face, _) := button_face(bounds, false)
        interaction = interact(state, id, face)
    }
    activated := enabled && interaction.activated
    if enabled && !activated && scope_accepts_keyboard(state) &&
        !state.event_handled && state.event.kind == .key {
        key := state.event.key
        access := access_key != 0 && key.code == .character && key.alt &&
            !key.control &&
            ascii_lower(key.byte_value) == ascii_lower(access_key)
        if access || (role == .default_action && key.code == .enter) ||
            (role == .cancel_action && key.code == .escape) {
            activated = true
            state.event_handled = true
        }
    }
    paint_button(
        state,
        id,
        bounds,
        label,
        access_key,
        role,
        interaction,
        enabled,
    )
    return activated
}

// checkbox toggles one caller-owned boolean on activation. The textual mark is
// painted separately from the borrowed label so no formatting allocation is
// required.
pub checkbox :: proc(
    state: ^State,
    id: Widget_Id,
    bounds: Rect,
    label: string,
    value: ^bool,
    enabled: bool = true,
) -> bool {
    interaction: Interaction
    if enabled {
        interaction = interact(state, id, bounds)
    }
    style_value := control_style(state, id, interaction, enabled)
    fill_rect(state.surface, state.clip, bounds, ' ', style_value)
    marker := "[ ]"
    if value^ {
        marker = "[x]"
    }
    write_clipped(
        state.surface,
        intersect(state.clip, bounds),
        Point{column = bounds.column, row = bounds.row},
        marker,
        style_value,
    )
    if bounds.width > 4 {
        label_bounds := Rect{
            column = bounds.column + 4,
            row = bounds.row,
            width = bounds.width - 4,
            height = 1,
        }
        write_clipped(
            state.surface,
            intersect(state.clip, label_bounds),
            Point{column = label_bounds.column, row = label_bounds.row},
            label,
            style_value,
        )
    }
    if enabled && interaction.activated {
        value^ = !value^
        return true
    }
    return false
}

// radio_button assigns one caller-owned choice on activation. Choices are
// ordinary usize values so applications can use dense enum ordinals or their
// own stable IDs without a generic wrapper or hidden group object.
pub radio_button :: proc(
    state: ^State,
    id: Widget_Id,
    bounds: Rect,
    label_text: string,
    value: ^usize,
    choice: usize,
    enabled: bool = true,
) -> bool {
    interaction: Interaction
    if enabled {
        interaction = interact(state, id, bounds)
    }
    style_value := control_style(state, id, interaction, enabled)
    fill_rect(state.surface, state.clip, bounds, ' ', style_value)
    marker := "( )"
    if value^ == choice {
        marker = "(•)"
    }
    write_clipped(
        state.surface,
        intersect(state.clip, bounds),
        Point{column = bounds.column, row = bounds.row},
        marker,
        style_value,
    )
    if bounds.width > 4 {
        label_bounds := Rect{
            column = bounds.column + 4,
            row = bounds.row,
            width = bounds.width - 4,
            height = 1,
        }
        write_clipped(
            state.surface,
            intersect(state.clip, label_bounds),
            Point{column = label_bounds.column, row = label_bounds.row},
            label_text,
            style_value,
        )
    }
    if enabled && interaction.activated && value^ != choice {
        value^ = choice
        return true
    }
    return false
}

// splitter mutates one caller-owned leading-pane extent. bounds is the full
// movement track, axis identifies the pane arrangement, and minimum/maximum
// express application constraints. The current separator is painted at value.
pub splitter :: proc(
    state: ^State,
    id: Widget_Id,
    bounds: Rect,
    axis: Axis,
    value: ^usize,
    minimum, maximum: usize,
) -> bool {
    assert(id != No_Widget, "turbo_ui widget ID zero is reserved")
    if value^ < minimum {
        value^ = minimum
    }
    if value^ > maximum {
        value^ = maximum
    }
    old := value^
    separator := Rect{column = bounds.column + value^, row = bounds.row, width = 1, height = bounds.height}
    if axis == .vertical {
        separator = Rect{column = bounds.column, row = bounds.row + value^, width = bounds.width, height = 1}
    }
    reaches := mouse_reaches_current_scope(state, separator)
    if reaches {
        state.hot_id = id
    }
    if !state.event_handled && reaches && state.event.kind == .mouse &&
        state.event.mouse.action == .press &&
        state.event.mouse.button == .primary {
        state.active_id = id
        state.active_kind = .splitter
        state.event_handled = true
    }
    dragging := state.active_id == id && state.active_kind == .splitter &&
        state.event.kind == .mouse
    if dragging && state.event.mouse.action == .move &&
        state.event.mouse.primary_down {
        coordinate := state.event.mouse.position.column
        origin := bounds.column
        if axis == .vertical {
            coordinate = state.event.mouse.position.row
            origin = bounds.row
        }
        if coordinate < origin {
            value^ = minimum
        } else {
            value^ = coordinate - origin
            if value^ < minimum {
                value^ = minimum
            }
            if value^ > maximum {
                value^ = maximum
            }
        }
        state.event_handled = true
    }
    if dragging && state.event.mouse.action == .release &&
        state.event.mouse.button == .primary {
        state.active_id = No_Widget
        state.active_kind = .none
        state.event_handled = true
    }
    separator = Rect{column = bounds.column + value^, row = bounds.row, width = 1, height = bounds.height}
    glyph := '│'
    if axis == .vertical {
        separator = Rect{column = bounds.column, row = bounds.row + value^, width = bounds.width, height = 1}
        glyph = '─'
    }
    fill_rect(state.surface, state.clip, separator, glyph, state.theme.border)
    return value^ != old
}

// status_bar paints one application-owned message across a single rectangle.
pub status_bar :: proc(state: ^State, bounds: Rect, text: string) {
    paint_label(state, bounds, text, state.theme.status)
}

// status_bar_bytes is the mutable-byte counterpart for application-formatted
// counts and paths. It borrows bytes only for this frame, fills the complete
// bar exactly like status_bar, and applies the same UTF-8 clipping policy.
pub status_bar_bytes :: proc(state: ^State, bounds: Rect, text: []u8) {
    fill_rect(state.surface, state.clip, bounds, ' ', state.theme.status)
    write_clipped_bytes(
        state.surface,
        intersect(state.clip, bounds),
        Point{column = bounds.column, row = bounds.row},
        text,
        state.theme.status,
    )
}

status_bytes_columns :: proc(text: []u8) -> (usize, bool) {
    columns: usize
    offset: usize
    for offset < len(text) {
        (next, width, error) := unicode.next_grapheme_bytes(text, offset)
        if error != .none || next <= offset {
            return (0, false)
        }
        columns = saturated_add(columns, width)
        offset = next
    }
    return (columns, true)
}

// status_bar_sections keeps transient command feedback on the left and a
// caller-owned session identity on the right. The right section is shown only
// when it and one separating cell fit; on a narrow terminal the command result
// wins rather than becoming unreadable. Both inputs are borrowed for this
// frame and clipped by terminal columns, including non-ASCII workspace names.
pub status_bar_sections :: proc(
    state: ^State,
    bounds: Rect,
    left: string,
    right: []u8,
) {
    fill_rect(state.surface, state.clip, bounds, ' ', state.theme.status)
    left_bounds := bounds
    (left_columns, left_valid) := text_columns(left)
    (right_columns, right_valid) := status_bytes_columns(right)
    right_bounds: Rect
    required := saturated_add(saturated_add(left_columns, right_columns), 1)
    show_right := left_valid && right_valid && len(right) != 0 &&
        required <= bounds.width
    if show_right {
        right_bounds = Rect{
            column = rect_right(bounds) - right_columns,
            row = bounds.row,
            width = right_columns,
            height = bounds.height,
        }
        left_bounds.width = right_bounds.column - bounds.column - 1
    }
    write_clipped(
        state.surface,
        intersect(state.clip, left_bounds),
        Point{column = left_bounds.column, row = left_bounds.row},
        left,
        state.theme.status,
    )
    if show_right {
        write_clipped_bytes(
            state.surface,
            intersect(state.clip, right_bounds),
            Point{column = right_bounds.column, row = right_bounds.row},
            right,
            state.theme.status,
        )
    }
}

// status_bar_sections_bytes is the mutable-left counterpart used for formatted
// counts. It deliberately shares the same geometry rule as the string form.
pub status_bar_sections_bytes :: proc(
    state: ^State,
    bounds: Rect,
    left, right: []u8,
) {
    fill_rect(state.surface, state.clip, bounds, ' ', state.theme.status)
    left_bounds := bounds
    (left_columns, left_valid) := status_bytes_columns(left)
    (right_columns, right_valid) := status_bytes_columns(right)
    right_bounds: Rect
    required := saturated_add(saturated_add(left_columns, right_columns), 1)
    show_right := left_valid && right_valid && len(right) != 0 &&
        required <= bounds.width
    if show_right {
        right_bounds = Rect{
            column = rect_right(bounds) - right_columns,
            row = bounds.row,
            width = right_columns,
            height = bounds.height,
        }
        left_bounds.width = right_bounds.column - bounds.column - 1
    }
    write_clipped_bytes(
        state.surface,
        intersect(state.clip, left_bounds),
        Point{column = left_bounds.column, row = left_bounds.row},
        left,
        state.theme.status,
    )
    if show_right {
        write_clipped_bytes(
            state.surface,
            intersect(state.clip, right_bounds),
            Point{column = right_bounds.column, row = right_bounds.row},
            right,
            state.theme.status,
        )
    }
}

// dialog_begin uses the ordinary window mechanism and then repaints its content
// with the dialog style. Modality remains application policy: the caller passes
// only the dialog window to begin_window_frame when it should capture input.
pub dialog_begin :: proc(
    state: ^State,
    window: ^Window_State,
    title: string,
) -> Window_Context {
    result := begin_window(state, window, title)
    if result.visible {
        result.painted = result.painted && fill_rect(
            state.surface,
            state.clip,
            result.content,
            ' ',
            state.theme.dialog,
        )
    }
    return result
}
