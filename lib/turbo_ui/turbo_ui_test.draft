// These same-package tests exercise turbo_ui entirely through in-memory cell
// surfaces and synthetic events. They open no terminal, sleep for no timeout,
// and destroy every owning Surface before returning. Private interaction fields
// are inspected only where they are the invariant under test.
package turbo_ui

import core/testing
import core/tui

// test_geometry_layout_and_paint fixes half-open rectangle arithmetic,
// clipping, explicit row layout, and Unicode border output.
test_geometry_layout_and_paint :: proc(test: ^testing.Test) {
    overlap := intersect(
        Rect{column = 2, row = 1, width = 5, height = 4},
        Rect{column = 5, row = 0, width = 4, height = 3},
    )
    testing.expect(test, rect_equal(
        overlap,
        Rect{column = 5, row = 1, width = 2, height = 2},
    ))
    testing.expect(test, point_in_rect(Point{column = 5, row = 2}, overlap))
    testing.expect(test, !point_in_rect(Point{column = 7, row = 2}, overlap))

    layout := layout_begin(
        Rect{width = 20, height = 5},
        .horizontal,
        1,
        1,
    )
    first := layout_next(&layout, 4)
    second := layout_next(&layout, 6)
    testing.expect(test, rect_equal(
        first,
        Rect{column = 1, row = 1, width = 4, height = 3},
    ))
    testing.expect(test, second.column == 6 && second.width == 6)
    testing.expect(test, layout_rest(&layout).column == 13)

    surface: tui.Surface
    tui.surface_init(&surface, 12, 6)
    clip := Rect{column = 1, row = 1, width = 9, height = 4}
    testing.expect(test, draw_border(
        &surface,
        clip,
        Rect{column = 0, row = 0, width = 12, height = 6},
        .double,
        turbo_theme().border,
    ))
    // The outer border is completely clipped, so the untouched origin remains
    // a blank while a direct clipped label appears in the visible region.
    (origin, origin_valid) := tui.cell_at(&surface, 0, 0)
    testing.expect(test, origin_valid && origin.value == ' ')
    testing.expect(test, write_clipped(
        &surface,
        clip,
        Point{column = 2, row = 2},
        "Draft",
        turbo_theme().text,
    ))
    (letter, letter_valid) := tui.cell_at(&surface, 2, 2)
    testing.expect(test, letter_valid && letter.value == 'D')
    tui.surface_destroy(&surface)
}

// test_button_and_focus proves mouse press/release activation and deterministic
// forward/backward keyboard traversal without a retained control list.
test_button_and_focus :: proc(test: ^testing.Test) {
    surface: tui.Surface
    tui.surface_init(&surface, 30, 8)
    state: State
    theme := turbo_theme()
    bounds := Rect{column = 2, row = 2, width = 8, height = 1}

    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 3, row = 2},
        action = .press,
        button = .primary,
        primary_down = true,
    }), theme)
    testing.expect(test, !button(&state, 10, bounds, "Open"))
    end_frame(&state)
    testing.expect(test, state.active_id == 10 && state.focused_id == 10)

    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 3, row = 2},
        action = .release,
        button = .primary,
    }), theme)
    testing.expect(test, button(&state, 10, bounds, "Open"))
    end_frame(&state)
    testing.expect(test, state.active_id == No_Widget)

    state.focused_id = No_Widget
    begin_frame(&state, &surface, key_event(Key_Event{code = .tab}), theme)
    button(&state, 10, bounds, "One")
    button(&state, 11, Rect{column = 11, row = 2, width = 8, height = 1}, "Two")
    end_frame(&state)
    testing.expect(test, state.focused_id == 10)

    begin_frame(&state, &surface, key_event(Key_Event{code = .tab}), theme)
    button(&state, 10, bounds, "One")
    button(&state, 11, Rect{column = 11, row = 2, width = 8, height = 1}, "Two")
    end_frame(&state)
    testing.expect(test, state.focused_id == 11)

    begin_frame(&state, &surface, key_event(Key_Event{code = .tab, shift = true}), theme)
    button(&state, 10, bounds, "One")
    button(&state, 11, Rect{column = 11, row = 2, width = 8, height = 1}, "Two")
    end_frame(&state)
    testing.expect(test, state.focused_id == 10)
    tui.surface_destroy(&surface)
}

// test_button_chrome_and_access fixes the visible Turbo button contract rather
// than testing activation alone. The caller reserves a two-row footprint; the
// face is centered, the access key is underlined, the default role has distinct
// brackets, focus is visible, and the shadow is real noninteractive content.
test_button_chrome_and_access :: proc(test: ^testing.Test) {
    surface: tui.Surface
    tui.surface_init(&surface, 32, 10)
    defer tui.surface_destroy(&surface)
    state: State
    theme := turbo_theme()
    bounds := Rect{column = 2, row = 2, width = 12, height = 2}

    state.focused_id = 90
    begin_frame(&state, &surface, no_event(), theme)
    button(
        &state,
        90,
        bounds,
        "Open",
        true,
        .default_action,
        cast[u8]('o'),
    )
    end_frame(&state)
    (left, left_valid) := tui.cell_at(&surface, 2, 2)
    (access, access_valid) := tui.cell_at(&surface, 5, 2)
    (right, right_valid) := tui.cell_at(&surface, 12, 2)
    (shadow, shadow_valid) := tui.cell_at(&surface, 3, 3)
    testing.expect(test, left_valid && left.value == '<')
    testing.expect(test, right_valid && right.value == '>')
    testing.expect(
        test,
        access_valid && access.value == 'O' && access.style.underline &&
            access.style.background.index == theme.selected.background.index,
    )
    testing.expect(test, shadow_valid && shadow.value == Shadow_Glyph)

    // The public layout width is an exact footprint, not a byte-count guess.
    // At its minimum width the complete label still precedes the closing face
    // bracket, including when one Unicode glyph occupies two terminal cells.
    testing.expect(test, button_width("Discard") == 10)
    testing.expect(test, button_width("界") == 5)
    minimum := Rect{
        column = 16,
        row = 5,
        width = button_width("Discard"),
        height = 2,
    }
    begin_frame(&state, &surface, no_event(), theme)
    button(&state, 92, minimum, "Discard")
    end_frame(&state)
    (last_label, last_label_valid) := tui.cell_at(&surface, 23, 5)
    (minimum_right, minimum_right_valid) := tui.cell_at(&surface, 24, 5)
    testing.expect(
        test,
        last_label_valid && last_label.value == 'd' &&
            minimum_right_valid && minimum_right.value == ']',
    )

    // The mnemonic is scoped like the button's default/cancel policy and does
    // not require the button to be the currently focused control.
    state.focused_id = 91
    begin_frame(&state, &surface, key_event(Key_Event{
        code = .character,
        byte_value = cast[u8]('o'),
        alt = true,
    }), theme)
    testing.expect(test, button(
        &state,
        90,
        bounds,
        "Open",
        true,
        .default_action,
        cast[u8]('o'),
    ))
    end_frame(&state)

    // A shadow cell is decoration, never part of the press target.
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 3, row = 3},
        action = .press,
        button = .primary,
        primary_down = true,
    }), theme)
    testing.expect(test, !button(&state, 90, bounds, "Open"))
    end_frame(&state)
    testing.expect(test, state.active_id == No_Widget)
}

// test_value_widgets proves explicit caller ownership for checkbox state, list
// selection/scrolling, scrollbar offset, and splitter geometry.
test_value_widgets :: proc(test: ^testing.Test) {
    surface: tui.Surface
    tui.surface_init(&surface, 40, 12)
    state: State
    theme := turbo_theme()
    checked := false
    state.focused_id = 20

    begin_frame(&state, &surface, key_event(Key_Event{code = .enter}), theme)
    testing.expect(test, checkbox(
        &state,
        20,
        Rect{column = 1, row = 1, width = 16, height = 1},
        "Enabled",
        &checked,
    ))
    end_frame(&state)
    testing.expect(test, checked)

    items := [5]string{"zero", "one", "two", "three", "four"}
    list_state: List_State
    state.focused_id = 21
    begin_frame(&state, &surface, key_event(Key_Event{code = .page_down}), theme)
    list_result := list(
        &state,
        21,
        22,
        Rect{column = 1, row = 3, width = 12, height = 2},
        items[:],
        &list_state,
    )
    testing.expect(test, list_result.selection_changed)
    end_frame(&state)
    testing.expect(test, list_state.cursor == 2 && list_state.offset == 1)

    scroll: usize
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 15, row = 6},
        action = .wheel,
        wheel_delta = 1,
    }), theme)
    scrollbar_vertical(
        &state,
        23,
        Rect{column = 15, row = 3, width = 1, height = 4},
        10,
        4,
        &scroll,
    )
    end_frame(&state)
    testing.expect(test, scroll == 3)

    split: usize = 5
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 5, row = 8},
        action = .press,
        button = .primary,
        primary_down = true,
    }), theme)
    splitter(
        &state,
        24,
        Rect{column = 0, row = 8, width = 20, height = 2},
        .horizontal,
        &split,
        2,
        18,
    )
    end_frame(&state)
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 9, row = 8},
        action = .move,
        primary_down = true,
    }), theme)
    testing.expect(test, splitter(
        &state,
        24,
        Rect{column = 0, row = 8, width = 20, height = 2},
        .horizontal,
        &split,
        2,
        18,
    ))
    end_frame(&state)
    testing.expect(test, split == 9)
    tui.surface_destroy(&surface)
}

// test_collection_viewports fixes the behavior which distinguishes the richer
// collection layer from a position marker: proportional thumb size, page
// regions, grab-relative dragging, viewport-only wheel movement, explicit row
// activation, and shared read-only text scrolling.
test_collection_viewports :: proc(test: ^testing.Test) {
    surface: tui.Surface
    tui.surface_init(&surface, 40, 14)
    defer tui.surface_destroy(&surface)
    state: State
    theme := turbo_theme()
    scrollbar_bounds := Rect{column = 30, row = 1, width = 1, height = 10}

    geometry := scrollbar_geometry(scrollbar_bounds, 40, 10, 15)
    testing.expect(test, geometry.maximum == 30)
    testing.expect(test, geometry.track.row == 2 && geometry.track.height == 8)
    testing.expect(test, geometry.thumb.row == 5 && geometry.thumb.height == 2)

    // A track press below the thumb advances exactly one visible page.
    offset: usize
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 30, row = 7},
        action = .press,
        button = .primary,
        primary_down = true,
    }), theme)
    testing.expect(test, scrollbar_vertical(
        &state, 30, scrollbar_bounds, 40, 10, &offset,
    ))
    end_frame(&state)
    testing.expect(test, offset == 10)
    (up, up_valid) := tui.cell_at(&surface, 30, 1)
    (down, down_valid) := tui.cell_at(&surface, 30, 10)
    testing.expect(test, up_valid && up.value == '▲')
    testing.expect(test, down_valid && down.value == '▼')

    // An arrow owns capture after its initial one-row action. Application
    // timer pulses repeat that exact action until release; the UI itself owns
    // no clock, which keeps this behavior deterministic under synthetic input.
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 30, row = 10},
        action = .press,
        button = .primary,
        primary_down = true,
    }), theme)
    testing.expect(test, scrollbar_vertical(
        &state, 30, scrollbar_bounds, 40, 10, &offset,
    ))
    end_frame(&state)
    testing.expect(test, offset == 11)
    testing.expect(test, scrollbar_repeat_active(&state))
    begin_frame(&state, &surface, repeat_event(), theme)
    testing.expect(test, scrollbar_vertical(
        &state, 30, scrollbar_bounds, 40, 10, &offset,
    ))
    end_frame(&state)
    testing.expect(test, offset == 12)
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 30, row = 10},
        action = .release,
        button = .primary,
    }), theme)
    scrollbar_vertical(&state, 30, scrollbar_bounds, 40, 10, &offset)
    end_frame(&state)
    testing.expect(test, !scrollbar_repeat_active(&state))

    // Press the lower half of a two-row thumb, then move it. Preserving the
    // one-row grab offset yields logical offset 25 rather than jumping as if
    // the pointer always grabbed the leading cell.
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 30, row = 5},
        action = .press,
        button = .primary,
        primary_down = true,
    }), theme)
    scrollbar_vertical(&state, 30, scrollbar_bounds, 40, 10, &offset)
    end_frame(&state)
    testing.expect(test, state.scrollbar_grab_offset == 1)
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 30, row = 8},
        action = .move,
        primary_down = true,
    }), theme)
    scrollbar_vertical(&state, 30, scrollbar_bounds, 40, 10, &offset)
    end_frame(&state)
    testing.expect(test, offset == 25)
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 30, row = 8},
        action = .release,
        button = .primary,
    }), theme)
    scrollbar_vertical(&state, 30, scrollbar_bounds, 40, 10, &offset)
    end_frame(&state)

    items := [10]string{
        "zero", "one", "two", "three", "four",
        "five", "six", "seven", "eight", "nine",
    }
    model := List_State{cursor = 4, offset = 3}
    list_bounds := Rect{column = 1, row = 1, width = 16, height = 3}
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 2, row = 2},
        action = .wheel,
        wheel_delta = 1,
    }), theme)
    list(&state, 31, 32, list_bounds, items[:], &model)
    end_frame(&state)
    testing.expect(test, model.cursor == 4 && model.offset == 6)

    // Click activation is completed on release over the row selected by the
    // corresponding press; the press alone only changes selection.
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 2, row = 1},
        action = .press,
        button = .primary,
        primary_down = true,
    }), theme)
    pressed := list(
        &state, 31, 32, list_bounds, items[:], &model, .click_and_enter,
    )
    end_frame(&state)
    testing.expect(test, !pressed.activated && model.cursor == 6)
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 2, row = 1},
        action = .release,
        button = .primary,
    }), theme)
    released := list(
        &state, 31, 32, list_bounds, items[:], &model, .click_and_enter,
    )
    end_frame(&state)
    testing.expect(test, released.activated && released.activated_index == 6)

    text := [9]u8{97, 10, 98, 10, 99, 10, 100, 10, 101}
    text_model: Text_View_State
    state.focused_id = 33
    begin_frame(&state, &surface, key_event(Key_Event{code = .page_down}), theme)
    testing.expect(test, text_view_bytes(
        &state,
        33,
        34,
        Rect{column = 18, row = 1, width = 10, height = 2},
        text[:],
        &text_model,
    ))
    end_frame(&state)
    testing.expect(test, text_model.offset == 2)
}

// test_tree_view fixes allocation-free preorder filtering and familiar outline
// navigation. Expansion belongs to the model, while selection remains the
// visible List_State index; the caller's scratch mapping connects the two.
test_tree_view :: proc(test: ^testing.Test) {
    surface: tui.Surface
    tui.surface_init(&surface, 30, 10)
    defer tui.surface_destroy(&surface)
    state: State
    theme := turbo_theme()
    nodes := [5]Tree_Node{
        Tree_Node{depth = 0, has_children = true, expanded = true},
        Tree_Node{depth = 1, has_children = true, expanded = true},
        Tree_Node{depth = 2},
        Tree_Node{depth = 1},
        Tree_Node{depth = 0},
    }
    scratch: [5]usize
    model := List_State{cursor = 2}
    bounds := Rect{column = 1, row = 1, width = 20, height = 6}
    state.focused_id = 35

    // Left on a leaf selects its nearest visible parent without changing the
    // tree model. A second Left closes that parent and requests repaint.
    begin_frame(&state, &surface, key_event(Key_Event{code = .left}), theme)
    view := tree_view(
        &state, 35, 36, bounds, nodes[:], scratch[:], &model,
    )
    end_frame(&state)
    testing.expect(test, model.cursor == 1 && view.selected_node == 1)

    begin_frame(&state, &surface, key_event(Key_Event{code = .left}), theme)
    view = tree_view(&state, 35, 36, bounds, nodes[:], scratch[:], &model)
    testing.expect(test, view.toggled && view.toggled_node == 1)
    testing.expect(test, !view.list.selection_changed)
    testing.expect(test, state.repaint_requested)
    end_frame(&state)
    testing.expect(test, !nodes[1].expanded)
    testing.expect(test, build_tree_visibility(nodes[:], scratch[:]) == 4)

    // Enter closes the root. The child subtree disappears, while the second
    // root remains visible because equal depth ends the collapsed interval.
    model.cursor = 0
    begin_frame(&state, &surface, key_event(Key_Event{code = .enter}), theme)
    view = tree_view(&state, 35, 36, bounds, nodes[:], scratch[:], &model)
    end_frame(&state)
    testing.expect(test, view.toggled && !nodes[0].expanded)
    testing.expect(test, build_tree_visibility(nodes[:], scratch[:]) == 2)

    // Right reopens the root; a second Right enters its first visible child.
    begin_frame(&state, &surface, key_event(Key_Event{code = .right}), theme)
    view = tree_view(&state, 35, 36, bounds, nodes[:], scratch[:], &model)
    end_frame(&state)
    testing.expect(test, nodes[0].expanded)
    begin_frame(&state, &surface, key_event(Key_Event{code = .right}), theme)
    view = tree_view(&state, 35, 36, bounds, nodes[:], scratch[:], &model)
    row := tree_row_begin(&state, view, model.cursor, nodes[:])
    end_frame(&state)
    testing.expect(test, model.cursor == 1 && row.model_index == 1)
    (marker, marker_valid) := tui.cell_at(&surface, 3, 2)
    testing.expect(test, marker_valid && marker.value == '+')
}

// test_window_order_drag_and_resize fixes z selection, explicit capture, and
// viewport clamping. The same public frame/window calls are used by the gallery.
test_window_order_drag_and_resize :: proc(test: ^testing.Test) {
    surface: tui.Surface
    tui.surface_init(&surface, 50, 20)
    state: State
    theme := turbo_theme()
    windows := [2]Window_State{
        window_init(30, Rect{column = 1, row = 1, width = 20, height = 8}, 1),
        window_init(31, Rect{column = 5, row = 3, width = 20, height = 8}, 2),
    }
    order: [2]usize
    testing.expect(test, window_order(windows[:], order[:]) == 2)
    testing.expect(test, order[0] == 0 && order[1] == 1)

    // Press the uncovered title text rather than the new close box, then drag
    // it four cells. Visible frame controls must not steal ordinary dragging.
    begin_window_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 6, row = 1},
        action = .press,
        button = .primary,
        primary_down = true,
    }), theme, windows[:])
    first := begin_window(&state, &windows[0], "First")
    end_window(&state, first)
    end_frame(&state)
    testing.expect(test, state.active_kind == .window_drag)
    testing.expect(test, windows[0].z > windows[1].z)

    begin_window_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 10, row = 3},
        action = .move,
        primary_down = true,
    }), theme, windows[:])
    first = begin_window(&state, &windows[0], "First")
    end_window(&state, first)
    end_frame(&state)
    testing.expect(test, windows[0].bounds.column == 5)
    testing.expect(test, windows[0].bounds.row == 3)

    begin_window_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 10, row = 3},
        action = .release,
        button = .primary,
    }), theme, windows[:])
    first = begin_window(&state, &windows[0], "First")
    end_window(&state, first)
    end_frame(&state)
    testing.expect(test, state.active_kind == .none)

    // The front window's bottom shadow covers the rear window's resize cell.
    // Hit testing must follow the painted footprint, so clicking that visible
    // shadow activates the front window without starting the hidden resize.
    windows[0] = window_init(
        30,
        Rect{column = 1, row = 1, width = 20, height = 8},
        1,
    )
    windows[1] = window_init(
        31,
        Rect{column = 4, row = 2, width = 16, height = 6},
        2,
    )
    covered_rear_resize := Point{column = 20, row = 8}
    begin_window_frame(&state, &surface, mouse_event(Mouse_Event{
        position = covered_rear_resize,
        action = .press,
        button = .primary,
        primary_down = true,
    }), theme, windows[:])
    first = begin_window(&state, &windows[0], "Rear")
    end_window(&state, first)
    second := begin_window(&state, &windows[1], "Front")
    end_window(&state, second)
    end_frame(&state)
    testing.expect(test, state.active_window == windows[1].id)
    testing.expect(test, state.active_kind == .none)

    // If a terminal loses the matching release, its next no-button move proves
    // the old resize capture stale. Routing must return to z-order selection
    // rather than remaining pinned to the formerly active rear window.
    windows[1].visible = false
    begin_window_frame(&state, &surface, mouse_event(Mouse_Event{
        position = covered_rear_resize,
        action = .press,
        button = .primary,
        primary_down = true,
    }), theme, windows[:])
    first = begin_window(&state, &windows[0], "Rear")
    end_window(&state, first)
    end_frame(&state)
    testing.expect(test, state.active_kind == .window_resize)
    windows[1].visible = true
    windows[1].z = windows[0].z + 1
    begin_window_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 10, row = 5},
        action = .move,
    }), theme, windows[:])
    testing.expect(test, state.active_kind == .none)
    testing.expect(test, state.target_window == windows[1].id)
    end_frame(&state)

    // A window may be opened by a control whose owner has already painted.
    // The next no-event traversal is part of the public immediate-mode
    // contract: it makes the new z-order visible before presentation.
    windows[1].visible = false
    begin_window_frame(&state, &surface, no_event(), theme, windows[:])
    end_frame(&state)
    begin_window_frame(&state, &surface, no_event(), theme, windows[:])
    testing.expect(test, show_window(&state, windows[:], windows[1].id))
    end_frame(&state)
    testing.expect(test, needs_repaint(&state))
    tui.surface_destroy(&surface)
}

// test_window_chrome_and_modality fixes the externally visible desktop policy:
// close requests do not destroy caller state, zoom restores its old rectangle,
// the resize handle changes extents, and a modal dialog owns the input scope.
test_window_chrome_and_modality :: proc(test: ^testing.Test) {
    surface: tui.Surface
    tui.surface_init(&surface, 60, 24)
    defer tui.surface_destroy(&surface)
    state: State
    theme := turbo_theme()
    windows := [2]Window_State{
        window_init(40, Rect{column = 2, row = 2, width = 24, height = 9}, 1),
        dialog_window_init(41, Rect{column = 14, row = 7, width = 25, height = 8}, 2),
    }
    windows[1].visible = false

    // Close is a completed press/release request; visibility remains entirely
    // under the caller's policy.
    close_point := Point{column = 3, row = 2}
    begin_window_frame(&state, &surface, mouse_event(Mouse_Event{
        position = close_point, action = .press, button = .primary,
        primary_down = true,
    }), theme, windows[:])
    frame := begin_window(&state, &windows[0], "")
    dynamic_title: [9]u8
    title_text := "main.draf"
    for index: usize = 0; index < len(title_text); index += 1 {
        dynamic_title[index] = title_text[index]
    }
    testing.expect(test,
        window_title_bytes(&state, &windows[0], dynamic_title[:]))
    (title_last, title_last_valid) := tui.cell_at(&surface, 14, 2)
    testing.expect(test, title_last_valid && title_last.value == 'f')
    chrome_right := rect_right(windows[0].bounds)
    (zoom, zoom_valid) := tui.cell_at(
        &surface,
        chrome_right - 2,
        windows[0].bounds.row,
    )
    (separator, separator_valid) := tui.cell_at(
        &surface,
        chrome_right - 3,
        windows[0].bounds.row,
    )
    (corner, corner_valid) := tui.cell_at(
        &surface,
        chrome_right - 1,
        windows[0].bounds.row,
    )
    testing.expect(test, zoom_valid && zoom.value == '↕' && zoom.columns == 1)
    testing.expect(test, separator_valid && separator.value == '═' &&
        !separator.continuation)
    testing.expect(test, corner_valid && corner.value == '╗')
    (shadow, shadow_valid) := tui.cell_at(
        &surface,
        chrome_right,
        windows[0].bounds.row + 1,
    )
    testing.expect(test, shadow_valid && shadow.value == Shadow_Glyph)
    end_window(&state, frame)
    end_frame(&state)
    begin_window_frame(&state, &surface, mouse_event(Mouse_Event{
        position = close_point, action = .release, button = .primary,
    }), theme, windows[:])
    frame = begin_window(&state, &windows[0], "Main")
    testing.expect(test, frame.close_requested)
    testing.expect(test, windows[0].visible)
    end_window(&state, frame)
    end_frame(&state)

    resize_point := Point{
        column = rect_right(windows[0].bounds) - 1,
        row = rect_bottom(windows[0].bounds) - 1,
    }
    begin_window_frame(&state, &surface, mouse_event(Mouse_Event{
        position = resize_point, action = .press, button = .primary,
        primary_down = true,
    }), theme, windows[:])
    frame = begin_window(&state, &windows[0], "Main")
    end_window(&state, frame)
    end_frame(&state)
    begin_window_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = resize_point.column + 3, row = resize_point.row + 2},
        action = .move, primary_down = true,
    }), theme, windows[:])
    frame = begin_window(&state, &windows[0], "Main")
    end_window(&state, frame)
    end_frame(&state)
    testing.expect(test, windows[0].bounds.width == 27)
    testing.expect(test, windows[0].bounds.height == 11)
    begin_window_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = resize_point.column + 3, row = resize_point.row + 2},
        action = .release, button = .primary,
    }), theme, windows[:])
    frame = begin_window(&state, &windows[0], "Main")
    end_window(&state, frame)
    end_frame(&state)

    // The upper-right chrome toggles zoom and preserves an exact restore rect.
    // The text-default arrow occupies exactly one terminal cell immediately
    // before the structural corner.
    original := windows[0].bounds
    zoom_point := Point{
        column = rect_right(windows[0].bounds) - 2,
        row = windows[0].bounds.row,
    }
    begin_window_frame(&state, &surface, mouse_event(Mouse_Event{
        position = zoom_point, action = .press, button = .primary,
        primary_down = true,
    }), theme, windows[:])
    frame = begin_window(&state, &windows[0], "Main")
    end_window(&state, frame)
    end_frame(&state)
    begin_window_frame(&state, &surface, mouse_event(Mouse_Event{
        position = zoom_point, action = .release, button = .primary,
    }), theme, windows[:])
    frame = begin_window(&state, &windows[0], "Main")
    end_window(&state, frame)
    end_frame(&state)
    testing.expect(test, windows[0].zoomed)
    testing.expect(test, rect_equal(windows[0].restore_bounds, original))

    windows[1].visible = true
    begin_window_frame(
        &state,
        &surface,
        mouse_event(Mouse_Event{
            position = Point{column = 4, row = 4},
            action = .press,
            button = .primary,
            primary_down = true,
        }),
        theme,
        windows[:],
        Rect{row = 1, width = 60, height = 22},
        windows[1].id,
    )
    testing.expect(test, state.active_window == windows[1].id)
    testing.expect(test, state.input_scope == windows[1].id)
    testing.expect(test, state.target_window == windows[1].id)
    end_frame(&state)
}

// test_window_arrangement fixes the reusable desktop policy: ordinary windows
// tile and cascade deterministically, while a fixed dialog retains the exact
// application-selected geometry. Arrangement also converts a zoomed window
// back into an ordinary restorable rectangle.
test_window_arrangement :: proc(test: ^testing.Test) {
    windows := [5]Window_State{
        window_init(70, Rect{column = 1, row = 1, width = 20, height = 8}, 4),
        window_init(71, Rect{column = 3, row = 2, width = 20, height = 8}, 3),
        window_init(72, Rect{column = 5, row = 3, width = 20, height = 8}, 2),
        dialog_window_init(73, Rect{column = 19, row = 8, width = 24, height = 7}, 9),
        tool_window_init(74, Rect{column = 52, row = 2, width = 20, height = 9}, 8),
    }
    windows[0].zoomed = true
    dialog_bounds := windows[3].bounds
    tool_bounds := windows[4].bounds
    desktop := Rect{column = 0, row = 1, width = 80, height = 22}

    testing.expect(test, tile_windows(windows[:], desktop) == 3)
    testing.expect(test, rect_equal(
        windows[0].bounds,
        Rect{column = 0, row = 1, width = 40, height = 11},
    ))
    testing.expect(test, rect_equal(
        windows[1].bounds,
        Rect{column = 40, row = 1, width = 40, height = 11},
    ))
    testing.expect(test, rect_equal(
        windows[2].bounds,
        Rect{column = 0, row = 12, width = 40, height = 11},
    ))
    testing.expect(test, !windows[0].zoomed)
    testing.expect(test, rect_equal(windows[0].restore_bounds, windows[0].bounds))
    testing.expect(test, rect_equal(windows[3].bounds, dialog_bounds))
    testing.expect(test, rect_equal(windows[4].bounds, tool_bounds))

    testing.expect(test, cascade_windows(windows[:], desktop) == 3)
    testing.expect(test, windows[0].bounds.column == 0)
    testing.expect(test, windows[0].bounds.row == 1)
    testing.expect(test, windows[1].bounds.column == 2)
    testing.expect(test, windows[1].bounds.row == 3)
    testing.expect(test, windows[2].bounds.column == 4)
    testing.expect(test, windows[2].bounds.row == 5)
    testing.expect(test, windows[0].bounds.width == 60)
    testing.expect(test, windows[0].bounds.height == 16)
    testing.expect(test, rect_equal(windows[3].bounds, dialog_bounds))
    testing.expect(test, rect_equal(windows[4].bounds, tool_bounds))
}

// submit_test_menu is the deterministic two-pass spelling used by the menu
// interaction test. It mirrors a real app: title before content, popup after.
submit_test_menu :: proc(
    state: ^State,
    menu: ^Menu_State,
    checked: ^bool,
) -> bool {
    menu_bar(state, menu, Rect{width = 40, height = 1})
    menu_title(
        state, menu, 50, 51,
        Rect{column = 1, width = 8, height = 1},
        "File", cast[u8]('f'),
        Rect{column = 1, row = 1, width = 22, height = 6},
    )
    menu_bar_end(state, menu)
    popup := begin_menu(
        state, menu, 50, 51,
        Rect{column = 1, row = 1, width = 22, height = 6},
    )
    menu_action(
        state, menu, &popup, 52, "Open", "Ctrl-O",
        access_key = cast[u8]('o'),
    )
    menu_separator(state, &popup)
    menu_action(
        state, menu, &popup, 53, "Disabled", "Ctrl-D", false,
        access_key = cast[u8]('d'),
    )
    changed := menu_check(
        state, menu, &popup, 54, "Checked", checked,
        access_key = cast[u8]('c'),
    )
    end_menu(state, menu, popup)
    return changed
}

// test_menu_popup_navigation proves title access, separator/disabled skipping,
// checked actions, popup dismissal, and both classic mouse gestures: click a
// title then click an item, or press the title and drag directly to an item.
// Leaving and re-entering the popup preserves the last explicit row until the
// pointer reaches another enabled command.
test_menu_popup_navigation :: proc(test: ^testing.Test) {
    surface: tui.Surface
    tui.surface_init(&surface, 40, 14)
    defer tui.surface_destroy(&surface)
    state: State
    menu: Menu_State
    checked := false
    theme := turbo_theme()

    begin_frame(&state, &surface, key_event(Key_Event{
        code = .character, byte_value = cast[u8]('f'), alt = true,
    }), theme)
    submit_test_menu(&state, &menu, &checked)
    end_frame(&state)
    testing.expect(test, popup_is_open(&state, 51))
    (title_access, title_access_valid) := tui.cell_at(&surface, 2, 0)
    (row_access, row_access_valid) := tui.cell_at(&surface, 4, 2)
    testing.expect(
        test,
        title_access_valid && title_access.value == cast[rune]('F') &&
            title_access.style.underline,
    )
    testing.expect(
        test,
        row_access_valid && row_access.value == cast[rune]('O') &&
            row_access.style.underline,
    )

    // One Down moves from row 0 past separator row 1 and disabled row 2 to the
    // checked action on row 3.
    begin_frame(&state, &surface, key_event(Key_Event{code = .down}), theme)
    submit_test_menu(&state, &menu, &checked)
    end_frame(&state)
    testing.expect(test, menu.highlighted == 3)
    testing.expect(test, needs_repaint(&state))

    begin_frame(&state, &surface, key_event(Key_Event{code = .enter}), theme)
    changed := submit_test_menu(&state, &menu, &checked)
    end_frame(&state)
    testing.expect(test, changed && checked)
    testing.expect(test, state.popup_id == No_Widget)

    // A plain access letter activates the matching enabled row while its menu
    // is open. It does not require the keyboard highlight to reach that row.
    begin_frame(&state, &surface, key_event(Key_Event{
        code = .character, byte_value = cast[u8]('f'), alt = true,
    }), theme)
    submit_test_menu(&state, &menu, &checked)
    end_frame(&state)
    begin_frame(&state, &surface, key_event(Key_Event{
        code = .character, byte_value = cast[u8]('c'),
    }), theme)
    changed = submit_test_menu(&state, &menu, &checked)
    end_frame(&state)
    testing.expect(test, changed && !checked)
    testing.expect(test, state.popup_id == No_Widget)

    begin_frame(&state, &surface, key_event(Key_Event{
        code = .character, byte_value = cast[u8]('f'), alt = true,
    }), theme)
    submit_test_menu(&state, &menu, &checked)
    end_frame(&state)
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 30, row = 10},
        action = .press,
        button = .primary,
        primary_down = true,
    }), theme)
    submit_test_menu(&state, &menu, &checked)
    end_frame(&state)
    testing.expect(test, state.popup_id == No_Widget)

    // A normal click releases on the title and leaves the menu open. Moving
    // outside preserves its last row highlight; moving back selects the exact
    // row under the pointer rather than jumping to row zero.
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 2, row = 0},
        action = .press,
        button = .primary,
        primary_down = true,
    }), theme)
    submit_test_menu(&state, &menu, &checked)
    end_frame(&state)
    testing.expect(test, menu.mouse_tracking && !menu.has_highlight)
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 2, row = 0},
        action = .release,
        button = .primary,
    }), theme)
    submit_test_menu(&state, &menu, &checked)
    end_frame(&state)
    testing.expect(test, popup_is_open(&state, 51))
    testing.expect(test, !menu.mouse_tracking && menu.has_highlight)

    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 30, row = 10},
        action = .move,
    }), theme)
    submit_test_menu(&state, &menu, &checked)
    end_frame(&state)
    testing.expect(test, menu.has_highlight && menu.highlighted == 0)
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 3, row = 5},
        action = .move,
    }), theme)
    submit_test_menu(&state, &menu, &checked)
    end_frame(&state)
    testing.expect(test, menu.has_highlight && menu.highlighted == 3)

    // A disabled row is inert in both behavior and presentation. Moving the
    // pointer over it must preserve the previous enabled selection and must
    // not paint either its label or shortcut using the selected-row style.
    // Testing the shortcut separately catches a partial-row defect where the
    // disabled label remained dim but its right-aligned shortcut reacted.
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 3, row = 4},
        action = .move,
    }), theme)
    submit_test_menu(&state, &menu, &checked)
    end_frame(&state)
    testing.expect(test, menu.has_highlight && menu.highlighted == 3)
    (disabled_label, disabled_label_valid) := tui.cell_at(&surface, 4, 4)
    (disabled_shortcut, disabled_shortcut_valid) := tui.cell_at(&surface, 17, 4)
    testing.expect(
        test,
        disabled_label_valid && disabled_shortcut_valid &&
            disabled_label.style.foreground.index ==
                theme.menu_disabled.foreground.index &&
            disabled_shortcut.style.foreground.index ==
                theme.menu_disabled.foreground.index,
    )

    // Separators are inert menu content. Crossing one keeps the last enabled
    // command selected, including through the no-event traversal a real app
    // may use to publish late interaction-state changes.
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 3, row = 3},
        action = .move,
    }), theme)
    submit_test_menu(&state, &menu, &checked)
    end_frame(&state)
    testing.expect(test, menu.has_highlight && menu.highlighted == 3)
    begin_frame(&state, &surface, no_event(), theme)
    submit_test_menu(&state, &menu, &checked)
    end_frame(&state)
    testing.expect(test, menu.has_highlight && menu.highlighted == 3)

    // One continuous press/drag/release activates the row where the gesture
    // ends. No row-specific active ID is required because the menu owns the
    // complete transient pointer session.
    popup_close(&state)
    menu.open_title = No_Widget
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 2, row = 0},
        action = .press,
        button = .primary,
        primary_down = true,
    }), theme)
    submit_test_menu(&state, &menu, &checked)
    end_frame(&state)
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 3, row = 5},
        action = .move,
        primary_down = true,
    }), theme)
    submit_test_menu(&state, &menu, &checked)
    end_frame(&state)
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 3, row = 5},
        action = .release,
        button = .primary,
    }), theme)
    changed = submit_test_menu(&state, &menu, &checked)
    end_frame(&state)
    testing.expect(test, changed && checked)
    testing.expect(test, state.popup_id == No_Widget)
}

// test_utf8_text_box proves byte-stream assembly, grapheme deletion, bounded
// storage, and immutable-text initialization through only public operations.
test_utf8_text_box :: proc(test: ^testing.Test) {
    surface: tui.Surface
    tui.surface_init(&surface, 30, 6)
    defer tui.surface_destroy(&surface)
    state: State
    field: Text_Box_State
    storage: [8]u8
    testing.expect(test, text_box_set_text(&field, storage[:], "A"))
    state.focused_id = 60
    theme := turbo_theme()
    bounds := Rect{column = 1, row = 1, width = 12, height = 1}

    begin_frame(&state, &surface, key_event(Key_Event{
        code = .character, byte_value = 0xc3,
    }), theme)
    first := text_box(&state, 60, bounds, &field, storage[:])
    end_frame(&state)
    testing.expect(test, !first.changed && field.pending_length == 1)

    begin_frame(&state, &surface, key_event(Key_Event{
        code = .character, byte_value = 0xa9,
    }), theme)
    second := text_box(&state, 60, bounds, &field, storage[:])
    end_frame(&state)
    testing.expect(test, second.changed && field.length == 3)

    begin_frame(&state, &surface, key_event(Key_Event{code = .backspace}), theme)
    third := text_box(&state, 60, bounds, &field, storage[:])
    end_frame(&state)
    testing.expect(test, third.changed && field.length == 1 && field.cursor == 1)

    begin_frame(&state, &surface, text_event("界"), theme)
    fourth := text_box(&state, 60, bounds, &field, storage[:])
    end_frame(&state)
    testing.expect(test, fourth.changed && field.length == 4)
}

// submit_test_combo keeps the field/popup draw order identical across events.
submit_test_combo :: proc(
    state: ^State,
    combo: ^Combo_Box_State,
    selected: ^usize,
) -> bool {
    items := [3]string{"one", "two", "three"}
    combo_box(
        state, combo, 70, 71,
        Rect{column = 2, row = 2, width = 14, height = 1},
        items[:], selected,
    )
    return combo_box_popup(state, combo, 71, items[:], selected)
}

// test_combo_and_dialog_buttons proves the shared popup selection path and the
// default/cancel roles used by modal dialogs.
test_combo_and_dialog_buttons :: proc(test: ^testing.Test) {
    surface: tui.Surface
    tui.surface_init(&surface, 32, 12)
    defer tui.surface_destroy(&surface)
    state: State
    combo: Combo_Box_State
    selected: usize
    state.focused_id = 70
    theme := turbo_theme()

    begin_frame(&state, &surface, key_event(Key_Event{code = .enter}), theme)
    submit_test_combo(&state, &combo, &selected)
    end_frame(&state)
    testing.expect(test, popup_is_open(&state, 71))

    begin_frame(&state, &surface, key_event(Key_Event{code = .down}), theme)
    submit_test_combo(&state, &combo, &selected)
    end_frame(&state)
    begin_frame(&state, &surface, key_event(Key_Event{code = .enter}), theme)
    changed := submit_test_combo(&state, &combo, &selected)
    end_frame(&state)
    testing.expect(test, changed && selected == 1)
    testing.expect(test, state.popup_id == No_Widget)

    begin_frame(&state, &surface, key_event(Key_Event{code = .enter}), theme)
    submit_test_combo(&state, &combo, &selected)
    end_frame(&state)
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 3, row = 6},
        action = .press,
        button = .primary,
        primary_down = true,
    }), theme)
    submit_test_combo(&state, &combo, &selected)
    end_frame(&state)
    begin_frame(&state, &surface, mouse_event(Mouse_Event{
        position = Point{column = 3, row = 6},
        action = .release,
        button = .primary,
    }), theme)
    changed = submit_test_combo(&state, &combo, &selected)
    end_frame(&state)
    testing.expect(test, changed && selected == 2)

    state.focused_id = 80
    begin_frame(&state, &surface, key_event(Key_Event{code = .escape}), theme)
    button(&state, 80, Rect{column = 1, row = 8, width = 8, height = 1}, "OK")
    cancelled := button(
        &state,
        81,
        Rect{column = 10, row = 8, width = 10, height = 1},
        "Cancel",
        true,
        .cancel_action,
    )
    end_frame(&state)
    testing.expect(test, cancelled)
}
