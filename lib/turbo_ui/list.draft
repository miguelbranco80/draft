// Lists separate reusable navigation/viewport policy from application-owned
// row data. list_view handles focus, selection, activation, wheel input, and a
// proportional scrollbar without retaining labels or invoking callbacks. The
// caller then paints only the returned visible rows through list_row_begin;
// string and mutable-byte convenience procedures cover the common one-label
// case. All persistent cursor/offset state remains in List_State.
package turbo_ui

import core/tui

// List_Activation states whether a completed primary click merely selects a
// row, activates it immediately, or waits for a caller-classified double click.
// Enter always activates the selected row. Keeping this explicit lets a file
// browser use conventional double-click activation while a compact action list
// can deliberately activate on one click.
pub List_Activation :: enum u8 {
    enter_only,
    click_and_enter,
    double_click_and_enter,
}

// List_Scrollbar controls only whether an unneeded scrollbar is painted. The
// final column remains reserved in both modes so labels never jump horizontally
// as the model crosses one page; when_needed paints that stable column as empty
// window background until scrolling is possible.
pub List_Scrollbar :: enum u8 {
    always,
    when_needed,
}

// List_State is application-owned persistent state for one logical list.
// cursor is the selected item index; offset is the first visible item. Empty
// lists normalize both fields to zero. The double-click fields retain only the
// first clicked row for this exact list, preventing a physical click pair which
// began in another control from activating it. No field owns item storage, so
// rebuilding a model requires the application to restore semantic selection
// and clear the armed click when index identity moved.
pub List_State :: struct {
    cursor: usize,
    offset: usize,
    double_click_index: usize,
    double_click_armed: bool,
}

// List_View is one frame's interaction and visible-range result. item_bounds
// excludes the reserved scrollbar column. [first, end) is a clamped range in
// the caller's item model. activated_index is meaningful only when activated.
pub List_View :: struct {
    item_bounds: Rect,
    first: usize,
    end: usize,
    cursor: usize,
    item_count: usize,
    selection_changed: bool,
    activated: bool,
    activated_index: usize,
}

// List_Row is the paint contract for one visible model index. bounds is the
// complete row and style already reflects selection. The caller may paint any
// marker, indentation, columns, or byte label inside this rectangle without
// reimplementing navigation or viewport calculations.
pub List_Row :: struct {
    visible: bool,
    selected: bool,
    bounds: Rect,
    style: tui.Style,
}

// keep_list_cursor_visible runs only after selection movement. Scrollbar and
// wheel input intentionally do not call it: a user may inspect rows away from
// the selection without the viewport snapping back.
keep_list_cursor_visible :: proc(model: ^List_State, visible: usize) {
    if visible == 0 {
        return
    }
    if model.cursor < model.offset {
        model.offset = model.cursor
    } else if model.cursor >= model.offset + visible {
        model.offset = model.cursor - visible + 1
    }
}

// list_view performs the complete interaction pass for item_count logical
// rows. body_id and scrollbar_id must be distinct stable IDs. The final column
// is always reserved when width permits, so labels do not jump horizontally
// merely because the model crossed one page. Mouse activation completes on
// release over the same selected row. Double-click activation additionally
// requires the first caller-classified click to have completed on that logical
// row in this list. Keyboard movement keeps selection visible, while wheel and
// scrollbar movement leave selection unchanged.
pub list_view :: proc(
    state: ^State,
    body_id, scrollbar_id: Widget_Id,
    bounds: Rect,
    item_count: usize,
    model: ^List_State,
    activation: List_Activation = .enter_only,
    scrollbar: List_Scrollbar = .always,
) -> List_View {
    assert(state.frame_open, "turbo_ui list outside a frame")
    assert(body_id != No_Widget && scrollbar_id != No_Widget,
        "turbo_ui list IDs must be nonzero")
    assert(body_id != scrollbar_id, "turbo_ui list IDs must be distinct")
    registered := register_focus(state, body_id)
    old_cursor := model.cursor

    item_bounds := bounds
    scrollbar_bounds: Rect
    if item_bounds.width > 1 {
        item_bounds.width -= 1
        scrollbar_bounds = Rect{
            column = item_bounds.column + item_bounds.width,
            row = bounds.row,
            width = 1,
            height = bounds.height,
        }
    }
    if item_count == 0 {
        model.cursor = 0
        model.offset = 0
        model.double_click_armed = false
    } else if model.cursor >= item_count {
        model.cursor = item_count - 1
    }
    maximum := maximum_scroll(item_count, item_bounds.height)
    if model.offset > maximum {
        model.offset = maximum
    }

    result := List_View{
        item_bounds = item_bounds,
        cursor = model.cursor,
        item_count = item_count,
    }
    reaches_items := mouse_reaches_current_scope(state, item_bounds)
    reaches_list := mouse_reaches_current_scope(state, bounds)
    if reaches_items {
        state.hot_id = body_id
    }

    selection_moved := false
    if !state.event_handled && reaches_list && state.event.kind == .mouse &&
        state.event.mouse.action == .wheel && maximum != 0 {
        model.double_click_armed = false
        if state.event.mouse.wheel_delta < 0 {
            scroll_backward(&model.offset, Scroll_Wheel_Rows)
        } else if state.event.mouse.wheel_delta > 0 {
            scroll_forward(&model.offset, maximum, Scroll_Wheel_Rows)
        }
        state.event_handled = true
    } else if !state.event_handled && reaches_items &&
        state.event.kind == .mouse &&
        state.event.mouse.action == .press &&
        state.event.mouse.button == .primary {
        row := state.event.mouse.position.row - item_bounds.row
        index := model.offset + row
        if index < item_count {
            model.cursor = index
            state.focused_id = body_id
            state.active_id = body_id
            state.active_kind = .widget
            state.drag_start.row = index
        }
        state.event_handled = true
    }

    captured := state.active_id == body_id &&
        state.active_kind == .widget && state.event.kind == .mouse
    if captured && state.event.mouse.action == .move &&
        state.event.mouse.primary_down && reaches_items {
        row := state.event.mouse.position.row - item_bounds.row
        index := model.offset + row
        if index < item_count {
            model.cursor = index
        }
        state.event_handled = true
    }
    if captured && state.event.mouse.action == .release &&
        state.event.mouse.button == .primary {
        if reaches_items {
            row := state.event.mouse.position.row - item_bounds.row
            index := model.offset + row
            if index < item_count && index == model.cursor {
                click_activates := activation == .click_and_enter
                if activation == .double_click_and_enter {
                    click_activates = state.event.mouse.click_count >= 2 &&
                        model.double_click_armed &&
                        model.double_click_index == index
                    if state.event.mouse.click_count == 1 {
                        model.double_click_index = index
                        model.double_click_armed = true
                    } else {
                        model.double_click_armed = false
                    }
                }
                if click_activates {
                    result.activated = true
                    result.activated_index = index
                }
            }
        } else if activation == .double_click_and_enter {
            // Releasing a captured press outside the rows cannot complete the
            // list's click pair. Retaining an older arm here could let a later
            // unrelated release activate stale row identity.
            model.double_click_armed = false
        }
        state.active_id = No_Widget
        state.active_kind = .none
        state.event_handled = true
    }

    if registered && !state.event_handled && state.focused_id == body_id &&
        state.event.kind == .key && item_count != 0 {
        key := state.event.key
        switch key.code {
        case .up:
            if model.cursor > 0 {
                model.cursor -= 1
                selection_moved = true
            }
        case .down:
            if model.cursor + 1 < item_count {
                model.cursor += 1
                selection_moved = true
            }
        case .home:
            model.cursor = 0
            selection_moved = true
        case .end:
            model.cursor = item_count - 1
            selection_moved = true
        case .page_up:
            amount := item_bounds.height
            if amount == 0 {
                amount = 1
            }
            scroll_backward(&model.cursor, amount)
            selection_moved = true
        case .page_down:
            amount := item_bounds.height
            if amount == 0 {
                amount = 1
            }
            scroll_forward(&model.cursor, item_count - 1, amount)
            selection_moved = true
        case .enter:
            result.activated = true
            result.activated_index = model.cursor
            model.double_click_armed = false
            state.event_handled = true
        case:
        }
        if selection_moved {
            state.event_handled = true
        }
    }

    if selection_moved {
        model.double_click_armed = false
        keep_list_cursor_visible(model, item_bounds.height)
    }
    scrollbar_needed := item_count > item_bounds.height
    if !rect_empty(scrollbar_bounds) &&
        (scrollbar == .always || scrollbar_needed) {
        // A press anywhere in the compound list, including its scrollbar,
        // gives keyboard focus to the body while the scrollbar retains its
        // own capture ID for drag correctness.
        if reaches_list && state.event.kind == .mouse &&
            state.event.mouse.action == .press &&
            state.event.mouse.button == .primary {
            state.focused_id = body_id
        }
        scrollbar_vertical(
            state,
            scrollbar_id,
            scrollbar_bounds,
            item_count,
            item_bounds.height,
            &model.offset,
        )
    } else if !rect_empty(scrollbar_bounds) {
        fill_rect(
            state.surface,
            state.clip,
            scrollbar_bounds,
            ' ',
            state.theme.window,
        )
    }
    maximum = maximum_scroll(item_count, item_bounds.height)
    if model.offset > maximum {
        model.offset = maximum
    }

    fill_rect(state.surface, state.clip, item_bounds, ' ', state.theme.window)
    result.first = model.offset
    result.end = model.offset + item_bounds.height
    if result.end > item_count {
        result.end = item_count
    }
    result.cursor = model.cursor
    result.selection_changed = model.cursor != old_cursor
    return result
}

// list_row_begin paints one visible row background and returns its geometry and
// style. Calling it for an offscreen or out-of-model index is a harmless empty
// result, which keeps a direct model loop simple during resize transients.
pub list_row_begin :: proc(
    state: ^State,
    view: List_View,
    index: usize,
) -> List_Row {
    result: List_Row
    if index < view.first || index >= view.end || index >= view.item_count {
        return result
    }
    result.visible = true
    result.selected = index == view.cursor
    result.bounds = Rect{
        column = view.item_bounds.column,
        row = view.item_bounds.row + index - view.first,
        width = view.item_bounds.width,
        height = 1,
    }
    result.style = state.theme.text
    if result.selected {
        result.style = state.theme.selected
    }
    fill_rect(state.surface, state.clip, result.bounds, ' ', result.style)
    return result
}

// list_row_text and list_row_bytes are allocation-free one-label convenience
// painters. Rich rows use list_row_begin and paint their own columns directly.
pub list_row_text :: proc(
    state: ^State,
    view: List_View,
    index: usize,
    text: string,
) -> bool {
    row := list_row_begin(state, view, index)
    if !row.visible {
        return true
    }
    return write_clipped(
        state.surface,
        intersect(state.clip, row.bounds),
        Point{column = row.bounds.column, row = row.bounds.row},
        text,
        row.style,
    )
}

pub list_row_bytes :: proc(
    state: ^State,
    view: List_View,
    index: usize,
    text: []u8,
) -> bool {
    row := list_row_begin(state, view, index)
    if !row.visible {
        return true
    }
    return write_clipped_bytes(
        state.surface,
        intersect(state.clip, row.bounds),
        Point{column = row.bounds.column, row = row.bounds.row},
        text,
        row.style,
    )
}

// list is the ordinary borrowed-string convenience form. Applications needing
// markers, indentation, byte labels, or columns call list_view and paint only
// its [first, end) rows with list_row_begin.
pub list :: proc(
    state: ^State,
    body_id, scrollbar_id: Widget_Id,
    bounds: Rect,
    items: []string,
    model: ^List_State,
    activation: List_Activation = .enter_only,
    scrollbar: List_Scrollbar = .always,
) -> List_View {
    result := list_view(
        state,
        body_id,
        scrollbar_id,
        bounds,
        len(items),
        model,
        activation,
        scrollbar,
    )
    for index := result.first; index < result.end; index += 1 {
        list_row_text(state, result, index, items[index])
    }
    return result
}
