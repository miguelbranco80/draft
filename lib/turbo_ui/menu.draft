// Menus are explicit immediate-mode overlays. Menu_State remembers only which
// top-level title is open and which row is highlighted; every title, item,
// label, shortcut, and application value is resubmitted by the caller each
// frame. The popup itself is painted after ordinary windows so a drop-down is
// never clipped by, or hidden behind, the window which opened it.
package turbo_ui

import core/tui

// Menu_State belongs to the application. The first four fields persist between
// frames. has_highlight distinguishes a real selected row from a newly opened
// click-drag menu which has not reached any enabled command; once a row is
// selected, leaving the menu or crossing inert space preserves that row.
// mouse_tracking spans press-title/drag/release and press-item/drag/release
// gestures, allowing a release over a different enabled row to choose that row
// exactly like a classic desktop menu. The remaining fields describe only the
// current menu-bar traversal; menu_bar resets them before the first title and
// menu_bar_end completes any left/right wrap requested by the open menu.
pub Menu_State :: struct {
    open_title: Widget_Id,
    highlighted: usize,
    has_highlight: bool,
    mouse_tracking: bool,

    first_title: Widget_Id,
    first_popup: Widget_Id,
    first_popup_bounds: Rect,
    previous_title: Widget_Id,
    previous_popup: Widget_Id,
    previous_popup_bounds: Rect,
    last_title: Widget_Id,
    last_popup: Widget_Id,
    last_popup_bounds: Rect,
    switch_right: bool,
    wrap_left: bool,
}

// Menu_Context is the balanced drop-down traversal. row includes separators,
// while the enabled-row fields let keyboard movement skip non-actions without
// retaining an item array. original_highlight detects a selection resolved
// after an earlier row painted; end_menu then requests one explicit event-free
// application traversal so visible feedback never waits for another input.
pub Menu_Context :: struct {
    visible: bool,
    popup: Popup_Context,
    row: usize,
    first_enabled: usize,
    last_enabled: usize,
    previous_enabled: usize,
    found_enabled: bool,
    found_highlight: bool,
    moved: bool,
    move: i8,
    home: bool,
    end: bool,
    original_highlight: usize,
    original_has_highlight: bool,
    pointer_event: bool,
    hovered_enabled: bool,
    hovered_separator: bool,
    tracking_release: bool,
    mouse_activated: bool,
}

ascii_lower :: proc(byte: u8) -> u8 {
    if byte >= cast[u8]('A') && byte <= cast[u8]('Z') {
        return byte + (cast[u8]('a') - cast[u8]('A'))
    }
    return byte
}

// paint_menu_label is the title-bar counterpart of paint_label. It keeps the
// generic widget label free of menu policy while painting the title's visible
// access key from the same value used by menu_title's keyboard handling.
paint_menu_label :: proc(
    state: ^State,
    bounds: Rect,
    label_text: string,
    access_key: u8,
    style_value: tui.Style,
) -> bool {
    if !fill_rect(state^.surface, state^.clip, bounds, ' ', style_value) {
        return false
    }
    if bounds.width < 2 || bounds.height == 0 {
        return true
    }
    label_clip := Rect{
        column = bounds.column + 1,
        row = bounds.row,
        width = bounds.width - 2,
        height = 1,
    }
    return write_access_text(
        state^.surface,
        intersect(state^.clip, label_clip),
        Point{column = label_clip.column, row = label_clip.row},
        label_text,
        access_key,
        style_value,
    )
}

open_menu_title :: proc(
    state: ^State,
    menu: ^Menu_State,
    title_id, popup_id: Widget_Id,
    popup_bounds: Rect,
) {
    if popup_open(state, popup_id, popup_bounds) {
        menu^.open_title = title_id
        menu^.highlighted = 0
        menu^.has_highlight = true
    }
}

// menu_bar starts one deterministic title traversal and paints its background.
// Call menu_bar_end after the final title, even when no menu is open.
pub menu_bar :: proc(
    state: ^State,
    menu: ^Menu_State,
    bounds: Rect,
) {
    assert(state^.frame_open, "turbo_ui menu bar outside a frame")
    if menu^.open_title != No_Widget && state^.popup_id == No_Widget {
        menu^.open_title = No_Widget
        menu^.has_highlight = false
        menu^.mouse_tracking = false
    }
    menu^.first_title = No_Widget
    menu^.first_popup = No_Widget
    menu^.previous_title = No_Widget
    menu^.previous_popup = No_Widget
    menu^.last_title = No_Widget
    menu^.last_popup = No_Widget
    menu^.switch_right = false
    menu^.wrap_left = false
    fill_rect(state^.surface, surface_bounds(state^.surface), bounds, ' ', state^.theme.menu)
}

// menu_title opens on a primary press or Alt+access_key and underlines the same
// letter in label_text. While a drop-down is open, moving over another title
// switches menus without first dismissing the popup. Left/Right traverse titles
// and wrap in menu_bar_end. popup_bounds is the complete bordered drop-down
// rectangle, normally immediately below title.
pub menu_title :: proc(
    state: ^State,
    menu: ^Menu_State,
    id, popup_id: Widget_Id,
    bounds: Rect,
    label_text: string,
    access_key: u8,
    popup_bounds: Rect,
) -> bool {
    assert(id != No_Widget && popup_id != No_Widget,
        "turbo_ui menu IDs zero are reserved")
    assert(access_key != 0, "turbo_ui menu title requires an access key")
    if menu^.first_title == No_Widget {
        menu^.first_title = id
        menu^.first_popup = popup_id
        menu^.first_popup_bounds = popup_bounds
    }

    if menu^.switch_right {
        open_menu_title(state, menu, id, popup_id, popup_bounds)
        menu^.switch_right = false
        state^.event_handled = true
    }

    open := menu^.open_title == id && state^.popup_id == popup_id
    hovered := false
    if state^.event.kind == .mouse {
        hovered = point_in_rect(state^.event.mouse.position, bounds)
    }
    modal_blocks := state^.modal_window != No_Widget
    if !modal_blocks && !state^.event_handled && state^.event.kind == .mouse &&
        hovered {
        mouse := state^.event.mouse
        if mouse.action == .press && mouse.button == .primary {
            if open {
                popup_close(state)
                menu^.open_title = No_Widget
                menu^.has_highlight = false
                menu^.mouse_tracking = false
            } else {
                open_menu_title(state, menu, id, popup_id, popup_bounds)
                // A press which opened the title may either become an ordinary
                // click when released on the title or continue directly into
                // the drop-down. Do not preselect row zero while that physical
                // gesture is still choosing a row.
                menu^.has_highlight = false
                menu^.mouse_tracking = true
            }
            state^.event_handled = true
        } else if mouse.action == .move && menu^.open_title != No_Widget && !open {
            open_menu_title(state, menu, id, popup_id, popup_bounds)
            if menu^.mouse_tracking {
                menu^.has_highlight = false
            }
            state^.event_handled = true
        } else if mouse.action == .release && mouse.button == .primary &&
            open && menu^.mouse_tracking {
            // Releasing on the title completes a normal click-to-open. The
            // menu remains open for a later item click; releasing anywhere
            // else is resolved by the drop-down pass below.
            menu^.mouse_tracking = false
            menu^.highlighted = 0
            menu^.has_highlight = true
            state^.event_handled = true
        }
    }
    if !modal_blocks && !state^.event_handled && state^.event.kind == .key {
        key := state^.event.key
        access := key.code == .character && key.alt &&
            ascii_lower(key.byte_value) == ascii_lower(access_key)
        if access {
            if open {
                popup_close(state)
                menu^.open_title = No_Widget
                menu^.has_highlight = false
                menu^.mouse_tracking = false
            } else {
                open_menu_title(state, menu, id, popup_id, popup_bounds)
            }
            state^.event_handled = true
        } else if open && key.code == .right {
            menu^.switch_right = true
        } else if open && key.code == .left {
            if menu^.previous_title != No_Widget {
                open_menu_title(
                    state,
                    menu,
                    menu^.previous_title,
                    menu^.previous_popup,
                    menu^.previous_popup_bounds,
                )
                state^.event_handled = true
            } else {
                menu^.wrap_left = true
            }
        }
    }

    open = menu^.open_title == id && state^.popup_id == popup_id
    style_value := state^.theme.menu
    if open || hovered {
        style_value = state^.theme.menu_selected
    }
    paint_menu_label(state, bounds, label_text, access_key, style_value)

    menu^.previous_title = id
    menu^.previous_popup = popup_id
    menu^.previous_popup_bounds = popup_bounds
    menu^.last_title = id
    menu^.last_popup = popup_id
    menu^.last_popup_bounds = popup_bounds
    return open
}

// menu_bar_end performs only wraparound which cannot be known until the last
// title has been submitted. It must precede ordinary window painting.
pub menu_bar_end :: proc(state: ^State, menu: ^Menu_State) {
    if menu^.switch_right && menu^.first_title != No_Widget {
        open_menu_title(
            state,
            menu,
            menu^.first_title,
            menu^.first_popup,
            menu^.first_popup_bounds,
        )
        state^.event_handled = true
    } else if menu^.wrap_left && menu^.last_title != No_Widget {
        open_menu_title(
            state,
            menu,
            menu^.last_title,
            menu^.last_popup,
            menu^.last_popup_bounds,
        )
        state^.event_handled = true
    }
    menu^.switch_right = false
    menu^.wrap_left = false
}

// begin_menu opens the topmost drop-down and captures navigation keys. Its
// caller submits rows with menu_action/menu_check/menu_radio/menu_separator,
// then calls end_menu. The bounds must match the title's popup_bounds.
pub begin_menu :: proc(
    state: ^State,
    menu: ^Menu_State,
    title_id, popup_id: Widget_Id,
    bounds: Rect,
) -> Menu_Context {
    result: Menu_Context
    result.first_enabled = ~cast[usize](0)
    result.last_enabled = ~cast[usize](0)
    result.previous_enabled = ~cast[usize](0)
    result.original_highlight = menu^.highlighted
    result.original_has_highlight = menu^.has_highlight
    if menu^.open_title != title_id || state^.popup_id != popup_id {
        return result
    }
    result.popup = begin_popup(state, popup_id, bounds)
    if !result.popup.visible {
        if state^.popup_id == No_Widget {
            menu^.open_title = No_Widget
        }
        return result
    }
    result.visible = true
    if state^.event.kind == .mouse && !state^.event_handled {
        mouse := state^.event.mouse
        result.pointer_event = mouse.action == .move ||
            mouse.action == .release
        result.tracking_release = mouse.action == .release &&
            mouse.button == .primary && menu^.mouse_tracking
    }
    if !state^.event_handled && state^.event.kind == .key {
        key := state^.event.key
        if key.code == .down {
            result.move = 1
            state^.event_handled = true
        } else if key.code == .up {
            result.move = -1
            state^.event_handled = true
        } else if key.code == .home {
            result.home = true
            state^.event_handled = true
        } else if key.code == .end {
            result.end = true
            state^.event_handled = true
        }
    }
    return result
}

menu_row :: proc(
    state: ^State,
    menu: ^Menu_State,
    menu_context: ^Menu_Context,
    id: Widget_Id,
    label_text, shortcut: string,
    marker: rune,
    enabled: bool,
    access_key: u8,
) -> bool {
    assert(id != No_Widget, "turbo_ui menu item ID zero is reserved")
    if !menu_context^.visible {
        return false
    }
    index := menu_context^.row
    menu_context^.row += 1
    row_bounds := Rect{
        column = menu_context^.popup.content.column,
        row = menu_context^.popup.content.row + index,
        width = menu_context^.popup.content.width,
        height = 1,
    }
    if index >= menu_context^.popup.content.height {
        return false
    }

    if enabled {
        if !menu_context^.found_enabled {
            menu_context^.first_enabled = index
            menu_context^.found_enabled = true
        }
        menu_context^.last_enabled = index
        if menu_context^.move == 1 && menu_context^.found_highlight &&
            !menu_context^.moved {
            menu^.highlighted = index
            menu_context^.moved = true
        }
        if menu^.has_highlight && menu^.highlighted == index {
            menu_context^.found_highlight = true
            if menu_context^.move == -1 && !menu_context^.moved &&
                menu_context^.previous_enabled != ~cast[usize](0) {
                menu^.highlighted = menu_context^.previous_enabled
                menu_context^.moved = true
            }
        }
        menu_context^.previous_enabled = index
    }

    hovered := mouse_reaches_current_scope(state, row_bounds)
    if hovered && enabled {
        menu^.highlighted = index
        menu^.has_highlight = true
        menu_context^.hovered_enabled = true
        state^.hot_id = id
    }
    selected := enabled && menu^.has_highlight && menu^.highlighted == index
    activated := false
    if enabled && !state^.event_handled && state^.event.kind == .mouse {
        mouse := state^.event.mouse
        if hovered && mouse.action == .press && mouse.button == .primary {
            menu^.mouse_tracking = true
            state^.event_handled = true
        } else if mouse.action == .release && mouse.button == .primary &&
            menu^.mouse_tracking && hovered {
            activated = hovered
            menu^.mouse_tracking = false
            menu_context^.mouse_activated = true
            state^.event_handled = true
        }
    }
    if enabled && selected && !state^.event_handled &&
        state^.event.kind == .key && state^.event.key.code == .enter {
        activated = true
        state^.event_handled = true
    }
    // An open menu accepts the unmodified mnemonic directly. Shift is allowed
    // because terminals commonly report an uppercase byte for Shift+letter;
    // Alt remains reserved for choosing a top-level title and Control remains
    // available to the application's global command shortcuts.
    if enabled && access_key != 0 && !state^.event_handled &&
        state^.event.kind == .key {
        key := state^.event.key
        if key.code == .character && !key.alt && !key.control &&
            ascii_lower(key.byte_value) == ascii_lower(access_key) {
            activated = true
            state^.event_handled = true
        }
    }

    style_value := state^.theme.menu
    if !enabled {
        style_value = state^.theme.menu_disabled
    } else if selected || hovered {
        style_value = state^.theme.menu_selected
    }
    fill_rect(state^.surface, state^.clip, row_bounds, ' ', style_value)
    if marker != cast[rune](0) && row_bounds.width != 0 {
        put_clipped(
            state^.surface,
            state^.clip,
            Point{column = row_bounds.column, row = row_bounds.row},
            marker,
            style_value,
        )
    }
    if row_bounds.width > 2 {
        label_bounds := Rect{
            column = row_bounds.column + 2,
            row = row_bounds.row,
            width = row_bounds.width - 2,
            height = 1,
        }
        write_access_text(
            state^.surface,
            intersect(state^.clip, label_bounds),
            Point{column = label_bounds.column, row = label_bounds.row},
            label_text,
            access_key,
            style_value,
        )
    }
    if len(shortcut) != 0 && len(shortcut) + 1 < row_bounds.width {
        shortcut_bounds := Rect{
            column = rect_right(row_bounds) - len(shortcut),
            row = row_bounds.row,
            width = len(shortcut),
            height = 1,
        }
        shortcut_style := state^.theme.menu_shortcut
        if !enabled {
            shortcut_style = state^.theme.menu_disabled
        } else if selected || hovered {
            shortcut_style = state^.theme.menu_selected
        }
        write_clipped(
            state^.surface,
            intersect(state^.clip, shortcut_bounds),
            Point{column = shortcut_bounds.column, row = shortcut_bounds.row},
            shortcut,
            shortcut_style,
        )
    }
    return activated
}

// menu_action reports activation and closes the menu. access_key zero disables
// a row mnemonic; otherwise it must name one printable ASCII label character,
// which is underlined and activates the row without modifiers while open. The
// procedure performs no callback; the caller executes the operation in the
// surrounding direct control flow.
pub menu_action :: proc(
    state: ^State,
    menu: ^Menu_State,
    menu_context: ^Menu_Context,
    id: Widget_Id,
    label_text: string,
    shortcut: string = "",
    enabled: bool = true,
    access_key: u8 = 0,
) -> bool {
    if !menu_row(
        state, menu, menu_context, id, label_text, shortcut,
        cast[rune](0), enabled, access_key,
    ) {
        return false
    }
    popup_close(state)
    menu^.open_title = No_Widget
    menu^.has_highlight = false
    menu^.mouse_tracking = false
    return true
}

// menu_check toggles one caller-owned boolean and closes after activation. Its
// marker is derived every frame, so external changes appear immediately. Its
// optional access_key has the same visible and keyboard contract as an action.
pub menu_check :: proc(
    state: ^State,
    menu: ^Menu_State,
    menu_context: ^Menu_Context,
    id: Widget_Id,
    label_text: string,
    value: ^bool,
    shortcut: string = "",
    enabled: bool = true,
    access_key: u8 = 0,
) -> bool {
    marker: rune
    if value^ {
        marker = '√'
    }
    if !menu_row(
        state, menu, menu_context, id, label_text, shortcut, marker, enabled,
        access_key,
    ) {
        return false
    }
    value^ = !value^
    popup_close(state)
    menu^.open_title = No_Widget
    menu^.has_highlight = false
    menu^.mouse_tracking = false
    return true
}

// menu_radio assigns one caller-owned choice and closes. The return value is a
// value change, not mere activation; selecting the current choice returns false.
// Its optional access_key has the same visible and keyboard contract as an
// action.
pub menu_radio :: proc(
    state: ^State,
    menu: ^Menu_State,
    menu_context: ^Menu_Context,
    id: Widget_Id,
    label_text: string,
    value: ^usize,
    choice: usize,
    shortcut: string = "",
    enabled: bool = true,
    access_key: u8 = 0,
) -> bool {
    marker: rune
    if value^ == choice {
        marker = '•'
    }
    if !menu_row(
        state, menu, menu_context, id, label_text, shortcut, marker, enabled,
        access_key,
    ) {
        return false
    }
    changed := value^ != choice
    value^ = choice
    popup_close(state)
    menu^.open_title = No_Widget
    menu^.has_highlight = false
    menu^.mouse_tracking = false
    return changed
}

// menu_separator consumes one row but no ID, focus, or action. The horizontal
// rule is clipped to the popup content and naturally survives narrow terminals.
pub menu_separator :: proc(state: ^State, menu_context: ^Menu_Context) {
    if !menu_context^.visible {
        return
    }
    index := menu_context^.row
    menu_context^.row += 1
    if index >= menu_context^.popup.content.height {
        return
    }
    bounds := Rect{
        column = menu_context^.popup.content.column,
        row = menu_context^.popup.content.row + index,
        width = menu_context^.popup.content.width,
        height = 1,
    }
    // A separator is part of the open menu but cannot become its selection.
    // Remembering that distinction prevents end_menu from treating the
    // pointer as outside and clearing the previous command highlight. That
    // clear would trigger a no-event repaint which legitimately initializes
    // keyboard selection at the first row, producing a visible jump to top.
    if menu_context^.pointer_event &&
        mouse_reaches_current_scope(state, bounds) {
        menu_context^.hovered_separator = true
    }
    fill_rect(state^.surface, state^.clip, bounds, '─', state^.theme.menu_disabled)
}

// end_menu completes deferred keyboard wrap/home/end selection and restores
// the scope which was active before the popup overlay was painted.
pub end_menu :: proc(
    state: ^State,
    menu: ^Menu_State,
    menu_context: Menu_Context,
) {
    if !menu_context.visible {
        return
    }
    if menu_context.found_enabled {
        if menu_context.home {
            menu^.highlighted = menu_context.first_enabled
        } else if menu_context.end {
            menu^.highlighted = menu_context.last_enabled
        } else if menu_context.move == 1 && !menu_context.moved {
            menu^.highlighted = menu_context.first_enabled
        } else if menu_context.move == -1 && !menu_context.moved {
            menu^.highlighted = menu_context.last_enabled
        } else if !menu_context.found_highlight &&
            !menu_context.pointer_event && !menu^.mouse_tracking {
            menu^.highlighted = menu_context.first_enabled
            menu^.has_highlight = true
        }
    }
    // Pointer movement over blank space, outside the popup, or across a
    // separator never invents a new row and never discards the last explicit
    // selection. This matches classic desktop menus: the highlight is stable
    // until another enabled item is reached. A tracked release without an
    // enabled activation still cancels the complete gesture; release on the
    // title was consumed in menu_title and never reaches here.
    if menu_context.tracking_release && !menu_context.mouse_activated &&
        !state^.event_handled {
        menu^.mouse_tracking = false
        popup_close(state)
        menu^.open_title = No_Widget
        state^.event_handled = true
    }
    if menu^.highlighted != menu_context.original_highlight ||
        menu^.has_highlight != menu_context.original_has_highlight {
        state^.repaint_requested = true
    }
    end_popup(state, menu_context.popup)
    if state^.popup_id == No_Widget {
        menu^.open_title = No_Widget
    }
}
