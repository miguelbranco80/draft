// draft_compiler is the thin Draft binding to the bootstrap compiler service.
// The service is an explicitly mapped native provider; this package owns no
// native handle implicitly and performs no filesystem discovery of its own.
// Configuration strings are borrowed only during create, while source and
// destination buffers are borrowed only for their synchronous call.
package draft_compiler

import lib/draft_compiler_api

// Target values are a versioned service ABI rather than target facts encoded in
// application code. The compiler service turns the selected value into its
// authoritative TargetProfile.
pub Target :: enum u8 {
    aarch64_macos,
    aarch64_linux,
    x86_64_linux,
    x86_64_windows,
}

// Configuration points at immutable Draft strings for one create call. The
// native service copies and canonicalizes every path before returning. An
// empty root requests deterministic executable-root discovery; an empty source
// selects the first target-qualified package file in bytewise filename order.
// target_is_explicit distinguishes `--target` policy from the host fallback
// which yields to each manifest program target.
pub Configuration :: c struct {
    workspace_data: rawptr,
    workspace_length: usize,
    root_data: rawptr,
    root_length: usize,
    source_data: rawptr,
    source_length: usize,
    target: Target,
    target_is_explicit: u8,
}

foreign draft_compiler_service {
    session_create_raw as "draft_compiler_session_create" :: c proc(
        configuration: ^Configuration,
        error_destination: [^]u8,
        error_capacity: usize,
    ) -> rawptr

    pub session_destroy as "draft_compiler_session_destroy" :: c proc(
        session: rawptr,
    )

    pub open_workspace as "draft_compiler_session_open_workspace" :: c proc(
        session: rawptr,
        path_data: rawptr,
        path_length: usize,
        error_destination: [^]u8,
        error_capacity: usize,
    ) -> u8

    pub copy_workspace_path as "draft_compiler_session_copy_workspace_path" :: c proc(
        session: rawptr,
        destination: [^]u8,
        capacity: usize,
    ) -> usize

    pub check as "draft_compiler_session_check" :: c proc(
        session: rawptr,
        overlays: ^draft_compiler_api.Overlay,
        overlay_count: usize,
        active_overlay: usize,
        result: ^draft_compiler_api.Result,
    )

    pub build as "draft_compiler_session_build" :: c proc(
        session: rawptr,
        overlays: ^draft_compiler_api.Overlay,
        overlay_count: usize,
        active_overlay: usize,
        result: ^draft_compiler_api.Result,
    )

    // colorize runs only the production lexer for one complete buffer. It is
    // intentionally separate from check so an interactive editor does not
    // refresh packages, types, effects, or LLVM products on each keystroke.
    pub colorize as "draft_compiler_session_colorize" :: c proc(
        session: rawptr,
        source: ^draft_compiler_api.Overlay,
        result: ^draft_compiler_api.Syntax_Result,
    )

    pub span as "draft_compiler_session_span" :: c proc(
        session: rawptr,
        index: usize,
        result: ^draft_compiler_api.Span,
    )

    pub copy_diagnostics as "draft_compiler_session_copy_diagnostics" :: c proc(
        session: rawptr,
        destination: [^]u8,
        capacity: usize,
    ) -> usize

    pub diagnostic_row_count as "draft_compiler_session_diagnostic_row_count" :: c proc(
        session: rawptr,
    ) -> usize

    pub diagnostic_row as "draft_compiler_session_diagnostic_row" :: c proc(
        session: rawptr,
        index: usize,
        result: ^draft_compiler_api.Diagnostic_Row,
    )

    pub copy_diagnostic_row_text as "draft_compiler_session_copy_diagnostic_row_text" :: c proc(
