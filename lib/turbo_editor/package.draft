// turbo_editor is the reusable document engine and cell-editor view used by
// DraftIDE. It owns byte buffers, one pathname, a saved-disk baseline, and
// bounded undo history; it borrows turbo_ui frame state only while painting or
// applying one semantic event. It does not own a terminal, renderer, event
// loop, compiler, process, project, or background task.
//
// Text storage preserves exact bytes. Cursor movement follows extended Unicode
// grapheme boundaries when bytes are valid UTF-8 and advances one byte through
// malformed input, while literal tab bytes advance through shared four-column
// display stops. An editor can therefore recover without silently rewriting a
// file. Newlines are LF bytes. Selection endpoints and history ranges are
// zero-based byte offsets in Buffer.bytes and never retain pointers across an
// allocation.
package turbo_editor

import core/array
import core/io
import core/memory
import core/os
import core/unicode
import lib/turbo_ui

Byte_Array :: array.Dynamic[u8]
Line_Array :: array.Dynamic[usize]

History_Limit :: 128
History_Byte_Limit :: 1024 * 1024
File_Read_Chunk :: 16 * 1024
// Literal tab bytes are preserved in Buffer storage and advance to the next
// four-column stop in every visual operation. Keeping this policy beside the
// shared display-step operation prevents painting, cursor placement, mouse
// hit-testing, and vertical movement from assigning different columns.
Tab_Columns :: 4

Edit_Kind :: enum u8 {
    insert,
    delete,
}

// Edit records one primitive forward operation. byte_start/byte_length address
// inserted bytes for insert or removed bytes for delete in the append-only
// history byte pool. before_cursor and after_cursor restore the user-visible
// insertion point for undo/redo. joined_to_previous chains every record after
// the first in one atomic transaction; ordinary replacement uses two records,
// while a generated multi-slot edit may use several insertions. The flag
// occupies existing enum padding, retaining the compact record representation
// used by ordinary edits.
Edit :: struct {
    kind: Edit_Kind,
    joined_to_previous: bool,
    at: usize,
    byte_start: usize,
    byte_length: usize,
    before_cursor: usize,
    after_cursor: usize,
}

// Insertion is one borrowed exact source fragment and its byte offset in the
// unchanged document. insert_at_many interprets the input order as desired
// final order when offsets coincide, derives a safe descending mutation order,
// and retains no slice after returning. This small record lets callers express
// one coherent edit without exposing history representation.
pub Insertion :: struct {
    at: usize,
    source: []u8,
}

Edit_Array :: array.Dynamic[Edit]

pub Load_Result :: enum u8 {
    loaded,
    new_file,
    failed,
}

pub Disk_Result :: enum u8 {
    unchanged,
    reloaded,
    conflict,
    unavailable,
    failed,
}

// Buffer is a move-by-convention owner. bytes contains current exact file
// content; disk_bytes contains the last loaded/saved baseline used by polling.
// line_starts is a sorted, nonempty table in the bytes offset domain: row zero
// starts at byte zero and each later row starts immediately after one LF. Every
// storage mutation updates it in the same operation, so viewport painting and
// cursor lookup never rescan the complete document. history_index partitions
// applied records [0,index) from redo records. The history byte pool is bounded
// by clearing the complete undo/redo history when the next payload would exceed
// its fixed policy; document content is never discarded. path is zero
// terminated for core/os and otherwise exposed only as borrowed bytes.
// read_only identifies compiler-distributed or dependency source whose bytes
// have no writable filesystem authority. Movement and selection remain fully
// available, while every mutating public operation refuses before touching
// content, history, dirty state, or the host filesystem.
pub Buffer :: struct {
    bytes: Byte_Array,
    disk_bytes: Byte_Array,
    line_starts: Line_Array,
    history: Edit_Array,
    history_bytes: Byte_Array,
    history_index: usize,
    path: memory.Owned_String,

    cursor: usize,
    anchor: usize,
    selection_active: bool,
    // preferred_column preserves the visual column across a vertical run, even
    // when an intermediate short line clamps the cursor. Any horizontal/edit
    // operation clears preferred_column_valid. reveal_cursor asks the next
    // editor view to scroll to a programmatically moved cursor; deliberate
    // wheel scrolling leaves it false so the viewport does not snap back.
    preferred_column: usize,
    preferred_column_valid: bool,
    reveal_cursor: bool,
    scroll_line: usize,
    scroll_column: usize,
    dirty: bool,
    disk_conflict: bool,
    read_only: bool,
    // unnamed distinguishes a new in-memory document's display label from a
    // filesystem pathname. Ordinary Save must not accidentally create a file
    // named after that label; Save As installs the first real path.
    unnamed: bool,
}

pub buffer_init :: proc(buffer: ^Buffer, path: string) {
    array.init(&buffer.bytes)
    array.init(&buffer.disk_bytes)
    array.init(&buffer.line_starts)
    array.append(&buffer.line_starts, 0)
    array.init(&buffer.history)
    array.init(&buffer.history_bytes)
    memory.owned_string_copy(&buffer.path, path)
}

// buffer_init_bytes is the C/host boundary counterpart. The exact pathname is
// copied before the caller's view expires and receives the same owned
// terminator as the ordinary string form.
pub buffer_init_bytes :: proc(buffer: ^Buffer, path: []u8) {
    array.init(&buffer.bytes)
    array.init(&buffer.disk_bytes)
    array.init(&buffer.line_starts)
    array.append(&buffer.line_starts, 0)
    array.init(&buffer.history)
    array.init(&buffer.history_bytes)
    memory.owned_string_copy_bytes(&buffer.path, path)
}

// buffer_init_unnamed creates an empty writable document whose borrowed label
// is used only for window and open-document navigation. The document begins
// dirty so Exit cannot discard it silently even before the first typed byte.
pub buffer_init_unnamed :: proc(buffer: ^Buffer, label: []u8) {
    buffer_init_bytes(buffer, label)
    buffer.unnamed = true
    buffer.dirty = true
}

// buffer_init_read_only_bytes constructs a complete clean buffer from bytes
// supplied by a compiler/source service. Both pathname and content are copied
// before the host call returns. The disk baseline deliberately mirrors content
// even though no disk operations are permitted, preserving ordinary dirty and
// comparison invariants for the shared editor view.
pub buffer_init_read_only_bytes :: proc(
    buffer: ^Buffer,
    path, source: []u8,
) {
    buffer_init_bytes(buffer, path)
    copy_bytes(&buffer.bytes, source)
    copy_bytes(&buffer.disk_bytes, source)
    rebuild_line_starts(buffer)
    buffer.read_only = true
}

pub buffer_destroy :: proc(buffer: ^Buffer) {
    memory.owned_string_destroy(&buffer.path)
    array.destroy(&buffer.history_bytes)
    array.destroy(&buffer.history)
    array.destroy(&buffer.line_starts)
    array.destroy(&buffer.disk_bytes)
    array.destroy(&buffer.bytes)
}

pub path_bytes :: proc(buffer: ^Buffer) -> []u8 {
    return memory.owned_string_bytes(&buffer.path)
}

pub content :: proc(buffer: ^Buffer) -> []u8 {
    return array.view(&buffer.bytes)
}

pub is_read_only :: proc(buffer: ^Buffer) -> bool {
    return buffer.read_only
}

pub is_unnamed :: proc(buffer: ^Buffer) -> bool {
    return buffer.unnamed
}

// can_undo/can_redo expose only history availability, not the history records
// themselves. Menus can therefore present an honest disabled state while all
// mutation and bounded-history invariants remain owned by undo/redo below.
pub can_undo :: proc(buffer: ^Buffer) -> bool {
    return !buffer.read_only && buffer.history_index != 0
}

pub can_redo :: proc(buffer: ^Buffer) -> bool {
    return !buffer.read_only && buffer.history_index < buffer.history.length
}

// can_delete reports whether Delete can change bytes under the current cursor
// or selection. It deliberately does not consider Backspace, whose boundary is
// different and is invoked directly from the editor key path.
pub can_delete :: proc(buffer: ^Buffer) -> bool {
    if buffer.read_only {
        return false
    }
    (_, _, selected) := selection(buffer)
    return selected || buffer.cursor < buffer.bytes.length
}

clear_history :: proc(buffer: ^Buffer) {
    array.clear(&buffer.history)
    array.clear(&buffer.history_bytes)
    buffer.history_index = 0
}

copy_bytes :: proc(destination: ^Byte_Array, source: []u8) {
    array.clear(destination)
    array.reserve(destination, len(source))
    for byte in source {
        array.append(destination, byte)
    }
}

// rebuild_line_starts establishes the exact offset table after a complete file
// replacement. Incremental edits use the narrower update operations below;
// full rebuild belongs only to load/reload where every source byte changed at
// once and is already being copied.
rebuild_line_starts :: proc(buffer: ^Buffer) {
    array.clear(&buffer.line_starts)
    array.append(&buffer.line_starts, 0)
    for index: usize = 0; index < buffer.bytes.length; index += 1 {
        if buffer.bytes.data[index] == cast[u8]('\n') {
            array.append(&buffer.line_starts, index + 1)
        }
    }
}

// line_for_offset returns the greatest line-start index not exceeding offset.
// Buffer mutations maintain a nonempty sorted table and every public caller
// supplies an offset at or before bytes.length, making binary search exact.
line_for_offset :: proc(buffer: ^Buffer, offset: usize) -> usize {
    assert(buffer.line_starts.length != 0,
        "editor line index must contain row zero")
    assert(offset <= buffer.bytes.length,
        "editor line lookup offset is invalid")
    lower: usize
    upper := buffer.line_starts.length
    for lower < upper {
        middle := lower + (upper - lower) / 2
        if buffer.line_starts.data[middle] <= offset {
            lower = middle + 1
        } else {
            upper = middle
        }
    }
    return lower - 1
}

// insert_line_starts updates only the line table suffix affected by one byte
// insertion. Existing starts after at shift by source length; one new start is
// inserted for each LF in source. Equal-at starts remain before the inserted
// rows, which is correct when bytes are inserted at the beginning of a line.
insert_line_starts :: proc(buffer: ^Buffer, at: usize, source: []u8) {
    newline_count: usize
    for byte in source {
        if byte == cast[u8]('\n') {
            newline_count += 1
        }
    }
    first_shifted := line_for_offset(buffer, at) + 1
    old_length := buffer.line_starts.length
    array.reserve(&buffer.line_starts, old_length + newline_count)
    buffer.line_starts.length = old_length + newline_count

    cursor := old_length
    for cursor > first_shifted {
        cursor -= 1
        buffer.line_starts.data[cursor + newline_count] =
            buffer.line_starts.data[cursor] + len(source)
    }
    inserted: usize
    for index: usize = 0; index < len(source); index += 1 {
        if source[index] == cast[u8]('\n') {
            buffer.line_starts.data[first_shifted + inserted] = at + index + 1
            inserted += 1
        }
    }
    assert(inserted == newline_count,
        "editor inserted line count must match its source scan")
}

// delete_line_starts removes row starts created by LF bytes in [at,end) and
// shifts every surviving later row backward. A row start equal to at belongs
// to an earlier newline and survives; one equal to end belongs to the final
// removed newline and is deleted.
delete_line_starts :: proc(buffer: ^Buffer, at, count: usize) {
    if count == 0 {
        return
    }
    end := at + count
    first_removed := line_for_offset(buffer, at) + 1
    after_removed := first_removed
    for after_removed < buffer.line_starts.length &&
        buffer.line_starts.data[after_removed] <= end {
        after_removed += 1
    }
    removed := after_removed - first_removed
    destination := first_removed
    for source := after_removed;
        source < buffer.line_starts.length;
        source += 1 {
        buffer.line_starts.data[destination] =
            buffer.line_starts.data[source] - count
        destination += 1
    }
    old_length := buffer.line_starts.length
    buffer.line_starts.length -= removed
    for index := buffer.line_starts.length; index < old_length; index += 1 {
        buffer.line_starts.data[index] = 0
    }
}

bytes_equal :: proc(left, right: []u8) -> bool {
    if len(left) != len(right) {
        return false
    }
    for index: usize = 0; index < len(left); index += 1 {
        if left[index] != right[index] {
            return false
        }
    }
    return true
}

// read_path replaces destination only after a complete successful read and
// close. unavailable identifies an absent/unopenable pathname; a later read or
// close failure is failed because partial bytes must never become authoritative.
read_path :: proc(path: cstring, destination: ^Byte_Array) -> Load_Result {
    (handle, open_error) := os.open_for_reading(path)
    if open_error != .none {
        return .new_file
    }
    scratch: Byte_Array
    array.init(&scratch)
    storage: [File_Read_Chunk]u8
    result: Load_Result = .loaded
    for {
        (count, error) := os.read(handle, storage[:])
        if error == .end_of_input {
            break
        }
        if error != .none {
            result = .failed
            break
        }
        for index: usize = 0; index < count; index += 1 {
            array.append(&scratch, storage[index])
        }
    }
    closed := os.close(&handle)
    if !closed {
        result = .failed
    }
    if result == .loaded {
        copy_bytes(destination, array.view(&scratch))
    }
    array.destroy(&scratch)
    return result
}

pub load :: proc(buffer: ^Buffer) -> Load_Result {
    if buffer.read_only {
        return .failed
    }
    result := read_path(
        memory.owned_string_cstring(&buffer.path),
        &buffer.bytes,
    )
    if result == .failed {
        return result
    }
    if result == .new_file {
        array.clear(&buffer.bytes)
    }
    rebuild_line_starts(buffer)
    copy_bytes(&buffer.disk_bytes, array.view(&buffer.bytes))
    clear_history(buffer)
    buffer.cursor = 0
    buffer.anchor = 0
    buffer.selection_active = false
    buffer.preferred_column_valid = false
    buffer.reveal_cursor = true
    buffer.scroll_line = 0
    buffer.scroll_column = 0
    buffer.dirty = false
    buffer.disk_conflict = false
    return result
}

// save refuses to overwrite a disk version observed after local edits unless
// the caller carries an explicit user decision through overwrite_conflict.
// Successful publication replaces the saved baseline and clears both dirty and
// conflict state; partial write or close failure preserves the owning buffer.
pub save :: proc(
    buffer: ^Buffer,
    overwrite_conflict: bool = false,
) -> bool {
    if buffer.read_only || buffer.unnamed {
        return false
    }
    if buffer.disk_conflict && !overwrite_conflict {
        return false
    }
    (handle, error) := os.create_for_writing(
        memory.owned_string_cstring(&buffer.path),
    )
    if error != .none {
        return false
    }
    written := os.write_all(handle, array.view(&buffer.bytes)) == .none
    closed := os.close(&handle)
    if !written || !closed {
        return false
    }
    copy_bytes(&buffer.disk_bytes, array.view(&buffer.bytes))
    buffer.dirty = false
    buffer.disk_conflict = false
    return true
}

// save_as writes the complete document to a caller-selected path and only then
// replaces the Buffer's owned pathname. A failed open/write/close leaves the
// editor's old path, dirty bytes, history, and disk baseline untouched; the OS
// may still have created or partly written the requested destination because
// core/os does not yet expose a same-directory temporary-file replacement.
// Entering a path in the explicit Save As dialog is the overwrite authority;
// this layer does not add a second confirmation policy.
pub save_as :: proc(buffer: ^Buffer, path: []u8) -> bool {
    if buffer.read_only || len(path) == 0 {
        return false
    }
    replacement: memory.Owned_String
    memory.owned_string_copy_bytes(&replacement, path)
    (handle, error) := os.create_for_writing(
        memory.owned_string_cstring(&replacement),
    )
    if error != .none {
        memory.owned_string_destroy(&replacement)
        return false
    }
    written := os.write_all(handle, array.view(&buffer.bytes)) == .none
    closed := os.close(&handle)
    if !written || !closed {
        memory.owned_string_destroy(&replacement)
        return false
    }
    memory.owned_string_destroy(&buffer.path)
    buffer.path = replacement
    copy_bytes(&buffer.disk_bytes, array.view(&buffer.bytes))
    buffer.dirty = false
    buffer.disk_conflict = false
    buffer.unnamed = false
    return true
}

// poll_disk compares exact content rather than depending on a missing metadata
// API. A changed baseline reloads only a clean buffer. Dirty content is retained
// and marked conflicted for explicit user resolution; no automatic merge or
// overwrite occurs.
pub poll_disk :: proc(buffer: ^Buffer) -> Disk_Result {
    if buffer.read_only {
        return .unchanged
    }
    observed: Byte_Array
    array.init(&observed)
    result := read_path(
        memory.owned_string_cstring(&buffer.path),
        &observed,
    )
    if result == .new_file {
        array.destroy(&observed)
        return .unavailable
    }
    if result == .failed {
        array.destroy(&observed)
        return .failed
    }
    if bytes_equal(array.view(&observed), array.view(&buffer.disk_bytes)) {
        array.destroy(&observed)
        return .unchanged
    }
    if buffer.dirty {
        buffer.disk_conflict = true
        array.destroy(&observed)
        return .conflict
    }
    copy_bytes(&buffer.bytes, array.view(&observed))
    copy_bytes(&buffer.disk_bytes, array.view(&observed))
    rebuild_line_starts(buffer)
    array.destroy(&observed)
    clear_history(buffer)
    if buffer.cursor > buffer.bytes.length {
        buffer.cursor = buffer.bytes.length
    }
    buffer.selection_active = false
    buffer.preferred_column_valid = false
    buffer.reveal_cursor = true
    buffer.disk_conflict = false
    return .reloaded
}

// insert_raw and delete_raw are the only storage mutations. They do not touch
// history, selection, cursor, or dirty state and are therefore safe for the
// inverse operations used by undo/redo.
insert_raw :: proc(buffer: ^Buffer, at: usize, source: []u8) {
    assert(at <= buffer.bytes.length, "editor insertion offset is invalid")
    assert(len(source) <= ~cast[usize](0) - buffer.bytes.length,
        "editor byte length overflows")
    insert_line_starts(buffer, at, source)
    old_length := buffer.bytes.length
    array.reserve(&buffer.bytes, old_length + len(source))
    buffer.bytes.length = old_length + len(source)
    cursor := old_length
    for cursor > at {
        cursor -= 1
        buffer.bytes.data[cursor + len(source)] = buffer.bytes.data[cursor]
    }
    for index: usize = 0; index < len(source); index += 1 {
        buffer.bytes.data[at + index] = source[index]
    }
}

delete_raw :: proc(buffer: ^Buffer, at, count: usize) {
    assert(at <= buffer.bytes.length &&
        count <= buffer.bytes.length - at,
        "editor deletion range is invalid")
    delete_line_starts(buffer, at, count)
    old_length := buffer.bytes.length
    for index := at; index + count < old_length; index += 1 {
        buffer.bytes.data[index] = buffer.bytes.data[index + count]
    }
    buffer.bytes.length -= count
    for index := buffer.bytes.length; index < old_length; index += 1 {
        buffer.bytes.data[index] = 0
    }
}

// prepare_history_append discards redo records and guarantees room for one
// atomic record. Crossing the aggregate record/byte bound clears prior history;
// a payload larger than the complete byte policy is rejected without changing
// existing history. Replace uses that rejection to avoid applying an operation
// which could not satisfy its one-step undo contract.
prepare_history_append :: proc(
    buffer: ^Buffer,
    payload_size, record_count: usize,
) -> bool {
    if payload_size > History_Byte_Limit || record_count > History_Limit {
        return false
    }
    for index := buffer.history_index; index < buffer.history.length; index += 1 {
        empty: Edit
        buffer.history.data[index] = empty
    }
    buffer.history.length = buffer.history_index

    exceeds_records := buffer.history.length > History_Limit - record_count
    exceeds_bytes := buffer.history_bytes.length >
        History_Byte_Limit - payload_size
    if exceeds_records || exceeds_bytes {
        clear_history(buffer)
    }
    return true
}

append_history_bytes :: proc(buffer: ^Buffer, source: []u8) -> usize {
    start := buffer.history_bytes.length
    for byte in source {
        array.append(&buffer.history_bytes, byte)
    }
    return start
}

// record_edit stores the single payload used by insert/delete. False means the
// payload cannot fit the complete bounded history. Ordinary typing deliberately
// retains its historical behavior by ignoring that result and still applying
// the edit after history is cleared; callers promising one-step undo, such as
// an agent expansion, must refuse the source mutation instead.
record_edit :: proc(
    buffer: ^Buffer,
    kind: Edit_Kind,
    at: usize,
    source: []u8,
    before_cursor, after_cursor: usize,
) -> bool {
    if !prepare_history_append(buffer, len(source), 1) {
        clear_history(buffer)
        return false
    }
    start := append_history_bytes(buffer, source)
    array.append(&buffer.history, Edit{
        kind = kind,
        at = at,
        byte_start = start,
        byte_length = len(source),
        before_cursor = before_cursor,
        after_cursor = after_cursor,
    })
    buffer.history_index = buffer.history.length
    return true
}

// record_replace stores old and replacement bytes in one joined record pair. The caller
// must not mutate Buffer until this succeeds: false means the combined payload
// or two-record group exceeds the explicit history limit and the atomic
// operation must be refused.
record_replace :: proc(
    buffer: ^Buffer,
    at: usize,
    old, replacement: []u8,
    before_cursor, after_cursor: usize,
) -> bool {
    if len(old) > ~cast[usize](0) - len(replacement) {
        return false
    }
    if !prepare_history_append(buffer, len(old) + len(replacement), 2) {
        return false
    }
    old_start := append_history_bytes(buffer, old)
    replacement_start := append_history_bytes(buffer, replacement)
    array.append(&buffer.history, Edit{
        kind = .delete,
        at = at,
        byte_start = old_start,
        byte_length = len(old),
        before_cursor = before_cursor,
        after_cursor = at,
    })
    array.append(&buffer.history, Edit{
        kind = .insert,
        joined_to_previous = true,
        at = at,
        byte_start = replacement_start,
        byte_length = len(replacement),
        before_cursor = at,
        after_cursor = after_cursor,
    })
    buffer.history_index = buffer.history.length
    return true
}

pub selection :: proc(buffer: ^Buffer) -> (usize, usize, bool) {
    if !buffer.selection_active || buffer.anchor == buffer.cursor {
        return (buffer.cursor, buffer.cursor, false)
    }
    if buffer.anchor < buffer.cursor {
        return (buffer.anchor, buffer.cursor, true)
    }
    return (buffer.cursor, buffer.anchor, true)
}

pub clear_selection :: proc(buffer: ^Buffer) {
    buffer.anchor = buffer.cursor
    buffer.selection_active = false
}

// select_all uses the same anchor/cursor representation as Shift movement.
// Empty documents intentionally have no active selection while still placing
// both endpoints at byte zero.
pub select_all :: proc(buffer: ^Buffer) {
    buffer.anchor = 0
    buffer.cursor = buffer.bytes.length
    buffer.selection_active = buffer.bytes.length != 0
    buffer.preferred_column_valid = false
    buffer.reveal_cursor = true
}

delete_range :: proc(buffer: ^Buffer, start, end: usize) {
    if end <= start {
        return
    }
    before := buffer.cursor
    deleted := cast[[^]u8](&buffer.bytes.data[start])
    _ = record_edit(
        buffer,
        .delete,
        start,
        deleted[:end - start],
        before,
        start,
    )
    delete_raw(buffer, start, end - start)
    buffer.cursor = start
    clear_selection(buffer)
    buffer.preferred_column_valid = false
    buffer.reveal_cursor = true
    buffer.dirty = true
}

pub delete_selection :: proc(buffer: ^Buffer) -> bool {
    if buffer.read_only {
        return false
    }
    (start, end, selected) := selection(buffer)
    if !selected {
        return false
    }
    delete_range(buffer, start, end)
    return true
}

pub insert :: proc(buffer: ^Buffer, source: []u8) {
    if buffer.read_only {
        return
    }
    delete_selection(buffer)
    if len(source) == 0 {
        return
    }
    before := buffer.cursor
    _ = record_edit(
        buffer,
        .insert,
        buffer.cursor,
        source,
        before,
        before + len(source),
    )
    insert_raw(buffer, buffer.cursor, source)
    buffer.cursor += len(source)
    clear_selection(buffer)
    buffer.preferred_column_valid = false
    buffer.reveal_cursor = true
    buffer.dirty = true
}

// insert_at performs one exact insertion without interpreting the current
// selection as replacement. The operation succeeds only when its complete
// payload can be retained as one undo record; false leaves content, cursor,
// selection, dirty state, and existing history unchanged. This is the editor's
// transaction boundary for externally generated source whose defining UX is
// ordinary Ctrl-Z rather than a parallel accept/reject mechanism.
pub insert_at :: proc(buffer: ^Buffer, at: usize, source: []u8) -> bool {
    if at > buffer.bytes.length || len(source) == 0 ||
        len(source) > ~cast[usize](0) - at {
        return false
    }
    insertions := [1]Insertion{Insertion{at = at, source = source}}
    return insert_at_many(buffer, insertions[:], at + len(source))
}

// insert_at_many applies zero-width insertions against one unchanged source as
// a single bounded undo transaction. Empty rows are ignored. Nonempty rows may
// appear in any offset order; a local fixed index table produces descending
// mutation order so every supplied offset remains valid. Equal offsets are
// applied in reverse input order, making the input order the final byte order.
//
// The complete operation is validated and recorded before content mutation.
// false therefore preserves content, cursor, selection, dirty state, redo, and
// prior history. cursor_after is an exact byte offset in the final document and
// becomes the one redo cursor for the whole transaction.
pub insert_at_many :: proc(
    buffer: ^Buffer,
    insertions: []Insertion,
    cursor_after: usize,
) -> bool {
    if buffer.read_only || len(insertions) == 0 ||
        len(insertions) > History_Limit {
        return false
    }
    order: [History_Limit]usize
    count: usize
    total: usize
    for index: usize = 0; index < len(insertions); index += 1 {
        insertion := insertions[index]
        if len(insertion.source) == 0 {
            continue
        }
        if insertion.at > buffer.bytes.length ||
            len(insertion.source) > History_Byte_Limit - total ||
            len(insertion.source) > ~cast[usize](0) - buffer.bytes.length - total {
            return false
        }
        total += len(insertion.source)

        // Descending offsets preserve the unchanged-source coordinate system.
        // For equal offsets, the later requested fragment is applied first so
        // repeated insertion at that offset leaves earlier input bytes first.
        position := count
        for position > 0 {
            previous_index := order[position - 1]
            previous := insertions[previous_index]
            comes_before := insertion.at > previous.at ||
                (insertion.at == previous.at && index > previous_index)
            if !comes_before {
                break
            }
            order[position] = previous_index
            position -= 1
        }
        order[position] = index
        count += 1
    }
    if count == 0 || cursor_after > buffer.bytes.length + total {
        return false
    }

    before_cursor := buffer.cursor
    if !prepare_history_append(buffer, total, count) {
        return false
    }
    for order_index: usize = 0; order_index < count; order_index += 1 {
        insertion := insertions[order[order_index]]
        byte_start := append_history_bytes(buffer, insertion.source)
        array.append(&buffer.history, Edit{
            kind = .insert,
            joined_to_previous = order_index != 0,
            at = insertion.at,
            byte_start = byte_start,
            byte_length = len(insertion.source),
            before_cursor = before_cursor if order_index == 0 else 0,
            after_cursor = cursor_after if order_index + 1 == count else 0,
        })
    }
    buffer.history_index = buffer.history.length

    for order_index: usize = 0; order_index < count; order_index += 1 {
        insertion := insertions[order[order_index]]
        insert_raw(buffer, insertion.at, insertion.source)
    }
    buffer.cursor = cursor_after
    clear_selection(buffer)
    buffer.preferred_column_valid = false
    buffer.reveal_cursor = true
    buffer.dirty = true
    return true
}

// replace_document installs one externally produced complete file as one
// bounded undo transaction. source is borrowed only for this call and must not
// alias Buffer storage because the operation deletes the old bytes before it
// inserts the replacement. The old-plus-new payload must fit the common history
// byte policy; false leaves content, cursor, selection, dirty state, redo, and
// prior history unchanged. An identical source is a successful no-op which
// updates only the transient cursor/selection presentation and creates no
// history record.
pub replace_document :: proc(
    buffer: ^Buffer,
    source: []u8,
    cursor_after: usize,
) -> bool {
    if buffer.read_only || cursor_after > len(source) {
        return false
    }
    old := array.view(&buffer.bytes)
    if bytes_equal(old, source) {
        buffer.cursor = cursor_after
        clear_selection(buffer)
        buffer.preferred_column_valid = false
        buffer.reveal_cursor = true
        return true
    }
    before_cursor := buffer.cursor
    if !record_replace(
        buffer,
        0,
        old,
        source,
        before_cursor,
        cursor_after,
    ) {
        return false
    }
    old_length := buffer.bytes.length
    delete_raw(buffer, 0, old_length)
    if len(source) != 0 {
        insert_raw(buffer, 0, source)
    }
    buffer.cursor = cursor_after
    clear_selection(buffer)
    buffer.preferred_column_valid = false
    buffer.reveal_cursor = true
    buffer.dirty = true
    return true
}

// insert_text is the immutable-string adapter for paste/IME events. The
// temporary array exists only because Draft 1 intentionally has no implicit
// string-to-mutable-byte view; insert still owns the one history/mutation rule.
pub insert_text :: proc(buffer: ^Buffer, text: string) {
    temporary: Byte_Array
    array.init(&temporary)
    array.reserve(&temporary, len(text))
    for index: usize = 0; index < len(text); index += 1 {
        array.append(&temporary, text[index])
    }
    insert(buffer, array.view(&temporary))
    array.destroy(&temporary)
}

line_start :: proc(buffer: ^Buffer, offset: usize) -> usize {
    return buffer.line_starts.data[line_for_offset(buffer, offset)]
}

line_end :: proc(buffer: ^Buffer, offset: usize) -> usize {
    line := line_for_offset(buffer, offset)
    if line + 1 < buffer.line_starts.length {
        return buffer.line_starts.data[line + 1] - 1
    }
    return buffer.bytes.length
}

previous_grapheme :: proc(buffer: ^Buffer, offset: usize) -> usize {
    start := line_start(buffer, offset)
    previous := start
    cursor := start
    bytes := array.view(&buffer.bytes)
    for cursor < offset {
        previous = cursor
        (end, _, _) := unicode.next_grapheme_bytes(bytes, cursor)
        if end <= cursor || end >= offset {
            return previous
        }
        cursor = end
    }
    return previous
}

// previous_text_unit is the reverse counterpart to next_grapheme over the
// complete document. previous_grapheme intentionally scans only one line;
// this wrapper exposes the intervening LF as its own one-byte unit so word and
// ordinary cursor navigation can cross row boundaries without rescanning.
previous_text_unit :: proc(buffer: ^Buffer, offset: usize) -> usize {
    if offset == 0 {
        return 0
    }
    if buffer.bytes.data[offset - 1] == cast[u8]('\n') {
        return offset - 1
    }
    return previous_grapheme(buffer, offset)
}

next_grapheme :: proc(buffer: ^Buffer, offset: usize) -> usize {
    if offset >= buffer.bytes.length {
        return buffer.bytes.length
    }
    if buffer.bytes.data[offset] == cast[u8]('\n') {
        return offset + 1
    }
    (end, _, _) := unicode.next_grapheme_bytes(
        array.view(&buffer.bytes),
        offset,
    )
    if end <= offset {
        return offset + 1
    }
    return end
}

prepare_movement :: proc(buffer: ^Buffer, old_cursor: usize, extend: bool) {
    if extend {
        if !buffer.selection_active {
            buffer.anchor = old_cursor
            buffer.selection_active = true
        }
    } else {
        clear_selection(buffer)
    }
    buffer.reveal_cursor = true
}

pub move_left :: proc(buffer: ^Buffer, extend: bool = false) {
    old := buffer.cursor
    if buffer.cursor > 0 {
        if buffer.bytes.data[buffer.cursor - 1] == cast[u8]('\n') {
            buffer.cursor -= 1
        } else {
            buffer.cursor = previous_grapheme(buffer, buffer.cursor)
        }
    }
    prepare_movement(buffer, old, extend)
    buffer.preferred_column_valid = false
}

pub move_right :: proc(buffer: ^Buffer, extend: bool = false) {
    old := buffer.cursor
    buffer.cursor = next_grapheme(buffer, buffer.cursor)
    prepare_movement(buffer, old, extend)
    buffer.preferred_column_valid = false
}

pub move_home :: proc(buffer: ^Buffer, extend: bool = false) {
    old := buffer.cursor
    buffer.cursor = line_start(buffer, buffer.cursor)
    prepare_movement(buffer, old, extend)
    buffer.preferred_column_valid = false
}

pub move_end :: proc(buffer: ^Buffer, extend: bool = false) {
    old := buffer.cursor
    buffer.cursor = line_end(buffer, buffer.cursor)
    prepare_movement(buffer, old, extend)
    buffer.preferred_column_valid = false
}

// word_byte follows Draft's source identifier vocabulary: ASCII letters,
// digits, and underscore are one word class. Every other grapheme is a
// separator for navigation. Draft identifiers are deliberately ASCII, so this
// policy is predictable even when comments and strings contain UTF-8 text.
word_byte :: proc(byte: u8) -> bool {
    return (byte >= cast[u8]('a') && byte <= cast[u8]('z')) ||
        (byte >= cast[u8]('A') && byte <= cast[u8]('Z')) ||
        (byte >= cast[u8]('0') && byte <= cast[u8]('9')) ||
        byte == cast[u8]('_')
}

// move_word_left skips separators, then the preceding ASCII source word. The
// grapheme helpers ensure malformed/non-ASCII input is crossed only at safe
// recovery boundaries and always makes progress.
pub move_word_left :: proc(buffer: ^Buffer, extend: bool = false) {
    old := buffer.cursor
    cursor := buffer.cursor
    for cursor > 0 {
        previous := previous_text_unit(buffer, cursor)
        if word_byte(buffer.bytes.data[previous]) {
            break
        }
        cursor = previous
    }
    for cursor > 0 {
        previous := previous_text_unit(buffer, cursor)
        if !word_byte(buffer.bytes.data[previous]) {
            break
        }
        cursor = previous
    }
    buffer.cursor = cursor
    prepare_movement(buffer, old, extend)
    buffer.preferred_column_valid = false
}

// move_word_right crosses the current word when inside one, then separators up
// to the next word start. This is the conventional Ctrl-Right destination and
// composes with Shift selection through the common movement transition.
pub move_word_right :: proc(buffer: ^Buffer, extend: bool = false) {
    old := buffer.cursor
    cursor := buffer.cursor
    for cursor < buffer.bytes.length &&
        word_byte(buffer.bytes.data[cursor]) {
        cursor = next_grapheme(buffer, cursor)
    }
    for cursor < buffer.bytes.length &&
        !word_byte(buffer.bytes.data[cursor]) {
        cursor = next_grapheme(buffer, cursor)
    }
    buffer.cursor = cursor
    prepare_movement(buffer, old, extend)
    buffer.preferred_column_valid = false
}

pub move_file_start :: proc(buffer: ^Buffer, extend: bool = false) {
    old := buffer.cursor
    buffer.cursor = 0
    prepare_movement(buffer, old, extend)
    buffer.preferred_column_valid = false
}

pub move_file_end :: proc(buffer: ^Buffer, extend: bool = false) {
    old := buffer.cursor
    buffer.cursor = buffer.bytes.length
    prepare_movement(buffer, old, extend)
    buffer.preferred_column_valid = false
}

// go_to_line moves to the first byte of a one-based document line. Zero and
// values beyond the indexed document are rejected without changing selection
// or viewport state. The successful transition uses the retained line-start
// table and requests one cursor reveal; it never rescans source bytes.
pub go_to_line :: proc(buffer: ^Buffer, one_based_line: usize) -> bool {
    if one_based_line == 0 || one_based_line > buffer.line_starts.length {
        return false
    }
    buffer.cursor = buffer.line_starts.data[one_based_line - 1]
    clear_selection(buffer)
    buffer.preferred_column_valid = false
    buffer.reveal_cursor = true
    return true
}

// display_step returns the next byte offset and terminal-cell width of one
// editor text unit at the supplied zero-based visual column. A tab is a
// deliberate one-byte control unit whose width reaches the next Tab_Columns
// stop. Valid UTF-8 advances by one extended grapheme; malformed or nonprinting
// bytes remain recoverable one-byte, one-cell units and retain their error so
// the view can paint a replacement glyph. offset must address bytes.
display_step :: proc(
    bytes: []u8,
    offset, column: usize,
) -> (usize, usize, unicode.Grapheme_Error) {
    assert(offset < len(bytes), "editor display step is outside source")
    if bytes[offset] == cast[u8]('\t') {
        return (
            offset + 1,
            Tab_Columns - column % Tab_Columns,
            .none,
        )
    }
    (next, width, error) := unicode.next_grapheme_bytes(bytes, offset)
    if next <= offset {
        next = offset + 1
        error = .invalid_encoding
    }
    if error != .none {
        width = 1
    }
    return (next, width, error)
}

// display_column measures one half-open byte range using the same tab stops and
// recovery units as painting. start/end are cursor-valid offsets on one line;
// the result is relative to that line start and independent of viewport scroll.
display_column :: proc(buffer: ^Buffer, start, end: usize) -> usize {
    column: usize
    cursor := start
    bytes := array.view(&buffer.bytes)
    for cursor < end {
        (next, width, _) := display_step(bytes, cursor, column)
        column += width
        cursor = next
    }
    return column
}

// offset_at_column is display_column's hit-testing inverse. A target inside a
// multi-column grapheme or expanded tab selects the unit's starting byte; a
// target at its far edge selects the following byte. This deterministic rule
// is shared by mouse placement and preferred-column vertical movement.
offset_at_column :: proc(
    buffer: ^Buffer,
    start, end, target_column: usize,
) -> usize {
    column: usize
    cursor := start
    bytes := array.view(&buffer.bytes)
    for cursor < end {
        (next, step, _) := display_step(bytes, cursor, column)
        if column + step > target_column {
            break
        }
        column += step
        cursor = next
    }
    return cursor
}

move_vertical :: proc(buffer: ^Buffer, upward, extend: bool) {
    old := buffer.cursor
    current_start := line_start(buffer, buffer.cursor)
    if !buffer.preferred_column_valid {
        buffer.preferred_column = display_column(
            buffer,
            current_start,
            buffer.cursor,
        )
        buffer.preferred_column_valid = true
    }
    target_start: usize
    target_end: usize
    if upward {
        if current_start == 0 {
            prepare_movement(buffer, old, extend)
            return
        }
        target_end = current_start - 1
        target_start = line_start(buffer, target_end)
    } else {
        current_end := line_end(buffer, buffer.cursor)
        if current_end == buffer.bytes.length {
            prepare_movement(buffer, old, extend)
            return
        }
        target_start = current_end + 1
        target_end = line_end(buffer, target_start)
    }
    buffer.cursor = offset_at_column(
        buffer,
        target_start,
        target_end,
        buffer.preferred_column,
    )
    prepare_movement(buffer, old, extend)
}

pub move_up :: proc(buffer: ^Buffer, extend: bool = false) {
    move_vertical(buffer, true, extend)
}

pub move_down :: proc(buffer: ^Buffer, extend: bool = false) {
    move_vertical(buffer, false, extend)
}

pub backspace :: proc(buffer: ^Buffer) -> bool {
    if buffer.read_only {
        return false
    }
    if delete_selection(buffer) {
        return true
    }
    if buffer.cursor == 0 {
        return false
    }
    start := buffer.cursor - 1
    if buffer.bytes.data[start] != cast[u8]('\n') {
        start = previous_grapheme(buffer, buffer.cursor)
    }
    delete_range(buffer, start, buffer.cursor)
    return true
}

pub delete_forward :: proc(buffer: ^Buffer) -> bool {
    if buffer.read_only {
        return false
    }
    if delete_selection(buffer) {
        return true
    }
    if buffer.cursor == buffer.bytes.length {
        return false
    }
    delete_range(buffer, buffer.cursor, next_grapheme(buffer, buffer.cursor))
    return true
}

// undo_primitive applies exactly one inverse history record without changing
// history_index, cursor, selection, or dirty state. Public undo owns atomic
// grouping and publishes those user-visible state transitions once.
undo_primitive :: proc(buffer: ^Buffer, edit: Edit) {
    if edit.kind == .insert {
        if edit.byte_length != 0 {
            delete_raw(buffer, edit.at, edit.byte_length)
        }
    } else {
        if edit.byte_length != 0 {
            source_data := cast[[^]u8](
                &buffer.history_bytes.data[edit.byte_start],
            )
            source := source_data[:edit.byte_length]
            insert_raw(buffer, edit.at, source)
        }
    }
}

pub undo :: proc(buffer: ^Buffer) -> bool {
    if buffer.read_only {
        return false
    }
    if buffer.history_index == 0 {
        return false
    }
    edit := buffer.history.data[buffer.history_index - 1]
    undo_primitive(buffer, edit)
    buffer.history_index -= 1
    before_cursor := edit.before_cursor
    joined := edit.joined_to_previous
    for joined {
        assert(buffer.history_index != 0,
            "joined editor history must have a preceding record")
        previous := buffer.history.data[buffer.history_index - 1]
        undo_primitive(buffer, previous)
        buffer.history_index -= 1
        before_cursor = previous.before_cursor
        joined = previous.joined_to_previous
    }
    buffer.cursor = before_cursor
    clear_selection(buffer)
    buffer.preferred_column_valid = false
    buffer.reveal_cursor = true
    buffer.dirty = !bytes_equal(
        array.view(&buffer.bytes),
        array.view(&buffer.disk_bytes),
    )
    return true
}

// redo_primitive applies one forward history record. It mirrors
// undo_primitive so pair grouping remains a small index policy rather than a
// third storage mutation path.
redo_primitive :: proc(buffer: ^Buffer, edit: Edit) {
    if edit.kind == .insert {
        if edit.byte_length != 0 {
            source_data := cast[[^]u8](
                &buffer.history_bytes.data[edit.byte_start],
            )
            source := source_data[:edit.byte_length]
            insert_raw(buffer, edit.at, source)
        }
    } else {
        if edit.byte_length != 0 {
            delete_raw(buffer, edit.at, edit.byte_length)
        }
    }
}

pub redo :: proc(buffer: ^Buffer) -> bool {
    if buffer.read_only {
        return false
    }
    if buffer.history_index == buffer.history.length {
        return false
    }
    edit := buffer.history.data[buffer.history_index]
    assert(!edit.joined_to_previous,
        "redo must begin at an atomic history group boundary")
    redo_primitive(buffer, edit)
    buffer.history_index += 1
    after_cursor := edit.after_cursor
    for buffer.history_index < buffer.history.length &&
        buffer.history.data[buffer.history_index].joined_to_previous {
        joined := buffer.history.data[buffer.history_index]
        redo_primitive(buffer, joined)
        buffer.history_index += 1
        after_cursor = joined.after_cursor
    }
    buffer.cursor = after_cursor
    clear_selection(buffer)
    buffer.preferred_column_valid = false
    buffer.reveal_cursor = true
    buffer.dirty = !bytes_equal(
        array.view(&buffer.bytes),
        array.view(&buffer.disk_bytes),
    )
    return true
}

// Find_Result distinguishes an ordinary match from one found only after
// crossing a document end. The IDE uses wrapped for precise status feedback;
// both cases publish the same visible Buffer selection.
pub Find_Result :: struct {
    found: bool,
    wrapped: bool,
}

// Replace_Result makes refusal explicit: selection_mismatch means the visible
// selection is not the caller's exact query; history_limit means applying the
// change would violate the promised one-record undo bound. Neither mutates.
pub Replace_Result :: enum u8 {
    replaced,
    selection_mismatch,
    history_limit,
    read_only,
}

// Replace_All_Result reports both the number of nonoverlapping source matches
// and whether the atomic edit was applied. completed is false only when the
// combined old/new undo payload exceeds the explicit history bound; count may
// then be nonzero, but Buffer remains entirely unchanged.
pub Replace_All_Result :: struct {
    count: usize,
    completed: bool,
}

bytes_match_at :: proc(buffer: ^Buffer, needle: []u8, at: usize) -> bool {
    if len(needle) > buffer.bytes.length ||
        at > buffer.bytes.length - len(needle) {
        return false
    }
    for index: usize = 0; index < len(needle); index += 1 {
        if buffer.bytes.data[at + index] != needle[index] {
            return false
        }
    }
    return true
}

select_match :: proc(buffer: ^Buffer, start, length: usize) {
    buffer.anchor = start
    buffer.cursor = start + length
    buffer.selection_active = true
    buffer.preferred_column_valid = false
    buffer.reveal_cursor = true
}

// find_forward_range returns the first match start in [begin,end), where end
// is a candidate-start boundary rather than a byte boundary. The all-ones
// sentinel cannot be a valid Dynamic-array offset.
find_forward_range :: proc(
    buffer: ^Buffer,
    needle: []u8,
    begin, end: usize,
) -> usize {
    cursor := begin
    for cursor < end {
        if bytes_match_at(buffer, needle, cursor) {
            return cursor
        }
        cursor += 1
    }
    return ~cast[usize](0)
}

// find_reverse_range returns the greatest match start in [begin,end). Counting
// through end as an exclusive one-past value avoids unsigned underflow at row
// zero and keeps reverse search deterministic for an empty leading range.
find_reverse_range :: proc(
    buffer: ^Buffer,
    needle: []u8,
    begin, end: usize,
) -> usize {
    cursor := end
    for cursor > begin {
        cursor -= 1
        if bytes_match_at(buffer, needle, cursor) {
            return cursor
        }
    }
    return ~cast[usize](0)
}

// find_next selects the next literal byte occurrence at/after the cursor and
// wraps once to the start. Empty needles do nothing. Search is deliberately
// literal; case folding and Unicode normalization require separate policies.
pub find_next :: proc(buffer: ^Buffer, needle: []u8) -> Find_Result {
    result: Find_Result
    if len(needle) == 0 || len(needle) > buffer.bytes.length {
        return result
    }
    candidate_count := buffer.bytes.length - len(needle) + 1
    start := buffer.cursor
    if start > candidate_count {
        start = candidate_count
    }
    match := find_forward_range(buffer, needle, start, candidate_count)
    if match == ~cast[usize](0) && start != 0 {
        match = find_forward_range(buffer, needle, 0, start)
        result.wrapped = match != ~cast[usize](0)
    }
    if match != ~cast[usize](0) {
        select_match(buffer, match, len(needle))
        result.found = true
    }
    return result
}

// find_previous starts before the current selection (or cursor), then wraps
// from the last legal candidate. This makes Shift-F3 move away from the visible
// match rather than selecting it again until a real one-match wrap occurs.
pub find_previous :: proc(buffer: ^Buffer, needle: []u8) -> Find_Result {
    result: Find_Result
    if len(needle) == 0 || len(needle) > buffer.bytes.length {
        return result
    }
    candidate_count := buffer.bytes.length - len(needle) + 1
    start := buffer.cursor
    (selected_start, _, selected) := selection(buffer)
    if selected {
        start = selected_start
    }
    if start > candidate_count {
        start = candidate_count
    }
    match := find_reverse_range(buffer, needle, 0, start)
    if match == ~cast[usize](0) {
        match = find_reverse_range(buffer, needle, start, candidate_count)
        result.wrapped = match != ~cast[usize](0)
    }
    if match != ~cast[usize](0) {
        select_match(buffer, match, len(needle))
        result.found = true
    }
    return result
}

// find retains the original small API for callers which do not need wrap
// feedback. New interactive code should use find_next/find_previous.
pub find :: proc(buffer: ^Buffer, needle: []u8) -> bool {
    return find_next(buffer, needle).found
}

// replace_selected applies one exact selected query match as one undo record.
// needle and replacement are borrowed only for this call and must not alias
// Buffer storage. A selection mismatch performs no mutation. Replacing bytes
// with themselves still clears the transient selection and counts as success,
// but does not manufacture a meaningless history record.
pub replace_selected :: proc(
    buffer: ^Buffer,
    needle, replacement: []u8,
) -> Replace_Result {
    if buffer.read_only {
        return .read_only
    }
    (start, end, selected) := selection(buffer)
    if !selected || end - start != len(needle) ||
        !bytes_match_at(buffer, needle, start) {
        return .selection_mismatch
    }
    same := len(needle) == len(replacement)
    if same {
        for index: usize = 0; index < len(needle); index += 1 {
            if needle[index] != replacement[index] {
                same = false
                break
            }
        }
    }
    if same {
        buffer.cursor = end
        clear_selection(buffer)
        buffer.reveal_cursor = true
        return .replaced
    }
    old_data := cast[[^]u8](&buffer.bytes.data[start])
    if !record_replace(
        buffer,
        start,
        old_data[:end - start],
        replacement,
        buffer.cursor,
        start + len(replacement),
    ) {
        return .history_limit
    }
    delete_raw(buffer, start, end - start)
    if len(replacement) != 0 {
        insert_raw(buffer, start, replacement)
    }
    buffer.cursor = start + len(replacement)
    clear_selection(buffer)
    buffer.preferred_column_valid = false
    buffer.reveal_cursor = true
    buffer.dirty = true
    return .replaced
}

// replace_all scans only the original document and advances by needle length,
// so replacement text is never re-matched during the same operation. It builds
// one candidate byte array, records the entire before/after pair as one atomic
// history entry, then publishes the new bytes through the same raw mutation
// operations used by undo/redo. No match is a successful zero-count operation.
pub replace_all :: proc(
    buffer: ^Buffer,
    needle, replacement: []u8,
) -> Replace_All_Result {
    result := Replace_All_Result{completed = true}
    if buffer.read_only {
        result.completed = false
        return result
    }
    if len(needle) == 0 || len(needle) > buffer.bytes.length {
        return result
    }
    final_length := buffer.bytes.length
    source: usize
    last_start := buffer.bytes.length - len(needle)
    for source <= last_start {
        if bytes_match_at(buffer, needle, source) {
            result.count += 1
            if len(replacement) >= len(needle) {
                growth := len(replacement) - len(needle)
                if growth > ~cast[usize](0) - final_length {
                    result.completed = false
                    return result
                }
                final_length += growth
            } else {
                final_length -= len(needle) - len(replacement)
            }
            source += len(needle)
        } else {
            source += 1
        }
    }
    if result.count == 0 {
        return result
    }

    candidate: Byte_Array
    array.init(&candidate)
    array.reserve(&candidate, final_length)
    before_cursor := buffer.cursor
    after_cursor: usize
    cursor_mapped := false
    source = 0
    for source < buffer.bytes.length {
        if source <= last_start &&
            bytes_match_at(buffer, needle, source) {
            output_start := candidate.length
            if !cursor_mapped && before_cursor >= source &&
                before_cursor <= source + len(needle) {
                after_cursor = output_start + len(replacement)
                cursor_mapped = true
            }
            for byte in replacement {
                array.append(&candidate, byte)
            }
            source += len(needle)
        } else {
            if !cursor_mapped && before_cursor == source {
                after_cursor = candidate.length
                cursor_mapped = true
            }
            array.append(&candidate, buffer.bytes.data[source])
            source += 1
        }
    }
    if !cursor_mapped {
        after_cursor = candidate.length
    }
    assert(candidate.length == final_length,
        "replace-all size preflight must match constructed bytes")

    old := array.view(&buffer.bytes)
    replacement_document := array.view(&candidate)
    if bytes_equal(old, replacement_document) {
        array.destroy(&candidate)
        clear_selection(buffer)
        buffer.reveal_cursor = true
        return result
    }
    if !record_replace(
        buffer,
        0,
        old,
        replacement_document,
        before_cursor,
        after_cursor,
    ) {
        array.destroy(&candidate)
        result.completed = false
        return result
    }
    old_length := buffer.bytes.length
    delete_raw(buffer, 0, old_length)
    if candidate.length != 0 {
        insert_raw(buffer, 0, array.view(&candidate))
    }
    array.destroy(&candidate)
    buffer.cursor = after_cursor
    clear_selection(buffer)
    buffer.preferred_column_valid = false
    buffer.reveal_cursor = true
    buffer.dirty = true
    return result
}

pub can_close :: proc(buffer: ^Buffer, force: bool = false) -> bool {
    return force || !buffer.dirty
}
